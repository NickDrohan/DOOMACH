# The compiler DOOMACH is built and tested against. It needs the SPIR-V
# backend and 256-bit vectors, which arrived after Mach 5.11.
# Change deliberately, re-run bootstrap.sh, then check.sh.
# The hash is the one the release publishes in its SHA256SUMS.
MACH_VERSION=6.9.0
MACH_WINDOWS_SHA256=392e8807c5f73c16ab3103c115796094a80648b72d9b89ad67637e27e8528249
