pub val TRIGGER_USE:   i32 = 1;
pub val TRIGGER_SHOOT: i32 = 2;

# the head of everything that acts once a tic. every record that thinks
# begins with one of these, so a *Thinker can be cast to the record it heads.
pub rec Thinker {
    prev: *Thinker;
    next: *Thinker;
    kind: u8;
}

# a map object: a monster, a missile, an item, a player's body, a decoration
pub rec Mobj {
    thinker: Thinker;

    x: Fixed;
    y: Fixed;
    z: Fixed;

    # links in the sector's list of things
    snext: *Mobj;
    sprev: *Mobj;

    angle:  u32;
    sprite: i32;
    frame:  i32;

    # links in the blockmap cell's list of things
    bnext: *Mobj;
    bprev: *Mobj;

    subsector: i32;

    # the closest interval over all contacted sectors
    floorz:   Fixed;
    ceilingz: Fixed;

    radius: Fixed;
    height: Fixed;

    momx: Fixed;
    momy: Fixed;
    momz: Fixed;

    validcount: i32;

    # MT_* object type; its info is info.mi(kind, ...)
    kind: i32;

    # state tic counter, and the S_* state it counts down
    tics:   i32;
    state:  i32;
    flags:  i32;
    health: i32;

    # movement direction and steps left in it, for monsters
    movedir:   i32;
    movecount: i32;

    # the thing being chased or attacked, or the firer of a missile
    target: *Mobj;

    reactiontime: i32;
    threshold:    i32;

    # only for players' bodies
    player: *Player;

    # player number last looked for
    lastlook: i32;

    # for nightmare respawn
    spawnpoint: level.Thing;

    # the thing being chased by a seeking missile
    tracer: *Mobj;
}

# one layer of the weapon drawn over the view
pub rec Pspdef {
    # S_* state, 0 for none
    state: i32;
    tics:  i32;
    sx:    Fixed;
    sy:    Fixed;
}

# what a player intends for one tic
pub rec Ticcmd {
    forwardmove: i8;
    sidemove:    i8;
    angleturn:   i16;
    consistancy: i16;
    chatchar:    u8;
    buttons:     u8;
}

pub rec Player {
    mo:          *Mobj;
    playerstate: i32;
    cmd:         Ticcmd;

    # eye height above the floor, bobbed, and the unbobbed height and its change
    viewz:           Fixed;
    viewheight:      Fixed;
    deltaviewheight: Fixed;
    bob:             Fixed;

    # carried between levels; mo.health is the one used during a level
    health:      i32;
    armorpoints: i32;
    armortype:   i32;

    powers:   [6]i32;
    cards:    [6]bool;
    backpack: bool;

    readyweapon:   i32;
    pendingweapon: i32;
    weaponowned:   [9]bool;
    ammo:          [4]i32;
    maxammo:       [4]i32;

    attackdown: i32;
    usedown:    i32;
    cheats:     i32;
    refire:     i32;

    killcount:   i32;
    itemcount:   i32;
    secretcount: i32;
    # in a deathmatch, how many times this player has killed each player;
    # its own entry counts the times it killed itself
    frags:       [4]i32;

    message: str;

    damagecount: i32;
    bonuscount:  i32;
    attacker:    *Mobj;

    extralight:    i32;
    fixedcolormap: i32;
    colormap:      i32;

    psprites:  [2]Pspdef;
    didsecret: bool;
}

pub rec Divline {
    x:  Fixed;
    y:  Fixed;
    dx: Fixed;
    dy: Fixed;
}

# where a traced path crosses a line or a thing
pub rec Intercept {
    frac:    Fixed;
    isaline: bool;
    line:    i32;
    thing:   *Mobj;
}

# a wall switch that will pop back out
pub rec Button {
    line:     i32;
    where:    i32;
    btexture: i32;
    btimer:   i32;
    soundorg: i32;
}

# an animated flat or wall texture
pub rec Anim {
    istexture: bool;
    picnum:    i32;
    basepic:   i32;
    numpics:   i32;
    speed:     i32;
}

pub def ActionHook:  fun(*Game, *Mobj, *Player, *Pspdef, i32);
pub def SpecialHook: fun(*Game, i32, i32, i32, *Mobj) bool;
pub def SoundHook:   fun(*Game, ptr, bool, Fixed, Fixed, i32);

pub rec Game {
    lv:  *level.Level;
    rnd: random.Random;
    # the WAD's graphics: texture heights for one floor mover, and the
    # tables that animated walls and flats are switched through
    d: *rdata.Data;

    # memory for everything that lives for one level
    a:         *allocator.Allocator;
    chunk:     *u8;
    chunkused: usize;
    chunkcap:  usize;

    # the two calls that go up the module order
    run_action:   ActionHook;
    line_special: SpecialHook;
    start_sound:  SoundHook;

    # the game
    gameskill:       i32;
    gameepisode:     i32;
    gamemap:         i32;
    gametic:         i32;
    leveltime:       i32;
    deathmatch:      i32;
    netgame:         bool;
    respawnmonsters: bool;
    fastparm:        bool;
    nomonsters:      bool;
    respawnparm:     bool;
    # 0 none, 1 the level's exit was taken, 2 its secret exit
    exited: i32;
    # counts the levels loaded; whatever held a pointer into the last one
    # must let go when this changes
    levelserial: i32;

    # the bots' walk grid for this level (bot.mach): a byte a cell, and which
    # level it was built for
    navgrid:   *u8;
    # a byte a sector: whether some line's switch or trigger moves it
    navmoves:  *u8;
    navw:      i32;
    navh:      i32;
    navserial: i32;
    # the WAD holds only the first episode
    shareware: bool;
    # the flat that means "sky"
    skyflatnum: i32;

    players:       [4]Player;
    playeringame:  [4]bool;
    consoleplayer: i32;
    playerstarts:  [4]level.Thing;
    # which players the simulation plays itself (bot.mach)
    isbot:         [4]bool;
    # where deathmatch players come in, and how many such places the map has
    deathmatchstarts: [10]level.Thing;
    numdmstarts:      i32;

    totalkills:  i32;
    totalitems:  i32;
    totalsecret: i32;

    # p_tick: the ring of thinkers; thinkercap is its head and its tail
    thinkercap: Thinker;

    # p_mobj: items waiting to respawn, and one list of things per blockmap
    # cell
    itemrespawnque:  [128]level.Thing;
    itemrespawntime: [128]i32;
    iquehead:        i32;
    iquetail:        i32;
    blocklinks:      **Mobj;
    validcount:      i32;
    bodyque:         [32]*Mobj;
    bodyqueslot:     i32;

    # p_maputl
    opentop:     Fixed;
    openbottom:  Fixed;
    openrange:   Fixed;
    lowfloor:    Fixed;
    intercepts:  [128]Intercept;
    intercept_p: i32;
    trace:       Divline;
    earlyout:    bool;

    # p_sight, and shared with p_map's aiming
    sightzstart: Fixed;
    topslope:    Fixed;
    bottomslope: Fixed;
    strace:      Divline;
    t2x:         Fixed;
    t2y:         Fixed;

    # p_map: the move being tried
    tmbbox:      [4]Fixed;
    tmthing:     *Mobj;
    tmflags:     i32;
    tmx:         Fixed;
    tmy:         Fixed;
    floatok:     bool;
    tmfloorz:    Fixed;
    tmceilingz:  Fixed;
    tmdropoffz:  Fixed;
    ceilingline: i32;
    spechit:     [8]i32;
    numspechit:  i32;

    # p_map: sliding along walls
    bestslidefrac:   Fixed;
    secondslidefrac: Fixed;
    bestslideline:   i32;
    secondslideline: i32;
    slidemo:         *Mobj;
    tmxmove:         Fixed;
    tmymove:         Fixed;

    # p_map: shooting, using, explosions, crushing
    linetarget:  *Mobj;
    shootthing:  *Mobj;
    shootz:      Fixed;
    la_damage:   i32;
    attackrange: Fixed;
    aimslope:    Fixed;
    usething:    *Mobj;
    bombsource:  *Mobj;
    bombspot:    *Mobj;
    bombdamage:  i32;
    crushchange: bool;
    nofit:       bool;

    # p_enemy
    soundtarget: *Mobj;

    # p_spec and p_switch
    activeplats:     [30]ptr;
    activeceilings:  [30]ptr;
    linespeciallist: [64]i32;
    numlinespecials: i32;
    buttonlist:      [16]Button;
    switchlist:      [100]i32;
    numswitches:     i32;
    anims:           [32]Anim;
    numanims:        i32;

    # p_pspr
    swingx:      Fixed;
    swingy:      Fixed;
    bulletslope: Fixed;

    # p_user
    onground: bool;
}

val CHUNK: usize = 1 << 20;

# memory that lasts until the level ends; zeroed
# ---
# g:    the game
# size: bytes wanted
# ret:  the memory, or nil when there is none left
pub fun alloc(g: *Game, size: usize) ptr {
    val need: usize = (size + 15) & (0 - 16:~usize);
    if (g.chunk == nil || g.chunkused + need > g.chunkcap) {
        var cap: usize = CHUNK;
        if (need + 16 > cap) { cap = need + 16; }
        val got: res[*u8, allocator.Error] = allocator.zallocate[u8](g.a, cap);
        if (sel got.err) { ret nil; }
        # each chunk begins with the address of the one before and its size
        val head: *usize = got.ok:~*usize;
        head[0]     = g.chunk::usize;
        head[1]     = cap;
        g.chunk     = got.ok;
        g.chunkused = 16;
        g.chunkcap  = cap;
    }
    val p: *u8 = ?g.chunk[g.chunkused];
    g.chunkused = g.chunkused + need;
    ret p:~ptr;
}

# give back everything alloc handed out, as the level ends
pub fun free_level(g: *Game) {
    for (g.chunk != nil) {
        val head: *usize = g.chunk:~*usize;
        val prev: usize  = head[0];
        val cap:  usize  = head[1];
        allocator.deallocate[u8](g.a, g.chunk, cap);
        g.chunk = prev::*u8;
    }
    g.chunkused = 0;
    g.chunkcap  = 0;
}

# make a noise at a thing; origin may be nil for a noise that has no place
pub fun sound(g: *Game, origin: *Mobj, sfx: i32) {
    if (g.start_sound == nil) { ret; }
    if (origin == nil) {
        g.start_sound(g, nil, 0, 0, 0, sfx);
    }
    or {
        g.start_sound(g, origin:~ptr, 1, origin.x, origin.y, sfx);
    }
}

# make a noise at the middle of a sector, as doors and lifts do
pub fun sector_sound(g: *Game, secnum: i32, sfx: i32) {
    if (g.start_sound == nil) { ret; }
    val sec: *level.Sector = ?g.lv.sectors[secnum];
    g.start_sound(g, sec:~ptr, 0, sec.soundorg_x, sec.soundorg_y, sfx);
}

# the sector an object stands in
pub fun sector_of(g: *Game, mo: *Mobj) *level.Sector {
    ret ?g.lv.sectors[g.lv.subsectors[mo.subsector].sector];
}

# the next number of the playsim's random walk
pub fun p_random(g: *Game) i32 {
    ret random.p_random(?g.rnd);
}
