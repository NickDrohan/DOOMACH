# what a thinker is; the C code holds a function pointer here
pub val TH_NONE:        u8 = 0;
pub val TH_REMOVED:     u8 = 1;
pub val TH_MOBJ:        u8 = 2;
pub val TH_DOOR:        u8 = 3;
pub val TH_FLOOR:       u8 = 4;
