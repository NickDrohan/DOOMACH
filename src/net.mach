# network play: lockstep over UDP
#
# Every machine runs the same deterministic game, and the only thing sent is
# each player's ticcmd, four bytes a tic. Tic N runs on a machine once it
# holds every player's command for tic N. Each packet carries every command
# the receiver has not yet acknowledged, so a lost packet costs only the
# wait for the next one, and carries the sender's checksum of the world at a
# recent tic, so two machines that ever disagree find out at once. See
# MULTIPLAYER.md for the design.
#
# The sockets are std.net.udp; nothing here is Windows-specific.

use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use io_error: std.io.error;
use std.net.ip;
use socket_api: std.net.socket;
use std.net.udp;
use std.crypto.rand;

use doom.defs;
use doom.defs.Ticcmd;
use rp: doom.relayproto;

pub val PORT: u16 = 5029;

val KIND_COMMAND: u8 = 1;
val KIND_START:   u8 = 2;
val KIND_HELLO:   u8 = 3;
val KIND_QUIT:    u8 = 4;
val KIND_REFUSE:  u8 = 5;

# commands kept per player, and the most a packet carries
val BACKUP:  i32 = 128;
val PERPACK: i32 = 16;

# how far this machine's commands may run ahead of the tic being played,
# beyond the playout cushion
pub val LEAD: i32 = 4;

# the playout cushion, in tics: a tic is played only once this machine's own
# commands are that far past it, which gives the others' commands that long
# to arrive. It starts here, grows by one after a wait (at most every
# quarter second), and shrinks by one
# after CALM steps in which commands kept arriving at least two tics early.
val PLAYOUT_START: i32 = 2;
val PLAYOUT_MAX:   i32 = 12;
val CALM:          i32 = 175;

# where a player is on the network: an IPv4 address and a port
pub rec Peer {
    octets: [4]u8;
    port:   u16;
    known:  bool;
}

# a bot the relay seated: its kind (1 the hand-written bot, otherwise a net),
# the seed of its noise, its name, and its net
pub rec BotSeat {
    known: bool;
    kind:  i32;
    seed:  u32;
    name:  [24]u8;
    net:   [942]i8;
}

pub rec Net {
    sock:   udp.Socket;
    opened: bool;

    # the game every machine agrees to play
    players: i32;
    me:      i32;
    skill:   i32;
    map:     i32;
    started: bool;
    host:    bool;
    peers:   [4]Peer;

    # every player's commands by tic: slot (player * BACKUP + tic % BACKUP)
    # holds the command for the tic in tics[] at the same slot
    cmds: [512]Ticcmd;
    tics: [512]i32;
    # for each player, how many tics from 0 are held without a gap
    have: [4]i32;
    # for each peer, how many of my tics it says it holds
    acked: [4]i32;
    # how many of my own commands exist
    maketic: i32;

    # the playout cushion; steps since it last grew, and steps in a row with
    # room to spare; how many steps had to wait, and the largest cushion
    playout:  i32;
    sincegrew: i32;
    calm:     i32;
    waits:    i32;
    widest:   i32;

    # my checksum of the world after each tic, by tic % BACKUP
    sums:    [128]u32;
    sumtics: [128]i32;

    # a peer's checksum disagreed with mine, at this tic; or a peer quit
    desync:    bool;
    desynctic: i32;
    # the two checksums that disagreed, mine and the peer's, and whose
    mysum:     u32;
    theirsum:  u32;
    against:   i32;
    quit:      bool;

    # the WAD every machine must hold, as the first eight bytes of its hash
    wadhash: u64;
    # a room hosted through a relay is put on its public list
    public:  bool;
    # the game is a deathmatch, as the host chose and the relay tells the
    # rest; and a hosted room would have its bots sooner than usual
    deathmatch: bool;
    quick:      bool;
    # why the host or the relay turned this machine away, or 0
    refused: u8;

    # through a relay: where it is, this player's token, the room's code,
    # how many have joined, and a count that paces the lobby messages
    relaymode: bool;
    relay:     Peer;
    token:     u64;
    code:      [7]u8;
    joincode:  [6]u8;
    joined:    i32;
    nonce:     u32;
    pace:      i32;
    wrap:      [1100]u8;

    # bots in the game, seated by the relay in the seats nobody took: a bit
    # a seat, and each one as the relay told it, which every machine is told
    # alike. The game starts when the relay has said start and every bot is
    # known.
    startseen: bool;
    botmask:   i32;
    bots:      [4]BotSeat;
    # seconds until bots take a public room's empty seats, 255 for never;
    # and whether this host has asked for them now
    fillin:    i32;
    wantfill:  bool;

    packet: [256]u8;
}

fun put32(p: *u8, at: i32, v: u32) {
    p[at]     = v::u8;
    p[at + 1] = (v >> 8)::u8;
    p[at + 2] = (v >> 16)::u8;
    p[at + 3] = (v >> 24)::u8;
}

fun get32(p: *u8, at: i32) u32 {
    ret p[at]::u32 | (p[at + 1]::u32 << 8) | (p[at + 2]::u32 << 16) | (p[at + 3]::u32 << 24);
}

fun endpoint_of(p: *Peer) ip.Endpoint {
    ret ip.endpoint(p.octets[0], p.octets[1], p.octets[2], p.octets[3], p.port);
}

fun same_peer(p: *Peer, ep: *ip.Endpoint) bool {
    ret p.known && p.port == ep.port && p.octets[0] == ep.addr.v4.octets[0] && p.octets[1] == ep.addr.v4.octets[1] &&
        p.octets[2] == ep.addr.v4.octets[2] && p.octets[3] == ep.addr.v4.octets[3];
}

fun set_peer(p: *Peer, ep: *ip.Endpoint) {
    p.octets[0] = ep.addr.v4.octets[0];
    p.octets[1] = ep.addr.v4.octets[1];
    p.octets[2] = ep.addr.v4.octets[2];
    p.octets[3] = ep.addr.v4.octets[3];
    p.port      = ep.port;
    p.known     = 1;
}

fun begin(n: *Net, kind: u8) i32 {
    n.packet[0] = 'M';
    n.packet[1] = 'D';
    n.packet[2] = 'M';
    n.packet[3] = '1';
    n.packet[4] = kind;
    n.packet[5] = n.me::u8;
    ret 6;
}

fun send(n: *Net, peer: i32, len: i32) {
    if (!n.peers[peer].known) { ret; }
    if (n.relaymode) {
        # through the relay: the same datagram, in an envelope naming who it
        # is for
        val at: i32 = rp.header(?n.wrap[0], rp.DATA, n.me, peer, n.token);
        var k:  i32 = 0;
        for (k < len) {
            n.wrap[at + k] = n.packet[k];
            k              = k + 1;
        }
        udp.send_to(?n.sock, ?n.wrap[0], (at + len)::usize, endpoint_of(?n.relay));
        ret;
    }
    udp.send_to(?n.sock, ?n.packet[0], len::usize, endpoint_of(?n.peers[peer]));
}

# a message to the relay itself
fun to_relay(n: *Net, len: i32) {
    udp.send_to(?n.sock, ?n.wrap[0], len::usize, endpoint_of(?n.relay));
}

# read where a host or relay is: a.b.c.d with an optional :port, the port
# the default when absent
pub fun parse_address(text: str, out: *Peer) bool {
    val parsed: res[ip.Endpoint, ip.ParseError] = ip.endpoint_parse(text);
    var ep:     ip.Endpoint;
    if (sel parsed.ok) {
        ep = parsed.ok;
    }
    or {
        val addr: res[ip.IPv4, ip.ParseError] = ip.ipv4_parse(text);
        if (sel addr.err) { ret 0; }
        ep = ip.endpoint_v4(addr.ok, PORT);
    }
    if (ep.addr.is_v6 != 0) { ret 0; }
    set_peer(out, ?ep);
    ret 1;
}

# play through a relay rather than directly
# ---
# n:     the network state, opened
# relay: where the relay is
pub fun use_relay(n: *Net, relay: *Peer) {
    n.relaymode   = 1;
    n.relay       = @relay;
    n.relay.known = 1;
    n.nonce       = rand.u32() | 1;
}

# join the room with a code, through the relay set by use_relay
# ---
# ret: whether the code is six of the code's symbols
pub fun join_code(n: *Net, code: str) bool {
    var k: i32 = 0;
    for (k < rp.CODELEN) {
        val c: u8 = rp.code_char(code[k]);
        if (c == 0) { ret 0; }
        n.joincode[k] = c;
        k             = k + 1;
    }
    if (code[rp.CODELEN] != 0) { ret 0; }
    n.host = 0;
    ret 1;
}

fun reset(n: *Net) {
    var i: i32 = 0;
    for (i < 4 * BACKUP) {
        n.tics[i] = -1;
        i         = i + 1;
    }
    i = 0;
    for (i < BACKUP) {
        n.sumtics[i] = -1;
        i            = i + 1;
    }
    i = 0;
    for (i < 4) {
        n.have[i]  = 0;
        n.acked[i] = 0;
        i          = i + 1;
    }
    n.maketic   = 0;
    n.playout   = PLAYOUT_START;
    n.widest    = PLAYOUT_START;
    n.sincegrew = 0;
    n.calm      = 0;
    n.waits     = 0;
}

# open a socket on a port, without blocking on receives
# ---
# n:        the network state, zeroed
# port:     the port to listen on; 0 for any
# loopback: listen on this machine only, as the tests do
# ret:      whether the socket opened
pub fun open(n: *Net, port: u16, loopback: bool) bool {
    var where: ip.Endpoint = ip.endpoint(0, 0, 0, 0, port);
    if (loopback) { where = ip.endpoint(127, 0, 0, 1, port); }
    val bound: res[udp.Socket, io_error.Error] = udp.bind_with_flags(where, socket_api.async_flags());
    if (sel bound.err) { ret 0; }
    n.sock   = bound.ok;
    n.opened = 1;
    reset(n);
    ret 1;
}

pub fun close(n: *Net) {
    if (!n.opened) { ret; }
    # say goodbye, more than once in case one is lost
    var k: i32 = 0;
    for (k < 3) {
        if (n.started) {
            val len: i32 = begin(n, KIND_QUIT);
            var p:   i32 = 0;
            for (p < n.players) {
                if (p != n.me) { send(n, p, len); }
                p = p + 1;
            }
        }
        if (n.relaymode && n.token != 0) { to_relay(n, rp.header(?n.wrap[0], rp.LEAVE, n.me, 0, n.token)); }
        k = k + 1;
    }
    udp.socket_close(?n.sock);
    n.opened = 0;
}

# set up as the host of a game for a number of players
pub fun host(n: *Net, players: i32, skill: i32, map: i32) {
    n.host    = 1;
    n.players = players;
    n.me      = 0;
    n.skill   = skill;
    n.map     = map;
}

# set up to join the game hosted at an address
# ---
# n:    the network state, opened
# text: the host's address, a.b.c.d, optionally :port
# ret:  whether the address could be read
pub fun join(n: *Net, text: str) bool {
    val parsed: res[ip.Endpoint, ip.ParseError] = ip.endpoint_parse(text);
    var ep:     ip.Endpoint;
    if (sel parsed.ok) {
        ep = parsed.ok;
    }
    or {
        val addr: res[ip.IPv4, ip.ParseError] = ip.ipv4_parse(text);
        if (sel addr.err) { ret 0; }
        ep = ip.endpoint_v4(addr.ok, PORT);
    }
    if (ep.addr.is_v6 != 0) { ret 0; }
    n.host = 0;
    set_peer(?n.peers[0], ?ep);
    ret 1;
}

# tell every joiner the game: who they are, and where everyone is
fun send_start(n: *Net) {
    var p: i32 = 1;
    for (p < n.players) {
        var at: i32 = begin(n, KIND_START);
        n.packet[at]     = p::u8;
        n.packet[at + 1] = n.players::u8;
        n.packet[at + 2] = n.skill::u8;
        n.packet[at + 3] = n.map::u8;
        at               = at + 4;
        var q: i32 = 0;
        for (q < n.players) {
            n.packet[at]     = n.peers[q].octets[0];
            n.packet[at + 1] = n.peers[q].octets[1];
            n.packet[at + 2] = n.peers[q].octets[2];
            n.packet[at + 3] = n.peers[q].octets[3];
            n.packet[at + 4] = (n.peers[q].port & 0xff)::u8;
            n.packet[at + 5] = (n.peers[q].port >> 8)::u8;
            at               = at + 6;
            q                = q + 1;
        }
        send(n, p, at);
        p = p + 1;
    }
}

# hold a command; ret whether it was new
fun store(n: *Net, player: i32, tic: i32, cmd: *Ticcmd) {
    val slot: i32 = player * BACKUP + tic % BACKUP;
    if (n.tics[slot] == tic) { ret; }
    # a command so old its slot has been reused is of no use
    if (tic < n.have[player]) { ret; }
    n.cmds[slot] = @cmd;
    n.tics[slot] = tic;

    # move the gap-free count forward over whatever is now held
    for (n.tics[player * BACKUP + n.have[player] % BACKUP] == n.have[player]) {
        n.have[player] = n.have[player] + 1;
    }
}

fun handle(n: *Net, len: i32, from: *ip.Endpoint) {
    if (len < 6 || n.packet[0] != 'M' || n.packet[1] != 'D' || n.packet[2] != 'M' || n.packet[3] != '1') { ret; }
    val kind:   u8  = n.packet[4];
    val sender: i32 = n.packet[5]::i32;

    # hello and start belong to a direct game; through a relay they come
    # without an address and are ignored
    if ((kind == KIND_HELLO || kind == KIND_START) && from == nil) { ret; }

    if (kind == KIND_HELLO && n.host) {
        # a known joiner asking again has missed its start
        var p: i32 = 1;
        for (p < 4) {
            if (same_peer(?n.peers[p], from)) {
                if (n.started) { send_start(n); }
                ret;
            }
            p = p + 1;
        }
        if (n.started) { ret; }

        # a different build or WAD would only go out of step: turn it away
        var why: u8 = 0;
        if (len < 15 || n.packet[6] != rp.VERSION) {
            why = rp.OLD_VERSION;
        }
        or (rp.get64(?n.packet[0], 7) != n.wadhash) {
            why = rp.WAD_MISMATCH;
        }
        if (why != 0) {
            val at: i32 = begin(n, KIND_REFUSE);
            n.packet[at] = why;
            udp.send_to(?n.sock, ?n.packet[0], (at + 1)::usize, @from);
            ret;
        }

        # a new joiner takes the next number
        p = 1;
        for (p < n.players) {
            if (!n.peers[p].known) {
                set_peer(?n.peers[p], from);
                brk;
            }
            p = p + 1;
        }
        ret;
    }

    if (kind == KIND_START && !n.host && !n.started && len >= 10) {
        n.me      = n.packet[6]::i32;
        n.players = n.packet[7]::i32;
        n.skill   = n.packet[8]::i32;
        n.map     = n.packet[9]::i32;
        if (n.players < 2 || n.players > 4 || n.me < 1 || n.me >= n.players || len < 10 + n.players * 6) { ret; }
        # the host is where it was reached from; the others as the host saw
        # them
        var q: i32 = 1;
        for (q < n.players) {
            val at: i32 = 10 + q * 6;
            n.peers[q].octets[0] = n.packet[at];
            n.peers[q].octets[1] = n.packet[at + 1];
            n.peers[q].octets[2] = n.packet[at + 2];
            n.peers[q].octets[3] = n.packet[at + 3];
            n.peers[q].port      = n.packet[at + 4]::u16 | (n.packet[at + 5]::u16 << 8);
            n.peers[q].known     = q != n.me;
            q                    = q + 1;
        }
        n.started = 1;
        ret;
    }

    if (kind == KIND_REFUSE && !n.host && !n.started && len >= 7) {
        n.refused = n.packet[6];
        ret;
    }

    if (kind == KIND_QUIT && n.started) {
        n.quit = 1;
        ret;
    }

    if (kind == KIND_COMMAND && n.started && sender >= 0 && sender < n.players && sender != n.me && len >= 11) {
        val first: i32 = get32(?n.packet[0], 6):~i32;
        val count: i32 = n.packet[10]::i32;
        if (count > PERPACK || len < 11 + count * 5 + 12) { ret; }
        var k: i32 = 0;
        for (k < count) {
            val at:  i32 = 11 + k * 5;
            var cmd: Ticcmd;
            cmd.forwardmove = n.packet[at]:~i8;
            cmd.sidemove    = n.packet[at + 1]:~i8;
            cmd.angleturn   = (n.packet[at + 2]::u16 | (n.packet[at + 3]::u16 << 8)):~i16;
            cmd.buttons     = n.packet[at + 4];
            store(n, sender, first + k, ?cmd);
            k = k + 1;
        }
        val at:  i32 = 11 + count * 5;
        val ack: i32 = get32(?n.packet[0], at):~i32;
        if (ack > n.acked[sender]) { n.acked[sender] = ack; }

        # the sender's world at a tic: if this machine has played that tic
        # too, the two must agree
        val checktic: i32 = get32(?n.packet[0], at + 4):~i32;
        val check:    u32 = get32(?n.packet[0], at + 8);
        if (checktic >= 0 && n.sumtics[checktic % BACKUP] == checktic && n.sums[checktic % BACKUP] != check && !n.desync) {
            n.desync    = 1;
            n.desynctic = checktic;
            n.mysum     = n.sums[checktic % BACKUP];
            n.theirsum  = check;
            n.against   = sender;
        }
    }
}

# a datagram from the relay
fun from_relay(n: *Net, len: i32) {
    if (!rp.is_relay(?n.wrap[0], len)) { ret; }
    val kind: u8  = n.wrap[4];
    val body: i32 = rp.HEADER;

    if (kind == rp.WELCOME && len >= body + 10) {
        n.token = rp.get64(?n.wrap[0], 8);
        n.me    = n.wrap[5]::i32;
        var k: i32 = 0;
        for (k < rp.CODELEN) {
            n.code[k] = n.wrap[body + k];
            k         = k + 1;
        }
        n.code[6]  = 0;
        n.players  = n.wrap[body + 6]::i32;
        n.skill    = n.wrap[body + 7]::i32;
        n.map      = n.wrap[body + 8]::i32;
        n.joined   = n.wrap[body + 9]::i32;
        n.pace     = 0;
        ret;
    }
    if (kind == rp.REFUSED && len >= body + 1 && n.token == 0) {
        n.refused = n.wrap[body];
        ret;
    }

    # the rest is for this player only
    if (n.token == 0 || rp.get64(?n.wrap[0], 8) != n.token) { ret; }

    if (kind == rp.LOBBY && len >= body + 2) {
        n.joined = n.wrap[body + 1]::i32;
        n.fillin = 255;
        if (len >= body + 3) { n.fillin = n.wrap[body + 2]::i32; }
    }
    or (kind == rp.START && len >= body + 3 && !n.started && !n.startseen) {
        n.players = n.wrap[body]::i32;
        n.skill   = n.wrap[body + 1]::i32;
        n.map     = n.wrap[body + 2]::i32;
        n.botmask = 0;
        if (len >= body + 4) { n.botmask = n.wrap[body + 3]::i32; }
        if (len >= body + 5) { n.deathmatch = (n.wrap[body + 4] & rp.FLAG_DEATHMATCH) != 0; }
        if (n.players < 2 || n.players > 4 || n.me >= n.players || (n.botmask & (1 << n.me)) != 0) { ret; }
        var q: i32 = 0;
        for (q < n.players) {
            # a bot is no peer: nothing is sent to it or awaited from it
            n.peers[q].known = q != n.me && (n.botmask & (1 << q)) == 0;
            q                = q + 1;
        }
        n.startseen = 1;
        n.started   = n.botmask == 0;
    }
    or (kind == rp.BOTIS && len >= body + rp.BOTBODY && n.startseen && !n.started) {
        val seat: i32 = n.wrap[body]::i32;
        if (seat < 0 || seat >= n.players || (n.botmask & (1 << seat)) == 0) { ret; }
        val b: *BotSeat = ?n.bots[seat];
        b.kind = rp.get32(?n.wrap[0], body + 4):~i32;
        b.seed = rp.get32(?n.wrap[0], body + 8);
        var k: i32 = 0;
        for (k < 24) {
            b.name[k] = n.wrap[body + 12 + k];
            k         = k + 1;
        }
        b.name[23] = 0;
        k = 0;
        for (k < 942) {
            b.net[k] = n.wrap[body + 36 + k]:~i8;
            k        = k + 1;
        }
        b.known = 1;
        # every bot known: play
        var all: bool = 1;
        var q:   i32  = 0;
        for (q < n.players) {
            if ((n.botmask & (1 << q)) != 0 && !n.bots[q].known) { all = 0; }
            q = q + 1;
        }
        n.started = all;
    }
    or (kind == rp.GONE && n.started) {
        n.quit = 1;
    }
    or (kind == rp.DATA && n.started) {
        # the game's own datagram, from the player the relay says sent it
        val slot: i32 = n.wrap[5]::i32;
        val size: i32 = len - body;
        if (size < 6 || size > 256 || n.wrap[body + 5]::i32 != slot) { ret; }
        var k: i32 = 0;
        for (k < size) {
            n.packet[k] = n.wrap[body + k];
            k           = k + 1;
        }
        handle(n, size, nil);
    }
}

# read every packet waiting
pub fun receive(n: *Net) {
    if (!n.opened) { ret; }
    for {
        var from: ip.Endpoint;
        if (n.relaymode) {
            val got: res[usize, io_error.Error] = udp.recv_from(?n.sock, ?n.wrap[0], 1100, ?from);
            if (sel got.err) { brk; }
            # only the relay speaks to a game that uses one
            if (same_peer(?n.relay, ?from)) { from_relay(n, got.ok::i32); }
            cnt;
        }
        val got: res[usize, io_error.Error] = udp.recv_from(?n.sock, ?n.packet[0], 256, ?from);
        if (sel got.err) { brk; }
        handle(n, got.ok::i32, ?from);
    }
}

# the lobby through a relay: create or join until welcomed, then report in
# until the room is full and the relay says start
fun gather_relay(n: *Net) bool {
    if (n.started) { ret 1; }
    if (n.refused != 0) { ret 0; }
    n.pace = n.pace + 1;
    if ((n.pace % 12) != 1) { ret 0; }

    if (n.token == 0) {
        if (n.host) {
            val at: i32 = rp.header(?n.wrap[0], rp.CREATE, 0, 0, 0);
            n.wrap[at]     = n.players::u8;
            n.wrap[at + 1] = n.skill::u8;
            n.wrap[at + 2] = n.map::u8;
            n.wrap[at + 3] = rp.VERSION;
            rp.put64(?n.wrap[0], at + 4, n.wadhash);
            rp.put32(?n.wrap[0], at + 12, n.nonce);
            n.wrap[at + 16] = 0;
            if (n.public)     { n.wrap[at + 16] = n.wrap[at + 16] | rp.FLAG_PUBLIC; }
            if (n.deathmatch) { n.wrap[at + 16] = n.wrap[at + 16] | rp.FLAG_DEATHMATCH; }
            if (n.quick)      { n.wrap[at + 16] = n.wrap[at + 16] | rp.FLAG_QUICK; }
            to_relay(n, at + 17);
        }
        or {
            val at: i32 = rp.header(?n.wrap[0], rp.JOIN, 0, 0, 0);
            var k:  i32 = 0;
            for (k < rp.CODELEN) {
                n.wrap[at + k] = n.joincode[k];
                k              = k + 1;
            }
            n.wrap[at + 6] = rp.VERSION;
            n.wrap[at + 7] = 0;
            rp.put64(?n.wrap[0], at + 8, n.wadhash);
            rp.put32(?n.wrap[0], at + 16, n.nonce);
            to_relay(n, at + 20);
        }
        ret 0;
    }

    # started, with bots not yet all known: ask about each
    if (n.startseen) {
        var seat: i32 = 0;
        for (seat < n.players) {
            if ((n.botmask & (1 << seat)) != 0 && !n.bots[seat].known) {
                # padded to the answer's length
                var k: i32 = 0;
                for (k < rp.BOTSIZE) {
                    n.wrap[k] = 0;
                    k         = k + 1;
                }
                val at: i32 = rp.header(?n.wrap[0], rp.BOTASK, n.me, 0, n.token);
                n.wrap[at] = seat::u8;
                to_relay(n, rp.BOTSIZE);
            }
            seat = seat + 1;
        }
        ret 0;
    }

    # the host would rather not wait: bots in the empty seats, now
    if (n.wantfill && n.host) { to_relay(n, rp.header(?n.wrap[0], rp.FILL, n.me, 0, n.token)); }
    to_relay(n, rp.header(?n.wrap[0], rp.STATUS, n.me, 0, n.token));
    ret 0;
}

# a host asks the relay to start now, with bots in the seats nobody took
# send how this machine's player has been playing to the relay, for the bot
# leagues: only ever called for a player who has said it may be
# ---
# mode:    1 for co-op, 2 for a deathmatch
# samples: count of them, rp.TRAINSAMPLE bytes each, at most rp.TRAINMOST
pub fun send_training(n: *Net, mode: i32, map: i32, skill: i32, samples: *u8, count: i32) {
    if (!n.relaymode || count < 1 || count > rp.TRAINMOST) { ret; }
    val at: i32 = rp.header(?n.wrap[0], rp.TRAIN, n.me, 0, n.token);
    n.wrap[at]     = rp.VERSION;
    n.wrap[at + 1] = mode::u8;
    n.wrap[at + 2] = map::u8;
    n.wrap[at + 3] = skill::u8;
    n.wrap[at + 4] = count::u8;
    var k: i32 = 0;
    for (k < count * rp.TRAINSAMPLE) {
        n.wrap[at + 5 + k] = samples[k];
        k                  = k + 1;
    }
    to_relay(n, at + 5 + count * rp.TRAINSAMPLE);
}

pub fun ask_fill(n: *Net) {
    n.wantfill = 1;
}

# while gathering players: the host checks whether everyone has arrived and
# starts the game; a joiner says hello until the host answers
# ---
# ret: whether the game has started
pub fun gather(n: *Net) bool {
    receive(n);
    if (n.relaymode) { ret gather_relay(n); }
    if (n.started) { ret 1; }
    if (n.refused != 0) { ret 0; }

    if (n.host) {
        var p: i32 = 1;
        for (p < n.players) {
            if (!n.peers[p].known) { ret 0; }
            p = p + 1;
        }
        # the host's own address, as the joiners will reach it, is not
        # needed: each joiner already has it
        n.started = 1;
        send_start(n);
        ret 1;
    }

    # hello, with this build's version and the WAD it holds
    val at: i32 = begin(n, KIND_HELLO);
    n.packet[at] = rp.VERSION;
    rp.put64(?n.packet[0], at + 1, n.wadhash);
    send(n, 0, at + 9);
    ret 0;
}

# ------------------------------------------------------- the public list

# an open game on a relay's list
pub rec Listing {
    code:    [7]u8;
    players: i32;
    joined:  i32;
    skill:   i32;
    map:     i32;
    deathmatch: bool;
}

# asking a relay for its open games, before any game is joined
pub rec Lobby {
    sock:     udp.Socket;
    opened:   bool;
    relay:    Peer;
    wadhash:  u64;
    # the last answer, and whether there has been one
    rooms:    [6]Listing;
    count:    i32;
    answered: bool;
    # when the relay was last asked, in microseconds, and how many times
    asked:    i64;
    asks:     i32;
    buf:      [128]u8;
}

pub fun lobby_open(l: *Lobby, relay: *Peer, wadhash: u64) bool {
    val bound: res[udp.Socket, io_error.Error] = udp.bind_with_flags(ip.endpoint(0, 0, 0, 0, 0), socket_api.async_flags());
    if (sel bound.err) { ret 0; }
    l.sock        = bound.ok;
    l.opened      = 1;
    l.relay       = @relay;
    l.relay.known = 1;
    l.wadhash     = wadhash;
    l.count       = 0;
    l.answered    = 0;
    l.asked       = 0;
    l.asks        = 0;
    ret 1;
}

pub fun lobby_close(l: *Lobby) {
    if (!l.opened) { ret; }
    udp.socket_close(?l.sock);
    l.opened = 0;
}

# ask again every two seconds, and take whatever answers have come
# ---
# now: the time in microseconds
pub fun lobby_poll(l: *Lobby, now: i64) {
    if (!l.opened) { ret; }
    if (l.asks == 0 || now - l.asked > 2000000) {
        # padded to the longest answer: the relay sends no more than it gets
        var k: i32 = 0;
        for (k < rp.LISTSIZE) {
            l.buf[k] = 0;
            k        = k + 1;
        }
        val at: i32 = rp.header(?l.buf[0], rp.LIST, 0, 0, 0);
        l.buf[at] = rp.VERSION;
        rp.put64(?l.buf[0], at + 1, l.wadhash);
        udp.send_to(?l.sock, ?l.buf[0], rp.LISTSIZE::usize, endpoint_of(?l.relay));
        l.asked = now;
        l.asks  = l.asks + 1;
    }
    for {
        var from: ip.Endpoint;
        val got:  res[usize, io_error.Error] = udp.recv_from(?l.sock, ?l.buf[0], 128, ?from);
        if (sel got.err) { brk; }
        val len: i32 = got.ok::i32;
        if (!same_peer(?l.relay, ?from) || !rp.is_relay(?l.buf[0], len) || l.buf[4] != rp.ROOMS || len < rp.HEADER + 1) { cnt; }
        var count: i32 = l.buf[rp.HEADER]::i32;
        if (count > rp.LISTMAX)                                { count = rp.LISTMAX; }
        if (len < rp.HEADER + 1 + count * rp.LISTENTRY)        { cnt; }
        var i: i32 = 0;
        for (i < count) {
            val at: i32      = rp.HEADER + 1 + i * rp.LISTENTRY;
            val g:  *Listing = ?l.rooms[i];
            var k:  i32      = 0;
            for (k < rp.CODELEN) {
                g.code[k] = l.buf[at + k];
                k         = k + 1;
            }
            g.code[6] = 0;
            g.players = l.buf[at + 6]::i32;
            g.joined  = l.buf[at + 7]::i32;
            g.skill   = l.buf[at + 8]::i32;
            g.map     = l.buf[at + 9]::i32;
            g.deathmatch = l.buf[at + 10] != 0;
            i         = i + 1;
        }
        l.count    = count;
        l.answered = 1;
    }
}

# ------------------------------------------------------ a match to watch

# fetching the bot league's last match from a relay, in pieces
pub rec Watch {
    sock:   udp.Socket;
    opened: bool;
    relay:  Peer;
    # the file, which pieces of it have come, and the match they are of
    data:  [4096]u8;
    have:  [4]bool;
    id:    u32;
    done:  bool;
    # the relay answered, but has no match to give
    none:  bool;
    asked: i64;
    asks:  i32;
    buf:   [1100]u8;
}

pub fun watch_open(w: *Watch, relay: *Peer) bool {
    val bound: res[udp.Socket, io_error.Error] = udp.bind_with_flags(ip.endpoint(0, 0, 0, 0, 0), socket_api.async_flags());
    if (sel bound.err) { ret 0; }
    w.sock        = bound.ok;
    w.opened      = 1;
    w.relay       = @relay;
    w.relay.known = 1;
    w.done        = 0;
    w.none        = 0;
    w.asks        = 0;
    w.asked       = 0;
    var i: i32 = 0;
    for (i < 4) {
        w.have[i] = 0;
        i         = i + 1;
    }
    ret 1;
}

pub fun watch_close(w: *Watch) {
    if (!w.opened) { ret; }
    udp.socket_close(?w.sock);
    w.opened = 0;
}

# ask for the pieces still missing, every three seconds, and take what comes
# ---
# now: the time in microseconds
pub fun watch_poll(w: *Watch, now: i64) {
    if (!w.opened || w.done) { ret; }
    val pieces: i32 = (rp.WATCHFILE + rp.WATCHPIECE - 1) / rp.WATCHPIECE;
    if (w.asks == 0 || now - w.asked > 3000000) {
        var piece: i32 = 0;
        for (piece < pieces) {
            if (!w.have[piece]) {
                # padded to the longest answer: the relay sends no more than
                # it gets
                var k: i32 = 0;
                for (k < rp.WATCHSIZE) {
                    w.buf[k] = 0;
                    k        = k + 1;
                }
                val at: i32 = rp.header(?w.buf[0], rp.WATCH, 0, 0, 0);
                w.buf[at]     = rp.VERSION;
                w.buf[at + 1] = piece::u8;
                udp.send_to(?w.sock, ?w.buf[0], rp.WATCHSIZE::usize, endpoint_of(?w.relay));
            }
            piece = piece + 1;
        }
        w.asked = now;
        w.asks  = w.asks + 1;
    }
    for {
        var from: ip.Endpoint;
        val got:  res[usize, io_error.Error] = udp.recv_from(?w.sock, ?w.buf[0], 1100, ?from);
        if (sel got.err) { brk; }
        val len: i32 = got.ok::i32;
        val at:  i32 = rp.HEADER;
        if (!same_peer(?w.relay, ?from) || !rp.is_relay(?w.buf[0], len) || w.buf[4] != rp.MATCH || len < at + 8) { cnt; }
        val total: i32 = w.buf[at]::i32 | (w.buf[at + 1]::i32 << 8);
        val piece: i32 = w.buf[at + 2]::i32;
        if (total != rp.WATCHFILE) {
            w.none = 1;
            cnt;
        }
        w.none = 0;
        if (piece >= pieces) { cnt; }
        var count: i32 = total - piece * rp.WATCHPIECE;
        if (count > rp.WATCHPIECE) { count = rp.WATCHPIECE; }
        if (len < at + 8 + count) { cnt; }
        # pieces of another match than the ones held: start again with it
        val id: u32 = get32(?w.buf[0], at + 4);
        var any: bool = 0;
        var i:   i32  = 0;
        for (i < pieces) {
            if (w.have[i]) { any = 1; }
            i = i + 1;
        }
        if (any && id != w.id) {
            i = 0;
            for (i < pieces) {
                w.have[i] = 0;
                i         = i + 1;
            }
            # ask for the rest of this one at once
            w.asked = 0;
        }
        w.id = id;
        var k: i32 = 0;
        for (k < count) {
            w.data[piece * rp.WATCHPIECE + k] = w.buf[at + 8 + k];
            k                                 = k + 1;
        }
        w.have[piece] = 1;
        w.done        = 1;
        i             = 0;
        for (i < pieces) {
            if (!w.have[i]) { w.done = 0; }
            i = i + 1;
        }
    }
}

# a line for the waiting screen about why this machine was turned away
pub fun refusal(n: *Net) str {
    val why: u8 = n.refused;
    if (why == rp.NO_ROOM) { ret "there is no room with that code."; }
    if (why == rp.ROOM_FULL) { ret "that room is full."; }
    if (why == rp.STARTED) { ret "that game has already started."; }
    if (why == rp.WAD_MISMATCH) { ret "the host has a different version of\nthe game or the WAD. everyone:\noptions, update the game."; }
    if (why == rp.OLD_VERSION) { ret "the host has a different version of this game."; }
    if (why == rp.BUSY) { ret "the relay is busy; try again in a little while."; }
    ret "the game could not be joined.";
}

# whether another of my commands may be made yet
pub fun wants_command(n: *Net, gametic: i32) bool {
    ret n.maketic < gametic + n.playout + LEAD && n.maketic - n.have[n.me] < BACKUP - PERPACK;
}

# whether a tic is due to be played, on a machine that makes one command a
# tic by the clock: once its own commands are the cushion past it
pub fun due(n: *Net, tic: i32) bool {
    ret tic + n.playout < n.maketic;
}

# after a step of the clock has played what it could: if a tic is still due,
# the step waited, and the cushion grows; if commands keep arriving early,
# it shrinks
# ---
# gametic: the next tic to play
pub fun pace(n: *Net, gametic: i32) {
    n.sincegrew = n.sincegrew + 1;
    if (due(n, gametic)) {
        n.waits = n.waits + 1;
        n.calm  = 0;
        # grow at most every quarter second, so that a far player settles in
        # a second or so and one late packet costs one tic of cushion
        if (n.playout < PLAYOUT_MAX && n.sincegrew >= 8) {
            n.playout   = n.playout + 1;
            n.sincegrew = 0;
            if (n.playout > n.widest) { n.widest = n.playout; }
        }
        ret;
    }
    # how many tics past the next one every player's commands already reach
    var early: i32 = BACKUP;
    var p:     i32 = 0;
    for (p < n.players) {
        if (p != n.me && (n.botmask & (1 << p)) == 0 && n.have[p] - gametic - 1 < early) { early = n.have[p] - gametic - 1; }
        p = p + 1;
    }
    if (early >= 2) {
        n.calm = n.calm + 1;
    }
    or {
        n.calm = 0;
    }
    if (n.calm >= CALM && n.playout > 1) {
        n.playout = n.playout - 1;
        n.calm    = 0;
    }
}

# hold my own command for the next tic
pub fun add_command(n: *Net, cmd: *Ticcmd) {
    store(n, n.me, n.maketic, cmd);
    n.maketic = n.maketic + 1;
}

# send every peer the commands it lacks, my ack of its commands, and my
# checksum at a recent tic
pub fun send_commands(n: *Net, lastrun: i32) {
    var p: i32 = 0;
    for (p < n.players) {
        if (p == n.me) {
            p = p + 1;
            cnt;
        }
        var first: i32 = n.acked[p];
        if (first < n.maketic - BACKUP + PERPACK) { first = n.maketic - BACKUP + PERPACK; }
        if (first < 0)                            { first = 0; }
        var count: i32 = n.maketic - first;
        if (count > PERPACK) { count = PERPACK; }
        if (count < 0)       { count = 0; }

        var at: i32 = begin(n, KIND_COMMAND);
        put32(?n.packet[0], at, first:~u32);
        n.packet[at + 4] = count::u8;
        at               = at + 5;
        var k: i32 = 0;
        for (k < count) {
            val c: *Ticcmd = ?n.cmds[n.me * BACKUP + (first + k) % BACKUP];
            n.packet[at]     = c.forwardmove:~u8;
            n.packet[at + 1] = c.sidemove:~u8;
            n.packet[at + 2] = (c.angleturn:~u16 & 0xff)::u8;
            n.packet[at + 3] = (c.angleturn:~u16 >> 8)::u8;
            n.packet[at + 4] = c.buttons;
            at               = at + 5;
            k                = k + 1;
        }
        put32(?n.packet[0], at, n.have[p]:~u32);
        var checktic: i32 = -1;
        var check:    u32 = 0;
        if (lastrun >= 0 && n.sumtics[lastrun % BACKUP] == lastrun) {
            checktic = lastrun;
            check    = n.sums[lastrun % BACKUP];
        }
        put32(?n.packet[0], at + 4, checktic:~u32);
        put32(?n.packet[0], at + 8, check);
        send(n, p, at + 12);
        p = p + 1;
    }
}

# whether every player's command for a tic is here
pub fun ready(n: *Net, tic: i32) bool {
    var p: i32 = 0;
    for (p < n.players) {
        # a bot's command is the simulation's own to make
        if ((n.botmask & (1 << p)) == 0 && n.have[p] <= tic) { ret 0; }
        p = p + 1;
    }
    ret 1;
}

# every player's command for a tic, into four ticcmds
pub fun commands(n: *Net, tic: i32, out: *Ticcmd) {
    var p: i32 = 0;
    for (p < 4) {
        var blank: Ticcmd;
        out[p] = blank;
        if (p < n.players) { out[p] = n.cmds[p * BACKUP + tic % BACKUP]; }
        p = p + 1;
    }
}

# remember my checksum after a tic, to compare with what the peers report
pub fun record(n: *Net, tic: i32, sum: u32) {
    n.sums[tic % BACKUP]    = sum;
    n.sumtics[tic % BACKUP] = tic;
}
