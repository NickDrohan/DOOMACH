# the relay's rooms and routing, with no sockets in sight
#
# The relay process (relay.mach) feeds every datagram it receives to handle,
# calls tick a few times a second, and sends whatever lands in the output
# queue. Keeping the logic here, away from the socket, is what lets the unit
# tests below drive a whole room by hand.
#
# What it guarantees:
# - A player is identified by its session token, never by its address, and
#   traffic goes only to addresses that have sent a valid token from there;
#   so a spoofed request can make the relay answer a stranger once, with a
#   reply no bigger than the request, and never more.
# - DATA goes only to the one player it names, in the same room.
# - Creates and joins are rate-limited per address, rooms are capped, and
#   silent players and stale rooms are cleared on a timer.
#
# What it does not: encrypt or sign game traffic. Someone who can see the
# packets between a player and the relay can read the token and act as that
# player. That is the accepted cost of a first version without HTTPS.

use std.types.bool.bool;
use std.types.string.str;

use lf: doom.leaguefile;
use p: doom.relayproto;

pub val MAXROOMS:   i32 = 256;
pub val MAXPLAYERS: i32 = 4;
pub val MAXPACKET:  i32 = 1200;
val QUEUE:          i32 = 64;
val RATESLOTS:      i32 = 64;

# a lobby player silent this long is dropped; a playing one, this long
pub val LOBBY_TIMEOUT: i64 = 15000;
pub val PLAY_TIMEOUT:  i64 = 10000;
# a room that asks to be quick waits this long for people before its bots
pub val QUICK_WAIT: i64 = 15000;
# a room that never filled is closed after this long
pub val ROOM_LIFETIME: i64 = 30 * 60 * 1000;
# at most this many creates and joins from one address in each window
val RATE_LIMIT:  i32 = 20;
val RATE_WINDOW: i64 = 10000;

# an IPv4 address and port
pub rec Addr {
    ip:   u32;
    port: u16;
}

pub rec Slot {
    used:      bool;
    validated: bool;
    token:     u64;
    addr:      Addr;
    nonce:     u32;
    lastseen:  i64;
}

pub rec Room {
    used:     bool;
    started:  bool;
    began:    i64;
    code:     [6]u8;
    players:  i32;
    skill:    i32;
    map:      i32;
    wadhash:  u64;
    public:   bool;
    deathmatch: bool;
    # how long it waits, if public, before bots take its empty seats, in
    # milliseconds; 0 for never
    wait:     i64;
    created:  i64;
    slots:    [4]Slot;
    # once started: which seats bots took, a bit a seat
    botmask:  i32;
}

# a bot in a seat
pub rec Seated {
    kind: i32;
    seed: u32;
    name: [24]u8;
    net:  [942]i8;
}

# what the relay needs to seat the league's bots: the league as the arena
# last wrote it, and, for each room, the bots seated in it, copied when the
# game starts so that every player is told the same nets however the league
# moves on. Too big for a stack: the process allocates it. Without it, or
# without a league, the bots seated are the hand-written one.
pub rec Bots {
    league:    [200000]u8;
    leaguelen: i32;
    # the co-op league, whose bots are seated in co-op games; without it
    # they are the deathmatch league's
    coop:    [200000]u8;
    cooplen: i32;
    seated:    [1024]Seated;
}

# How people played, for the leagues' apprentices to learn from: the last
# TRAINCAP samples sent by players who said they may be, each with its mode
# and map before it. It is laid out as the file the process keeps it in: a
# head of sixteen bytes (see train_head), then the samples. Too big for a
# stack: the process allocates it, and without it samples are dropped.
pub val TRAINCAP: i32 = 100000;
pub rec Train {
    # how many samples have ever come; the next goes at count mod TRAINCAP
    count: i64;
    # something has come since the file was last written
    dirty: bool;
    # the file: its head, and the samples straight after
    head:  [16]u8;
    data:  [4000000]u8;
}

# a datagram to send
pub rec Out {
    to:   Addr;
    len:  i32;
    data: [1216]u8;
}

# something that happened to a room, for the log: no addresses, only the
# room's code and seats
pub val EV_OPENED:   u8 = 1;
pub val EV_JOINED:   u8 = 2;
pub val EV_STARTED:  u8 = 3;
pub val EV_LEFT:     u8 = 4;
pub val EV_TIMEDOUT: u8 = 5;
pub val EV_CLOSED:   u8 = 6;
pub val EV_REFUSED:  u8 = 7;
val EVENTS:          i32 = 32;

pub rec Event {
    what:    u8;
    code:    [6]u8;
    # the seat, or the refusal's reason
    slot:    i32;
    players: i32;
    # how long the room had been playing, in seconds, when it closed
    played:  i64;
}

rec Rate {
    ip:    u32;
    start: i64;
    count: i32;
}

pub def Random: fun() u64;

pub rec Relay {
    maxrooms: i32;
    random:   Random;
    rooms:    [256]Room;
    out:      [64]Out;
    nout:     i32;
    rates:    [64]Rate;

    # the league's bots, if the process has them; and how long a public room
    # waits before bots take its empty seats, in milliseconds, 0 for never
    bots:     *Bots;
    fillwait: i64;
    # what people have sent for the bots to learn from, if the process keeps it
    train: *Train;
    # one game in this many that bots join has the shy bot among them; 0
    # for never
    shyin:    i32;

    # the league match the arena last left to be watched, if any; and the
    # co-op league's
    watch:      [4096]u8;
    watchlen:   i32;
    cowatch:    [4096]u8;
    cowatchlen: i32;

    # the time of the datagram or tick being handled
    now: i64;

    # what has happened to rooms since the process last took the list
    events:  [32]Event;
    nevents: i32;

    # what has happened, for the log
    created:   i64;
    started:   i64;
    closed:    i64;
    forwarded: i64;
    refused:   i64;
    dropped:   i64;
}

fun same_addr(a: *Addr, b: *Addr) bool {
    ret a.ip == b.ip && a.port == b.port;
}

# a datagram to queue, or nil if the queue is full this round
fun queue(r: *Relay, to: *Addr) *Out {
    if (r.nout >= QUEUE) {
        r.dropped = r.dropped + 1;
        ret nil;
    }
    val o: *Out = ?r.out[r.nout];
    r.nout = r.nout + 1;
    o.to   = @to;
    o.len  = 0;
    ret o;
}

fun event(r: *Relay, what: u8, room: *Room, slot: i32) {
    if (r.nevents >= EVENTS) { ret; }
    val e: *Event = ?r.events[r.nevents];
    r.nevents = r.nevents + 1;
    e.what    = what;
    e.slot    = slot;
    e.players = 0;
    e.played  = 0;
    var k: i32 = 0;
    for (k < p.CODELEN) {
        e.code[k] = '-';
        if (room != nil) { e.code[k] = room.code[k]; }
        k = k + 1;
    }
    if (room != nil) { e.players = room.players; }
}

fun refuse(r: *Relay, to: *Addr, reason: u8) {
    r.refused = r.refused + 1;
    event(r, EV_REFUSED, nil, reason::i32);
    val o: *Out = queue(r, to);
    if (o == nil) { ret; }
    val at: i32 = p.header(?o.data[0], p.REFUSED, 0, 0, 0);
    o.data[at] = reason;
    o.len      = at + 1;
}

fun welcome(r: *Relay, room: *Room, slot: i32) {
    val s: *Slot = ?room.slots[slot];
    val o: *Out  = queue(r, ?s.addr);
    if (o == nil) { ret; }
    val at: i32 = p.header(?o.data[0], p.WELCOME, slot, 0, s.token);
    var k:  i32 = 0;
    for (k < p.CODELEN) {
        o.data[at + k] = room.code[k];
        k              = k + 1;
    }
    o.data[at + 6] = room.players::u8;
    o.data[at + 7] = room.skill::u8;
    o.data[at + 8] = room.map::u8;
    o.data[at + 9] = joined(room)::u8;
    o.len          = at + 10;
}

fun joined(room: *Room) i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    for (i < MAXPLAYERS) {
        if (room.slots[i].used) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun send_start(r: *Relay, room: *Room, slot: i32) {
    val s: *Slot = ?room.slots[slot];
    val o: *Out  = queue(r, ?s.addr);
    if (o == nil) { ret; }
    val at: i32 = p.header(?o.data[0], p.START, slot, 0, s.token);
    o.data[at]     = room.players::u8;
    o.data[at + 1] = room.skill::u8;
    o.data[at + 2] = room.map::u8;
    o.data[at + 3] = room.botmask::u8;
    o.data[at + 4] = 0;
    if (room.deathmatch) { o.data[at + 4] = p.FLAG_DEATHMATCH; }
    o.len          = at + 5;
}

fun send_lobby(r: *Relay, room: *Room, slot: i32) {
    val s: *Slot = ?room.slots[slot];
    val o: *Out  = queue(r, ?s.addr);
    if (o == nil) { ret; }
    val at: i32 = p.header(?o.data[0], p.LOBBY, slot, 0, s.token);
    o.data[at]     = room.players::u8;
    o.data[at + 1] = joined(room)::u8;
    # seconds until bots take the empty seats, 255 for never
    o.data[at + 2] = 255;
    if (room.public && room.wait > 0) {
        var left: i64 = (room.created + room.wait - r.now) / 1000;
        if (left < 0)   { left = 0; }
        if (left > 254) { left = 254; }
        o.data[at + 2] = left::u8;
    }
    o.len = at + 3;
}

# tell everyone left in a room that a player has gone
fun send_gone(r: *Relay, room: *Room, gone: i32) {
    var i: i32 = 0;
    for (i < MAXPLAYERS) {
        val s: *Slot = ?room.slots[i];
        if (i != gone && s.used && s.validated) {
            val o: *Out = queue(r, ?s.addr);
            if (o != nil) {
                val at: i32 = p.header(?o.data[0], p.GONE, gone, 0, s.token);
                o.data[at] = gone::u8;
                o.len      = at + 1;
            }
        }
        i = i + 1;
    }
}

fun close_room(r: *Relay, room: *Room, now: i64) {
    val before: i32 = r.nevents;
    event(r, EV_CLOSED, room, 0);
    if (room.started && r.nevents > before) { r.events[before].played = (now - room.began) / 1000; }
    var blank: Room;
    @room    = blank;
    r.closed = r.closed + 1;
}

fun remove_slot(r: *Relay, room: *Room, slot: i32, why: u8, now: i64) {
    event(r, why, room, slot);
    send_gone(r, room, slot);
    var blank: Slot;
    room.slots[slot] = blank;
    if (joined(room) == 0) { close_room(r, room, now); }
}

# a game starts when every seat is taken and every player has shown the
# relay it can be reached
fun try_start(r: *Relay, room: *Room, now: i64) {
    if (room.started || joined(room) != room.players) { ret; }
    var i: i32 = 0;
    for (i < room.players) {
        if (!room.slots[i].validated) { ret; }
        i = i + 1;
    }
    room.started = 1;
    room.began   = now;
    r.started    = r.started + 1;
    event(r, EV_STARTED, room, 0);
    i            = 0;
    for (i < room.players) {
        send_start(r, room, i);
        i = i + 1;
    }
}

fun room_index(r: *Relay, room: *Room) i32 {
    var i: i32 = 0;
    for (i < MAXROOMS) {
        if (room == ?r.rooms[i]) { ret i; }
        i = i + 1;
    }
    ret 0;
}

# start a room that is not full: bots take the empty seats. Every player
# there must have shown it can be reached. The bots are drawn from the
# league if the process has one, each a different member, and copied for the
# room; otherwise they are the hand-written bot.
fun fill(r: *Relay, room: *Room, now: i64) {
    if (room.started || joined(room) == 0) { ret; }
    var mask: i32 = 0;
    var i:    i32 = 0;
    for (i < room.players) {
        if (room.slots[i].used) {
            if (!room.slots[i].validated) { ret; }
        }
        or {
            mask = mask | (1 << i);
        }
        i = i + 1;
    }
    if (mask == 0) {
        try_start(r, room, now);
        ret;
    }

    val index: i32 = room_index(r, room);
    var drawn: [4]i32 = [4]i32{-1, -1, -1, -1};
    # which league: a co-op game's bots are the co-op league's, if there is one
    var league:    *u8 = nil;
    var leaguelen: i32 = 0;
    if (r.bots != nil) {
        league    = ?r.bots.league[0];
        leaguelen = r.bots.leaguelen;
        if (!room.deathmatch && lf.valid(?r.bots.coop[0], r.bots.cooplen)) {
            league    = ?r.bots.coop[0];
            leaguelen = r.bots.cooplen;
        }
    }
    # now and then, one of them is the shy bot, which is in no league and
    # joins only games with people in them
    var shy: bool = r.shyin > 0 && r.bots != nil && (r.random() % r.shyin::u64) == 0;
    i = 0;
    for (i < room.players) {
        if ((mask & (1 << i)) != 0 && r.bots != nil) {
            val b: *Seated = ?r.bots.seated[index * MAXPLAYERS + i];
            var blank: Seated;
            @b     = blank;
            b.seed = r.random()::u32;
            b.kind = lf.SEAT_SCRIPT;
            var k: i32 = 0;
            if (shy) {
                shy    = 0;
                b.kind = lf.SEAT_SCRIPT | lf.TRAIT_SHY;
                val name: str = "Shy Bot";
                for (name[k] != 0) {
                    b.name[k] = name[k];
                    k         = k + 1;
                }
            }
            or (lf.valid(league, leaguelen)) {
                # a member not already drawn for this room
                var who: i32 = 0;
                for {
                    who = (r.random() % lf.MEMBERS::u64)::i32;
                    if (who != drawn[0] && who != drawn[1] && who != drawn[2] && who != drawn[3]) { brk; }
                }
                drawn[i] = who;
                val at: i32 = lf.HEAD + who * lf.MEMBER_BYTES;
                if (p.get32(league, at + lf.AT_KIND) != lf.KIND_SCRIPT::u32) {
                    b.kind = lf.SEAT_NET;
                    if (p.get32(league, at + lf.AT_STYLE) == lf.STYLE_BRAWLER::u32) { b.kind = b.kind | lf.TRAIT_FISTS; }
                }
                for (k < lf.NET) {
                    b.net[k] = league[at + lf.AT_NET + k]:~i8;
                    k        = k + 1;
                }
                # and its quirk goes with it; its feelings about the league's
                # other bots do not, into a game with people in it
                b.kind = b.kind | (lf.quirk_of(who) << lf.QUIRK_SHIFT);
                lf.name_of(who, ?b.name[0]);
            }
            or {
                lf.name_of(0, ?b.name[0]);
            }
        }
        i = i + 1;
    }

    room.botmask = mask;
    room.started = 1;
    room.began   = now;
    r.started    = r.started + 1;
    event(r, EV_STARTED, room, 0);
    i = 0;
    for (i < room.players) {
        if (room.slots[i].used) { send_start(r, room, i); }
        i = i + 1;
    }
}

# tell a player about the bot in a seat of its room
fun bot_is(r: *Relay, room: *Room, slot: i32, seat: i32) {
    if (seat < 0 || seat >= room.players || (room.botmask & (1 << seat)) == 0) { ret; }
    val s: *Slot = ?room.slots[slot];
    val o: *Out  = queue(r, ?s.addr);
    if (o == nil) { ret; }
    val at: i32 = p.header(?o.data[0], p.BOTIS, slot, 0, s.token);
    var k:  i32 = 0;
    for (k < p.BOTBODY) {
        o.data[at + k] = 0;
        k              = k + 1;
    }
    o.data[at] = seat::u8;
    o.len      = at + p.BOTBODY;
    if (r.bots == nil) {
        # no league: the hand-written bot, its seed from the room and seat
        p.put32(?o.data[0], at + 4, lf.SEAT_SCRIPT::u32);
        p.put32(?o.data[0], at + 8, (room.code[0]::u32 << 16) | (room.code[1]::u32 << 8) | seat::u32);
        lf.name_of(0, ?o.data[at + 12]);
        ret;
    }
    val index: i32     = room_index(r, room);
    val b:     *Seated = ?r.bots.seated[index * MAXPLAYERS + seat];
    p.put32(?o.data[0], at + 4, b.kind::u32);
    p.put32(?o.data[0], at + 8, b.seed);
    k = 0;
    for (k < 24) {
        o.data[at + 12 + k] = b.name[k];
        k                   = k + 1;
    }
    k = 0;
    for (k < lf.NET) {
        o.data[at + 36 + k] = b.net[k]:~u8;
        k                   = k + 1;
    }
}

# whether an address may create or join again now
fun rate_ok(r: *Relay, ip: u32, now: i64) bool {
    var oldest: i32 = 0;
    var i:      i32 = 0;
    for (i < RATESLOTS) {
        val e: *Rate = ?r.rates[i];
        if (e.ip == ip && e.start != 0) {
            if (now - e.start > RATE_WINDOW) {
                e.start = now;
                e.count = 0;
            }
            e.count = e.count + 1;
            ret e.count <= RATE_LIMIT;
        }
        if (r.rates[i].start < r.rates[oldest].start) { oldest = i; }
        i = i + 1;
    }
    # a new address takes the slot used longest ago
    r.rates[oldest].ip    = ip;
    r.rates[oldest].start = now;
    r.rates[oldest].count = 1;
    ret 1;
}

fun find_code(r: *Relay, code: *u8) *Room {
    var i: i32 = 0;
    for (i < r.maxrooms) {
        val room: *Room = ?r.rooms[i];
        if (room.used) {
            var k:    i32  = 0;
            var same: bool = 1;
            for (k < p.CODELEN) {
                if (room.code[k] != code[k]) { same = 0; }
                k = k + 1;
            }
            if (same) { ret room; }
        }
        i = i + 1;
    }
    ret nil;
}

fun new_code(r: *Relay, room: *Room) {
    for {
        var bits: u64 = r.random();
        var k:    i32 = 0;
        for (k < p.CODELEN) {
            room.code[k] = p.ALPHABET[(bits % p.SYMBOLS::u64)::i32];
            bits         = bits / p.SYMBOLS::u64;
            k            = k + 1;
        }
        # unique among live rooms; the room itself is not live yet
        room.used = 0;
        if (find_code(r, ?room.code[0]) == nil) { brk; }
    }
}

fun new_token(r: *Relay) u64 {
    var t: u64 = r.random();
    if (t == 0) { t = 1; }
    ret t;
}

fun create(r: *Relay, d: *u8, len: i32, from: *Addr, now: i64) {
    if (len < p.HEADER + 16) { ret; }
    if (!rate_ok(r, from.ip, now)) {
        refuse(r, from, p.BUSY);
        ret;
    }
    val nonce: u32 = p.get32(d, p.HEADER + 12);

    # a repeated create, its answer lost: the same room again
    var i: i32 = 0;
    for (i < r.maxrooms) {
        val room: *Room = ?r.rooms[i];
        if (room.used && room.slots[0].used && same_addr(?room.slots[0].addr, from) && room.slots[0].nonce == nonce) {
            welcome(r, room, 0);
            ret;
        }
        i = i + 1;
    }

    if (d[p.HEADER + 3] != p.VERSION) {
        refuse(r, from, p.OLD_VERSION);
        ret;
    }

    i = 0;
    for (i < r.maxrooms) {
        if (!r.rooms[i].used) { brk; }
        i = i + 1;
    }
    if (i == r.maxrooms) {
        refuse(r, from, p.BUSY);
        ret;
    }

    val room: *Room = ?r.rooms[i];
    var blank: Room;
    @room = blank;
    new_code(r, room);
    room.used    = 1;
    room.players = d[p.HEADER]::i32;
    if (room.players < 2) { room.players = 2; }
    if (room.players > MAXPLAYERS) { room.players = MAXPLAYERS; }
    room.skill   = d[p.HEADER + 1]::i32;
    room.map     = d[p.HEADER + 2]::i32;
    room.wadhash = p.get64(d, p.HEADER + 4);
    # an older game's create has no flags, and its room is private
    var flags: u8 = 0;
    if (len >= p.HEADER + 17) { flags = d[p.HEADER + 16]; }
    room.public     = (flags & p.FLAG_PUBLIC) != 0;
    room.deathmatch = (flags & p.FLAG_DEATHMATCH) != 0;
    room.wait       = r.fillwait;
    if ((flags & p.FLAG_QUICK) != 0) { room.wait = QUICK_WAIT; }
    room.created = now;

    val s: *Slot = ?room.slots[0];
    s.used     = 1;
    s.token    = new_token(r);
    s.addr     = @from;
    s.nonce    = nonce;
    s.lastseen = now;
    r.created  = r.created + 1;
    event(r, EV_OPENED, room, 0);
    welcome(r, room, 0);
}

fun join(r: *Relay, d: *u8, len: i32, from: *Addr, now: i64) {
    if (len < p.HEADER + 20) { ret; }
    if (!rate_ok(r, from.ip, now)) {
        refuse(r, from, p.BUSY);
        ret;
    }

    var code: [6]u8;
    var k:    i32 = 0;
    for (k < p.CODELEN) {
        code[k] = p.code_char(d[p.HEADER + k]);
        k       = k + 1;
    }
    val room: *Room = find_code(r, ?code[0]);
    if (room == nil) {
        refuse(r, from, p.NO_ROOM);
        ret;
    }
    val nonce: u32 = p.get32(d, p.HEADER + 16);

    # a repeated join, its answer lost: the same seat again
    var i: i32 = 0;
    for (i < MAXPLAYERS) {
        val s: *Slot = ?room.slots[i];
        if (s.used && same_addr(?s.addr, from) && s.nonce == nonce) {
            welcome(r, room, i);
            ret;
        }
        i = i + 1;
    }

    if (room.started) {
        refuse(r, from, p.STARTED);
        ret;
    }
    if (d[p.HEADER + 6] != p.VERSION) {
        refuse(r, from, p.OLD_VERSION);
        ret;
    }
    if (p.get64(d, p.HEADER + 8) != room.wadhash) {
        refuse(r, from, p.WAD_MISMATCH);
        ret;
    }

    i = 1;
    for (i < room.players) {
        if (!room.slots[i].used) { brk; }
        i = i + 1;
    }
    if (i >= room.players) {
        refuse(r, from, p.ROOM_FULL);
        ret;
    }

    val s: *Slot = ?room.slots[i];
    s.used     = 1;
    s.token    = new_token(r);
    s.addr     = @from;
    s.nonce    = nonce;
    s.lastseen = now;
    event(r, EV_JOINED, room, i);
    welcome(r, room, i);
}

# the public list: the rooms this game could join now. Answered only to a
# request as long as the answer could be, within the rate limit.
fun list(r: *Relay, d: *u8, len: i32, from: *Addr, now: i64) {
    if (len < p.LISTSIZE || d[p.HEADER] != p.VERSION) {
        r.dropped = r.dropped + 1;
        ret;
    }
    if (!rate_ok(r, from.ip, now)) { ret; }
    val wad: u64  = p.get64(d, p.HEADER + 1);
    val o:   *Out = queue(r, from);
    if (o == nil) { ret; }
    var at:    i32 = p.header(?o.data[0], p.ROOMS, 0, 0, 0) + 1;
    var count: i32 = 0;
    var i:     i32 = 0;
    for (i < r.maxrooms && count < p.LISTMAX) {
        val room: *Room = ?r.rooms[i];
        i = i + 1;
        if (!room.used || !room.public || room.started || room.wadhash != wad) { cnt; }
        val here: i32 = joined(room);
        if (here >= room.players) { cnt; }
        var k: i32 = 0;
        for (k < p.CODELEN) {
            o.data[at + k] = room.code[k];
            k              = k + 1;
        }
        o.data[at + 6] = room.players::u8;
        o.data[at + 7] = here::u8;
        o.data[at + 8]  = room.skill::u8;
        o.data[at + 9]  = room.map::u8;
        o.data[at + 10] = 0;
        if (room.deathmatch) { o.data[at + 10] = 1; }
        at    = at + p.LISTENTRY;
        count = count + 1;
    }
    o.data[p.HEADER] = count::u8;
    o.len            = at;
}

# the process read the arena's match file: keep it to hand out
# ---
# coop: it is the co-op league's
pub fun set_watch(r: *Relay, data: *u8, len: i32, coop: bool) {
    var keep: i32 = len;
    if (len != p.WATCHFILE) { keep = 0; }
    var k: i32 = 0;
    for (k < keep) {
        if (coop) {
            r.cowatch[k] = data[k];
        }
        or {
            r.watch[k] = data[k];
        }
        k = k + 1;
    }
    if (coop) {
        r.cowatchlen = keep;
    }
    or {
        r.watchlen = keep;
    }
}

# one piece of the match to watch, to a request as long as the answer
fun watch(r: *Relay, d: *u8, len: i32, from: *Addr, now: i64) {
    if (len < p.WATCHSIZE || d[p.HEADER] != p.VERSION) {
        r.dropped = r.dropped + 1;
        ret;
    }
    if (!rate_ok(r, from.ip, now)) { ret; }
    val piece: i32 = d[p.HEADER + 1]::i32;
    val start: i32 = piece * p.WATCHPIECE;
    # which league's match: the byte after the piece, 1 for co-op's
    var file:    *u8 = ?r.watch[0];
    var filelen: i32 = r.watchlen;
    if (d[p.HEADER + 2] == 1) {
        file    = ?r.cowatch[0];
        filelen = r.cowatchlen;
    }
    val o: *Out = queue(r, from);
    if (o == nil) { ret; }
    val at: i32 = p.header(?o.data[0], p.MATCH, 0, 0, 0);
    p.put16(?o.data[0], at, filelen::u32);
    o.data[at + 2] = piece::u8;
    o.data[at + 3] = 0;
    # the match's number, by which a game tells pieces of one match from
    # pieces of the next
    var k: i32 = 0;
    for (k < 4) {
        o.data[at + 4 + k] = file[12 + k];
        k                  = k + 1;
    }
    var count: i32 = 0;
    if (start < filelen) {
        count = filelen - start;
        if (count > p.WATCHPIECE) { count = p.WATCHPIECE; }
    }
    k = 0;
    for (k < count) {
        o.data[at + 8 + k] = file[start + k];
        k                  = k + 1;
    }
    o.len = at + 8 + count;
}

# the room and seat a token belongs to, or nil
fun find_token(r: *Relay, slot: i32, token: u64) *Room {
    if (slot < 0 || slot >= MAXPLAYERS || token == 0) { ret nil; }
    var i: i32 = 0;
    for (i < r.maxrooms) {
        val room: *Room = ?r.rooms[i];
        if (room.used && room.slots[slot].used && room.slots[slot].token == token) { ret room; }
        i = i + 1;
    }
    ret nil;
}

# one datagram from a game
# ---
# r:    the relay
# d:    the datagram
# len:  its length
# from: where it came from
# now:  the time, in milliseconds
pub fun handle(r: *Relay, d: *u8, len: i32, from: *Addr, now: i64) {
    if (!p.is_relay(d, len) || len > MAXPACKET) {
        r.dropped = r.dropped + 1;
        ret;
    }
    val kind: u8 = d[4];
    if (kind == p.CREATE) {
        create(r, d, len, from, now);
        ret;
    }
    if (kind == p.JOIN) {
        join(r, d, len, from, now);
        ret;
    }
    if (kind == p.LIST) {
        list(r, d, len, from, now);
        ret;
    }
    if (kind == p.WATCH) {
        watch(r, d, len, from, now);
        ret;
    }

    # everything else must carry a seat's token
    val slot: i32   = d[5]::i32;
    val room: *Room = find_token(r, slot, p.get64(d, 8));
    if (room == nil) {
        r.dropped = r.dropped + 1;
        ret;
    }
    val s: *Slot = ?room.slots[slot];
    r.now = now;

    # a token from a new address is the same player after its router
    # changed its mapping; the token is the proof it can be reached there
    s.addr      = @from;
    s.validated = 1;
    s.lastseen  = now;

    if (kind == p.STATUS) {
        if (room.started) {
            send_start(r, room, slot);
        }
        or {
            send_lobby(r, room, slot);
            try_start(r, room, now);
        }
    }
    or (kind == p.DATA) {
        val dest: i32 = d[6]::i32;
        if (!room.started || dest < 0 || dest >= room.players || dest == slot) {
            r.dropped = r.dropped + 1;
            ret;
        }
        val to: *Slot = ?room.slots[dest];
        if (!to.used || !to.validated) {
            r.dropped = r.dropped + 1;
            ret;
        }
        val o: *Out = queue(r, ?to.addr);
        if (o == nil) { ret; }
        val at: i32 = p.header(?o.data[0], p.DATA, slot, dest, to.token);
        var k:  i32 = p.HEADER;
        for (k < len) {
            o.data[k] = d[k];
            k         = k + 1;
        }
        o.len       = len;
        r.forwarded = r.forwarded + 1;
        k           = at;
    }
    or (kind == p.LEAVE) {
        remove_slot(r, room, slot, EV_LEFT, now);
    }
    or (kind == p.FILL) {
        # the host would rather start now, with bots in the empty seats
        if (slot == 0) { fill(r, room, now); }
    }
    or (kind == p.BOTASK) {
        if (room.started && len >= p.BOTSIZE) { bot_is(r, room, slot, d[p.HEADER]::i32); }
    }
    or (kind == p.TRAIN) {
        if (room.started) { train(r, room, d, len); }
    }
}

# a player's samples: kept if they are what they say, from a game of the
# kind they say
fun train(r: *Relay, room: *Room, d: *u8, len: i32) {
    val at: i32 = p.HEADER;
    if (r.train == nil || len < at + 5 || d[at] != p.VERSION) { ret; }
    val mode:  i32 = d[at + 1]::i32;
    val map:   i32 = d[at + 2]::i32;
    val count: i32 = d[at + 4]::i32;
    var want:  i32 = 1;
    if (room.deathmatch) { want = 2; }
    if (mode != want || map < 1 || map > 9 || count < 1 || count > p.TRAINMOST || len < at + 5 + count * p.TRAINSAMPLE) {
        r.dropped = r.dropped + 1;
        ret;
    }
    val t: *Train = r.train;
    var i: i32    = 0;
    for (i < count) {
        val to: i32 = (t.count % TRAINCAP::i64)::i32 * p.TRAINRECORD;
        t.data[to]     = mode::u8;
        t.data[to + 1] = map::u8;
        var k: i32 = 0;
        for (k < p.TRAINSAMPLE) {
            t.data[to + 2 + k] = d[at + 5 + i * p.TRAINSAMPLE + k];
            k                  = k + 1;
        }
        t.count = t.count + 1;
        i       = i + 1;
    }
    t.dirty = 1;
}

# make the head of the samples' file, and say how long the file is: the
# magic, the size of a record, how many records follow, and how many have
# ever come
pub fun train_head(t: *Train) i32 {
    var n: i64 = t.count;
    if (n > TRAINCAP::i64) { n = TRAINCAP::i64; }
    t.head[0] = 'M';
    t.head[1] = 'D';
    t.head[2] = 'T';
    t.head[3] = '1';
    p.put32(?t.head[0], 4, p.TRAINRECORD::u32);
    p.put32(?t.head[0], 8, n::u32);
    p.put32(?t.head[0], 12, (t.count & 0x7fffffff)::u32);
    ret 16 + n::i32 * p.TRAINRECORD;
}

# take up a file of samples read back: so many bytes at the head
pub fun train_loaded(t: *Train, len: i32) {
    t.count = 0;
    t.dirty = 0;
    if (len < 16 || t.head[0] != 'M' || t.head[1] != 'D' || t.head[2] != 'T' || t.head[3] != '1') { ret; }
    if (p.get32(?t.head[0], 4) != p.TRAINRECORD::u32) { ret; }
    val n: i32 = p.get32(?t.head[0], 8):~i32;
    if (n < 0 || n > TRAINCAP || len < 16 + n * p.TRAINRECORD) { ret; }
    # the ring goes on from where it was only if it was not yet full; a
    # full one starts overwriting from its beginning, which is as good
    t.count = n::i64;
}

# the timers: drop silent players, close rooms nobody filled
pub fun tick(r: *Relay, now: i64) {
    r.now = now;
    var i: i32 = 0;
    for (i < r.maxrooms) {
        val room: *Room = ?r.rooms[i];
        i = i + 1;
        if (!room.used) { cnt; }

        var limit: i64 = LOBBY_TIMEOUT;
        if (room.started) { limit = PLAY_TIMEOUT; }
        var k: i32 = 0;
        for (k < MAXPLAYERS && room.used) {
            if (room.slots[k].used && now - room.slots[k].lastseen > limit) { remove_slot(r, room, k, EV_TIMEDOUT, now); }
            k = k + 1;
        }
        # a public room that has waited long enough starts with bots
        if (room.used && !room.started && room.public && room.wait > 0 && now - room.created >= room.wait) { fill(r, room, now); }
        if (room.used && !room.started && now - room.created > ROOM_LIFETIME) { close_room(r, room, now); }
    }
}

# how many rooms are open
pub fun open_rooms(r: *Relay) i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    for (i < r.maxrooms) {
        if (r.rooms[i].used) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# ------------------------------------------------------------------- tests

var testseed: u64;

fun test_random() u64 {
    testseed = testseed * 6364136223846793005 + 1442695040888963407;
    ret testseed;
}

fun request(buf: *u8, kind: u8, slot: i32, dest: i32, token: u64) i32 {
    ret p.header(buf, kind, slot, dest, token);
}

fun create_req(buf: *u8, players: i32, wad: u64, nonce: u32) i32 {
    val at: i32 = request(buf, p.CREATE, 0, 0, 0);
    buf[at]     = players::u8;
    buf[at + 1] = 2;
    buf[at + 2] = 1;
    buf[at + 3] = p.VERSION;
    p.put64(buf, at + 4, wad);
    p.put32(buf, at + 12, nonce);
    ret at + 16;
}

fun join_req(buf: *u8, code: *u8, wad: u64, nonce: u32) i32 {
    val at: i32 = request(buf, p.JOIN, 0, 0, 0);
    var k:  i32 = 0;
    for (k < 6) {
        buf[at + k] = code[k];
        k           = k + 1;
    }
    buf[at + 6] = p.VERSION;
    buf[at + 7] = 0;
    p.put64(buf, at + 8, wad);
    p.put32(buf, at + 16, nonce);
    ret at + 20;
}

fun fresh(r: *Relay) {
    var blank: Relay;
    @r         = blank;
    r.maxrooms = 8;
    r.random   = test_random;
    testseed   = 7;
}

test relay__room_fills_starts_and_routes {
    var r: Relay;
    fresh(?r);
    var buf:  [64]u8;
    var host: Addr = Addr{ip: 0x0a000001, port: 5000};
    var gst:  Addr = Addr{ip: 0x0a000002, port: 6000};

    # create: a welcome with a code and a token
    handle(?r, ?buf[0], create_req(?buf[0], 2, 77, 1), ?host, 0);
    if (r.nout != 1 || r.out[0].data[4] != p.WELCOME) { ret 1; }
    var code: [6]u8;
    var k:    i32 = 0;
    for (k < 6) {
        code[k] = r.out[0].data[16 + k];
        k       = k + 1;
    }
    val htoken: u64 = p.get64(?r.out[0].data[0], 8);
    r.nout = 0;

    # the same create again, its answer lost: the same room, no new one
    handle(?r, ?buf[0], create_req(?buf[0], 2, 77, 1), ?host, 10);
    if (open_rooms(?r) != 1 || p.get64(?r.out[0].data[0], 8) != htoken) { ret 2; }
    r.nout = 0;

    # a different WAD is turned away
    handle(?r, ?buf[0], join_req(?buf[0], ?code[0], 78, 9), ?gst, 20);
    if (r.out[0].data[4] != p.REFUSED || r.out[0].data[16] != p.WAD_MISMATCH) { ret 3; }
    r.nout = 0;

    # the right one gets seat 1, in lower case too
    k = 0;
    for (k < 6) {
        if (code[k] >= 'A' && code[k] <= 'Z') { code[k] = code[k] + 32; }
        k = k + 1;
    }
    handle(?r, ?buf[0], join_req(?buf[0], ?code[0], 77, 2), ?gst, 30);
    if (r.out[0].data[4] != p.WELCOME || r.out[0].data[5] != 1) { ret 4; }
    val gtoken: u64 = p.get64(?r.out[0].data[0], 8);
    r.nout = 0;

    # nothing starts until both have shown they can be reached
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 0, 0, htoken), ?host, 40);
    if (r.rooms[0].started) { ret 5; }
    r.nout = 0;
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 1, 0, gtoken), ?gst, 50);
    if (!r.rooms[0].started) { ret 6; }
    r.nout = 0;

    # data from the host to seat 1 reaches the guest only, marked as the
    # host's, carrying the guest's token
    val at: i32 = request(?buf[0], p.DATA, 0, 1, htoken);
    buf[at]     = 0xab;
    handle(?r, ?buf[0], at + 1, ?host, 60);
    if (r.nout != 1 || !same_addr(?r.out[0].to, ?gst)) { ret 7; }
    if (r.out[0].data[5] != 0 || r.out[0].data[16] != 0xab || p.get64(?r.out[0].data[0], 8) != gtoken) { ret 8; }
    r.nout = 0;

    # a wrong token goes nowhere
    handle(?r, ?buf[0], request(?buf[0], p.DATA, 0, 1, htoken + 1), ?host, 70);
    if (r.nout != 0) { ret 9; }

    # the guest goes silent: after the timeout the host is told
    tick(?r, 50 + PLAY_TIMEOUT + 1);
    if (r.nout != 1 || r.out[0].data[4] != p.GONE || !same_addr(?r.out[0].to, ?host)) { ret 10; }
    ret 0;
}

test relay__events_tell_the_story {
    var r: Relay;
    fresh(?r);
    var buf:  [64]u8;
    var host: Addr = Addr{ip: 1, port: 1};
    var gst:  Addr = Addr{ip: 2, port: 2};

    handle(?r, ?buf[0], create_req(?buf[0], 2, 5, 1), ?host, 0);
    val htoken: u64 = p.get64(?r.out[0].data[0], 8);
    var code: [6]u8;
    var k:    i32 = 0;
    for (k < 6) {
        code[k] = r.out[0].data[16 + k];
        k       = k + 1;
    }
    handle(?r, ?buf[0], join_req(?buf[0], ?code[0], 6, 2), ?gst, 10);
    handle(?r, ?buf[0], join_req(?buf[0], ?code[0], 5, 2), ?gst, 20);
    val gtoken: u64 = p.get64(?r.out[r.nout - 1].data[0], 8);
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 0, 0, htoken), ?host, 30);
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 1, 0, gtoken), ?gst, 40);
    handle(?r, ?buf[0], request(?buf[0], p.LEAVE, 1, 0, gtoken), ?gst, 5040);
    handle(?r, ?buf[0], request(?buf[0], p.LEAVE, 0, 0, htoken), ?host, 7040);

    val want: [7]u8 = [7]u8{EV_OPENED, EV_REFUSED, EV_JOINED, EV_STARTED, EV_LEFT, EV_LEFT, EV_CLOSED};
    if (r.nevents != 7) { ret 1; }
    k = 0;
    for (k < 7) {
        if (r.events[k].what != want[k]) { ret 2 + k; }
        k = k + 1;
    }
    if (r.events[1].slot != p.WAD_MISMATCH::i32 || r.events[2].slot != 1 || r.events[4].slot != 1) { ret 10; }
    if (r.events[6].played != 7 || r.events[6].code[0] != code[0]) { ret 11; }
    ret 0;
}

fun list_req(buf: *u8, wad: u64, len: i32) i32 {
    var k: i32 = 0;
    for (k < p.LISTSIZE) {
        buf[k] = 0;
        k      = k + 1;
    }
    val at: i32 = request(buf, p.LIST, 0, 0, 0);
    buf[at] = p.VERSION;
    p.put64(buf, at + 1, wad);
    ret len;
}

test relay__list_shows_only_what_can_be_joined {
    var r: Relay;
    fresh(?r);
    var buf: [128]u8;
    var a:   Addr = Addr{ip: 1, port: 1};
    var b:   Addr = Addr{ip: 2, port: 2};
    var c:   Addr = Addr{ip: 3, port: 3};
    var ask: Addr = Addr{ip: 9, port: 9};

    # a public room, a private one, and a public one with another WAD
    var len: i32 = create_req(?buf[0], 2, 5, 1);
    buf[len] = p.FLAG_PUBLIC;
    handle(?r, ?buf[0], len + 1, ?a, 0);
    var code: [6]u8;
    var k:    i32 = 0;
    for (k < 6) {
        code[k] = r.out[0].data[16 + k];
        k       = k + 1;
    }
    handle(?r, ?buf[0], create_req(?buf[0], 2, 5, 2), ?b, 0);
    len = create_req(?buf[0], 2, 6, 3);
    buf[len] = p.FLAG_PUBLIC;
    handle(?r, ?buf[0], len + 1, ?c, 0);
    if (open_rooms(?r) != 3) { ret 1; }
    r.nout = 0;

    # a short request gets nothing: the answer could be longer than it
    handle(?r, ?buf[0], list_req(?buf[0], 5, 30), ?ask, 10);
    if (r.nout != 0) { ret 2; }

    # a full-length one gets the one room it could join
    handle(?r, ?buf[0], list_req(?buf[0], 5, p.LISTSIZE), ?ask, 20);
    if (r.nout != 1 || r.out[0].data[4] != p.ROOMS || r.out[0].data[16] != 1) { ret 3; }
    if (r.out[0].len > p.LISTSIZE) { ret 4; }
    k = 0;
    for (k < 6) {
        if (r.out[0].data[17 + k] != code[k]) { ret 5; }
        k = k + 1;
    }
    if (r.out[0].data[23] != 2 || r.out[0].data[24] != 1) { ret 6; }
    r.nout = 0;

    # once it fills it is off the list
    handle(?r, ?buf[0], join_req(?buf[0], ?code[0], 5, 7), ?b, 30);
    r.nout = 0;
    handle(?r, ?buf[0], list_req(?buf[0], 5, p.LISTSIZE), ?ask, 40);
    if (r.nout != 1 || r.out[0].data[16] != 0) { ret 7; }
    ret 0;
}

test relay__bots_take_the_empty_seats {
    var r: Relay;
    fresh(?r);
    r.fillwait = 60000;
    var buf:  [1100]u8;
    var host: Addr = Addr{ip: 1, port: 1};

    # a public room for three, with only its host
    var len: i32 = create_req(?buf[0], 3, 5, 1);
    buf[len] = p.FLAG_PUBLIC;
    handle(?r, ?buf[0], len + 1, ?host, 0);
    val token: u64 = p.get64(?r.out[0].data[0], 8);
    r.nout = 0;
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 0, 0, token), ?host, 1000);
    # the lobby says how long until the bots come: 59 seconds
    if (r.out[0].data[4] != p.LOBBY || r.out[0].data[18] != 59) { ret 1; }
    r.nout = 0;

    # the host keeps reporting in; not yet
    var t: i64 = 10000;
    for (t < 59000) {
        handle(?r, ?buf[0], request(?buf[0], p.STATUS, 0, 0, token), ?host, t);
        t = t + 10000;
    }
    tick(?r, 59000);
    if (r.rooms[0].started) { ret 2; }
    # at a minute, the room starts with bots in seats 1 and 2
    r.nout = 0;
    tick(?r, 60000);
    if (!r.rooms[0].started || r.rooms[0].botmask != 6) { ret 3; }
    if (r.nout != 1 || r.out[0].data[4] != p.START || r.out[0].data[19] != 6) { ret 4; }
    r.nout = 0;

    # asked who is in seat 2: the hand-written bot, here, with no league
    var k: i32 = 0;
    for (k < p.BOTSIZE) {
        buf[k] = 0;
        k      = k + 1;
    }
    val at: i32 = request(?buf[0], p.BOTASK, 0, 0, token);
    buf[at] = 2;
    handle(?r, ?buf[0], p.BOTSIZE, ?host, 60100);
    if (r.nout != 1 || r.out[0].data[4] != p.BOTIS || r.out[0].data[16] != 2) { ret 5; }
    if (p.get32(?r.out[0].data[0], 20) != lf.SEAT_SCRIPT::u32 || r.out[0].data[28] != 'T') { ret 6; }
    r.nout = 0;
    # and a seat a person holds is not a bot's
    buf[at] = 0;
    handle(?r, ?buf[0], p.BOTSIZE, ?host, 60200);
    if (r.nout != 0) { ret 7; }
    ret 0;
}

test relay__a_host_can_start_at_once_with_bots {
    var r: Relay;
    fresh(?r);
    var buf:  [64]u8;
    var host: Addr = Addr{ip: 1, port: 1};
    # a private room: bots never come by themselves
    r.fillwait = 1000;
    handle(?r, ?buf[0], create_req(?buf[0], 4, 5, 1), ?host, 0);
    val token: u64 = p.get64(?r.out[0].data[0], 8);
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 0, 0, token), ?host, 100);
    tick(?r, 5000);
    if (r.rooms[0].started) { ret 1; }
    # until the host asks
    r.nout = 0;
    handle(?r, ?buf[0], request(?buf[0], p.FILL, 0, 0, token), ?host, 5100);
    if (!r.rooms[0].started || r.rooms[0].botmask != 14) { ret 2; }
    ret 0;
}

test relay__keeps_what_players_send_to_train_bots {
    var r: Relay;
    fresh(?r);
    # room for the head and four samples is all this needs
    var room: [512]u8;
    r.train = (?room[0]):~*Train;
    var buf:  [1100]u8;
    var host: Addr = Addr{ip: 1, port: 1};
    handle(?r, ?buf[0], create_req(?buf[0], 2, 5, 1), ?host, 0);
    val token: u64 = p.get64(?r.out[0].data[0], 8);
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 0, 0, token), ?host, 100);

    var at: i32 = request(?buf[0], p.TRAIN, 0, 0, token);
    buf[at]     = p.VERSION;
    buf[at + 1] = 1;
    buf[at + 2] = 3;
    buf[at + 3] = 4;
    buf[at + 4] = 2;
    var k: i32 = 0;
    for (k < 2 * p.TRAINSAMPLE) {
        buf[at + 5 + k] = (k + 1)::u8;
        k               = k + 1;
    }
    val len: i32 = at + 5 + 2 * p.TRAINSAMPLE;
    # before the game has started: not kept
    handle(?r, ?buf[0], len, ?host, 200);
    if (r.train.count != 0) { ret 1; }
    var ask: [64]u8;
    handle(?r, ?ask[0], request(?ask[0], p.FILL, 0, 0, token), ?host, 300);
    if (!r.rooms[0].started) { ret 2; }
    handle(?r, ?buf[0], len, ?host, 400);
    if (r.train.count != 2 || !r.train.dirty) { ret 3; }
    # each with its mode and map before it
    if (r.train.data[0] != 1 || r.train.data[1] != 3 || r.train.data[2] != 1) { ret 4; }
    if (r.train.data[40] != 1 || r.train.data[42] != 39)                      { ret 5; }
    # saying it is a deathmatch's, from a co-op room: not kept
    buf[at + 1] = 2;
    handle(?r, ?buf[0], len, ?host, 500);
    if (r.train.count != 2) { ret 6; }
    # cut short: not kept
    buf[at + 1] = 1;
    handle(?r, ?buf[0], len - 1, ?host, 600);
    if (r.train.count != 2) { ret 7; }
    # the file is its head and two records, and reads back as two
    if (train_head(r.train) != 16 + 80) { ret 8; }
    train_loaded(r.train, 16 + 80);
    if (r.train.count != 2) { ret 9; }
    ret 0;
}

test relay__rooms_do_not_mix {
    var r: Relay;
    fresh(?r);
    var buf: [64]u8;
    var a:   Addr = Addr{ip: 1, port: 1};
    var b:   Addr = Addr{ip: 2, port: 2};

    handle(?r, ?buf[0], create_req(?buf[0], 2, 5, 1), ?a, 0);
    val ta: u64 = p.get64(?r.out[0].data[0], 8);
    r.nout = 0;
    handle(?r, ?buf[0], create_req(?buf[0], 2, 5, 1), ?b, 0);
    if (open_rooms(?r) != 2) { ret 1; }
    r.nout = 0;

    # a's token names seat 0 of a's room; it cannot speak as seat 1 anywhere
    handle(?r, ?buf[0], request(?buf[0], p.STATUS, 1, 0, ta), ?a, 5);
    if (r.nout != 0 || r.dropped == 0) { ret 2; }

    # an unknown code is refused
    var nocode: [6]u8 = [6]u8{'2', '2', '2', '2', '2', '2'};
    handle(?r, ?buf[0], join_req(?buf[0], ?nocode[0], 5, 3), ?a, 6);
    if (r.out[0].data[16] != p.NO_ROOM) { ret 3; }
    ret 0;
}

test relay__rate_limit {
    var r: Relay;
    fresh(?r);
    var buf: [64]u8;
    var a:   Addr = Addr{ip: 9, port: 9};
    var nocode: [6]u8 = [6]u8{'2', '2', '2', '2', '2', '2'};
    var i: i32 = 0;
    for (i < 25) {
        r.nout = 0;
        handle(?r, ?buf[0], join_req(?buf[0], ?nocode[0], 5, i::u32), ?a, 100);
        i = i + 1;
    }
    # the 25th guess within the window is turned away as busy, not checked
    if (r.out[0].data[16] != p.BUSY) { ret 1; }
    ret 0;
}
