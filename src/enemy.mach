# monster thinking: looking, chasing, choosing a direction, attacking, dying
#
# Ported from p_enemy.c. Enemies are always spawned with targetplayer = -1,
# threshold = 0. Most monsters are spawned unaware of all players, but some
# can be made preaware.
#
# Only the first game's monsters act here. The second game's (the arch-vile,
# revenant, mancubus, arachnotron, pain elemental and the boss brain) have
# states in the table but no behaviour, and no first-game map contains them.

use std.types.bool.bool;

use doom.defs;
use doom.defs.Game;
use doom.defs.Mobj;
use doom.defs.Player;
use doom.defs.Thinker;
use doom.fixed;
use doom.fixed.Fixed;
use doom.info;
use doom.level;
use doom.maputl;
use doom.movers;
use t: doom.tables;
use doom.world;

val DI_EAST:      i32 = 0;
val DI_NORTHEAST: i32 = 1;
val DI_NORTH:     i32 = 2;
val DI_NORTHWEST: i32 = 3;
val DI_WEST:      i32 = 4;
val DI_SOUTHWEST: i32 = 5;
val DI_SOUTH:     i32 = 6;
val DI_SOUTHEAST: i32 = 7;
val DI_NODIR:     i32 = 8;

val OPPOSITE: [9]i32 = [9]i32{4, 5, 6, 7, 0, 1, 2, 3, 8};
val DIAGS:    [4]i32 = [4]i32{3, 1, 5, 7};

val XSPEED: [8]Fixed = [8]Fixed{65536, 47000, 0, -47000, -65536, -47000, 0, 47000};
val YSPEED: [8]Fixed = [8]Fixed{0, 47000, 65536, 47000, 0, -47000, -65536, -47000};

val SKULLSPEED: Fixed = 20 * 65536;

fun abs32(x: i32) i32 {
    if (x < 0) { ret 0 - x; }
    ret x;
}

fun mi(actor: *Mobj, field: i32) i32 {
    ret info.mi(actor.kind, field);
}

# P_CheckMeleeRange
fun check_melee_range(g: *Game, actor: *Mobj) bool {
    if (actor.target == nil) { ret 0; }

    val pl:   *Mobj = actor.target;
    val dist: Fixed = maputl.aprox_distance(pl.x - actor.x, pl.y - actor.y);

    if (dist >= defs.MELEERANGE - 20 * 65536 + mi(pl, info.MI_RADIUS)) { ret 0; }
    if (!maputl.check_sight(g, actor, actor.target))                   { ret 0; }
    ret 1;
}

# P_CheckMissileRange
fun check_missile_range(g: *Game, actor: *Mobj) bool {
    if (!maputl.check_sight(g, actor, actor.target)) { ret 0; }

    if ((actor.flags & defs.MF_JUSTHIT) != 0) {
        # the target just hit the enemy, so fight back!
        actor.flags = actor.flags & ~defs.MF_JUSTHIT;
        ret 1;
    }

    if (actor.reactiontime != 0) {
        # do not attack yet
        ret 0;
    }

    # OPTIMIZE: get this from a global checksight
    var dist: Fixed = maputl.aprox_distance(actor.x - actor.target.x, actor.y - actor.target.y) - 64 * 65536;

    if (mi(actor, info.MI_MELEESTATE) == 0) {
        # no melee attack, so fire more
        dist = dist - 128 * 65536;
    }

    dist = dist >> 16;

    if (actor.kind == info.MT_VILE) {
        if (dist > 14 * 64) {
            # too far away
            ret 0;
        }
    }

    if (actor.kind == info.MT_UNDEAD) {
        if (dist < 196) {
            # close for fist attack
            ret 0;
        }
        dist = dist >> 1;
    }

    if (actor.kind == info.MT_CYBORG || actor.kind == info.MT_SPIDER || actor.kind == info.MT_SKULL) { dist = dist >> 1; }

    if (dist > 200)                                 { dist = 200; }
    if (actor.kind == info.MT_CYBORG && dist > 160) { dist = 160; }

    if (defs.p_random(g) < dist) { ret 0; }
    ret 1;
}

# P_Move: move in the current direction
# ---
# ret: false if the move is blocked
fun move(g: *Game, actor: *Mobj) bool {
    if (actor.movedir == DI_NODIR) { ret 0; }

    val speed: i32   = mi(actor, info.MI_SPEED);
    val tryx:  Fixed = actor.x + speed * XSPEED[actor.movedir & 7];
    val tryy:  Fixed = actor.y + speed * YSPEED[actor.movedir & 7];

    if (!world.try_move(g, actor, tryx, tryy)) {
        # open any specials
        if ((actor.flags & defs.MF_FLOAT) != 0 && g.floatok) {
            # must adjust height
            if (actor.z < g.tmfloorz) {
                actor.z = actor.z + defs.FLOATSPEED;
            }
            or {
                actor.z = actor.z - defs.FLOATSPEED;
            }
            actor.flags = actor.flags | defs.MF_INFLOAT;
            ret 1;
        }

        if (g.numspechit == 0) { ret 0; }

        actor.movedir = DI_NODIR;
        var good: bool = 0;
        for (g.numspechit > 0) {
            g.numspechit = g.numspechit - 1;
            # if the special is not a door that can be opened, return false
            if (g.line_special(g, defs.TRIGGER_USE, g.spechit[g.numspechit], 0, actor)) { good = 1; }
        }
        g.numspechit = -1;
        ret good;
    }

    actor.flags = actor.flags & ~defs.MF_INFLOAT;

    if ((actor.flags & defs.MF_FLOAT) == 0) { actor.z = actor.floorz; }
    ret 1;
}

# P_TryWalk: attempts to move actor on in its current (ob->moveangle)
# direction. if blocked by either a wall or an actor returns FALSE. if move
# is either clear or blocked only by a door, returns TRUE and sets... if a
# door is in the way, an OpenDoor call is made to start it opening.
fun try_walk(g: *Game, actor: *Mobj) bool {
    if (!move(g, actor)) { ret 0; }
    actor.movecount = defs.p_random(g) & 15;
    ret 1;
}

# P_NewChaseDir
fun new_chase_dir(g: *Game, actor: *Mobj) {
    val olddir:     i32   = actor.movedir;
    val turnaround: i32   = OPPOSITE[olddir];
    val deltax:     Fixed = actor.target.x - actor.x;
    val deltay:     Fixed = actor.target.y - actor.y;

    var d1: i32 = DI_NODIR;
    if (deltax > 10 * 65536) {
        d1 = DI_EAST;
    }
    or (deltax < 0 - 10 * 65536) {
        d1 = DI_WEST;
    }

    var d2: i32 = DI_NODIR;
    if (deltay < 0 - 10 * 65536) {
        d2 = DI_SOUTH;
    }
    or (deltay > 10 * 65536) {
        d2 = DI_NORTH;
    }

    # try direct route
    if (d1 != DI_NODIR && d2 != DI_NODIR) {
        actor.movedir = DIAGS[((deltay < 0)::i32 << 1) + (deltax > 0)::i32];
        if (actor.movedir != turnaround && try_walk(g, actor)) { ret; }
    }

    # try other directions
    if (defs.p_random(g) > 200 || abs32(deltay) > abs32(deltax)) {
        val tdir: i32 = d1;
        d1 = d2;
        d2 = tdir;
    }

    if (d1 == turnaround) { d1 = DI_NODIR; }
    if (d2 == turnaround) { d2 = DI_NODIR; }

    if (d1 != DI_NODIR) {
        actor.movedir = d1;
        if (try_walk(g, actor)) {
            # either moved forward or attacked
            ret;
        }
    }

    if (d2 != DI_NODIR) {
        actor.movedir = d2;
        if (try_walk(g, actor)) { ret; }
    }

    # there is no direct path to the player, so pick another direction
    if (olddir != DI_NODIR) {
        actor.movedir = olddir;
        if (try_walk(g, actor)) { ret; }
    }

    # randomly determine direction of search
    if ((defs.p_random(g) & 1) != 0) {
        var tdir: i32 = DI_EAST;
        for (tdir <= DI_SOUTHEAST) {
            if (tdir != turnaround) {
                actor.movedir = tdir;
                if (try_walk(g, actor)) { ret; }
            }
            tdir = tdir + 1;
        }
    }
    or {
        var tdir: i32 = DI_SOUTHEAST;
        for (tdir != DI_EAST - 1) {
            if (tdir != turnaround) {
                actor.movedir = tdir;
                if (try_walk(g, actor)) { ret; }
            }
            tdir = tdir - 1;
        }
    }

    if (turnaround != DI_NODIR) {
        actor.movedir = turnaround;
        if (try_walk(g, actor)) { ret; }
    }

    # can not move
    actor.movedir = DI_NODIR;
}

# P_LookForPlayers: if allaround is false, only look 180 degrees in front
# ---
# ret: true if a player is targeted
fun look_for_players(g: *Game, actor: *Mobj, allaround: bool) bool {
    var c:    i32 = 0;
    val stop: i32 = (actor.lastlook - 1) & 3;

    for {
        if (g.playeringame[actor.lastlook]) {
            if (c == 2 || actor.lastlook == stop) {
                # done looking
                ret 0;
            }
            c = c + 1;

            val player: *Player = ?g.players[actor.lastlook];
            var seen:   bool    = 1;

            if (player.health <= 0) {
                # dead
                seen = 0;
            }
            or (!maputl.check_sight(g, actor, player.mo)) {
                # out of sight
                seen = 0;
            }
            or (!allaround) {
                val an: u32 = world.point_to_angle2(actor.x, actor.y, player.mo.x, player.mo.y) - actor.angle;
                if (an > t.ANG90 && an < t.ANG270) {
                    val dist: Fixed = maputl.aprox_distance(player.mo.x - actor.x, player.mo.y - actor.y);
                    # if real close, react anyway
                    if (dist > defs.MELEERANGE) {
                        # behind back
                        seen = 0;
                    }
                }
            }

            if (seen) {
                actor.target = player.mo;
                ret 1;
            }
        }
        actor.lastlook = (actor.lastlook + 1) & 3;
    }
    ret 0;
}

# A_FaceTarget
fun face_target(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    actor.flags = actor.flags & ~defs.MF_AMBUSH;
    actor.angle = world.point_to_angle2(actor.x, actor.y, actor.target.x, actor.target.y);

    if ((actor.target.flags & defs.MF_SHADOW) != 0) { actor.angle = actor.angle + (world.sub_random(g) << 21):~u32; }
}

# A_Look: stay in state until a player is sighted
fun look(g: *Game, actor: *Mobj) {
    # any shot will wake up
    actor.threshold = 0;
    val targ:   *Mobj = defs.sector_of(g, actor).soundtarget:~*Mobj;
    var seeyou: bool  = 0;

    if (targ != nil && (targ.flags & defs.MF_SHOOTABLE) != 0) {
        actor.target = targ;
        if ((actor.flags & defs.MF_AMBUSH) != 0) {
            if (maputl.check_sight(g, actor, actor.target)) { seeyou = 1; }
        }
        or {
            seeyou = 1;
        }
    }

    if (!seeyou) {
        if (!look_for_players(g, actor, 0)) { ret; }
    }

    # go into chase state
    val seesound: i32 = mi(actor, info.MI_SEESOUND);
    if (seesound != 0) {
        var sound: i32 = seesound;
        if (seesound == info.SFX_POSIT1 || seesound == info.SFX_POSIT2 || seesound == info.SFX_POSIT3) {
            sound = info.SFX_POSIT1 + defs.p_random(g) % 3;
        }
        or (seesound == info.SFX_BGSIT1 || seesound == info.SFX_BGSIT2) {
            sound = info.SFX_BGSIT1 + defs.p_random(g) % 2;
        }

        if (actor.kind == info.MT_SPIDER || actor.kind == info.MT_CYBORG) {
            # full volume
            defs.sound(g, nil, sound);
        }
        or {
            defs.sound(g, actor, sound);
        }
    }

    world.set_mobj_state(g, actor, mi(actor, info.MI_SEESTATE));
}

# A_Chase: actor has a melee attack, so it tries to close as fast as possible
fun chase(g: *Game, actor: *Mobj) {
    if (actor.reactiontime != 0) { actor.reactiontime = actor.reactiontime - 1; }

    # modify target threshold
    if (actor.threshold != 0) {
        if (actor.target == nil || actor.target.health <= 0) {
            actor.threshold = 0;
        }
        or {
            actor.threshold = actor.threshold - 1;
        }
    }

    # turn towards movement direction if not there yet
    if (actor.movedir < 8) {
        actor.angle = actor.angle & (7 << 29);
        val delta: i32 = (actor.angle - (actor.movedir:~u32 << 29)):~i32;

        if (delta > 0) {
            actor.angle = actor.angle - t.ANG90 / 2;
        }
        or (delta < 0) {
            actor.angle = actor.angle + t.ANG90 / 2;
        }
    }

    if (actor.target == nil || (actor.target.flags & defs.MF_SHOOTABLE) == 0) {
        # look for a new target
        if (look_for_players(g, actor, 1)) {
            # got a new target
            ret;
        }
        world.set_mobj_state(g, actor, mi(actor, info.MI_SPAWNSTATE));
        ret;
    }

    # do not attack twice in a row
    if ((actor.flags & defs.MF_JUSTATTACKED) != 0) {
        actor.flags = actor.flags & ~defs.MF_JUSTATTACKED;
        if (g.gameskill != defs.SK_NIGHTMARE && !g.fastparm) { new_chase_dir(g, actor); }
        ret;
    }

    # check for melee attack
    if (mi(actor, info.MI_MELEESTATE) != 0 && check_melee_range(g, actor)) {
        if (mi(actor, info.MI_ATTACKSOUND) != 0) { defs.sound(g, actor, mi(actor, info.MI_ATTACKSOUND)); }
        world.set_mobj_state(g, actor, mi(actor, info.MI_MELEESTATE));
        ret;
    }

    # check for missile attack
    if (mi(actor, info.MI_MISSILESTATE) != 0) {
        var fire: bool = 1;
        if (g.gameskill < defs.SK_NIGHTMARE && !g.fastparm && actor.movecount != 0) {
            fire = 0;
        }
        or (!check_missile_range(g, actor)) {
            fire = 0;
        }

        if (fire) {
            world.set_mobj_state(g, actor, mi(actor, info.MI_MISSILESTATE));
            actor.flags = actor.flags | defs.MF_JUSTATTACKED;
            ret;
        }
    }

    # possibly choose another target
    if (g.netgame && actor.threshold == 0 && !maputl.check_sight(g, actor, actor.target)) {
        if (look_for_players(g, actor, 1)) {
            # got a new target
            ret;
        }
    }

    # chase towards player
    actor.movecount = actor.movecount - 1;
    if (actor.movecount < 0 || !move(g, actor)) { new_chase_dir(g, actor); }

    # make active sound
    if (mi(actor, info.MI_ACTIVESOUND) != 0 && defs.p_random(g) < 3) { defs.sound(g, actor, mi(actor, info.MI_ACTIVESOUND)); }
}

# A_PosAttack
fun pos_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    face_target(g, actor);
    var angle: u32   = actor.angle;
    val slope: Fixed = world.aim_line_attack(g, actor, angle, defs.MISSILERANGE);

    defs.sound(g, actor, info.SFX_PISTOL);
    angle = angle + (world.sub_random(g) << 20):~u32;
    val damage: i32 = ((defs.p_random(g) % 5) + 1) * 3;
    world.line_attack(g, actor, angle, defs.MISSILERANGE, slope, damage);
}

# A_SPosAttack
fun spos_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    defs.sound(g, actor, info.SFX_SHOTGN);
    face_target(g, actor);
    val bangle: u32   = actor.angle;
    val slope:  Fixed = world.aim_line_attack(g, actor, bangle, defs.MISSILERANGE);

    var i: i32 = 0;
    for (i < 3) {
        val angle:  u32 = bangle + (world.sub_random(g) << 20):~u32;
        val damage: i32 = ((defs.p_random(g) % 5) + 1) * 3;
        world.line_attack(g, actor, angle, defs.MISSILERANGE, slope, damage);
        i = i + 1;
    }
}

# A_CPosAttack
fun cpos_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    defs.sound(g, actor, info.SFX_SHOTGN);
    face_target(g, actor);
    val bangle: u32   = actor.angle;
    val slope:  Fixed = world.aim_line_attack(g, actor, bangle, defs.MISSILERANGE);

    val angle:  u32 = bangle + (world.sub_random(g) << 20):~u32;
    val damage: i32 = ((defs.p_random(g) % 5) + 1) * 3;
    world.line_attack(g, actor, angle, defs.MISSILERANGE, slope, damage);
}

# A_CPosRefire and A_SpidRefire: keep firing unless the target got out of
# sight
fun refire(g: *Game, actor: *Mobj, chance: i32) {
    face_target(g, actor);

    if (defs.p_random(g) < chance) { ret; }

    if (actor.target == nil || actor.target.health <= 0 || !maputl.check_sight(g, actor, actor.target)) {
        world.set_mobj_state(g, actor, mi(actor, info.MI_SEESTATE));
    }
}

# A_TroopAttack
fun troop_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    face_target(g, actor);
    if (check_melee_range(g, actor)) {
        defs.sound(g, actor, info.SFX_CLAW);
        val damage: i32 = (defs.p_random(g) % 8 + 1) * 3;
        world.damage_mobj(g, actor.target, actor, actor, damage);
        ret;
    }

    # launch a missile
    world.spawn_missile(g, actor, actor.target, info.MT_TROOPSHOT);
}

# A_SargAttack
fun sarg_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    face_target(g, actor);
    if (check_melee_range(g, actor)) {
        val damage: i32 = ((defs.p_random(g) % 10) + 1) * 4;
        world.damage_mobj(g, actor.target, actor, actor, damage);
    }
}

# A_HeadAttack
fun head_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    face_target(g, actor);
    if (check_melee_range(g, actor)) {
        val damage: i32 = (defs.p_random(g) % 6 + 1) * 10;
        world.damage_mobj(g, actor.target, actor, actor, damage);
        ret;
    }

    # launch a missile
    world.spawn_missile(g, actor, actor.target, info.MT_HEADSHOT);
}

# A_CyberAttack
fun cyber_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    face_target(g, actor);
    world.spawn_missile(g, actor, actor.target, info.MT_ROCKET);
}

# A_BruisAttack
fun bruis_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    if (check_melee_range(g, actor)) {
        defs.sound(g, actor, info.SFX_CLAW);
        val damage: i32 = (defs.p_random(g) % 8 + 1) * 10;
        world.damage_mobj(g, actor.target, actor, actor, damage);
        ret;
    }

    # launch a missile
    world.spawn_missile(g, actor, actor.target, info.MT_BRUISERSHOT);
}

# A_SkullAttack: fly at the player like a missile
fun skull_attack(g: *Game, actor: *Mobj) {
    if (actor.target == nil) { ret; }

    val dest: *Mobj = actor.target;
    actor.flags = actor.flags | defs.MF_SKULLFLY;

    defs.sound(g, actor, mi(actor, info.MI_ATTACKSOUND));
    face_target(g, actor);
    val an: u32 = actor.angle >> t.ANGLETOFINESHIFT;
    actor.momx = fixed.mul(SKULLSPEED, t.FINESINE[an + 2048]);
    actor.momy = fixed.mul(SKULLSPEED, t.FINESINE[an]);

    var dist: i32 = maputl.aprox_distance(dest.x - actor.x, dest.y - actor.y);
    dist = dist / SKULLSPEED;

    if (dist < 1) { dist = 1; }
    actor.momz = (dest.z + (dest.height >> 1) - actor.z) / dist;
}

# A_Scream
fun scream(g: *Game, actor: *Mobj) {
    val deathsound: i32 = mi(actor, info.MI_DEATHSOUND);
    if (deathsound == 0) { ret; }

    var sound: i32 = deathsound;
    if (deathsound == info.SFX_PODTH1 || deathsound == info.SFX_PODTH2 || deathsound == info.SFX_PODTH3) {
        sound = info.SFX_PODTH1 + defs.p_random(g) % 3;
    }
    or (deathsound == info.SFX_BGDTH1 || deathsound == info.SFX_BGDTH2) {
        sound = info.SFX_BGDTH1 + defs.p_random(g) % 2;
    }

    # check for bosses
    if (actor.kind == info.MT_SPIDER || actor.kind == info.MT_CYBORG) {
        # full volume
        defs.sound(g, nil, sound);
    }
    or {
        defs.sound(g, actor, sound);
    }
}

# whether any other living thing of the same kind is left
fun others_alive(g: *Game, mo: *Mobj) bool {
    var th: *Thinker = g.thinkercap.next;
    for (th != ?g.thinkercap) {
        if (th.kind == defs.TH_MOBJ) {
            val mo2: *Mobj = th:~*Mobj;
            if (mo2 != mo && mo2.kind == mo.kind && mo2.health > 0) { ret 1; }
        }
        th = th.next;
    }
    ret 0;
}

# A_BossDeath: possibly trigger special effects if on first boss level
fun boss_death(g: *Game, mo: *Mobj) {
    if (g.gameepisode == 1) {
        if (g.gamemap != 8 || mo.kind != info.MT_BRUISER) { ret; }
    }
    or (g.gameepisode == 2) {
        if (g.gamemap != 8 || mo.kind != info.MT_CYBORG) { ret; }
    }
    or (g.gameepisode == 3) {
        if (g.gamemap != 8 || mo.kind != info.MT_SPIDER) { ret; }
    }
    or (g.gameepisode == 4) {
        if (g.gamemap == 6) {
            if (mo.kind != info.MT_CYBORG) { ret; }
        }
        or (g.gamemap == 8) {
            if (mo.kind != info.MT_SPIDER) { ret; }
        }
        or {
            ret;
        }
    }
    or {
        if (g.gamemap != 8) { ret; }
    }

    # make sure there is a player alive for victory
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        if (g.playeringame[i] && g.players[i].health > 0) { brk; }
        i = i + 1;
    }
    if (i == defs.MAXPLAYERS) {
        # no one left alive, so do not end game
        ret;
    }

    # scan the remaining thinkers to see if all bosses are dead
    if (others_alive(g, mo)) {
        # other boss not dead
        ret;
    }

    # victory!
    if (g.gameepisode == 1) {
        movers.do_floor(g, 666, level.NONE, movers.LOWER_FLOOR_TO_LOWEST);
        ret;
    }
    if (g.gameepisode == 4) {
        if (g.gamemap == 6) {
            movers.do_door(g, 666, movers.BLAZE_OPEN);
            ret;
        }
        if (g.gamemap == 8) {
            movers.do_floor(g, 666, level.NONE, movers.LOWER_FLOOR_TO_LOWEST);
            ret;
        }
    }

    g.exited = 1;
}

# A_BFGSpray: spawn a BFG explosion on every monster in view
fun bfg_spray(g: *Game, mo: *Mobj) {
    # offset angles from its attack angle
    var i: i32 = 0;
    for (i < 40) {
        val an: u32 = mo.angle - t.ANG90 / 2 + t.ANG90 / 40 * i:~u32;
        i = i + 1;

        # mo.target is the originator (player) of the missile
        world.aim_line_attack(g, mo.target, an, 16 * 64 * 65536);
        if (g.linetarget == nil) { cnt; }

        world.spawn_mobj(g, g.linetarget.x, g.linetarget.y, g.linetarget.z + (g.linetarget.height >> 2), info.MT_EXTRABFG);

        var damage: i32 = 0;
        var j:      i32 = 0;
        for (j < 15) {
            damage = damage + (defs.p_random(g) & 7) + 1;
            j      = j + 1;
        }

        world.damage_mobj(g, g.linetarget, mo.target, mo.target, damage);
    }
}

# run the action a map object's state names
# ---
# g:      the game
# actor:  the object entering the state
# action: A_* from the state table
# ret:    false if the action is not a map object's
pub fun run(g: *Game, actor: *Mobj, action: i32) bool {
    if (action == info.A_LOOK) {
        look(g, actor);
    }
    or (action == info.A_CHASE) {
        chase(g, actor);
    }
    or (action == info.A_FACETARGET) {
        face_target(g, actor);
    }
    or (action == info.A_POSATTACK) {
        pos_attack(g, actor);
    }
    or (action == info.A_SPOSATTACK) {
        spos_attack(g, actor);
    }
    or (action == info.A_CPOSATTACK) {
        cpos_attack(g, actor);
    }
    or (action == info.A_CPOSREFIRE) {
        refire(g, actor, 40);
    }
    or (action == info.A_SPIDREFIRE) {
        refire(g, actor, 10);
    }
    or (action == info.A_TROOPATTACK) {
        troop_attack(g, actor);
    }
    or (action == info.A_SARGATTACK) {
        sarg_attack(g, actor);
    }
    or (action == info.A_HEADATTACK) {
        head_attack(g, actor);
    }
    or (action == info.A_CYBERATTACK) {
        cyber_attack(g, actor);
    }
    or (action == info.A_BRUISATTACK) {
        bruis_attack(g, actor);
    }
    or (action == info.A_SKULLATTACK) {
        skull_attack(g, actor);
    }
    or (action == info.A_SCREAM) {
        scream(g, actor);
    }
    or (action == info.A_XSCREAM) {
        defs.sound(g, actor, info.SFX_SLOP);
    }
    or (action == info.A_PAIN) {
        if (mi(actor, info.MI_PAINSOUND) != 0) { defs.sound(g, actor, mi(actor, info.MI_PAINSOUND)); }
    }
    or (action == info.A_FALL) {
        # actor is on ground, it can be walked over
        actor.flags = actor.flags & ~defs.MF_SOLID;
    }
    or (action == info.A_EXPLODE) {
        world.radius_attack(g, actor, actor.target, 128);
    }
    or (action == info.A_BOSSDEATH) {
        boss_death(g, actor);
    }
    or (action == info.A_HOOF) {
        defs.sound(g, actor, info.SFX_HOOF);
        chase(g, actor);
    }
    or (action == info.A_METAL) {
        defs.sound(g, actor, info.SFX_METAL);
        chase(g, actor);
    }
    or (action == info.A_PLAYERSCREAM) {
        defs.sound(g, actor, info.SFX_PLDETH);
    }
    or (action == info.A_BFGSPRAY) {
        bfg_spray(g, actor);
    }
    or {
        ret 0;
    }
    ret 1;
}
