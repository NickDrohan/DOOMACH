# what the player's weapons do: the actions of the weapon sprite's states
#
# Ported from the action routines of p_pspr.c. The state machine that runs
# them (P_SetPsprite and friends) is in world.mach, because dying and picking
# things up need it; this is the part that only the state table calls.

use std.types.bool.bool;

use doom.defs;
use doom.defs.Game;
use doom.defs.Mobj;
use doom.defs.Player;
use doom.defs.Pspdef;
use doom.fixed;
use doom.fixed.Fixed;
use doom.info;
use t: doom.tables;
use doom.world;

val LOWERSPEED: Fixed = 6 * 65536;
val RAISESPEED: Fixed = 6 * 65536;

fun ammo_of(player: *Player) i32 {
    ret world.weaponinfo(player.readyweapon, world.WI_AMMO);
}

fun flash_of(player: *Player) i32 {
    ret world.weaponinfo(player.readyweapon, world.WI_FLASH);
}

# A_WeaponReady: the player can fire the weapon or change to another weapon
# at this time. follows after getting weapon up, or after previous attack /
# fire sequence.
fun weapon_ready(g: *Game, player: *Player, psp: *Pspdef) {
    # get out of attack state
    if (player.mo.state == info.S_PLAY_ATK1 || player.mo.state == info.S_PLAY_ATK2) {
        world.set_mobj_state(g, player.mo, info.S_PLAY);
    }

    if (player.readyweapon == defs.WP_CHAINSAW && psp.state == info.S_SAW) { defs.sound(g, player.mo, info.SFX_SAWIDL); }

    # check for change. if player is dead, put the weapon away.
    if (player.pendingweapon != defs.WP_NOCHANGE || player.health == 0) {
        # change weapon (pending weapon should allready be validated)
        world.set_psprite(g, player, defs.PS_WEAPON, world.weaponinfo(player.readyweapon, world.WI_DOWN));
        ret;
    }

    # check for fire. the missile launcher and bfg do not auto fire.
    if ((player.cmd.buttons::i32 & defs.BT_ATTACK) != 0) {
        if (player.attackdown == 0 || (player.readyweapon != defs.WP_MISSILE && player.readyweapon != defs.WP_BFG)) {
            player.attackdown = 1;
            world.fire_weapon(g, player);
            ret;
        }
    }
    or {
        player.attackdown = 0;
    }

    # bob the weapon based on movement speed
    var angle: i32 = (128 * g.leveltime) & t.FINEMASK;
    psp.sx = 65536 + fixed.mul(player.bob, t.FINESINE[angle + 2048]);
    angle  = angle & (t.FINEANGLES / 2 - 1);
    psp.sy = world.WEAPONTOP + fixed.mul(player.bob, t.FINESINE[angle]);
}

# A_ReFire: the player can re-fire the weapon without lowering it entirely
fun re_fire(g: *Game, player: *Player) {
    # check for fire (if a weaponchange is pending, let it go through instead)
    if ((player.cmd.buttons::i32 & defs.BT_ATTACK) != 0 && player.pendingweapon == defs.WP_NOCHANGE && player.health != 0) {
        player.refire = player.refire + 1;
        world.fire_weapon(g, player);
    }
    or {
        player.refire = 0;
        world.check_ammo(g, player);
    }
}

# A_Lower: lowers current weapon, and changes weapon at bottom
fun lower(g: *Game, player: *Player, psp: *Pspdef) {
    psp.sy = psp.sy + LOWERSPEED;

    # is already down
    if (psp.sy < world.WEAPONBOTTOM) { ret; }

    # player is dead
    if (player.playerstate == defs.PST_DEAD) {
        psp.sy = world.WEAPONBOTTOM;
        # don't bring weapon back up
        ret;
    }

    # the old weapon has been lowered off the screen, so change the weapon
    # and start raising it
    if (player.health == 0) {
        # player is dead, so keep the weapon off screen
        world.set_psprite(g, player, defs.PS_WEAPON, info.S_NULL);
        ret;
    }

    player.readyweapon = player.pendingweapon;
    world.bring_up_weapon(g, player);
}

# A_Raise
fun raise(g: *Game, player: *Player, psp: *Pspdef) {
    psp.sy = psp.sy - RAISESPEED;
    if (psp.sy > world.WEAPONTOP) { ret; }
    psp.sy = world.WEAPONTOP;

    # the weapon has been raised all the way, so change to the ready state
    world.set_psprite(g, player, defs.PS_WEAPON, world.weaponinfo(player.readyweapon, world.WI_READY));
}

# A_Punch
fun punch(g: *Game, player: *Player) {
    var damage: i32 = (defs.p_random(g) % 10 + 1) << 1;
    if (player.powers[defs.PW_STRENGTH] != 0) { damage = damage * 10; }

    var angle: u32 = player.mo.angle;
    angle = angle + (world.sub_random(g) << 18):~u32;
    val slope: Fixed = world.aim_line_attack(g, player.mo, angle, defs.MELEERANGE);
    world.line_attack(g, player.mo, angle, defs.MELEERANGE, slope, damage);

    # turn to face target
    if (g.linetarget != nil) {
        defs.sound(g, player.mo, info.SFX_PUNCH);
        player.mo.angle = world.point_to_angle2(player.mo.x, player.mo.y, g.linetarget.x, g.linetarget.y);
    }
}

# A_Saw
fun saw(g: *Game, player: *Player) {
    val damage: i32 = 2 * (defs.p_random(g) % 10 + 1);
    var angle:  u32 = player.mo.angle;
    angle = angle + (world.sub_random(g) << 18):~u32;

    # use meleerange + 1 so the puff doesn't skip the flash
    val slope: Fixed = world.aim_line_attack(g, player.mo, angle, defs.MELEERANGE + 1);
    world.line_attack(g, player.mo, angle, defs.MELEERANGE + 1, slope, damage);

    if (g.linetarget == nil) {
        defs.sound(g, player.mo, info.SFX_SAWFUL);
        ret;
    }
    defs.sound(g, player.mo, info.SFX_SAWHIT);

    # turn to face target
    angle = world.point_to_angle2(player.mo.x, player.mo.y, g.linetarget.x, g.linetarget.y);
    if (angle - player.mo.angle > t.ANG180) {
        if (angle - player.mo.angle < 0 - t.ANG90 / 20) {
            player.mo.angle = angle + t.ANG90 / 21;
        }
        or {
            player.mo.angle = player.mo.angle - t.ANG90 / 20;
        }
    }
    or {
        if (angle - player.mo.angle > t.ANG90 / 20) {
            player.mo.angle = angle - t.ANG90 / 21;
        }
        or {
            player.mo.angle = player.mo.angle + t.ANG90 / 20;
        }
    }
    player.mo.flags = player.mo.flags | defs.MF_JUSTATTACKED;
}

# P_BulletSlope: sets a slope so a near miss is at aproximately the height
# of the intended target
fun bullet_slope(g: *Game, mo: *Mobj) {
    # see which target is to be aimed at
    var an: u32 = mo.angle;
    g.bulletslope = world.aim_line_attack(g, mo, an, 16 * 64 * 65536);

    if (g.linetarget == nil) {
        an            = an + (1 << 26);
        g.bulletslope = world.aim_line_attack(g, mo, an, 16 * 64 * 65536);
        if (g.linetarget == nil) {
            an            = an - (2 << 26);
            g.bulletslope = world.aim_line_attack(g, mo, an, 16 * 64 * 65536);
        }
    }
}

# P_GunShot
fun gun_shot(g: *Game, mo: *Mobj, accurate: bool) {
    val damage: i32 = 5 * (defs.p_random(g) % 3 + 1);
    var angle:  u32 = mo.angle;

    if (!accurate) { angle = angle + (world.sub_random(g) << 18):~u32; }

    world.line_attack(g, mo, angle, defs.MISSILERANGE, g.bulletslope, damage);
}

# A_FirePistol
fun fire_pistol(g: *Game, player: *Player) {
    defs.sound(g, player.mo, info.SFX_PISTOL);

    world.set_mobj_state(g, player.mo, info.S_PLAY_ATK2);
    player.ammo[ammo_of(player)] = player.ammo[ammo_of(player)] - 1;

    world.set_psprite(g, player, defs.PS_FLASH, flash_of(player));

    bullet_slope(g, player.mo);
    gun_shot(g, player.mo, player.refire == 0);
}

# A_FireShotgun
fun fire_shotgun(g: *Game, player: *Player) {
    defs.sound(g, player.mo, info.SFX_SHOTGN);
    world.set_mobj_state(g, player.mo, info.S_PLAY_ATK2);

    player.ammo[ammo_of(player)] = player.ammo[ammo_of(player)] - 1;

    world.set_psprite(g, player, defs.PS_FLASH, flash_of(player));

    bullet_slope(g, player.mo);

    var i: i32 = 0;
    for (i < 7) {
        gun_shot(g, player.mo, 0);
        i = i + 1;
    }
}

# A_FireCGun
fun fire_cgun(g: *Game, player: *Player, psp: *Pspdef) {
    defs.sound(g, player.mo, info.SFX_PISTOL);

    if (player.ammo[ammo_of(player)] == 0) { ret; }

    world.set_mobj_state(g, player.mo, info.S_PLAY_ATK2);
    player.ammo[ammo_of(player)] = player.ammo[ammo_of(player)] - 1;

    world.set_psprite(g, player, defs.PS_FLASH, flash_of(player) + psp.state - info.S_CHAIN1);

    bullet_slope(g, player.mo);
    gun_shot(g, player.mo, player.refire == 0);
}

# run the action a weapon sprite's state names
# ---
# g:      the game
# player: whose weapon
# psp:    the sprite layer entering the state
# action: A_* from the state table
# ret:    false if the action is not a weapon's
pub fun run(g: *Game, player: *Player, psp: *Pspdef, action: i32) bool {
    if (action == info.A_LIGHT0) {
        player.extralight = 0;
    }
    or (action == info.A_LIGHT1) {
        player.extralight = 1;
    }
    or (action == info.A_LIGHT2) {
        player.extralight = 2;
    }
    or (action == info.A_WEAPONREADY) {
        weapon_ready(g, player, psp);
    }
    or (action == info.A_LOWER) {
        lower(g, player, psp);
    }
    or (action == info.A_RAISE) {
        raise(g, player, psp);
    }
    or (action == info.A_PUNCH) {
        punch(g, player);
    }
    or (action == info.A_REFIRE) {
        re_fire(g, player);
    }
    or (action == info.A_FIREPISTOL) {
        fire_pistol(g, player);
    }
    or (action == info.A_FIRESHOTGUN) {
        fire_shotgun(g, player);
    }
    or (action == info.A_FIRECGUN) {
        fire_cgun(g, player, psp);
    }
    or (action == info.A_GUNFLASH) {
        world.set_mobj_state(g, player.mo, info.S_PLAY_ATK2);
        world.set_psprite(g, player, defs.PS_FLASH, flash_of(player));
    }
    or (action == info.A_FIREMISSILE) {
        player.ammo[ammo_of(player)] = player.ammo[ammo_of(player)] - 1;
        world.spawn_player_missile(g, player.mo, info.MT_ROCKET);
    }
    or (action == info.A_SAW) {
        saw(g, player);
    }
    or (action == info.A_FIREPLASMA) {
        player.ammo[ammo_of(player)] = player.ammo[ammo_of(player)] - 1;
        world.set_psprite(g, player, defs.PS_FLASH, flash_of(player) + (defs.p_random(g) & 1));
        world.spawn_player_missile(g, player.mo, info.MT_PLASMA);
    }
    or (action == info.A_BFGSOUND) {
        defs.sound(g, player.mo, info.SFX_BFG);
    }
    or (action == info.A_FIREBFG) {
        player.ammo[ammo_of(player)] = player.ammo[ammo_of(player)] - world.BFGCELLS;
        world.spawn_player_missile(g, player.mo, info.MT_BFG);
    }
    or (action == info.A_CHECKRELOAD) {
        world.check_ammo(g, player);
    }
    or {
        ret 0;
    }
    ret 1;
}
