val VK_RBUTTON: i32 = 0x02;
val VK_SHIFT:   i32 = 0x10;
val VK_CONTROL: i32 = 0x11;
val VK_SPACE:   i32 = 0x20;
val VK_LEFT:    i32 = 0x25;
val VK_UP:      i32 = 0x26;
val VK_RIGHT:   i32 = 0x27;
val VK_DOWN:    i32 = 0x28;

