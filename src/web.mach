val NOW_HEAD:  i32 = 20;
val NOW_SEAT:  i32 = 32 + 1326;
val NOW_BYTES: i32 = 20 + 4 * (32 + 1326) + 1040;

val BOTMAPS: [7]i32 = [7]i32{1, 2, 3, 4, 7, 8, 9};

