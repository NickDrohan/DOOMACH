# the status bar and the message line: health, armour, ammunition, weapons,
# keys and the marine's face, drawn over the bottom of the frame
#
# A reduced port of st_stuff.c, st_lib.c, hu_stuff.c and v_video.c. The
# numbers, keys and weapon slots are placed as the original places them. The
# face is not: the original's face looks toward damage, grins at a new weapon
# and grimaces under fire, and this one only shows how hurt the player is.

use std.types.option.opt;
use std.types.string.str;

use doom.defs;
use doom.defs.Game;
use doom.defs.Player;
use doom.rdata;
use doom.wad;
use doom.world;

val SCREENWIDTH:  i32 = 320;
val SCREENHEIGHT: i32 = 200;

val ST_Y: i32 = 168;

# what the bar remembers between tics
pub rec State {
    # which of the three straight-ahead faces, and tics until it changes
    faceindex: i32;
    facecount: i32;
    # its own walk through a cheap random sequence, so that drawing never
    # draws from the simulation's
    seed: u32;
    # the message on screen and tics until it goes
    message: str;
    msgtics: i32;
    # which of the 14 palettes the screen should be shown through
    palette: i32;
}

fun le16(p: *u8, at: i32) i32 {
    ret ((p[at]::u16 | (p[at + 1]::u16 << 8)):~i16)::i32;
}

fun le32(p: *u8, at: i32) i32 {
    ret (p[at]::u32 | (p[at + 1]::u32 << 8) | (p[at + 2]::u32 << 16) | (p[at + 3]::u32 << 24)):~i32;
}

# a patch lump by name, or nil
fun patch(d: *rdata.Data, name: str) *u8 {
    val found: opt[u32] = wad.find(d.w, name);
    if (sel found.none)                     { ret nil; }
    if (wad.lump(d.w, found.some).size < 8) { ret nil; }
    ret wad.bytes(d.w, found.some);
}

fun width_of(p: *u8) i32 {
    if (p == nil) { ret 0; }
    ret le16(p, 0);
}

# V_DrawPatch: masks a column based masked pic to the screen
# ---
# screen: 320 by 200 palette indices
# x:      where the patch's origin goes
# y:      where the patch's origin goes
# p:      the patch, or nil to draw nothing
fun draw_patch(screen: *u8, x_in: i32, y_in: i32, p: *u8) {
    if (p == nil) { ret; }
    val width: i32 = le16(p, 0);
    val x:     i32 = x_in - le16(p, 4);
    val y:     i32 = y_in - le16(p, 6);

    var col: i32 = 0;
    for (col < width) {
        val sx: i32 = x + col;
        if (sx >= 0 && sx < SCREENWIDTH) {
            # step through the posts in a column
            var at: i32 = le32(p, 8 + col * 4);
            for (p[at] != 0xff) {
                val top:    i32 = y + p[at]::i32;
                val length: i32 = p[at + 1]::i32;
                var k:      i32 = 0;
                for (k < length) {
                    val sy: i32 = top + k;
                    if (sy >= 0 && sy < SCREENHEIGHT) { screen[sy * SCREENWIDTH + sx] = p[at + 3 + k]; }
                    k = k + 1;
                }
                at = at + length + 4;
            }
        }
        col = col + 1;
    }
}

# a lump name made of a prefix and a decimal digit
fun digit_patch(d: *rdata.Data, prefix: str, digit: i32) *u8 {
    var name: [9]u8;
    var k:    i32 = 0;
    for (prefix[k] != 0 && k < 7) {
        name[k] = prefix[k];
        k       = k + 1;
    }
    name[k] = ('0' + digit)::u8;
    ret patch(d, ?name[0]);
}

# STlib_drawNum: a number, right-justified with its last digit ending at x
fun draw_num(d: *rdata.Data, screen: *u8, x_in: i32, y: i32, value: i32, digits: i32, prefix: str) {
    # 1994 means "nothing to show", as for a weapon that uses no ammunition
    if (value == 1994) { ret; }

    var num: i32 = value;
    if (num < 0) { num = 0; }

    val w: i32 = width_of(digit_patch(d, prefix, 0));
    var x: i32 = x_in;

    # in the special case of 0, you draw 0
    if (num == 0) {
        draw_patch(screen, x - w, y, digit_patch(d, prefix, 0));
        ret;
    }

    # draw the new number
    var left: i32 = digits;
    for (num != 0 && left > 0) {
        x = x - w;
        draw_patch(screen, x, y, digit_patch(d, prefix, num % 10));
        num  = num / 10;
        left = left - 1;
    }
}

# the next number of the bar's own sequence
fun st_random(st: *State) i32 {
    st.seed = st.seed * 1103515245 + 12345;
    ret ((st.seed >> 16) & 0xff)::i32;
}

# ST_Ticker: once a tic, age the face and the message, pick the palette
pub fun ticker(g: *Game, st: *State) {
    val player: *Player = ?g.players[g.consoleplayer];

    st.facecount = st.facecount - 1;
    if (st.facecount <= 0) {
        st.faceindex = st_random(st) % 3;
        st.facecount = defs.TICRATE / 2;
    }

    # a new message replaces the old and starts its time again
    if (player.message != nil) {
        st.message     = player.message;
        st.msgtics     = 4 * defs.TICRATE;
        player.message = nil;
    }
    or (st.msgtics > 0) {
        st.msgtics = st.msgtics - 1;
    }

    # ST_doPaletteStuff: red for damage, gold for a pickup, green for the
    # radiation suit
    var cnt: i32 = player.damagecount;
    if (player.powers[defs.PW_STRENGTH] != 0) {
        # slowly fade the berzerk out
        val bzc: i32 = 12 - (player.powers[defs.PW_STRENGTH] >> 6);
        if (bzc > cnt) { cnt = bzc; }
    }

    if (cnt != 0) {
        var palette: i32 = (cnt + 7) >> 3;
        if (palette >= 8) { palette = 7; }
        st.palette = palette + 1;
    }
    or (player.bonuscount != 0) {
        var palette: i32 = (player.bonuscount + 7) >> 3;
        if (palette >= 4) { palette = 3; }
        st.palette = palette + 9;
    }
    or (player.powers[defs.PW_IRONFEET] > 4 * 32 || (player.powers[defs.PW_IRONFEET] & 8) != 0) {
        st.palette = 13;
    }
    or {
        st.palette = 0;
    }
}

# the message line, in the game's small font
fun draw_message(d: *rdata.Data, screen: *u8, text: str) {
    var x: i32 = 0;
    var i: i32 = 0;
    for (text[i] != 0) {
        var c: i32 = text[i]::i32;
        if (c >= 'a' && c <= 'z') { c = c - 32; }
        i = i + 1;

        if (c < 33 || c > 95) {
            # a space, or something the font has no picture of
            x = x + 4;
            cnt;
        }

        var name: [9]u8 = [9]u8{'S', 'T', 'C', 'F', 'N', '0', '0', '0', 0};
        name[5] = ('0' + c / 100)::u8;
        name[6] = ('0' + (c / 10) % 10)::u8;
        name[7] = ('0' + c % 10)::u8;
        val p: *u8 = patch(d, ?name[0]);
        if (p == nil)                      { cnt; }
        if (x + width_of(p) > SCREENWIDTH) { brk; }
        draw_patch(screen, x, 0, p);
        x = x + width_of(p);
    }
}

# ST_Drawer: draw the bar and the message over a finished frame
# ---
# g:      the game
# st:     the bar's state
# screen: 320 by 200 palette indices, with the view already drawn
pub fun draw(g: *Game, st: *State, screen: *u8) {
    val d:      *rdata.Data = g.d;
    val player: *Player     = ?g.players[g.consoleplayer];

    # the bar itself, and the panel of weapon numbers that covers the frag
    # count of a deathmatch
    draw_patch(screen, 0, ST_Y, patch(d, "STBAR"));
    draw_patch(screen, 104, ST_Y, patch(d, "STARMS"));

    # ready weapon ammo
    var ready: i32 = 1994;
    val ammo:  i32 = world.weaponinfo(player.readyweapon, world.WI_AMMO);
    if (ammo != defs.AM_NOAMMO) { ready = player.ammo[ammo]; }
    draw_num(d, screen, 44, 171, ready, 3, "STTNUM");

    # health and armor percentages
    draw_num(d, screen, 90, 171, player.health, 3, "STTNUM");
    draw_patch(screen, 90, 171, patch(d, "STTPRCNT"));
    draw_num(d, screen, 221, 171, player.armorpoints, 3, "STTNUM");
    draw_patch(screen, 221, 171, patch(d, "STTPRCNT"));

    # weapons owned: slots 2 to 7, yellow when held and grey when not
    var i: i32 = 0;
    for (i < 6) {
        val x: i32 = 111 + (i % 3) * 12;
        val y: i32 = 172 + (i / 3) * 10;
        if (player.weaponowned[i + 1]) {
            draw_patch(screen, x, y, digit_patch(d, "STYSNUM", i + 2));
        }
        or {
            draw_patch(screen, x, y, digit_patch(d, "STGNUM", i + 2));
        }
        i = i + 1;
    }

    # the face: one of five levels of hurt, or dead
    if (player.health <= 0) {
        draw_patch(screen, 143, ST_Y, patch(d, "STFDEAD0"));
    }
    or ((player.cheats & defs.CF_GODMODE) != 0 || player.powers[defs.PW_INVULNERABILITY] != 0) {
        draw_patch(screen, 143, ST_Y, patch(d, "STFGOD0"));
    }
    or {
        var health: i32 = player.health;
        if (health > 100) { health = 100; }
        var name: [9]u8 = [9]u8{'S', 'T', 'F', 'S', 'T', '0', '0', 0, 0};
        name[5] = ('0' + ((100 - health) * 5) / 101)::u8;
        name[6] = ('0' + st.faceindex)::u8;
        draw_patch(screen, 143, ST_Y, patch(d, ?name[0]));
    }

    # keys: a card or, failing that, a skull of each colour
    i = 0;
    for (i < 3) {
        var key: i32 = -1;
        if (player.cards[i])     { key = i; }
        if (player.cards[i + 3]) { key = i + 3; }
        if (key >= 0)            { draw_patch(screen, 239, 171 + i * 10, digit_patch(d, "STKEYS", key)); }
        i = i + 1;
    }

    # ammunition held and the most that can be: bullets, shells, rockets,
    # cells down the right of the bar
    draw_num(d, screen, 288, 173, player.ammo[defs.AM_CLIP], 3, "STYSNUM");
    draw_num(d, screen, 288, 179, player.ammo[defs.AM_SHELL], 3, "STYSNUM");
    draw_num(d, screen, 288, 191, player.ammo[defs.AM_CELL], 3, "STYSNUM");
    draw_num(d, screen, 288, 185, player.ammo[defs.AM_MISL], 3, "STYSNUM");
    draw_num(d, screen, 314, 173, player.maxammo[defs.AM_CLIP], 3, "STYSNUM");
    draw_num(d, screen, 314, 179, player.maxammo[defs.AM_SHELL], 3, "STYSNUM");
    draw_num(d, screen, 314, 191, player.maxammo[defs.AM_CELL], 3, "STYSNUM");
    draw_num(d, screen, 314, 185, player.maxammo[defs.AM_MISL], 3, "STYSNUM");

    if (st.msgtics > 0 && st.message != nil) { draw_message(d, screen, st.message); }
}
