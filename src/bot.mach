# bot: players the simulation plays itself
#
# A bot is a player whose commands are computed from the world rather than
# read from a keyboard. It is part of the simulation, as a monster is: in a
# network game every machine computes the same bot's same command from the
# same world, so nothing about a bot crosses the network. That holds only
# because everything here is integer arithmetic over the shared game state
# and the bot's own seeded sequence; nothing local to one machine may be
# read.
#
# Every fourth tic a bot senses: how far it can go along eight rays, the
# nearest enemy it can see, the way through the map's sectors toward the
# nearest opponent, its own state, the nearest pickup. From those 32
# numbers it decides: forward, sideways, turn, fire, use, change weapon. Two
# things can decide. The script is a hand-written fighter, a function of the
# senses alone. The net is a small integer network, 32 inputs to 24 hidden
# units to 6 outputs, in eight-bit weights: 942 bytes, which is what makes a
# bot something to send to another machine, to mutate, and to keep a
# hundred of. A net that imitates the script is where every bot begins.

use std.types.bool.bool;
use std.types.size.usize;

use doom.defs;
use doom.defs.Game;
use doom.defs.Mobj;
use doom.defs.Player;
use doom.defs.Ticcmd;
use doom.fixed;
use doom.fixed.Fixed;
use doom.info;
use doom.level;
use doom.maputl;
use doom.movers;
use doom.render;
use t: doom.tables;
use doom.world;

pub val INPUTS:  i32 = 32;
pub val HIDDEN:  i32 = 24;
pub val OUTPUTS: i32 = 6;
# input weights, hidden biases, output weights, output biases
pub val NETSIZE: i32 = 32 * 24 + 24 + 24 * 6 + 6;

pub val KIND_SCRIPT: i32 = 1;
pub val KIND_NET:    i32 = 2;

# traits, added to a kind: what a bot is like whatever decides for it.
# A brawler fights with its fists and nothing else. A shy bot does not fight
# at all: it stays behind the nearest person, and runs to get out of sight
# whenever they turn to look.
pub val TRAIT_FISTS: i32 = 0x100;
pub val TRAIT_SHY:   i32 = 0x200;

# A bot's kind carries two more things, in the bits above its traits, so
# that they go wherever a bot is described: a quirk, and how it feels about
# each of the other three players in its game.
#
# A quirk is a turn of character, three bits from bit 10:
pub val QUIRK_SHIFT:    i32 = 10;
pub val QUIRK_NONE:     i32 = 0;
# keeps out of the way of dying: hurt, it backs off from a fight
pub val QUIRK_CAUTIOUS: i32 = 1;
# dying is a way of getting on: hurt, it charges; slime is a short cut
pub val QUIRK_RECKLESS: i32 = 2;
# stays with its friend
pub val QUIRK_LOYAL:    i32 = 3;
# feels everything three times as strongly (the league's business: here it
# changes nothing)
pub val QUIRK_GRUDGE:   i32 = 4;
#
# A feeling is 0 (enemy) to 100 (friend), 50 for nothing either way: six
# bits for each of the other players, lowest seat first, from bit 13. Each
# holds the feeling halved, plus one; nothing there at all means 50, so that
# a kind that says nothing of feelings is a bot with none.
pub val FEEL_SHIFT: i32 = 13;

# the bits for a feeling of 0 to 100 toward the nth other player (0 to 2)
pub fun feel_bits(nth: i32, feeling: i32) i32 {
    ret (clamp(feeling, 0, 100) / 2 + 1) << (FEEL_SHIFT + nth * 6);
}

# the senses, by index
pub val F_RAYS:      i32 = 0;
pub val F_SEEN:      i32 = 8;
pub val F_BEARING:   i32 = 9;
pub val F_CLOSE:     i32 = 10;
pub val F_FACED:     i32 = 11;
pub val F_SINCE:     i32 = 12;
pub val F_LASTBEAR:  i32 = 13;
pub val F_HEALTH:    i32 = 14;
pub val F_PATH:      i32 = 15;
pub val F_AMMO:      i32 = 16;
pub val F_WEAPON:    i32 = 17;
pub val F_HURT:      i32 = 22;
pub val F_HURTBEAR:  i32 = 23;
pub val F_ITEM:      i32 = 24;
pub val F_ITEMBEAR:  i32 = 25;
pub val F_ITEMCLOSE: i32 = 26;
pub val F_STUCK:     i32 = 27;
pub val F_PHASE:     i32 = 28;
pub val F_NOISE:     i32 = 29;
pub val F_WAY:       i32 = 30;
pub val F_BETTER:    i32 = 31;

# the decisions, by index
pub val O_FORWARD: i32 = 0;
pub val O_SIDE:    i32 = 1;
pub val O_TURN:    i32 = 2;
pub val O_FIRE:    i32 = 3;
pub val O_USE:     i32 = 4;
pub val O_SWITCH:  i32 = 5;

# a bot's reflexes: tics between presses of use, five seconds, and how far
# use reaches; and how close
# (as the sense has it, 127 less a sixteenth of the distance) an enemy must
# be for a fist to reach, about eighty units
val USE_WAIT:    i32 = 175;
val USE_REACH:   i32 = 64;
val MELEE_CLOSE: i32 = 122;

val RAYS:     i32   = 8;
val RAYRANGE: i32   = 1024;
val STEP:     Fixed = 24 * 65536;
val TALL:     Fixed = 56 * 65536;

# the rays' directions from straight ahead, in 256ths of a turn: ahead, 30
# and 60 degrees to each side, both sides, and behind
val RAYTURN: [8]i32 = [8]i32{0, 21, -21, 43, -43, 64, -64, 128};

pub rec Bot {
    active: bool;
    kind:   i32;
    fists:  bool;
    shy:    bool;
    # its quirk (QUIRK_*), and its feelings as its kind carried them
    quirk:  i32;
    feels:  i32;
    net:    [942]i8;
    seed:   u32;

    # what it last sensed and decided
    feat: [32]i32;
    out:  [6]i32;

    # what the senses remember between looks: tics since an enemy was seen
    # and where; where it stood a second ago, and for how long it has not
    # moved from there
    since:    i32;
    lastbear: i32;
    wasx:     Fixed;
    wasy:     Fixed;
    stuck:    i32;
    # the place it is making for on the way to an opponent, if it has one
    haveway:  bool;
    wayx:     Fixed;
    wayy:     Fixed;
    # whether it has closed with the enemy in sight: what it has closed
    # with it fights out to the end of sight, what it is passing by stays
    # passed — the line between fighting and passing must not flutter
    engaged:  bool;
    # pressing on without getting anywhere: where it stood eight tics
    # ago, how many such checks in a row it barely moved, and a slide
    # along the wall in progress (tics left, and which way)
    pressx:   Fixed;
    pressy:   Fixed;
    pressed:  i32;
    slide:    i32;
    slidedir: i32;
    # the cells it last caught on, and until when its searches go round
    # them: what the map's lines do not show, a pillar or a crowd
    snag:     [4]i32;
    snagtill: [4]i32;
    nsnag:    i32;

    # tics until it may press use again, and whether there is something
    # within reach ahead to use
    usewait: i32;
    usable:  bool;

    # how far from the exit it began the level, and the nearest it has been
    goalserial: i32;
    goalstart:  i32;
    goalbest:   i32;
    # it follows nobody and plays the level: the secret it is making for or
    # -1, since when, the secrets it has given up on (a bit each), and the
    # keys it had when it gave up on them
    alone:     bool;
    # there is a person in its co-op game, whom it follows: the level is
    # theirs to end
    led:       bool;
    want:      i32;
    wantsince: i32;
    gaveup:    u32;
    gavekeys:  i32;
    # and how often each has had to be given up: SECRET_TRIES of those and
    # the secret counts as out of reach, until a new key may open the way
    struck:    [32]u8;
    # the nearest it has been to the secret it is making for
    wantbest: i32;
    # the key it has set out for, by where it lies, and until when it keeps
    # to that one rather than change its mind with every step
    keyx:     Fixed;
    keyy:     Fixed;
    keyuntil: i32;
    # a goal that is no secret — a monster, a key, a friend — by where it
    # lay, since when it has been after it, and the nearest it has been to
    # it; and the place it has given up on, and until when
    gox:      Fixed;
    goy:      Fixed;
    gosince:  i32;
    gobest:   i32;
    gavex:    Fixed;
    gavey:    Fixed;
    gavetill: i32;
    # working what is in the way, at each depth of solving: the line in the
    # way, which of the lines that work it is being tried, and since when
    actblock: [3]i32;
    acttry:   [3]i32;
    actsince: [3]i32;
    # what is within reach ahead to use is the switch that ends the level
    useexit: bool;
    # its way was found only by going through what hurts or what there is
    # no way back out of: it has chosen to wade, and is not held back
    wades: bool;
    # for whoever is watching it think: what it is after (1 a secret, 3
    # the exit, 4 a key, 5 a friend), the place it is going for that, and
    # how many things it must work first to get there
    after:  i32;
    afterx: Fixed;
    aftery: Fixed;
    works:  i32;
    # and the lines its last search went round
    bans:  [6]i32;
    nbans: i32;

    # what it has done, for whoever scores it
    shots:  i32;
    turned: i32;
    uses:   i32;
    # how it last turned, and how often its turning has changed sides: what
    # watching through its eyes is like
    wasturn: i32;
    swings:  i32;

    # what a net learns by: the last eight things it decided (the senses it
    # had and what it made of them), the newest where tpos less one says,
    # so that what happens to it next can be laid at their door; and the
    # numbers a tic ago said the world gave it, for what has changed since
    tfeat:   [256]i32;
    tout:    [48]i32;
    tpos:    i32;
    tn:      i32;
    wstate:  i32;
    whealth: i32;
    wkills:  i32;
    wsecret: i32;
    wkeys:   i32;
    warmed:  i32;
    primed:  bool;
}

fun clamp(v: i32, lo: i32, hi: i32) i32 {
    if (v < lo) { ret lo; }
    if (v > hi) { ret hi; }
    ret v;
}

fun next_random(b: *Bot) i32 {
    b.seed = b.seed * 1103515245 + 12345;
    ret ((b.seed >> 16) & 0xff)::i32;
}

# a direction relative to where a thing faces, in 256ths of a turn, -128 to
# 127; positive is to its left
fun bearing(from: *Mobj, x: Fixed, y: Fixed) i32 {
    val rel: u32 = world.point_to_angle2(from.x, from.y, x, y) - from.angle;
    ret (((rel >> 24)::i32) ^ 0x80) - 0x80;
}

fun distance(a: *Mobj, x: Fixed, y: Fixed) i32 {
    ret maputl.aprox_distance(x - a.x, y - a.y) >> 16;
}

# ------------------------------------------------------------------ the rays

# how far along the ray the first thing a player could not pass is, as the
# traverser leaves it; and the floor the ray started from
var rayfrac:  Fixed;
var rayfloor: Fixed;
# and the line that stopped it, or -1
var rayline:  i32;

fun ray_stops(g: *Game, in: *defs.Intercept) bool {
    if (!in.isaline) { ret 1; }
    val line: *level.Line = ?g.lv.lines[in.line];
    var blocked: bool = (line.flags::i32 & defs.ML_TWOSIDED) == 0 || (line.flags::i32 & defs.ML_BLOCKING) != 0;
    if (!blocked) {
        # a gap too low to walk through, or a step too high to climb
        maputl.line_opening(g, in.line);
        blocked = g.openrange < TALL || g.openbottom - rayfloor > STEP;
    }
    if (blocked) {
        rayfrac = in.frac;
        rayline = in.line;
        ret 0;
    }
    ret 1;
}

# how far a player could walk from a thing in a direction, up to RAYRANGE
fun ray(g: *Game, mo: *Mobj, turn: i32) i32 {
    val an: u32   = (mo.angle + (turn:~u32 << 24)) >> t.ANGLETOFINESHIFT;
    val x2: Fixed = mo.x + RAYRANGE * t.FINESINE[an + 2048];
    val y2: Fixed = mo.y + RAYRANGE * t.FINESINE[an];
    rayfrac  = 65536;
    rayline  = -1;
    rayfloor = mo.floorz;
    maputl.path_traverse(g, mo.x, mo.y, x2, y2, defs.PT_ADDLINES, ray_stops);
    ret fixed.mul(rayfrac, RAYRANGE << 16) >> 16;
}

# ---------------------------------------------------------------- the senses

# how a bot in a seat feels about the player in another: 0 to 100
fun feeling(b: *Bot, seat: i32, other: i32) i32 {
    var nth: i32 = other;
    if (other > seat) { nth = other - 1; }
    val bits: i32 = (b.feels >> (nth * 6)) & 63;
    if (bits == 0 || other == seat) { ret 50; }
    ret (bits - 1) * 2;
}

# In a deathmatch a feeling this low is hatred: the bot hunts that player,
# wherever they are, before anyone nearer.
val HUNTED: i32 = 25;

# how a bot feels about an opponent in a deathmatch: never better than 50,
# whatever is written, for there are no friends there
fun dislike(g: *Game, b: *Bot, seat: i32, other: i32) i32 {
    val felt: i32 = feeling(b, seat, other);
    if (felt > 50) { ret 50; }
    ret felt;
}

# how a bot regards another player: as it feels, but a person in co-op is
# always a friend, whatever any bot has come to feel about anyone
fun regard(g: *Game, b: *Bot, seat: i32, other: i32) i32 {
    if (g.deathmatch == 0 && !g.isbot[other]) { ret 100; }
    ret feeling(b, seat, other);
}

# whether a monster is after a person: its target is one
fun hunts_a_person(g: *Game, mo: *Mobj) bool {
    if (mo.target == nil) { ret 0; }
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        if (g.playeringame[i] && !g.isbot[i] && g.players[i].mo == mo.target) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# whether a place is within 512 units of a living person
fun by_a_person(g: *Game, x: Fixed, y: Fixed) bool {
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        val o: *Mobj = g.players[i].mo;
        if (g.playeringame[i] && !g.isbot[i] && o != nil && o.health > 0 && distance(o, x, y) < 512) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# the nearest living thing a bot should fight that it can see: the other
# players in a deathmatch, the monsters otherwise. There are no friends in
# a deathmatch, only enemies, and some more than others: near is as it
# feels, so that the less a bot likes another the nearer it seems, down to
# half as far for one it merely dislikes; and one it has come to hate (see
# HUNTED) seems a tenth as far, which is to say that if it can see that one
# it shoots at that one.
fun find_enemy(g: *Game, me: *Mobj, b: *Bot, seat: i32) *Mobj {
    var best:     *Mobj = nil;
    var bestdist: i32   = 0x7fffffff;

    if (g.deathmatch != 0) {
        var i: i32 = 0;
        for (i < defs.MAXPLAYERS) {
            val o: *Mobj = g.players[i].mo;
            if (g.playeringame[i] && o != nil && o != me && o.health > 0) {
                val felt: i32 = dislike(g, b, seat, i);
                var d:    i32 = distance(me, o.x, o.y) * (50 + felt) / 100;
                if (felt < HUNTED) { d = d / 5; }
                if (d < bestdist && maputl.check_sight(g, me, o)) {
                    best     = o;
                    bestdist = d;
                }
            }
            i = i + 1;
        }
        ret best;
    }

    # monsters: the four nearest within reach, then the nearest of those in
    # sight, so that sight is tested four times at most. With a person in
    # the game near is as it matters to them: a monster that is after a
    # person counts as a quarter as far off as it is, and one that is merely
    # near a person as half, so that a bot shoots what threatens its people
    # before what threatens itself.
    var near:  [4]*Mobj;
    var dists: [4]i32 = [4]i32{0x7fffffff, 0x7fffffff, 0x7fffffff, 0x7fffffff};
    var th: *defs.Thinker = g.thinkercap.next;
    for (th != ?g.thinkercap) {
        if (th.kind == defs.TH_MOBJ) {
            val mo: *Mobj = th:~*Mobj;
            if ((mo.flags & defs.MF_COUNTKILL) != 0 && mo.health > 0) {
                var d: i32   = distance(me, mo.x, mo.y);
                var m: *Mobj = mo;
                if (d < 1536) {
                    if (hunts_a_person(g, mo)) {
                        d = d / 4;
                    }
                    or (by_a_person(g, mo.x, mo.y)) {
                        d = d / 2;
                    }
                    # insert into the four, nearest first
                    var k: i32 = 0;
                    for (k < 4) {
                        if (d < dists[k]) {
                            val td: i32   = dists[k];
                            val tm: *Mobj = near[k];
                            dists[k] = d;
                            near[k]  = m;
                            d        = td;
                            m        = tm;
                        }
                        k = k + 1;
                    }
                }
            }
        }
        th = th.next;
    }
    var k: i32 = 0;
    for (k < 4) {
        if (near[k] != nil && dists[k] != 0x7fffffff && maputl.check_sight(g, me, near[k])) { ret near[k]; }
        k = k + 1;
    }
    ret nil;
}

# whether a player walking onto a thing would pick it up: not health when
# whole, armour when armoured, ammunition when full, a key already had, or,
# where weapons stay for the others (co-op), a weapon already owned. A bot
# that made for such a thing stood on it and went nowhere.
fun takes(g: *Game, p: *Player, mo: *Mobj) bool {
    val sprite: i32 = mo.sprite;
    # nor what it is leaving for a person nearby
    if (world.left_for_people(g, mo, world.player_number(g, p))) { ret 0; }
    if (sprite == info.SPR_STIM || sprite == info.SPR_MEDI) { ret p.health < 100; }
    if (sprite == info.SPR_ARM1)                            { ret p.armorpoints < 100; }
    if (sprite == info.SPR_ARM2)                            { ret p.armorpoints < 200; }
    if (sprite == info.SPR_CLIP || sprite == info.SPR_AMMO) { ret p.ammo[defs.AM_CLIP] < p.maxammo[defs.AM_CLIP]; }
    if (sprite == info.SPR_SHEL || sprite == info.SPR_SBOX) { ret p.ammo[defs.AM_SHELL] < p.maxammo[defs.AM_SHELL]; }
    if (sprite == info.SPR_ROCK || sprite == info.SPR_BROK) { ret p.ammo[defs.AM_MISL] < p.maxammo[defs.AM_MISL]; }
    if (sprite == info.SPR_BKEY)                            { ret !p.cards[defs.IT_BLUECARD]; }
    if (sprite == info.SPR_YKEY)                            { ret !p.cards[defs.IT_YELLOWCARD]; }
    if (sprite == info.SPR_RKEY)                            { ret !p.cards[defs.IT_REDCARD]; }
    if (g.netgame && g.deathmatch != 2) {
        if (sprite == info.SPR_SHOT) { ret !p.weaponowned[defs.WP_SHOTGUN]; }
        if (sprite == info.SPR_MGUN) { ret !p.weaponowned[defs.WP_CHAINGUN]; }
        if (sprite == info.SPR_LAUN) { ret !p.weaponowned[defs.WP_MISSILE]; }
        if (sprite == info.SPR_CSAW) { ret !p.weaponowned[defs.WP_CHAINSAW]; }
        if (sprite == info.SPR_PLAS) { ret !p.weaponowned[defs.WP_PLASMA]; }
        if (sprite == info.SPR_BFUG) { ret !p.weaponowned[defs.WP_BFG]; }
    }
    ret 1;
}

# what a thing on the floor is worth going for, beside how far off it is.
# A weapon it does not have outbids everything but a hurt worse; then a
# powerup, and the spheres that heal over the top; then health, the more
# the worse it is hurt; then armour; then ammunition; and whatever else
# is picked up is picked up on the way, not gone out of the way for.
fun worth(g: *Game, p: *Player, mo: *Mobj) i32 {
    val sprite: i32 = mo.sprite;
    if (g.netgame && g.deathmatch != 2) {
        if (sprite == info.SPR_SHOT || sprite == info.SPR_MGUN || sprite == info.SPR_LAUN ||
            sprite == info.SPR_CSAW || sprite == info.SPR_PLAS || sprite == info.SPR_BFUG) { ret 300; }
    }
    if (sprite == info.SPR_STIM || sprite == info.SPR_MEDI || sprite == info.SPR_BON1) {
        if (p.health < 40) { ret 290; }
        if (p.health < 75) { ret 160; }
        ret 70;
    }
    if (sprite == info.SPR_SOUL || sprite == info.SPR_MEGA || sprite == info.SPR_PINV ||
        sprite == info.SPR_PINS || sprite == info.SPR_PSTR || sprite == info.SPR_SUIT ||
        sprite == info.SPR_PMAP || sprite == info.SPR_PVIS) { ret 260; }
    if (sprite == info.SPR_ARM1 || sprite == info.SPR_ARM2 || sprite == info.SPR_BON2) { ret 140; }
    if (sprite == info.SPR_CLIP || sprite == info.SPR_AMMO || sprite == info.SPR_SHEL ||
        sprite == info.SPR_SBOX || sprite == info.SPR_ROCK || sprite == info.SPR_BROK) { ret 110; }
    ret 90;
}

# the best thing to pick up it would take, can see and can walk to: the
# most it is worth less the walk, not merely the nearest — a clip at its
# feet does not beat the shotgun across the room
fun find_item(g: *Game, p: *Player) *Mobj {
    val me: *Mobj = p.mo;
    var best:      *Mobj = nil;
    var bestscore: i32   = 0;
    var th: *defs.Thinker = g.thinkercap.next;
    for (th != ?g.thinkercap) {
        if (th.kind == defs.TH_MOBJ) {
            val mo: *Mobj = th:~*Mobj;
            if ((mo.flags & defs.MF_SPECIAL) != 0) {
                val score: i32 = worth(g, p, mo) * 8 - distance(me, mo.x, mo.y);
                if (score > bestscore && takes(g, p, mo) && !lost(g, mo.x, mo.y)) {
                    best      = mo;
                    bestscore = score;
                }
            }
        }
        th = th.next;
    }
    if (best != nil && !maputl.check_sight(g, me, best)) { ret nil; }
    # and can walk straight to: something seen through a window or up on a
    # ledge is not there for the taking, and a bot that made for it stood
    # and stared
    if (best != nil && !can_walk(g, me.x, me.y, best.x, best.y)) { ret nil; }
    ret best;
}

# -------------------------------------------------------------- the walk grid

# The map as cells 32 units square, built once a level. A cell's byte says
# which of its four neighbours a player could walk to from its middle: no
# wall or blocking line between, room to stand, no step up of more than a
# stride. A line that does something (a door, a lift) is taken to open.
pub val CELL:  i32 = 32;
val EAST:  i32 = 1;
val NORTH: i32 = 2;
val WEST:  i32 = 4;
val SOUTH: i32 = 8;
val MAXCELLS: i32 = 65536;

# where the walk being tested ends, for telling which side of a line is the
# far one
var walkx: Fixed;
var walky: Fixed;
# The searches' working room, a number a cell. Here and not on the stack: a
# search is called from deep inside a tic, and four such arrays are most of
# a megabyte. Nothing here is kept from one search to the next.
var fieldqueue: [65536]u16;
var floodqueue: [65536]u16;
var reachqueue: [65536]u16;
var wayqueue:   [65536]u16;
var waystep:    [65536]u8;
# a co-op search weighs its steps: what each cell has cost to reach, and a
# heap of cells still to look at, the cost in the high half
var waycost:    [65536]u16;
# which search last touched a cell: a cell another search left is unvisited,
# so the cells need not all be cleared before every search
var waymark:    [65536]u16;
var wayepoch:   u16;
# the cells one co-op decision's searches have looked at: past SOLVE_WORK it
# stops working through doors and switches and takes what it has on trust.
# Where a goal lies behind something nothing opens, as E1M8's exit behind
# its barons' wall does, every door between was otherwise worked through
# again on every decision, the whole map flooded each time
var solvework: i32;
val SOLVE_WORK: i32 = 150000;
# what a step taken on trust looked like as the level stood, remembered for
# the rest of the tic: many searches in a tic ask about the same few steps
var trustnow:   [262144]u8;
var truststamp: [262144]u32;
var wayheap:    [262144]u32;
var nheap:      i32;

# the keys whoever is walking has, a bit a colour; and the keys the doors
# the walk went through needed
var walkhave: i32;
var walkitem: *Mobj;
var walkkey:  i32;
# a strict test asks whether the walk can be made as the level stands this
# tic, doors shut and lifts wherever they are; and notes the line that
# stopped it
var walkstrict: bool;
var walkblock:  i32;
# and a walk tested the easy way notes the line it took on trust
var walktrust: i32;

# the tags of the sectors a level ends in (special 11): a teleport that
# lands on one is crossed as a way out, the same as a line that ends the
# level when walked over
var navendtags: [8]i32;
var nendtags:   i32;

# lines a bot solving its way has found shut with nothing to open them from
# where it would come: its search goes round them
var banned:  [16]i32;
var nbanned: i32;
# the search is only going round what is shut, not to what opens it
var detour: bool;
# the search keeps out of harm: it will not step into a cell whose floor
# hurts, nor into one there is no way from to the level's exit
var careful: bool;

# a cell's floor hurts whoever stands on it: marked in the cell's navout byte
val HURTS: i32 = 0x10;
# a cell a player's body barely fits: a wall or a ledge within a stride of
# its middle, where a bot walking the middle catches its shoulder; and a
# cell beside one whose floor hurts, where a sidestep is a step into it
val NEAR:     i32 = 0x20;
val NEARHURT: i32 = 0x40;
# a cell a solid thing stands in or beside: a pillar, a lamp, a barrel
val THING:    i32 = 0x80;

# what stepping into a cell costs a co-op search: a cell of open floor 4;
# against a wall or beside slime more; slime itself a great deal, so that a
# way that must wade wades the least it can
fun step_cost(g: *Game, cell: i32) i32 {
    val out: i32 = g.navout[cell]::i32;
    var cost: i32 = 4;
    if ((out & NEAR) != 0)     { cost = cost + 5; }
    if ((out & NEARHURT) != 0) { cost = cost + 4; }
    if ((out & HURTS) != 0)    { cost = cost + 40; }
    if ((out & THING) != 0)    { cost = cost + 30; }
    ret cost;
}

# and for one bot, a cell it caught on lately costs a great deal more
fun snag_cost(g: *Game, b: *Bot, cell: i32) i32 {
    var i: i32 = 0;
    for (i < 4) {
        if (b.snag[i] == cell && b.snagtill[i] > g.leveltime) { ret 120; }
        i = i + 1;
    }
    ret 0;
}

# the least the walk from a cell to the bot's could cost
fun guess(cell: i32, mex: i32, mey: i32, w: i32) i32 {
    var dx: i32 = cell % w - mex;
    var dy: i32 = cell / w - mey;
    if (dx < 0) { dx = -dx; }
    if (dy < 0) { dy = -dy; }
    var d: i32 = dx + dy - 1;
    if (d < 0) { d = 0; }
    ret d * 4;
}

fun open_now(g: *Game, cell: i32, way: i32, to: i32) bool {
    val at: i32 = cell * 4 + way_index(way);
    val stamp: u32 = ((g.levelserial::u32) << 20) ^ (g.leveltime::u32) ^ 0x80000000;
    if (truststamp[at] != stamp) {
        truststamp[at] = stamp;
        trustnow[at] = 2;
        if (walks_now(g, cell_x(g, cell % g.navw), cell_y(g, cell / g.navw), cell_x(g, to % g.navw), cell_y(g, to / g.navw))) { trustnow[at] = 1; }
    }
    ret trustnow[at] == 1;
}

fun new_search() {
    if (wayepoch == 0xffff) {
        var i: i32 = 0;
        for (i < 65536) {
            waymark[i] = 0;
            i = i + 1;
        }
        wayepoch = 0;
    }
    wayepoch = wayepoch + 1;
}

# what a search knows of a cell: the way out of it it found (16 at an end of
# the walk, 0 if it has not reached it), and what reaching it cost
fun step_of(cell: i32) i32 {
    if (waymark[cell] != wayepoch) { ret 0; }
    ret waystep[cell]::i32;
}

fun cost_of(cell: i32) i32 {
    if (waymark[cell] != wayepoch) { ret 0xffff; }
    ret waycost[cell]::i32;
}

fun set_step(cell: i32, way: i32, cost: i32) {
    waymark[cell] = wayepoch;
    waystep[cell] = way::u8;
    waycost[cell] = cost::u16;
}

fun heap_push(key: u32) {
    if (nheap >= 262144) { ret; }
    var at: i32 = nheap;
    nheap = nheap + 1;
    for (at > 0) {
        val up: i32 = (at - 1) / 2;
        if (wayheap[up] <= key) { brk; }
        wayheap[at] = wayheap[up];
        at = up;
    }
    wayheap[at] = key;
}

fun heap_pop() u32 {
    val top: u32 = wayheap[0];
    nheap = nheap - 1;
    val last: u32 = wayheap[nheap];
    var at: i32 = 0;
    for {
        var child: i32 = at * 2 + 1;
        if (child >= nheap) { brk; }
        if (child + 1 < nheap && wayheap[child + 1] < wayheap[child]) { child = child + 1; }
        if (last <= wayheap[child]) { brk; }
        wayheap[at] = wayheap[child];
        at = child;
    }
    if (nheap > 0) { wayheap[at] = last; }
    ret top;
}

# whether a player's body, not just its middle, can walk from one place to
# another: the middle's walk and, on each side where there is room to stand
# at all, the walk of a shoulder fourteen units out
fun body_walk(g: *Game, x1: Fixed, y1: Fixed, x2: Fixed, y2: Fixed) bool {
    if (!can_walk(g, x1, y1, x2, y2)) { ret 0; }
    # and no short cut across slime the way itself goes round: the middle
    # of the body is what the floor hurts, every eight units of the walk
    if (!floor_hurts(g.lv.sectors[sector_at(g, x2, y2)].special::i32)) {
        var len0: i32 = maputl.aprox_distance(x2 - x1, y2 - y1) >> 16;
        var n: i32 = len0 / 8;
        var k: i32 = 1;
        for (k < n) {
            val px: Fixed = x1 + ((x2 - x1) / n) * k;
            val py: Fixed = y1 + ((y2 - y1) / n) * k;
            if (floor_hurts(g.lv.sectors[sector_at(g, px, py)].special::i32)) { ret 0; }
            k = k + 1;
        }
    }
    var len: i32 = maputl.aprox_distance(x2 - x1, y2 - y1) >> 16;
    if (len < 4) { ret 1; }
    val ox: Fixed = (0 - (y2 - y1) / len) * 14;
    val oy: Fixed = ((x2 - x1) / len) * 14;
    var sign: i32 = -1;
    for (sign <= 1) {
        val sx: Fixed = x1 + ox * sign;
        val sy: Fixed = y1 + oy * sign;
        if (can_walk(g, x1, y1, sx, sy) && !can_walk(g, sx, sy, x2 + ox * sign, y2 + oy * sign)) { ret 0; }
        sign = sign + 2;
    }
    ret 1;
}

# a floor that hurts: the slime, acid and lava kinds of sector
fun floor_hurts(special: i32) bool {
    ret special == 4 || special == 5 || special == 7 || special == 16;
}

# whether a cell is one to keep out of: its floor hurts, or it is a pit, a
# place the level's exit cannot be walked to from
fun harmful(g: *Game, cell: i32) bool {
    if ((g.navout[cell]::i32 & HURTS) != 0) { ret 1; }
    ret g.navpits && g.navexit[cell] == 0 && g.navgrid[cell] != 0;
}

# whether a place stands in a cell the level's exit cannot be walked to
# from: a goal there is bait, for whoever goes in is not coming back out.
# (Only the pit half of harmful(): slime on the way back out is waded.)
fun lost(g: *Game, x: Fixed, y: Fixed) bool {
    val cell: i32 = cell_of(g, x, y);
    ret cell >= 0 && g.navpits && g.navexit[cell] == 0 && g.navgrid[cell] != 0;
}

val KEY_BLUE:   i32 = 1;
val KEY_YELLOW: i32 = 2;
val KEY_RED:    i32 = 4;
# not a key: leave to cross a line that ends the level when walked over,
# which a bot playing the level has only when it is time to go
val KEY_EXIT: i32 = 8;
val KEY_ALL:  i32 = 15;

# A team of bots plays a level through, however long that takes: the
# secrets first, until it has been in every one it can reach or counted
# every one out of reach, and then the exit. There is no clock in it; a
# level ends when the team is out or, in the league's game, when it has
# stopped getting anywhere at all (game.stalled). This is the grace a
# stalled level is measured after: the tics a team may spend getting
# nowhere before it counts as stopped for good.
pub val GRACE: i32 = 5 * 60 * 35;
# how long a bot makes for one secret without getting any nearer it before
# giving it up for another
val SECRET_PATIENCE: i32 = 45 * 35;
# and how often a bot may set out for a secret and have to give it up
# before the secret counts as out of reach for good, a new key aside: a
# key may open the way there. Without a last call a team that had found
# every secret it could went on circling one it could not, and the
# league's teams finished the first level of the nine and no other.
val SECRET_TRIES: i32 = 4;
# how long a bot keeps after a goal it has made no progress toward, and how
# near a place the one it has given up on
val GOAL_PATIENCE: i32 = 45 * 35;
val GAVE_RADIUS:   i32 = 192;

# whether a line teleports whoever crosses it onto the level's ending floor:
# a teleport special whose tag names a sector of special 11, as E1M8's star
# teleporter does once the bruisers are dead
fun ends_level(g: *Game, line: *level.Line) bool {
    val s: i32 = line.special::i32;
    if (s != 39 && s != 97 && s != 125 && s != 126) { ret 0; }
    var i: i32 = 0;
    for (i < nendtags) {
        if (navendtags[i] == line.tagnum::i32) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# the key a line's door needs, as its bit, or 0
fun key_of(special: i32) i32 {
    if (special == 26 || special == 32 || special == 99 || special == 133)  { ret KEY_BLUE; }
    if (special == 27 || special == 34 || special == 136 || special == 137) { ret KEY_YELLOW; }
    if (special == 28 || special == 33 || special == 134 || special == 135) { ret KEY_RED; }
    ret 0;
}

# the keys a player has, a bit a colour: a card or a skull will do
fun keys_of(p: *Player) i32 {
    var have: i32 = 0;
    if (p.cards[defs.IT_BLUECARD] || p.cards[defs.IT_BLUESKULL])     { have = have | KEY_BLUE; }
    if (p.cards[defs.IT_YELLOWCARD] || p.cards[defs.IT_YELLOWSKULL]) { have = have | KEY_YELLOW; }
    if (p.cards[defs.IT_REDCARD] || p.cards[defs.IT_REDSKULL])       { have = have | KEY_RED; }
    ret have | KEY_EXIT;
}

fun walk_stops(g: *Game, in: *defs.Intercept) bool {
    if (!in.isaline) { ret 1; }
    val line: *level.Line = ?g.lv.lines[in.line];
    walkblock = in.line;
    if (line.sidenum[1] == level.NONE || (line.flags::i32 & defs.ML_BLOCKING) != 0) { ret 0; }
    # a locked door stops whoever has not its key, and a line that ends the
    # level whoever is not yet leaving
    var key: i32 = key_of(line.special::i32);
    if (line.special == 52 || line.special == 124 || ends_level(g, line)) { key = KEY_EXIT; }
    if (key != 0) {
        if ((walkhave & key) == 0) { ret 0; }
        walkkey = walkkey | key;
    }
    if (!walkstrict) {
        # a line that does something is taken to open, and a sector that a
        # switch or trigger moves (a lift, a far door, a rising floor) to be
        # where it needs to be when the time comes
        if (line.special != 0 || (g.navmoves != nil && (g.navmoves[line.frontsector] != 0 || g.navmoves[line.backsector] != 0))) {
            walktrust = in.line;
            ret 1;
        }
    }
    maputl.line_opening(g, in.line);
    if (g.openrange < TALL) { ret 0; }
    # the floor on the far side against the floor on the near one
    var far:  i32 = line.frontsector;
    var near: i32 = line.backsector;
    if (maputl.point_on_line_side(g, walkx, walky, in.line) != 0) {
        far  = line.backsector;
        near = line.frontsector;
    }
    if (g.lv.sectors[far].floorheight - g.lv.sectors[near].floorheight > STEP) { ret 0; }
    walkblock = -1;
    ret 1;
}

fun can_walk(g: *Game, x1: Fixed, y1: Fixed, x2: Fixed, y2: Fixed) bool {
    walkx     = x2;
    walky     = y2;
    walkkey   = 0;
    walktrust = -1;
    ret maputl.path_traverse(g, x1, y1, x2, y2, defs.PT_ADDLINES, walk_stops);
}

# whether the walk can be made as the level stands; if not, walkblock is the
# line in the way
fun walks_now(g: *Game, x1: Fixed, y1: Fixed, x2: Fixed, y2: Fixed) bool {
    walkstrict = 1;
    walkblock  = -1;
    val ok: bool = can_walk(g, x1, y1, x2, y2);
    walkstrict = 0;
    ret ok;
}

pub fun cell_x(g: *Game, cx: i32) Fixed {
    ret g.lv.bmaporgx + ((cx * CELL + CELL / 2) << 16);
}

pub fun cell_y(g: *Game, cy: i32) Fixed {
    ret g.lv.bmaporgy + ((cy * CELL + CELL / 2) << 16);
}

fun way_index(way: i32) i32 {
    if (way == NORTH) { ret 1; }
    if (way == WEST)  { ret 2; }
    if (way == SOUTH) { ret 3; }
    ret 0;
}

# note the key the way just walked out of a cell needs, and the line it
# took on trust
fun lock_way(g: *Game, cell: i32, way: i32) {
    if (walktrust >= 0) { g.navline[cell * 4 + way_index(way)] = (walktrust + 1)::u16; }
    if ((walkkey & KEY_EXIT) != 0) {
        g.navout[cell] = g.navout[cell] | way::u8;
        g.navlocks     = g.navlocks | KEY_EXIT;
    }
    if ((walkkey & 7) == 0) { ret; }
    var index: i32 = 1;
    if ((walkkey & KEY_YELLOW) != 0) { index = 2; }
    if ((walkkey & KEY_RED) != 0)    { index = 3; }
    var shift: i32 = 0;
    if (way == NORTH) { shift = 2; }
    if (way == WEST)  { shift = 4; }
    if (way == SOUTH) { shift = 6; }
    g.navkey[cell] = g.navkey[cell] | (index << shift)::u8;
    g.navlocks     = g.navlocks | (walkkey & 7);
}

# whether a player with these keys can walk out of a cell this way
fun way_open(g: *Game, cell: i32, way: i32, have: i32) bool {
    if ((g.navgrid[cell]::i32 & way) == 0) { ret 0; }
    if ((g.navout[cell]::i32 & way) != 0 && (have & KEY_EXIT) == 0) { ret 0; }
    if (nbanned > 0) {
        val line: i32 = g.navline[cell * 4 + way_index(way)]::i32 - 1;
        var k:    i32 = 0;
        for (k < nbanned) {
            if (banned[k] == line) { ret 0; }
            k = k + 1;
        }
    }
    var shift: i32 = 0;
    if (way == NORTH) { shift = 2; }
    if (way == WEST)  { shift = 4; }
    if (way == SOUTH) { shift = 6; }
    val index: i32 = (g.navkey[cell]::i32 >> shift) & 3;
    ret index == 0 || (have & (1 << (index - 1))) != 0;
}

# the steps a stair builder raises out of a tagged sector, flagged as moved
# so the grid trusts the walks across them. the chain is the one movers'
# build_stairs follows: each step takes the next sector behind a two-sided
# line its predecessor faces out of, where that sector's floor wears the
# first step's flat
fun mark_stairs(g: *Game, start: i32) {
    val texture: i32 = g.lv.sectors[start].floorflat;
    var secnum:  i32 = start;
    for {
        var ok: bool = 0;
        var i:  i32  = 0;
        for (i < g.lv.sectors[secnum].linecount) {
            val line: *level.Line = ?g.lv.lines[g.lv.sector_lines[g.lv.sectors[secnum].firstline + i]];
            i = i + 1;
            if ((line.flags::i32 & defs.ML_TWOSIDED) == 0) { cnt; }
            if (line.frontsector != secnum)                { cnt; }
            val next: i32 = line.backsector;
            if (next == level.NONE)                      { cnt; }
            if (g.lv.sectors[next].floorflat != texture) { cnt; }
            if (g.navmoves[next] != 0)                   { cnt; }
            g.navmoves[next] = 1;
            secnum = next;
            ok     = 1;
            brk;
        }
        if (!ok) { brk; }
    }
}

fun build_grid(g: *Game) {
    val had: i32 = walkhave;
    walkhave = KEY_ALL;
    nbanned  = 0;
    build_grid_with_every_key(g);
    walkhave = had;
}

fun build_grid_with_every_key(g: *Game) {
    g.navserial   = g.levelserial;
    g.navw        = g.lv.bmapwidth * (128 / CELL);
    g.navh        = g.lv.bmapheight * (128 / CELL);
    g.navgrid     = nil;
    g.navexit     = nil;
    g.navexitline = -1;
    g.navlocks    = 0;
    g.navsecrets  = 0;
    g.navpits     = 0;
    nendtags      = 0;
    if (g.navw * g.navh > MAXCELLS) { ret; }
    g.navgrid  = defs.alloc(g, (g.navw * g.navh)::usize):~*u8;
    g.navkey   = defs.alloc(g, (g.navw * g.navh)::usize):~*u8;
    g.navout   = defs.alloc(g, (g.navw * g.navh)::usize):~*u8;
    g.navline  = defs.alloc(g, (g.navw * g.navh * 8)::usize):~*u16;
    g.navmoves = defs.alloc(g, (g.lv.numsectors + 1)::usize):~*u8;
    if (g.navgrid == nil || g.navmoves == nil || g.navkey == nil || g.navout == nil || g.navline == nil) {
        g.navgrid = nil;
        ret;
    }
    # the sectors some line's special is aimed at, by tag
    var l: i32 = 0;
    for (l < g.lv.numlines) {
        val line: *level.Line = ?g.lv.lines[l];
        if (line.special != 0 && line.tagnum != 0) {
            var sc: i32 = 0;
            for (sc < g.lv.numsectors) {
                if (g.lv.sectors[sc].tagnum == line.tagnum) { g.navmoves[sc] = 1; }
                sc = sc + 1;
            }
            # a stair builder's tag names only the first step; the rest of the
            # flight is found at run time, so mark it the same way here
            if (line.special == 7 || line.special == 8 || line.special == 100 || line.special == 127) {
                sc = 0;
                for (sc < g.lv.numsectors) {
                    if (g.lv.sectors[sc].tagnum == line.tagnum) { mark_stairs(g, sc); }
                    sc = sc + 1;
                }
            }
        }
        l = l + 1;
    }
    # and the walls a boss's death lowers (tag 666): no line works them, the
    # level's last bruiser or the like dying does
    var sc2: i32 = 0;
    for (sc2 < g.lv.numsectors) {
        if (g.lv.sectors[sc2].tagnum == 666) { g.navmoves[sc2] = 1; }
        if (g.lv.sectors[sc2].special == 11 && g.lv.sectors[sc2].tagnum != 0 && nendtags < 8) {
            var seen: i32 = 0;
            for (seen < nendtags && navendtags[seen] != g.lv.sectors[sc2].tagnum::i32) {
                seen = seen + 1;
            }
            if (seen == nendtags) {
                navendtags[nendtags] = g.lv.sectors[sc2].tagnum::i32;
                nendtags             = nendtags + 1;
            }
        }
        sc2 = sc2 + 1;
    }

    var cy: i32 = 0;
    for (cy < g.navh) {
        var cx: i32 = 0;
        for (cx < g.navw) {
            val at: i32   = cy * g.navw + cx;
            val x:  Fixed = cell_x(g, cx);
            val y:  Fixed = cell_y(g, cy);
            if (cx + 1 < g.navw) {
                val ex: Fixed = cell_x(g, cx + 1);
                if (can_walk(g, x, y, ex, y)) {
                    g.navgrid[at] = g.navgrid[at] | EAST::u8;
                    lock_way(g, at, EAST);
                }
                if (can_walk(g, ex, y, x, y)) {
                    g.navgrid[at + 1] = g.navgrid[at + 1] | WEST::u8;
                    lock_way(g, at + 1, WEST);
                }
            }
            if (cy + 1 < g.navh) {
                val ny: Fixed = cell_y(g, cy + 1);
                if (can_walk(g, x, y, x, ny)) {
                    g.navgrid[at] = g.navgrid[at] | NORTH::u8;
                    lock_way(g, at, NORTH);
                }
                if (can_walk(g, x, ny, x, y)) {
                    g.navgrid[at + g.navw] = g.navgrid[at + g.navw] | SOUTH::u8;
                    lock_way(g, at + g.navw, SOUTH);
                }
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    # the cells whose floor hurts
    var c: i32 = 0;
    for (c < g.navw * g.navh) {
        if (g.navgrid[c] != 0 && floor_hurts(g.lv.sectors[sector_at(g, cell_x(g, c % g.navw), cell_y(g, c / g.navw))].special::i32)) {
            g.navout[c] = g.navout[c] | HURTS::u8;
        }
        c = c + 1;
    }
    # the cells a solid thing that is no monster stands in or beside
    var th: *defs.Thinker = g.thinkercap.next;
    for (th != ?g.thinkercap) {
        if (th.kind == defs.TH_MOBJ) {
            val mo: *Mobj = th:~*Mobj;
            if ((mo.flags & defs.MF_SOLID) != 0 && (mo.flags & defs.MF_COUNTKILL) == 0 && mo.player == nil) {
                val reach: i32 = (mo.radius >> 16) + 16;
                var oy: i32 = 0 - reach;
                for (oy <= reach) {
                    var ox: i32 = 0 - reach;
                    for (ox <= reach) {
                        val tc: i32 = cell_of(g, mo.x + ox * 65536, mo.y + oy * 65536);
                        if (tc >= 0) { g.navout[tc] = g.navout[tc] | THING::u8; }
                        ox = ox + 16;
                    }
                    oy = oy + 16;
                }
            }
        }
        th = th.next;
    }
    # the cells a body barely fits, and the cells beside slime
    c = 0;
    for (c < g.navw * g.navh) {
        if (g.navgrid[c] != 0) {
            val cx: i32 = c % g.navw;
            val cy: i32 = c / g.navw;
            val x: Fixed = cell_x(g, cx);
            val y: Fixed = cell_y(g, cy);
            var near: bool = (g.navgrid[c]::i32 & (EAST | WEST | NORTH | SOUTH)) != (EAST | WEST | NORTH | SOUTH);
            var d: i32 = 0;
            for (d < 4 && !near) {
                var dx: i32 = 20;
                var dy: i32 = 20;
                if ((d & 1) != 0) { dx = -20; }
                if ((d & 2) != 0) { dy = -20; }
                if (!walks_now(g, x, y, x + dx * 65536, y + dy * 65536)) { near = 1; }
                d = d + 1;
            }
            if (near) { g.navout[c] = g.navout[c] | NEAR::u8; }
            if ((g.navout[c]::i32 & HURTS) == 0) {
                var oy: i32 = -1;
                for (oy <= 1) {
                    var ox: i32 = -1;
                    for (ox <= 1) {
                        val nx: i32 = cx + ox;
                        val ny: i32 = cy + oy;
                        if (nx >= 0 && ny >= 0 && nx < g.navw && ny < g.navh && (g.navout[ny * g.navw + nx]::i32 & HURTS) != 0) {
                            g.navout[c] = g.navout[c] | NEARHURT::u8;
                        }
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
            }
        }
        c = c + 1;
    }
    find_exit(g);
    find_secrets(g);
}

# the sector a place is in
fun sector_at(g: *Game, x: Fixed, y: Fixed) i32 {
    ret g.lv.subsectors[render.point_in_subsector(g.lv, x, y)].sector;
}

# The level's secrets, for bots that play co-op: every sector marked secret,
# and a place to stand in each. The place is the point of a sixteen-unit
# lattice inside the sector that is nearest the middle of all such points,
# which for a sector of any shape is well inside it.
fun find_secrets(g: *Game) {
    var sc: i32 = 0;
    for (sc < g.lv.numsectors && g.navsecrets < 32) {
        if (g.lv.sectors[sc].special != 9) {
            sc = sc + 1;
            cnt;
        }
        # the box its lines lie in
        var x0: i32 = 0x7fffffff;
        var y0: i32 = 0x7fffffff;
        var x1: i32 = 0 - 0x7fffffff;
        var y1: i32 = 0 - 0x7fffffff;
        var l:  i32 = 0;
        for (l < g.lv.numlines) {
            val line: *level.Line = ?g.lv.lines[l];
            if (line.frontsector == sc || line.backsector == sc) {
                var k: i32 = 0;
                for (k < 2) {
                    var v: level.Vertex = g.lv.vertexes[line.v1];
                    if (k == 1) { v = g.lv.vertexes[line.v2]; }
                    if ((v.x >> 16) < x0) { x0 = v.x >> 16; }
                    if ((v.x >> 16) > x1) { x1 = v.x >> 16; }
                    if ((v.y >> 16) < y0) { y0 = v.y >> 16; }
                    if ((v.y >> 16) > y1) { y1 = v.y >> 16; }
                    k = k + 1;
                }
            }
            l = l + 1;
        }
        # twice over the lattice: the middle of its points, then the point
        # nearest that
        var sumx:  i64 = 0;
        var sumy:  i64 = 0;
        var count: i64 = 0;
        var bestx: i32 = 0;
        var besty: i32 = 0;
        var best:  i32 = 0x7fffffff;
        var pass:  i32 = 0;
        for (pass < 2 && x1 >= x0) {
            var y: i32 = y0 + 8;
            for (y < y1) {
                var x: i32 = x0 + 8;
                for (x < x1) {
                    if (sector_at(g, x << 16, y << 16) == sc) {
                        if (pass == 0) {
                            sumx  = sumx + x::i64;
                            sumy  = sumy + y::i64;
                            count = count + 1;
                        }
                        or {
                            var dx: i32 = x - (sumx / count)::i32;
                            var dy: i32 = y - (sumy / count)::i32;
                            if (dx < 0) { dx = -dx; }
                            if (dy < 0) { dy = -dy; }
                            if (dx + dy < best) {
                                best  = dx + dy;
                                bestx = x;
                                besty = y;
                            }
                        }
                    }
                    x = x + 16;
                }
                y = y + 16;
            }
            if (count == 0) { brk; }
            pass = pass + 1;
        }
        if (count > 0) {
            g.navsecretx[g.navsecrets] = bestx << 16;
            g.navsecrety[g.navsecrets] = besty << 16;
            g.navsecret[g.navsecrets]  = sc;
            g.navsecrets               = g.navsecrets + 1;
        }
        sc = sc + 1;
    }
}

# The level's exit, for bots that play co-op: the first line that ends the
# level the ordinary way, a switch (11) or a line to walk over (52). The
# place to make for is a little in front of a switch; for a line to walk
# over there are two, one either side, and a bot makes for the far one.
fun find_exit(g: *Game) {
    var l:      i32  = 0;
    var across: bool = 0;
    for (l < g.lv.numlines) {
        val line: *level.Line = ?g.lv.lines[l];
        if (line.special == 11 || line.special == 52) {
            across = line.special == 52;
            brk;
        }
        l = l + 1;
    }
    # no switch and no line that ends the level where crossed: the level may
    # end on a floor that hurts to death instead, reached by teleport
    if (l == g.lv.numlines) {
        l = 0;
        for (l < g.lv.numlines) {
            val line: *level.Line = ?g.lv.lines[l];
            if (ends_level(g, line)) { across = 1; brk; }
            l = l + 1;
        }
    }
    if (l < g.lv.numlines) {
        val line: *level.Line = ?g.lv.lines[l];
        val v1: level.Vertex = g.lv.vertexes[line.v1];
        val v2: level.Vertex = g.lv.vertexes[line.v2];
        val mx: Fixed = v1.x / 2 + v2.x / 2;
        val my: Fixed = v1.y / 2 + v2.y / 2;
        # twenty units off the line, to its front, which is its right
        var len: i32 = maputl.aprox_distance(line.dx, line.dy) >> 16;
        if (len < 1) { len = 1; }
        val nx: Fixed = (line.dy / len) * 20;
        val ny: Fixed = 0 - (line.dx / len) * 20;
        g.navexitline = l;
        g.navax       = mx + nx;
        g.navay       = my + ny;
        g.navbx       = g.navax;
        g.navby       = g.navay;
        if (across) {
            g.navbx = mx - nx;
            g.navby = my - ny;
        }
    }
    if (g.navexitline < 0) { ret; }
    g.navexit = defs.alloc(g, (g.navw * g.navh * 2)::usize):~*u16;
    if (g.navexit != nil) {
        exit_field(g, KEY_ALL, g.navexit);
        # the count tells pits from the rest only if it reaches where the
        # players come in; on a level whose exit the grid cannot find a
        # walk to, everywhere would be a pit
        val start: i32 = cell_of(g, g.playerstarts[0].x::i32 << 16, g.playerstarts[0].y::i32 << 16);
        g.navpits = start >= 0 && g.navexit[start] != 0;
    }
}

# how many cells every cell is from the exit, for a player with these keys:
# 1 beside it, more farther off, 0 where there is no way
fun exit_field(g: *Game, have: i32, dist: *u16) {
    val cells: i32 = g.navw * g.navh;
    var i:     i32 = 0;
    for (i < cells) {
        dist[i] = 0;
        i       = i + 1;
    }
    val queue: *u16 = ?fieldqueue[0];
    var tail:  i32 = 0;
    var side:  i32 = 0;
    for (side < 2) {
        var x: Fixed = g.navax;
        var y: Fixed = g.navay;
        if (side == 1) {
            x = g.navbx;
            y = g.navby;
        }
        var dy: i32 = -1;
        for (dy <= 1) {
            var dx: i32 = -1;
            for (dx <= 1) {
                val near: i32 = cell_of(g, x + ((dx * CELL) << 16), y + ((dy * CELL) << 16));
                if (near >= 0 && dist[near] == 0 && can_walk(g, cell_x(g, near % g.navw), cell_y(g, near / g.navw), x, y)) {
                    dist[near]  = 1;
                    queue[tail] = near::u16;
                    tail        = tail + 1;
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        side = side + 1;
    }
    var head: i32 = 0;
    for (head < tail) {
        val to: i32 = queue[head]::i32;
        head = head + 1;
        val tx: i32 = to % g.navw;
        var k:  i32 = 0;
        for (k < 4) {
            var next: i32 = -1;
            var way:  i32 = 0;
            if (k == 0 && tx > 0)               { next = to - 1;      way = EAST; }
            if (k == 1 && tx + 1 < g.navw)      { next = to + 1;      way = WEST; }
            if (k == 2 && to >= g.navw)         { next = to - g.navw; way = NORTH; }
            if (k == 3 && to + g.navw < cells)  { next = to + g.navw; way = SOUTH; }
            k = k + 1;
            if (next < 0 || dist[next] != 0 || !way_open(g, next, way, have)) { cnt; }
            dist[next]  = dist[to] + 1;
            queue[tail] = next::u16;
            tail        = tail + 1;
        }
    }
}

# for looking at the grid: mark every cell that can be walked to from a
# place (1), leaving the rest 0; ret how many
pub fun grid_flood(g: *Game, x: Fixed, y: Fixed, marks: *u8, back: bool) i32 {
    walkhave = KEY_ALL;
    if (g.navserial != g.levelserial) { build_grid(g); }
    if (g.navgrid == nil) { ret 0; }
    val cells: i32 = g.navw * g.navh;
    val queue: *u16 = ?floodqueue[0];
    var tail:  i32 = 0;
    var dy:    i32 = -1;
    for (dy <= 1) {
        var dx: i32 = -1;
        for (dx <= 1) {
            val by: i32 = cell_of(g, x + ((dx * CELL) << 16), y + ((dy * CELL) << 16));
            if (by >= 0 && marks[by] == 0 && can_walk(g, x, y, cell_x(g, by % g.navw), cell_y(g, by / g.navw))) {
                marks[by]   = 1;
                queue[tail] = by::u16;
                tail        = tail + 1;
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    var head: i32 = 0;
    for (head < tail) {
        val at: i32 = queue[head]::i32;
        head = head + 1;
        val e:  i32 = g.navgrid[at]::i32;
        val ax: i32 = at % g.navw;
        var k:  i32 = 0;
        for (k < 4) {
            var next: i32 = -1;
            if (!back) {
                if (k == 0 && (e & EAST) != 0)  { next = at + 1; }
                if (k == 1 && (e & WEST) != 0)  { next = at - 1; }
                if (k == 2 && (e & NORTH) != 0) { next = at + g.navw; }
                if (k == 3 && (e & SOUTH) != 0) { next = at - g.navw; }
            }
            or {
                # backwards: the neighbours that can walk into this cell
                if (k == 0 && ax > 0 && (g.navgrid[at - 1]::i32 & EAST) != 0)                         { next = at - 1; }
                if (k == 1 && ax + 1 < g.navw && (g.navgrid[at + 1]::i32 & WEST) != 0)                { next = at + 1; }
                if (k == 2 && at >= g.navw && (g.navgrid[at - g.navw]::i32 & NORTH) != 0)             { next = at - g.navw; }
                if (k == 3 && at + g.navw < cells && (g.navgrid[at + g.navw]::i32 & SOUTH) != 0)      { next = at + g.navw; }
            }
            k = k + 1;
            if (next < 0 || next >= cells || marks[next] != 0) { cnt; }
            marks[next] = 1;
            queue[tail] = next::u16;
            tail        = tail + 1;
        }
    }
    ret tail;
}

# for looking at the grid: whether a walk is found from one place to another
# with every key, going round up to two lines (-1 for none); and how many
# cells were walked to
pub fun reaches(g: *Game, x1: Fixed, y1: Fixed, x2: Fixed, y2: Fixed, round1: i32, round2: i32, marks: *u8, have: i32) i32 {
    walkhave = KEY_ALL;
    if (g.navserial != g.levelserial) { build_grid(g); }
    if (g.navgrid == nil) { ret -1; }
    nbanned = 0;
    if (round1 >= 0) { banned[nbanned] = round1; nbanned = nbanned + 1; }
    if (round2 >= 0 && round2 != round1) { banned[nbanned] = round2; nbanned = nbanned + 1; }
    val cells: i32 = g.navw * g.navh;
    val queue: *u16 = ?reachqueue[0];
    var tail:  i32 = 0;
    val first: i32 = cell_of(g, x1, y1);
    if (first < 0) { ret -1; }
    marks[first] = 1;
    queue[0]     = first::u16;
    tail         = 1;
    var head: i32 = 0;
    for (head < tail) {
        val at: i32 = queue[head]::i32;
        head = head + 1;
        var k: i32 = 0;
        for (k < 4) {
            var next: i32 = at - g.navw;
            var way:  i32 = SOUTH;
            if (k == 0) { next = at + 1;      way = EAST; }
            if (k == 1) { next = at - 1;      way = WEST; }
            if (k == 2) { next = at + g.navw; way = NORTH; }
            k = k + 1;
            if (next < 0 || next >= cells || marks[next] != 0 || !way_open(g, at, way, have)) { cnt; }
            marks[next] = 1;
            queue[tail] = next::u16;
            tail        = tail + 1;
        }
    }
    nbanned = 0;
    val goal: i32 = cell_of(g, x2, y2);
    if (goal >= 0 && marks[goal] != 0) { ret tail; }
    ret 0 - tail;
}

# for looking at the grid: the cell a place is in, or -1
pub fun cell_at(g: *Game, x: Fixed, y: Fixed) i32 {
    ret cell_of(g, x, y);
}

# for navcheck's gap report: walk between two places the way grid-building
# tests it, and again as the level stands this tic, saying what stopped each.
# ret: the line that stopped the easy walk, or -1 when it goes (a special or
# a moved sector taken on trust); strict gets whether the strict walk goes,
# and strictline what stopped it
pub fun probe_walk(g: *Game, x1: Fixed, y1: Fixed, x2: Fixed, y2: Fixed, strict: *bool, strictline: *i32) i32 {
    if (g.navserial != g.levelserial) { build_grid(g); }
    walkhave = KEY_ALL;
    nbanned  = 0;
    val ok:     bool = can_walk(g, x1, y1, x2, y2);
    val easy:   i32  = walkblock;
    @strict     = walks_now(g, x1, y1, x2, y2);
    @strictline = walkblock;
    if (ok) { ret -1; }
    ret easy;
}

# the cell a place is in, or -1 off the grid
fun cell_of(g: *Game, x: Fixed, y: Fixed) i32 {
    val cx: i32 = ((x - g.lv.bmaporgx) >> 16) / CELL;
    val cy: i32 = ((y - g.lv.bmaporgy) >> 16) / CELL;
    if (x < g.lv.bmaporgx || y < g.lv.bmaporgy || cx >= g.navw || cy >= g.navh) { ret -1; }
    ret cy * g.navw + cx;
}

# the way to the nearest living opponent: the bearing of a place a few cells
# along the shortest walk to it, searched across the grid from the opponent
# back to the bot. Looked for afresh every sixteenth tic; the place is kept
# in between. 0 if there is no opponent or no way.
fun path_bearing(g: *Game, playernum: i32, b: *Bot) i32 {
    val me: *Mobj = g.players[playernum].mo;
    if (((g.leveltime + playernum) & 15) != 0 && b.haveway) { ret clamp(bearing(me, b.wayx, b.wayy), -127, 127); }
    # in co-op a way not found is looked for again every eighth tic, not
    # every tic: where there is none, a search floods the whole map and
    # solves every door in it, four bots at a time
    if (g.deathmatch == 0 && !b.haveway && ((g.leveltime + playernum) & 7) != 0) { ret 0; }
    # and a way that took working through many things to find is kept a
    # while longer before it is worked out again, while the bot is still
    # some way short of the place it was making for
    if (g.deathmatch == 0 && b.haveway && b.works >= 8 && ((g.leveltime + playernum) & 63) != 0 && distance(me, b.wayx, b.wayy) > 24) { ret clamp(bearing(me, b.wayx, b.wayy), -127, 127); }
    b.haveway = 0;
    solvework = 0;
    if (g.deathmatch != 0) { solvework = 0 - 0x40000000; }
    val have: i32 = keys_of(?g.players[playernum]);
    walkhave = have;

    # whom to make for: in a deathmatch the nearest opponent, unless there
    # is one it hates, and then that one however far (the most hated, if
    # there are several); in co-op the nearest person, to follow, or failing
    # a person the nearest bot
    var target:   *Mobj = nil;
    var bestdist: i32   = 0x7fffffff;
    var person:   bool  = 0;
    # whether there is a person in the game at all, alive or not
    var anyone:   bool  = 0;
    # a bot that follows people: any bot in co-op, a shy one in any game
    val follows:  bool  = g.deathmatch == 0 || b.shy;
    var i:        i32   = 0;
    for (i < defs.MAXPLAYERS) {
        val o: *Mobj = g.players[i].mo;
        if (i != playernum && g.playeringame[i] && !g.isbot[i]) { anyone = 1; }
        if (i != playernum && g.playeringame[i] && o != nil && o.health > 0) {
            var dist:   i32  = distance(me, o.x, o.y);
            # the hunted come before everyone, the most hated first
            if (!follows && dislike(g, b, playernum, i) < HUNTED) { dist = dislike(g, b, playernum, i) - 100; }
            val better: bool = follows && !g.isbot[i] && !person;
            if (better || (dist < bestdist && (!follows || person == !g.isbot[i]))) {
                target   = o;
                bestdist = dist;
                person   = follows && !g.isbot[i];
            }
        }
        i = i + 1;
    }
    # co-op with no person in it: the level is the thing, and the bots play
    # it through. With a person in it the level is theirs: the bots follow,
    # and while the person is dead they wait rather than go on without them.
    b.alone = g.deathmatch == 0 && !b.shy && !anyone;
    b.led   = g.deathmatch == 0 && !b.shy && anyone;
    if (b.alone) { ret goal_bearing(g, playernum, b, have); }
    if (target == nil || (b.led && !person)) { ret 0; }
    # in co-op, near enough: stay about rather than stand on their toes
    if (follows && !b.shy && bestdist < 128) { ret 0; }
    if (!b.led) { ret way_to(g, me, b, target.x, target.y, have); }

    # Following a person through the level: wherever they have got to, by
    # the walk as the level stands now, working what is in the way as a bot
    # playing alone would (the lift they rode has gone back up; the door
    # they opened has shut). Never across a line that ends the level. If the
    # bot's own keys allow no sure walk, then by the walk a player with
    # every key has: the person got there, and a door they unlocked may
    # still be open, and the key they used lies somewhere on the way.
    val mine: i32 = have & (KEY_ALL ^ KEY_EXIT);
    walkhave = mine;
    var to: i32 = solve_to(g, me, b, target.x, target.y, target.x, target.y, mine);
    if (!b.haveway || unsure) {
        walkhave = KEY_ALL ^ KEY_EXIT;
        to       = solve_to(g, me, b, target.x, target.y, target.x, target.y, KEY_ALL ^ KEY_EXIT);
    }
    ret to;
}

# Lines that do their work when walked over rather than when used, by their
# special: the W1 and WR kinds of the original's table.
fun walked_over(special: i32) bool {
    if (special >= 72 && special <= 98 && special != 78 && special != 85) { ret 1; }
    if (special >= 2 && special <= 6)                                     { ret 1; }
    if (special == 8 || special == 10 || special == 12 || special == 13)  { ret 1; }
    if (special == 16 || special == 17 || special == 19 || special == 22) { ret 1; }
    if (special == 25 || special == 30 || (special >= 35 && special <= 40)) { ret 1; }
    if (special == 44 || (special >= 52 && special <= 54))                { ret 1; }
    if (special >= 56 && special <= 59)                                   { ret 1; }
    if (special == 104 || (special >= 105 && special <= 110))             { ret 1; }
    if (special == 119 || special == 120 || special == 121)               { ret 1; }
    if (special == 124 || special == 125 || special == 126)               { ret 1; }
    if (special == 128 || special == 129 || special == 130 || special == 141) { ret 1; }
    ret 0;
}

# what solving a walk found: the place to go to work whatever is in the
# way, and the place to face there (the same place, for a line to walk over)
# the place to face on arriving where solve_to is going, for way_to to hand
# back when it sends the search another way to the same place
var keepfx: Fixed;
var keepfy: Fixed;
# solve_to found no walk it could vouch for, and fell back on trust
var unsure: bool;
var solving:    bool;
var solvedepth: i32;
var solved:     bool;
var solvex:  Fixed;
var solvey:  Fixed;
var facex:   Fixed;
var facey:   Fixed;

# A line stops the walk as the level stands. If a sector it borders is one
# that a switch or a trigger elsewhere moves (a door worked from across the
# room, a lift, a floor that rises to make a bridge), find the nearest line
# that still works it, and say where to go: in front of a switch, facing it,
# or across a line that works when walked over. Not if the line in the way
# works it itself: then walking at it and pressing use is all there is to do.
fun activator(g: *Game, me: *Mobj, b: *Bot, blocked: i32) bool {
    val wall: *level.Line = ?g.lv.lines[blocked];
    if (wall.sidenum[1] == level.NONE) { ret 0; }
    # the lines that work either sector, nearest the line in the way first.
    # Nearest the line and not the bot, so that the choice does not change
    # as the bot walks.
    val wx: Fixed = g.lv.vertexes[wall.v1].x / 2 + g.lv.vertexes[wall.v2].x / 2;
    val wy: Fixed = g.lv.vertexes[wall.v1].y / 2 + g.lv.vertexes[wall.v2].y / 2;
    var found: [12]i32;
    var dists: [12]i32;
    var n:     i32 = 0;
    var side:  i32 = 0;
    for (side < 2) {
        var sc: i32 = wall.frontsector;
        if (side == 1) { sc = wall.backsector; }
        side = side + 1;
        val tag: i32 = g.lv.sectors[sc].tagnum::i32;
        if (tag == 0 || (side == 2 && g.lv.sectors[wall.frontsector].tagnum::i32 == tag)) { cnt; }
        var l: i32 = 0;
        for (l < g.lv.numlines) {
            val line: *level.Line = ?g.lv.lines[l];
            if (line.tagnum::i32 == tag && line.special != 0) {
                if (l == blocked) { ret 0; }
                val mx: Fixed = g.lv.vertexes[line.v1].x / 2 + g.lv.vertexes[line.v2].x / 2;
                val my: Fixed = g.lv.vertexes[line.v1].y / 2 + g.lv.vertexes[line.v2].y / 2;
                var d:  i32   = maputl.aprox_distance(mx - wx, my - wy) >> 16;
                var m:  i32   = l;
                # into the list, nearest first; the twelfth and after dropped
                var k: i32 = 0;
                for (k < n) {
                    if (d < dists[k]) {
                        val td: i32 = dists[k];
                        val tm: i32 = found[k];
                        dists[k] = d;
                        found[k] = m;
                        d        = td;
                        m        = tm;
                    }
                    k = k + 1;
                }
                if (n < 12) {
                    dists[n] = d;
                    found[n] = m;
                    n        = n + 1;
                }
            }
            l = l + 1;
        }
    }
    if (n == 0) { ret 0; }
    # one at a time, twenty seconds each, then the next
    val depth: i32 = solvedepth;
    if (b.actblock[depth] != blocked + 1) {
        b.actblock[depth] = blocked + 1;
        b.acttry[depth]   = 0;
        b.actsince[depth] = g.leveltime;
    }
    if (g.leveltime - b.actsince[depth] > 20 * 35) {
        b.acttry[depth]   = b.acttry[depth] + 1;
        b.actsince[depth] = g.leveltime;
    }
    val best: i32 = found[b.acttry[depth] % n];
    val line: *level.Line = ?g.lv.lines[best];
    val mx:   Fixed = g.lv.vertexes[line.v1].x / 2 + g.lv.vertexes[line.v2].x / 2;
    val my:   Fixed = g.lv.vertexes[line.v1].y / 2 + g.lv.vertexes[line.v2].y / 2;
    var len:  i32   = maputl.aprox_distance(line.dx, line.dy) >> 16;
    if (len < 1) { len = 1; }
    # off the line, to its front, which is its right
    val nx: Fixed = line.dy / len;
    val ny: Fixed = 0 - line.dx / len;
    if (walked_over(line.special::i32)) {
        # across it: the side the bot is not on
        var sign: i32 = 1;
        if (maputl.point_on_line_side(g, me.x, me.y, best) == 0) { sign = -1; }
        solvex = mx + nx * 24 * sign;
        solvey = my + ny * 24 * sign;
        facex  = solvex;
        facey  = solvey;
    }
    or {
        solvex = mx + nx * 20;
        solvey = my + ny * 20;
        facex  = mx;
        facey  = my;
    }
    ret 1;
}

# The way to a place for a bot that plays the level: as way_to, but if the
# walk there is stopped, as the level stands, by something a switch or a
# trigger works, the way leads to that instead, and if the walk to that is
# stopped likewise, to what works that, three deep.
# ---
# fx: a place to turn to face on arriving, or the place itself
# fy: likewise
fun solve_to(g: *Game, me: *Mobj, b: *Bot, tox: Fixed, toy: Fixed, fx_in: Fixed, fy_in: Fixed, have: i32) i32 {
    # First keeping out of harm: no step into slime or into a pit. Only if
    # there is no walk to vouch for that way does it wade.
    # (A reckless bot does not look for the careful way at all: the short
    # way through the slime is the way, and if it kills it, it comes back.)
    careful = b.quirk != QUIRK_RECKLESS;
    var to: i32 = solve_pass(g, me, b, tox, toy, fx_in, fy_in, have);
    careful = 0;
    b.wades = 0;
    if (!b.haveway || unsure) {
        to      = solve_pass(g, me, b, tox, toy, fx_in, fy_in, have);
        b.wades = 1;
    }
    ret to;
}

fun solve_pass(g: *Game, me: *Mobj, b: *Bot, tox: Fixed, toy: Fixed, fx_in: Fixed, fy_in: Fixed, have: i32) i32 {
    var x:     Fixed = tox;
    var y:     Fixed = toy;
    var fx:    Fixed = fx_in;
    var fy:    Fixed = fy_in;
    var to:    i32   = 0;
    var depth: i32   = 0;
    var works: i32   = 0;
    unsure  = 0;
    # whatever an earlier search found is not this one's
    b.haveway = 0;

    # First a walk that can be made as the level stands, going round
    # whatever is shut: a way that is open now is better than a switch that
    # may open another.
    nbanned = 0;
    detour  = 1;
    solved  = 1;
    for (solved && depth < 17 && solvework < SOLVE_WORK) {
        solving = 1;
        solved  = 0;
        keepfx  = fx;
        keepfy  = fy;
        to      = way_to(g, me, b, x, y, have);
        solving = 0;
        depth   = depth + 1;
    }
    detour = 0;
    val open: bool = b.haveway && !solved;

    # Failing that, what works the first thing in the way, and what works
    # whatever is in the way of that.
    if (!open) {
        nbanned   = 0;
        depth     = 0;
        b.haveway = 0;
        for (depth < 17 && solvework < SOLVE_WORK) {
            solving    = 1;
            solvedepth = works;
            solved     = 0;
            keepfx     = fx;
            keepfy     = fy;
            to         = way_to(g, me, b, x, y, have);
            solving    = 0;
            if (!solved) { brk; }
            if ((solvex != x || solvey != y) && works < 2) { works = works + 1; }
            x     = solvex;
            y     = solvey;
            fx    = facex;
            fy    = facey;
            depth = depth + 1;
        }
    }
    b.nbans = nbanned;
    if (b.nbans > 6) { b.nbans = 6; }
    var q: i32 = 0;
    for (q < 6) {
        b.bans[q] = banned[q];
        q         = q + 1;
    }
    nbanned = 0;
    if (!b.haveway || solved) {
        # no way to what works it, and no way round: the walk itself, on
        # trust, which is not a walk to vouch for
        b.haveway = 0;
        unsure    = 1;
        x         = tox;
        y         = toy;
        fx        = fx_in;
        fy        = fy_in;
        to        = way_to(g, me, b, x, y, have);
    }
    b.afterx = x;
    b.aftery = y;
    b.works  = depth;
    if (works > depth) { b.works = works; }
    # arrived: turn to the switch
    if (b.haveway && b.wayx == x && b.wayy == y && (fx != x || fy != y)) {
        b.wayx = fx;
        b.wayy = fy;
        to     = clamp(bearing(me, fx, fy), -127, 127);
    }
    ret to;
}

# whether a goal that is no secret should be given up for now: it has had
# GOAL_PATIENCE tics at it without coming a stride and a half nearer than
# it has yet been. A goal that has wandered a quarter of a corridor is
# counted a new one, its clock starting then
fun stalling(g: *Game, b: *Bot, me: *Mobj, x: Fixed, y: Fixed) bool {
    var dx: i32 = (x - b.gox) >> 16;
    var dy: i32 = (y - b.goy) >> 16;
    if (dx < 0) { dx = -dx; }
    if (dy < 0) { dy = -dy; }
    if (dx + dy > 256) {
        b.gox     = x;
        b.goy     = y;
        b.gobest  = distance(me, x, y);
        b.gosince = g.leveltime;
        ret 0;
    }
    val away: i32 = distance(me, x, y);
    if (away + 48 < b.gobest) {
        b.gobest  = away;
        b.gosince = g.leveltime;
        ret 0;
    }
    ret g.leveltime - b.gosince > GOAL_PATIENCE;
}

# give up on the place a goal lay for a while: whatever is found there is
# not tried again until then
fun give_up(g: *Game, b: *Bot, x: Fixed, y: Fixed) {
    b.gavex    = x;
    b.gavey    = y;
    b.gavetill = g.leveltime + 90 * 35;
}

# whether a place is the one the bot has given up on for now
fun given_up(g: *Game, b: *Bot, x: Fixed, y: Fixed) bool {
    if (g.leveltime >= b.gavetill) { ret 0; }
    var dx: i32 = (x - b.gavex) >> 16;
    var dy: i32 = (y - b.gavey) >> 16;
    if (dx < 0) { dx = -dx; }
    if (dy < 0) { dy = -dy; }
    ret dx + dy <= GAVE_RADIUS;
}

# whether optional exploration still has a secret not counted out of
# reach. A secret given up on only for the moment still counts, to be
# tried again when no verified mission route is available.
fun secrets_left(g: *Game, b: *Bot) bool {
    if (g.navserial != g.levelserial) { build_grid(g); }
    if (g.navgrid == nil || g.navsecrets == 0) { ret 0; }
    var i: i32 = 0;
    for (i < g.navsecrets) {
        if (g.lv.sectors[g.navsecret[i]].special == 9 && b.struck[i]::i32 < SECRET_TRIES && !lost(g, g.navsecretx[i], g.navsecrety[i])) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# the way for a co-op bot that follows nobody: a verified route to the
# exit or its keys and switches first. Unfound secrets are optional
# exploration when no mission route can be vouched for; 0 if there is
# nowhere to go
fun goal_bearing(g: *Game, playernum: i32, b: *Bot, had: i32) i32 {
    val me: *Mobj = g.players[playernum].mo;
    if (g.navserial != g.levelserial) { build_grid(g); }
    if (g.navgrid == nil) { ret 0; }
    if (b.goalserial != g.levelserial) {
        b.goalserial = g.levelserial;
        b.goalstart  = 0;
        b.goalbest   = 0;
        b.want       = -1;
        b.gaveup     = 0;
        b.gavetill   = 0;
        b.gavekeys   = had;
        b.keyuntil   = 0;
    }
    # A bot-only team may leave even while secrets remain. Human-led
    # routing removes KEY_EXIT in path_bearing instead.
    val have: i32 = had;
    walkhave = have;

    # how far it has come toward the exit, for whoever scores it: by the
    # map's count for a player with every key, so that standing at a locked
    # door is as far as the door
    if (g.navexit != nil) {
        var near: i32 = 0;
        var dy:   i32 = -1;
        for (dy <= 1) {
            var dx: i32 = -1;
            for (dx <= 1) {
                val by: i32 = cell_of(g, me.x + ((dx * CELL) << 16), me.y + ((dy * CELL) << 16));
                if (by >= 0 && g.navexit[by] != 0 && (near == 0 || g.navexit[by]::i32 < near)) { near = g.navexit[by]::i32; }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        if (near != 0) {
            if (b.goalstart == 0)                     { b.goalstart = near; }
            if (b.goalbest == 0 || near < b.goalbest) {
                b.goalbest = near;
                learn(g, b, 1);
            }
        }
    }

    # Keep optional exploration current when keys or doors may have
    # changed. The mission is always tried first: its exit, the keys
    # it needs, and switches that open its route. Without a verified
    # mission route it may try an unfound secret, each starting at a different
    # one. A stalled or unreachable secret is given up for a while;
    # SECRET_TRIES failures count it out until another key is found.
    # None of that prevents the team from taking a normal exit whenever
    # it reaches one, or a mission route from taking priority again.
    if (b.gavekeys != had) {
        var z: i32 = 0;
        for (z < 32) {
            b.struck[z] = 0;
            z           = z + 1;
        }
    }
    if (b.gavekeys != had || (g.leveltime + playernum * 16) % (60 * 35) < 16) {
        # a door may have been opened since
        b.gavekeys = had;
        b.gaveup   = 0;
        b.gavetill = 0;
    }
    val mission: i32 = mission_bearing(g, playernum, me, b, have);
    if (b.haveway && !unsure) { b.want = -1; ret mission; }
    # what the mission said, for falling back on without working it all out
    # a second time
    val mhave: bool = b.haveway;
    val mwayx: Fixed = b.wayx;
    val mwayy: Fixed = b.wayy;
    val mafter: i32 = b.after;
    val mafterx: Fixed = b.afterx;
    val maftery: Fixed = b.aftery;
    val mworks: i32 = b.works;
    val mwades: bool = b.wades;
    val munsure: bool = unsure;

    var tries: i32 = 0;
    for (tries < 4 && secrets_left(g, b)) {
        tries = tries + 1;
        var pick: i32 = -1;
        if (b.want >= 0 && g.lv.sectors[g.navsecret[b.want]].special == 9 && (b.gaveup & (1 << b.want:~u32)) == 0 && b.struck[b.want]::i32 < SECRET_TRIES && !lost(g, g.navsecretx[b.want], g.navsecrety[b.want])) { pick = b.want; }
        var k: i32 = 0;
        for (k < g.navsecrets && pick < 0) {
            val at: i32 = (k + playernum * 5) % g.navsecrets;
            if (g.lv.sectors[g.navsecret[at]].special == 9 && (b.gaveup & (1 << at:~u32)) == 0 && b.struck[at]::i32 < SECRET_TRIES && !lost(g, g.navsecretx[at], g.navsecrety[at])) { pick = at; }
            k = k + 1;
        }
        if (pick < 0) { brk; }
        val away: i32 = distance(me, g.navsecretx[pick], g.navsecrety[pick]);
        if (pick != b.want || away + 48 < b.wantbest) {
            # a new one, or nearer than it has yet been: the clock starts again
            b.want      = pick;
            b.wantsince = g.leveltime;
            b.wantbest  = away;
        }
        if (g.leveltime - b.wantsince <= SECRET_PATIENCE) {
            b.after = 1;
            val to: i32 = solve_to(g, me, b, g.navsecretx[pick], g.navsecrety[pick], g.navsecretx[pick], g.navsecrety[pick], have);
            if (b.haveway && !unsure) { ret to; }
        }
        if ((b.gaveup & (1 << pick:~u32)) == 0 && b.struck[pick] < 255) { b.struck[pick] = (b.struck[pick]::i32 + 1)::u8; }
        b.gaveup = b.gaveup | (1 << pick:~u32);
    }

    # With no mission or optional secret route, a loyal bot stays with
    # the bot it likes best, if it likes one and has strayed from it
    if (b.quirk == QUIRK_LOYAL) {
        var friend: *Mobj = nil;
        var liked:  i32   = 59;
        var i:      i32   = 0;
        for (i < defs.MAXPLAYERS) {
            val o: *Mobj = g.players[i].mo;
            if (i != playernum && g.playeringame[i] && o != nil && o.health > 0 && regard(g, b, playernum, i) > liked) {
                liked  = regard(g, b, playernum, i);
                friend = o;
            }
            i = i + 1;
        }
        if (friend != nil && distance(me, friend.x, friend.y) > 320 && !given_up(g, b, friend.x, friend.y) && !lost(g, friend.x, friend.y)) {
            b.after = 5;
            val to: i32 = solve_to(g, me, b, friend.x, friend.y, friend.x, friend.y, have);
            if (b.haveway) {
                if (stalling(g, b, me, friend.x, friend.y)) { give_up(g, b, friend.x, friend.y); }
                or { ret to; }
            }
        }
    }

    b.haveway = mhave;
    b.wayx    = mwayx;
    b.wayy    = mwayy;
    b.after   = mafter;
    b.afterx  = mafterx;
    b.aftery  = maftery;
    b.works   = mworks;
    b.wades   = mwades;
    unsure    = munsure;
    ret mission;
}

fun pickup_point(g: *Game, me: *Mobj, item: *Mobj, x: Fixed, y: Fixed, tx: *Fixed, ty: *Fixed) bool {
    val reach: Fixed = me.radius + item.radius - 65536;
    if (reach <= 0) { ret 0; }
    var probe: Mobj;
    probe.x = item.x + clamp(x - item.x, 0 - reach, reach);
    probe.y = item.y + clamp(y - item.y, 0 - reach, reach);
    probe.subsector = render.point_in_subsector(g.lv, probe.x, probe.y);
    probe.z = g.lv.sectors[g.lv.subsectors[probe.subsector].sector].floorheight;
    probe.height = me.height;
    val delta: Fixed = item.z - probe.z;
    if (delta > probe.height || delta < 0 - 8 * 65536 || !maputl.check_sight(g, ?probe, item)) { ret 0; }
    if (!walks_now(g, x, y, probe.x, probe.y)) { ret 0; }
    @tx = probe.x;
    @ty = probe.y;
    ret 1;
}

fun solve_pickup(g: *Game, me: *Mobj, b: *Bot, key: *Mobj, have: i32) i32 {
    val previous: *Mobj = walkitem;
    walkitem = key;
    val to: i32 = solve_to(g, me, b, key.x, key.y, key.x, key.y, have);
    walkitem = previous;
    ret to;
}

fun mission_bearing(g: *Game, playernum: i32, me: *Mobj, b: *Bot, have: i32) i32 {
    # The exit: in front of its switch and facing it, or across its line
    b.haveway = 0;
    if (g.navexitline < 0) { ret 0; }
    var x:  Fixed = g.navax;
    var y:  Fixed = g.navay;
    var fx: Fixed = x;
    var fy: Fixed = y;
    if (g.navax == g.navbx && g.navay == g.navby) {
        val line: *level.Line = ?g.lv.lines[g.navexitline];
        fx = g.lv.vertexes[line.v1].x / 2 + g.lv.vertexes[line.v2].x / 2;
        fy = g.lv.vertexes[line.v1].y / 2 + g.lv.vertexes[line.v2].y / 2;
    }
    or (maputl.point_on_line_side(g, me.x, me.y, g.navexitline) == maputl.point_on_line_side(g, x, y, g.navexitline)) {
        x  = g.navbx;
        y  = g.navby;
        fx = x;
        fy = y;
    }
    b.after = 3;
    val out: i32 = solve_to(g, me, b, x, y, fx, fy, have);

    if (b.haveway && !unsure) { ret out; }

    # no sure way to the exit with these keys: a key not yet had, the
    # nearest there is a sure walk to
    var keys:  [6]*Mobj;
    var dists: [6]i32;
    var n:     i32 = 0;
    var th: *defs.Thinker = g.thinkercap.next;
    for (th != ?g.thinkercap) {
        if (th.kind == defs.TH_MOBJ) {
            var mo:  *Mobj = th:~*Mobj;
            var bit: i32   = 0;
            if (mo.kind == info.MT_MISC4 || mo.kind == info.MT_MISC7) { bit = KEY_BLUE; }
            if (mo.kind == info.MT_MISC6 || mo.kind == info.MT_MISC8) { bit = KEY_YELLOW; }
            if (mo.kind == info.MT_MISC5 || mo.kind == info.MT_MISC9) { bit = KEY_RED; }
            if (bit != 0 && (have & bit) == 0) {
                var dist: i32 = distance(me, mo.x, mo.y);
                var k:    i32 = 0;
                for (k < n) {
                    if (dist < dists[k]) {
                        val td: i32   = dists[k];
                        val tm: *Mobj = keys[k];
                        dists[k] = dist;
                        keys[k]  = mo;
                        dist     = td;
                        mo       = tm;
                    }
                    k = k + 1;
                }
                if (n < 6) {
                    dists[n] = dist;
                    keys[n]  = mo;
                    n        = n + 1;
                }
            }
        }
        th = th.next;
    }
    b.after = 4;
    # the one it set out for first, while it is still there and the time
    # it gave itself is not up
    var k: i32 = 0;
    for (k < n && g.leveltime < b.keyuntil) {
        if (keys[k].x == b.keyx && keys[k].y == b.keyy && !lost(g, b.keyx, b.keyy)) {
            val to: i32 = solve_pickup(g, me, b, keys[k], have);
            if (b.haveway && !unsure && !stalling(g, b, me, b.keyx, b.keyy)) { ret to; }
            give_up(g, b, b.keyx, b.keyy);
        }
        k = k + 1;
    }
    k = 0;
    for (k < n) {
        if (given_up(g, b, keys[k].x, keys[k].y) || lost(g, keys[k].x, keys[k].y)) { k = k + 1; cnt; }
        val to: i32 = solve_pickup(g, me, b, keys[k], have);
        if (b.haveway && !unsure && !stalling(g, b, me, keys[k].x, keys[k].y)) {
            b.keyx     = keys[k].x;
            b.keyy     = keys[k].y;
            b.keyuntil = g.leveltime + 45 * 35;
            ret to;
        }
        give_up(g, b, keys[k].x, keys[k].y);
        k = k + 1;
    }
    # none: the exit anyway, on trust
    b.after = 3;
    val trusted: i32 = solve_to(g, me, b, x, y, fx, fy, have);
    if (b.haveway || n == 0) { ret trusted; }
    # And when not even trust finds a way out, for the way out is behind a
    # door its key opens, the nearest key, on trust, given up on or not. A
    # team without it once wandered the last two minutes of every E1M2.
    b.after = 4;
    ret solve_pickup(g, me, b, keys[0], have);
}

# the bearing of a place a few cells along the shortest walk to a place,
# for a player with these keys; 0 if there is no way
# the first line along a found walk that is shut as the level stands and
# that the walk cannot open by itself (a use door it reaches is opened by
# walking at it), or -1
fun first_shut(g: *Game, from: i32) i32 {
    var c: i32 = from;
    var n: i32 = 0;
    for (n < 4000 && step_of(c) != 16) {
        var next: i32 = c - g.navw;
        if (step_of(c) == EAST)  { next = c + 1; }
        if (step_of(c) == WEST)  { next = c - 1; }
        if (step_of(c) == NORTH) { next = c + g.navw; }
        val cx: Fixed = cell_x(g, c % g.navw);
        val cy: Fixed = cell_y(g, c / g.navw);
        if (!walks_now(g, cx, cy, cell_x(g, next % g.navw), cell_y(g, next / g.navw)) && walkblock >= 0) {
            val shut: i32 = walkblock;
            # a line that works when used is opened by walking at it and
            # pressing use; and a door's far face, come at from inside
            # the door, is open by then
            if (!(g.lv.lines[shut].special != 0 && !walked_over(g.lv.lines[shut].special::i32))) { ret shut; }
        }
        c = next;
        n = n + 1;
    }
    ret -1;
}

fun way_to(g: *Game, me: *Mobj, b: *Bot, tox: Fixed, toy: Fixed, have: i32) i32 {
    var i: i32 = 0;
    if (g.navserial != g.levelserial) { build_grid(g); }
    if (g.navgrid == nil) { ret 0; }
    val mine: i32 = cell_of(g, me.x, me.y);
    val goal: i32 = cell_of(g, tox, toy);
    if (mine < 0 || goal < 0) { ret 0; }

    # A thing is rarely at the middle of its cell, and the middle may be in
    # a wall. So the search starts from every cell around the opponent whose
    # middle can walk to it, and ends at the first cell around the bot that
    # the bot can walk to the middle of.
    val step:  *u8  = ?waystep[0];
    val queue: *u16 = ?wayqueue[0];
    val cells: i32 = g.navw * g.navh;
    val weighed: bool = g.deathmatch == 0;
    new_search();
    var ends:  [9]i32;
    var goalx: [9]Fixed;
    var goaly: [9]Fixed;
    val collecting: bool = walkitem != nil && tox == walkitem.x && toy == walkitem.y;
    var nends: i32 = 0;
    var tail:  i32 = 0;
    var dy:    i32 = -1;
    for (dy <= 1) {
        var dx: i32 = -1;
        for (dx <= 1) {
            val near: i32 = cell_of(g, tox + ((dx * CELL) << 16), toy + ((dy * CELL) << 16));
            if (near >= 0 && step_of(near) == 0) {
                val x: Fixed = cell_x(g, near % g.navw);
                val y: Fixed = cell_y(g, near / g.navw);
                var gx: Fixed = tox;
                var gy: Fixed = toy;
                var reaches: bool = can_walk(g, x, y, tox, toy);
                if (!reaches && collecting) { reaches = pickup_point(g, me, walkitem, x, y, ?gx, ?gy); }
                if (reaches) {
                    set_step(near, 16, 0);
                    queue[tail] = near::u16;
                    goalx[tail] = gx;
                    goaly[tail] = gy;
                    tail        = tail + 1;
                }
            }
            val by: i32 = cell_of(g, me.x + ((dx * CELL) << 16), me.y + ((dy * CELL) << 16));
            if (by >= 0 && can_walk(g, me.x, me.y, cell_x(g, by % g.navw), cell_y(g, by / g.navw))) {
                ends[nends] = by;
                nends       = nends + 1;
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }

    val starts: i32 = tail;

    # breadth first from the opponent's cells. step[c] is the way to go from
    # c, as its direction's bit, 16 at an end of the walk, 0 if not reached.
    var from: i32 = -1;
    i = 0;
    for (i < nends && from < 0) {
        if (step_of(ends[i]) != 0) { from = ends[i]; }
        i = i + 1;
    }
    val mex: i32 = mine % g.navw;
    val mey: i32 = mine / g.navw;
    # first breadth first, which says quickly whether there is any way at
    # all; then, in co-op, again by cost for the way to take (step_cost)
    var heaped: bool = 0;
    var pass: i32 = 0;
    # and the search by cost is given only so long: half as many cells
    # again as the first search looked at, and never fewer than two thousand
    var budget: i32 = 2000;
    var pops: i32 = 0;
    for (pass < 3) {
        var head: i32 = 0;
        # in co-op, the cheapest way rather than the fewest cells: walls and
        # slime cost more than open floor (step_cost)
        # (and searched toward the bot first: a cell's cost so far plus the
        # least the rest could cost, four a cell, decides which is looked at
        # next, so the search does not flood the whole map)
        nheap = 0;
        if (heaped) {
            i = 0;
            for (i < tail) {
                heap_push((guess(queue[i]::i32, mex, mey, g.navw)::u32 << 16) | queue[i]::u32);
                i = i + 1;
            }
            head = tail;
        }
        for ((heaped && nheap > 0 && from < 0) || (!heaped && head < tail && from < 0)) {
            var to: i32 = 0;
            if (heaped) {
                val top: u32 = heap_pop();
                pops = pops + 1;
                solvework = solvework + 1;
                if (pops > budget) {
                    from = -2;
                    brk;
                }
                to = (top & 0xffff)::i32;
                if ((top >> 16)::i32 != clamp(cost_of(to) + guess(to, mex, mey, g.navw), 0, 0xffff)) { cnt; }
                i = 0;
                for (i < nends) {
                    if (ends[i] == to) { from = to; }
                    i = i + 1;
                }
                if (from >= 0) { brk; }
            }
            or {
                to = queue[head]::i32;
                head = head + 1;
                solvework = solvework + 1;
            }
            val tx: i32 = to % g.navw;
            # each neighbour that can walk into this cell
            var k: i32 = 0;
            for (k < 4) {
                var next: i32 = -1;
                var way:  i32 = 0;
                if (k == 0 && tx > 0)               { next = to - 1;      way = EAST; }
                if (k == 1 && tx + 1 < g.navw)      { next = to + 1;      way = WEST; }
                if (k == 2 && to >= g.navw)         { next = to - g.navw; way = NORTH; }
                if (k == 3 && to + g.navw < cells)  { next = to + g.navw; way = SOUTH; }
                k = k + 1;
                if (next < 0 || !way_open(g, next, way, have)) { cnt; }
                if (step_of(next) != 0 && !heaped) { cnt; }
                # keeping out of harm: no step from a safe cell into a harmful
                # one. Out of one, or along inside one, is another matter.
                if (careful && (g.navout[to]::i32 & HURTS) != 0 && (g.navout[next]::i32 & HURTS) == 0) { cnt; }
                if (heaped) {
                    if (step_of(next) == 16) { cnt; }
                    var cost: i32 = cost_of(to) + step_cost(g, next) + snag_cost(g, b, next);
                    # a step taken on trust that cannot be taken as the
                    # level stands costs a great deal: a floor that was to
                    # move may have moved the other way, or will not again
                    if (g.navline[next * 4 + way_index(way)] != 0 && !open_now(g, next, way, to)) { cost = cost + 200; }
                    if (cost > 0xfffe) { cost = 0xfffe; }
                    if (cost >= cost_of(next)) { cnt; }
                    set_step(next, way, cost);
                    heap_push((clamp(cost + guess(next, mex, mey, g.navw), 0, 0xffff)::u32 << 16) | next::u32);
                    cnt;
                }
                set_step(next, way, 0);
                queue[tail] = next::u16;
                tail        = tail + 1;
                i = 0;
                for (i < nends) {
                    if (ends[i] == next) { from = next; }
                    i = i + 1;
                }
            }
        }
        if (heaped && (from == -2 || (solving && first_shut(g, from) >= 0))) {
            # the walk by cost took too long to find, or meets what the
            # first walk went round: the first walk, again
            new_search();
            i = 0;
            for (i < starts) {
                set_step(queue[i]::i32, 16, 0);
                i = i + 1;
            }
            tail   = starts;
            from   = -1;
            heaped = 0;
            i = 0;
            for (i < nends && from < 0) {
                if (step_of(ends[i]) != 0) { from = ends[i]; }
                i = i + 1;
            }
            pass = 2;
            cnt;
        }
        if (from < 0) { ret 0; }
        # asked to solve it: along the whole walk, the first step that
        # cannot be taken as the level stands and that something elsewhere
        # works. Asked of the first, breadth-first walk; a cheaper walk by
        # cost that would meet a shut line the first does not is not taken
        if (solving && !heaped) {
            val shut: i32 = first_shut(g, from);
            if (shut >= 0 && nbanned >= 16) {
                # more shut lines than it can keep count of: no walk it
                # can vouch for
                solved = 1;
                ret 0;
            }
            if (shut >= 0) {
                # something elsewhere works it: go there, and not this
                # way; nothing does, or the search is for a way round:
                # another way to the same place
                solved = 1;
                if (detour || !activator(g, me, b, shut)) {
                    solvex = tox;
                    solvey = toy;
                    facex  = keepfx;
                    facey  = keepfy;
                }
                banned[nbanned] = shut;
                nbanned         = nbanned + 1;
                ret 0;
            }
        }
        if (!weighed || heaped || pass >= 2 || step_of(from) == 16) { brk; }
        if (tail + tail / 2 > budget) { budget = tail + tail / 2; }
        new_search();
        i = 0;
        for (i < starts) {
            set_step(queue[i]::i32, 16, 0);
            i = i + 1;
        }
        tail   = starts;
        from   = -1;
        heaped = 1;
        pass   = pass + 1;
    }
    if (from < 0) { ret 0; }

    # along the way: the farthest of the next six cells the bot can walk
    # straight to, so that it cuts corners no more than the walls allow
    b.wayx    = cell_x(g, from % g.navw);
    b.wayy    = cell_y(g, from / g.navw);
    b.haveway = 1;
    var at:   i32 = from;
    var hops: i32 = 0;
    for (hops < 6 && step[at] != 16) {
        val way: i32 = step[at]::i32;
        if (way == EAST)  { at = at + 1; }
        or (way == WEST)  { at = at - 1; }
        or (way == NORTH) { at = at + g.navw; }
        or                { at = at - g.navw; }
        hops = hops + 1;
        val x: Fixed = cell_x(g, at % g.navw);
        val y: Fixed = cell_y(g, at / g.navw);
        if (weighed) {
            if (!body_walk(g, me.x, me.y, x, y)) { brk; }
        }
        or { if (!can_walk(g, me.x, me.y, x, y)) { brk; } }
        b.wayx = x;
        b.wayy = y;
    }
    # at the end of the walk, the opponent itself
    if (step[at] == 16) {
        var end: i32 = 0;
        for (end < starts && queue[end] != at::u16) { end = end + 1; }
        if (end < starts && can_walk(g, me.x, me.y, goalx[end], goaly[end]) && (!weighed || body_walk(g, me.x, me.y, goalx[end], goaly[end]))) {
            b.wayx = goalx[end];
            b.wayy = goaly[end];
        }
    }
    ret clamp(bearing(me, b.wayx, b.wayy), -127, 127);
}

# which ammunition a weapon uses, or -1
fun ammo_of(weapon: i32) i32 {
    if (weapon == defs.WP_PISTOL || weapon == defs.WP_CHAINGUN) { ret defs.AM_CLIP; }
    if (weapon == defs.WP_SHOTGUN)                              { ret defs.AM_SHELL; }
    if (weapon == defs.WP_MISSILE)                              { ret defs.AM_MISL; }
    ret -1;
}

# the best weapon a player owns and has ammunition for: chaingun, shotgun,
# pistol, then fists. Rockets are left out: a bot would only kill itself.
fun best_weapon(p: *Player) i32 {
    if (p.weaponowned[defs.WP_CHAINGUN] && p.ammo[defs.AM_CLIP] > 0) { ret defs.WP_CHAINGUN; }
    if (p.weaponowned[defs.WP_SHOTGUN] && p.ammo[defs.AM_SHELL] > 0) { ret defs.WP_SHOTGUN; }
    if (p.weaponowned[defs.WP_PISTOL] && p.ammo[defs.AM_CLIP] > 0)   { ret defs.WP_PISTOL; }
    ret defs.WP_FIST;
}

# look at the world: fill the bot's 32 senses, each within -127 to 127
fun sense(g: *Game, playernum: i32, b: *Bot) {
    val p:  *Player = ?g.players[playernum];
    val me: *Mobj   = p.mo;
    var f:  *i32    = ?b.feat[0];
    # the walk grid, before anything asks whether a walk can be made: a bot
    # beside the person it follows has no way to look for, and once looked
    # for nothing else that would have built it
    if (g.navserial != g.levelserial) { build_grid(g); }

    var i: i32 = 0;
    for (i < RAYS) {
        # near is high: 127 at the wall, 0 at the ray's end
        val far: i32 = ray(g, me, RAYTURN[i]);
        f[F_RAYS + i] = 127 - far / 8;
        if (f[F_RAYS + i] < 0) { f[F_RAYS + i] = 0; }
        # straight ahead: is what stops the way something to use, a door or
        # a switch or a lift, and within an arm's reach?
        if (i == 0) {
            b.usable  = far <= USE_REACH && rayline >= 0 && g.lv.lines[rayline].special != 0;
            b.useexit = b.usable && (g.lv.lines[rayline].special == 11 || g.lv.lines[rayline].special == 51);
        }
        i = i + 1;
    }

    val enemy: *Mobj = find_enemy(g, me, b, playernum);
    f[F_SEEN]    = 0;
    f[F_BEARING] = 0;
    f[F_CLOSE]   = 0;
    f[F_FACED]   = 0;
    if (enemy != nil) {
        f[F_SEEN]    = 127;
        f[F_BEARING] = clamp(bearing(me, enemy.x, enemy.y), -127, 127);
        f[F_CLOSE]   = clamp(127 - distance(me, enemy.x, enemy.y) / 16, 0, 127);
        val back: i32 = bearing(enemy, me.x, me.y);
        if (back > -16 && back < 16) { f[F_FACED] = 127; }
        b.since    = 0;
        b.lastbear = f[F_BEARING];
    }
    or {
        b.since = b.since + 4;
        if (b.since > 127) { b.since = 127; }
    }
    f[F_SINCE]    = b.since;
    f[F_LASTBEAR] = b.lastbear;

    f[F_HEALTH] = clamp(p.health, 0, 127);
    f[F_PATH]   = path_bearing(g, playernum, b);
    val ammo: i32 = ammo_of(p.readyweapon);
    f[F_AMMO] = 127;
    if (ammo >= 0) { f[F_AMMO] = clamp(p.ammo[ammo], 0, 127); }
    i = 0;
    for (i < 5) {
        f[F_WEAPON + i] = 0;
        i               = i + 1;
    }
    if (p.readyweapon >= 0 && p.readyweapon < 5) { f[F_WEAPON + p.readyweapon] = 127; }

    f[F_HURT]     = clamp(p.damagecount, 0, 127);
    f[F_HURTBEAR] = 0;
    if (p.damagecount > 0 && p.attacker != nil && p.attacker != me) {
        f[F_HURTBEAR] = clamp(bearing(me, p.attacker.x, p.attacker.y), -127, 127);
    }

    val item: *Mobj = find_item(g, p);
    f[F_ITEM]      = 0;
    f[F_ITEMBEAR]  = 0;
    f[F_ITEMCLOSE] = 0;
    if (item != nil) {
        f[F_ITEM]      = 127;
        f[F_ITEMBEAR]  = clamp(bearing(me, item.x, item.y), -127, 127);
        f[F_ITEMCLOSE] = clamp(127 - distance(me, item.x, item.y) / 8, 0, 127);
    }

    # stuck: how long since it was last a stride from where it stood
    if (distance(me, b.wasx, b.wasy) > 48) {
        b.wasx  = me.x;
        b.wasy  = me.y;
        b.stuck = 0;
    }
    or {
        b.stuck = b.stuck + 4;
        if (b.stuck > 127) { b.stuck = 127; }
    }
    f[F_STUCK] = b.stuck;

    # a slow square wave, out of step between players, for anything done by
    # turns; and noise
    f[F_PHASE] = -127;
    if (((g.leveltime + playernum * 23) & 64) != 0) { f[F_PHASE] = 127; }
    f[F_NOISE] = next_random(b) - 128;
    if (f[F_NOISE] < -127) { f[F_NOISE] = -127; }
    f[F_WAY] = 0;
    if (b.haveway) { f[F_WAY] = 127; }
    f[F_BETTER] = 0;
    if (best_weapon(p) != p.readyweapon) { f[F_BETTER] = 127; }
}

# ---------------------------------------------------------------- the script

# the hand-written fighter: a decision from the senses alone, so that a net
# given the same senses can learn to make the same one
pub fun script(f: *i32, out: *i32) {
    var forward: i32 = 0;
    var side:    i32 = 0;
    var turn:    i32 = 0;
    var fire:    i32 = -64;
    var use:     i32 = -64;

    val ahead: i32 = f[F_RAYS];
    val left:  i32 = f[F_RAYS + 1] + f[F_RAYS + 3] + f[F_RAYS + 5];
    val right: i32 = f[F_RAYS + 2] + f[F_RAYS + 4] + f[F_RAYS + 6];

    if (f[F_SEEN] > 0) {
        # fight: face it, fire when it is in the sights, keep a middling
        # distance (or close in, with fists), and sidestep by turns
        turn = f[F_BEARING] * 6;
        if (f[F_BEARING] > -4 && f[F_BEARING] < 4) { fire = 64; }
        if (f[F_CLOSE] < 100 || f[F_WEAPON] > 0) {
            forward = 100;
        }
        or (f[F_CLOSE] > 118) {
            forward = -100;
        }
        side = f[F_PHASE] * 100 / 127;
    }
    or (f[F_HURT] > 0 && f[F_HURTBEAR] != 0) {
        # shot from somewhere: turn to it
        turn    = f[F_HURTBEAR] * 6;
        forward = 40;
    }
    or (f[F_SINCE] < 24) {
        # it was just there: go where it was last seen
        turn    = f[F_LASTBEAR] * 3;
        forward = 100;
    }
    or (f[F_ITEM] > 0 && f[F_ITEMCLOSE] > 64 && f[F_STUCK] < 60) {
        # something to pick up, close by
        turn    = f[F_ITEMBEAR] * 6;
        forward = 100;
    }
    or (f[F_WAY] > 0) {
        # hunt: along the way to an opponent, slowing to turn a corner; a
        # wall in the way straight ahead is likely a door
        forward = 100;
        turn    = f[F_PATH] * 6;
        if (f[F_PATH] > 32 || f[F_PATH] < -32) { forward = 30; }
        if (ahead > 112 && f[F_PATH] > -12 && f[F_PATH] < 12) { use = 64; }
    }
    or {
        # no way known: roam forward, steering off the nearer wall, and hard
        # away from a wall ahead; the phase picks a side when both are alike
        forward = 100;
        turn    = (right - left) / 6;
        if (ahead > 96) {
            turn = 100;
            if (right < left || (right == left && f[F_PHASE] < 0)) { turn = -100; }
            if (ahead > 115) {
                forward = 0;
                # a wall this near may be a door
                use = 64;
            }
        }
    }

    # stuck a while: back off turning, the way the phase says, and try the wall
    if (f[F_STUCK] > 60 && f[F_SEEN] == 0) {
        forward = -60;
        turn    = f[F_PHASE] * 100 / 127;
        use     = 64;
    }

    out[O_FORWARD] = clamp(forward, -127, 127);
    out[O_SIDE]    = clamp(side, -127, 127);
    out[O_TURN]    = clamp(turn, -127, 127);
    out[O_FIRE]    = fire;
    out[O_USE]     = use;
    out[O_SWITCH]  = -64;
    if (f[F_BETTER] > 0) { out[O_SWITCH] = 64; }
}

# ------------------------------------------------------------------- the net

# the network: inputs to hidden units, clipped at 0 and 127, to outputs.
# Weights are in 64ths; a bias counts as a weight on an input of 64.
pub fun forward(net: *i8, f: *i32, out: *i32) {
    var hidden: [24]i32;
    var j:      i32 = 0;
    for (j < HIDDEN) {
        var sum: i32 = net[INPUTS * HIDDEN + j]::i32 * 64;
        var i:   i32 = 0;
        for (i < INPUTS) {
            sum = sum + net[j * INPUTS + i]::i32 * f[i];
            i   = i + 1;
        }
        hidden[j] = clamp(sum >> 6, 0, 127);
        j         = j + 1;
    }
    val base: i32 = INPUTS * HIDDEN + HIDDEN;
    var k:    i32 = 0;
    for (k < OUTPUTS) {
        var sum: i32 = net[base + HIDDEN * OUTPUTS + k]::i32 * 64;
        j = 0;
        for (j < HIDDEN) {
            sum = sum + net[base + k * HIDDEN + j]::i32 * hidden[j];
            j   = j + 1;
        }
        out[k] = clamp(sum >> 6, -127, 127);
        k      = k + 1;
    }
}

# ------------------------------------------------------------- the shy bot

# How far behind its person a shy bot stands, and how near the middle of
# their view (in 256ths of a turn to either side; the view is 32 each way)
# counts as being looked at.
val SHY_BEHIND: i32 = 96;
val SHY_SEEN:   i32 = 44;

# The shy bot's whole mind: find the nearest living person; the place to be
# is a little way behind them. If they can see it, the place is behind and
# to the side it is already on, so that it goes round them and not through
# them. Run there flat out; once there and unseen, stand and face their
# back.
fun shy(g: *Game, playernum: i32, b: *Bot) {
    var i: i32 = 0;
    for (i < OUTPUTS) {
        b.out[i] = -64;
        i        = i + 1;
    }
    b.out[O_FORWARD] = 0;
    b.out[O_SIDE]    = 0;
    b.out[O_TURN]    = 0;

    val me: *Mobj = g.players[playernum].mo;
    var person:   *Mobj = nil;
    var bestdist: i32   = 0x7fffffff;
    i = 0;
    for (i < defs.MAXPLAYERS) {
        val o: *Mobj = g.players[i].mo;
        if (i != playernum && g.playeringame[i] && !g.isbot[i] && o != nil && o.health > 0) {
            val dist: i32 = distance(me, o.x, o.y);
            if (dist < bestdist) {
                person   = o;
                bestdist = dist;
            }
        }
        i = i + 1;
    }
    if (person == nil) { ret; }

    # where it is in their view: 0 is dead ahead of them
    val seen:    i32  = bearing(person, me.x, me.y);
    val watched: bool = seen > -SHY_SEEN && seen < SHY_SEEN;
    var back: u32 = person.angle + t.ANG180;
    if (watched) {
        back = person.angle - t.ANG90 - t.ANG45;
        if (seen >= 0) { back = person.angle + t.ANG90 + t.ANG45; }
    }
    val an: u32   = back >> t.ANGLETOFINESHIFT;
    val px: Fixed = person.x + SHY_BEHIND * t.FINESINE[an + 2048];
    val py: Fixed = person.y + SHY_BEHIND * t.FINESINE[an];

    if (!watched && distance(me, px, py) < 32) {
        # there, and unseen: stand, facing their back
        b.out[O_TURN] = clamp(bearing(me, person.x, person.y) * 4, -127, 127);
        ret;
    }

    # straight there if it can walk it; otherwise the way to them through
    # the map, as any bot finds its way, and through its doors
    var to: i32 = bearing(me, px, py);
    if (!can_walk(g, me.x, me.y, px, py) && b.feat[F_WAY] > 0) {
        to = b.feat[F_PATH];
        if (b.usable) { b.out[O_USE] = 64; }
    }
    b.out[O_TURN]    = clamp(to * 6, -127, 127);
    b.out[O_FORWARD] = 127;
    if (to > 48 || to < -48) { b.out[O_FORWARD] = 40; }
}

# ------------------------------------------------------------------ thinking

# A net learns as it goes. The last eight things it decided are kept, and
# what happens to it is laid at their door: a secret, a key, a kill, ground
# made toward the exit, a wound, a death — each nudges the weights from the
# hidden units to the outputs it chose, so that given the same senses it
# would say the same louder or softer, and often enough the other way. A
# death is the deepest cut, and it falls on what it did nearest the end.
#
# Only the output layer moves. The features the hidden units learned by
# imitation are worth keeping whatever a match turns out to reward, and a
# change there is a change everywhere; the outputs are what the features
# mean to do. And all of it is the integers everything here is done in,
# over what the bot itself sensed and decided — nothing outside the game
# is read, so every machine computes the same learning.
#
# r: what the thing that happened was worth, positive or negative
val LEARN_SHIFT: i32 = 12;

fun learn(g: *Game, b: *Bot, r: i32) {
    if (r == 0 || b.kind != KIND_NET || b.shy || g.deathmatch != 0 || b.tn == 0) { ret; }
    # the change to make is gathered over every decision remembered before
    # any of it is made: the newest counts most, the oldest a ninth of it
    var acc: [150]i32;
    var s:   i32 = 0;
    for (s < b.tn) {
        val at: i32 = (b.tpos + 7 - s) % 8;
        val w:  i32 = b.tn - s;
        var hid: [24]i32;
        var j:   i32 = 0;
        for (j < HIDDEN) {
            var sum: i32 = b.net[INPUTS * HIDDEN + j]::i32 * 64;
            var i:   i32 = 0;
            for (i < INPUTS) {
                sum = sum + b.net[j * INPUTS + i]::i32 * b.tfeat[at * INPUTS + i];
                i   = i + 1;
            }
            hid[j] = clamp(sum >> 6, 0, 127);
            j      = j + 1;
        }
        var k: i32 = 0;
        for (k < OUTPUTS) {
            val o: i32 = b.tout[at * OUTPUTS + k];
            if (o != 0) {
                var sgn: i32 = 1;
                if (o < 0) { sgn = -1; }
                val push: i32 = r * w * sgn;
                j = 0;
                for (j < HIDDEN) {
                    acc[k * HIDDEN + j] = acc[k * HIDDEN + j] + push * hid[j];
                    j                   = j + 1;
                }
                # a bias is a weight on an input of 64
                acc[HIDDEN * OUTPUTS + k] = acc[HIDDEN * OUTPUTS + k] + push * 64;
            }
            k = k + 1;
        }
        s = s + 1;
    }
    val base: i32 = INPUTS * HIDDEN + HIDDEN;
    var k:    i32 = 0;
    for (k < HIDDEN * OUTPUTS + OUTPUTS) {
        var d: i32 = acc[k];
        if (d >= 0) { d = (d + 2048) >> LEARN_SHIFT; }
        or          { d = -((2048 - d) >> LEARN_SHIFT); }
        if (d != 0) {
            var v: i32 = b.net[base + k]::i32 + d;
            if (v > 127)  { v = 127; }
            if (v < -128) { v = -128; }
            b.net[base + k] = v::i8;
        }
        k = k + 1;
    }
}

# one tic of a bot: its command
# ---
# g:         the game
# playernum: which player it is
# b:         the bot
# cmd:       the command to fill
pub fun think(g: *Game, playernum: i32, b: *Bot, cmd: *Ticcmd) {
    var blank: Ticcmd;
    @cmd = blank;
    val p: *Player = ?g.players[playernum];

    # what it learns by, in co-op, before anything: what the world did to
    # it since it last thought — a death, a wound, a kill, a secret, a key
    if (b.kind == KIND_NET && g.deathmatch == 0) {
        if (b.primed) {
            if (p.playerstate == defs.PST_DEAD && b.wstate != defs.PST_DEAD) { learn(g, b, -8); }
            val hurt: i32 = b.whealth - p.health;
            if (hurt > 0) {
                var r: i32 = 0 - (hurt + 19) / 20;
                if (r < -4) { r = -4; }
                learn(g, b, r);
            }
            # a kill is worth a little; on Nightmare the dead rise again
            # and a level is won by the way out of it, not by the body count
            if (p.killcount > b.wkills)    { learn(g, b, p.killcount - b.wkills); }
            if (p.secretcount > b.wsecret) { learn(g, b, 10 * (p.secretcount - b.wsecret)); }
            var cards: i32 = 0;
            var c:     i32 = 0;
            for (c < 6) {
                if (p.cards[c]) { cards = cards + 1; }
                c = c + 1;
            }
            if (cards > b.wkeys) { learn(g, b, 5 * (cards - b.wkeys)); }
            b.wkeys = cards;
            # an arm it did not have before, and health when it was hurt
            var armed: i32 = 0;
            var w:     i32 = 0;
            for (w < 8) {
                if (p.weaponowned[w]) { armed = armed + 1; }
                w = w + 1;
            }
            if (armed > b.warmed) { learn(g, b, 4 * (armed - b.warmed)); }
            b.warmed = armed;
            if (p.health > b.whealth && b.whealth < 60) { learn(g, b, 2); }
        }
        or {
            var cards: i32 = 0;
            var c:     i32 = 0;
            for (c < 6) {
                if (p.cards[c]) { cards = cards + 1; }
                c = c + 1;
            }
            b.wkeys = cards;
            var armed: i32 = 0;
            var w:     i32 = 0;
            for (w < 8) {
                if (p.weaponowned[w]) { armed = armed + 1; }
                w = w + 1;
            }
            b.warmed = armed;
            b.primed = 1;
        }
        b.wstate  = p.playerstate;
        b.whealth = p.health;
        b.wkills  = p.killcount;
        b.wsecret = p.secretcount;
    }
    if (p.mo == nil) { ret; }

    # dead: press use, off and on, to come back
    if (p.playerstate == defs.PST_DEAD) {
        if (((g.leveltime + playernum) & 7) == 0) { cmd.buttons = defs.BT_USE::u8; }
        ret;
    }

    # look and decide every fourth tic, each player on its own tic
    val looking: bool = ((g.leveltime + playernum) & 3) == 0;
    walkhave = keys_of(p);
    if (looking) {
        sense(g, playernum, b);
        if (b.shy) {
            shy(g, playernum, b);
        }
        or (b.kind == KIND_NET) {
            forward(?b.net[0], ?b.feat[0], ?b.out[0]);
            # and remember it, for what happens next to be laid at its door
            var r: i32 = 0;
            for (r < INPUTS) {
                b.tfeat[b.tpos * INPUTS + r] = b.feat[r];
                r                            = r + 1;
            }
            r = 0;
            for (r < OUTPUTS) {
                b.tout[b.tpos * OUTPUTS + r] = b.out[r];
                r                            = r + 1;
            }
            b.tpos = (b.tpos + 1) % 8;
            if (b.tn < 8) { b.tn = b.tn + 1; }
        }
        or {
            script(?b.feat[0], ?b.out[0]);
        }
    }

    # Reflexes, which every bot has whatever decided, because a net that
    # never learned them plays like a fool.
    var forward: i32  = b.out[O_FORWARD];
    var side:    i32  = b.out[O_SIDE];
    var turn:    i32  = b.out[O_TURN];
    var fire:    bool = b.out[O_FIRE] > 0;

    # A shy bot never fires. A brawler puts away whatever it has picked up,
    # and does not fire until its fists are out.
    var away: bool = 0;
    if (b.shy) { fire = 0; }
    if (b.fists && p.readyweapon != defs.WP_FIST) {
        fire = 0;
        away = 1;
    }

    # Hurt, with an enemy in sight, a quirk shows: the cautious back away
    # from the fight, still firing; the reckless run straight in.
    if (p.health < 35 && b.feat[F_SEEN] > 0 && !b.shy) {
        if (b.quirk == QUIRK_CAUTIOUS) { forward = -127; }
        if (b.quirk == QUIRK_RECKLESS) { forward = 127; }
    }

    # Fists and the saw reach only as far as an arm. With nothing else in
    # hand and an enemy in sight: run straight at it, and swing only when it
    # is within reach and in front.
    if ((p.readyweapon == defs.WP_FIST || p.readyweapon == defs.WP_CHAINSAW) && b.feat[F_SEEN] > 0) {
        forward = 127;
        side    = 0;
        turn    = clamp(b.feat[F_BEARING] * 6, -127, 127);
        fire    = b.feat[F_CLOSE] >= MELEE_CLOSE && b.feat[F_BEARING] > -10 && b.feat[F_BEARING] < 10;
    }

    # And in co-op a monster only far off is not a reason to stand: with a
    # way to walk it walks it, shooting when its sights happen across what
    # is out there. What is near is fought; what is far is walked past —
    # on Nightmare the dead rise again, and the way out is the win, not
    # the body count. It closes when the enemy is about a thousand units
    # off and walks on again only well past that, so it does not flutter
    # between the two on every look.
    if (g.deathmatch == 0) {
        if (b.feat[F_SEEN] == 0 || b.feat[F_CLOSE] < 40) { b.engaged = 0; }
        or (b.feat[F_CLOSE] >= 64) { b.engaged = 1; }
    }
    val walking: bool = g.deathmatch == 0 && !b.shy && b.haveway && !b.engaged && b.feat[F_SEEN] > 0 && p.readyweapon != defs.WP_FIST && p.readyweapon != defs.WP_CHAINSAW;
    if (walking) {
        forward = 100;
        side    = 0;
        turn    = clamp(b.feat[F_PATH] * 6, -127, 127);
        if (b.feat[F_PATH] > -8 && b.feat[F_PATH] < 8) { turn = 0; }
        if (b.feat[F_PATH] > 32 || b.feat[F_PATH] < -32) { forward = 40; }
    }

    # In co-op, with a way and nothing close to fight, the way is walked in
    # the world's terms: straight at the next place along it, forward and
    # sideways together, whichever way the bot happens to face, as a person
    # strafes round a corner. A net left to steer by bearing alone swung
    # wide and caught its shoulder on every corner. And pressing on without
    # getting anywhere, it slides along the wall the way there is more room,
    # as a person does, instead of pushing into it until it gives up.
    val brawl: bool = (p.readyweapon == defs.WP_FIST || p.readyweapon == defs.WP_CHAINSAW) && b.feat[F_SEEN] > 0;
    # (in a fight too, when standing in slime or at its edge: a dodge or a
    # step back there is a step into it, and a fight is no place to stand
    # in it, so it fights its way out along the way instead)
    var hazard: bool = 0;
    if (g.deathmatch == 0 && g.navgrid != nil && g.navserial == g.levelserial) {
        val cell: i32 = cell_of(g, p.mo.x, p.mo.y);
        hazard = cell >= 0 && (g.navout[cell]::i32 & (HURTS | NEARHURT)) != 0;
    }
    val guided: bool = g.deathmatch == 0 && !b.shy && b.haveway && g.navgrid != nil && g.navserial == g.levelserial && !brawl && (b.feat[F_SEEN] == 0 || !b.engaged || hazard);
    var pathing: bool = 0;
    if (guided) {
        # and with room for the team: a team-mate close by pushes it off a
        # little, and one close ahead in a lower seat goes first, so that
        # four making for the same doorway file through it rather than jam
        # it shoulder to shoulder
        # On a lift that has not yet brought it level with the way on: to
        # the lift's middle, and wait there. A bot standing at a lift's edge,
        # its shoulder over a lower ceiling beside, stops the lift rising,
        # and Doom sends it back down: E1M7's held four bots for good.
        var tx: Fixed = b.wayx;
        var ty: Fixed = b.wayy;
        var riding: bool = 0;
        val here: i32 = g.lv.subsectors[p.mo.subsector].sector;
        val lift: ptr = g.lv.sectors[here].specialdata;
        val waysec: i32 = sector_at(g, b.wayx, b.wayy);
        if (lift != nil && (lift:~*defs.Thinker).kind == defs.TH_PLAT && (waysec == here || g.lv.sectors[waysec].floorheight > p.mo.floorz + STEP)) {
            sector_middle(g, here, ?tx, ?ty);
            riding = 1;
            # and if it cannot get wholly on because a team-mate already is,
            # it gets off again and lets the lift go: half on, it would hold
            # the lift down for everyone
            if (!wholly_in(g, p.mo, here) && boarded(g, playernum, here)) {
                tx = p.mo.x + (p.mo.x - tx);
                ty = p.mo.y + (p.mo.y - ty);
            }
        }
        # Off a working lift its way lies on, with a team-mate already
        # aboard: it waits its turn clear of the lift's edge
        var waiting: bool = 0;
        val waylift: ptr = g.lv.sectors[waysec].specialdata;
        if (!riding && waysec != here && waylift != nil && (waylift:~*defs.Thinker).kind == defs.TH_PLAT && boarded(g, playernum, waysec)) {
            waiting = 1;
            var mx: Fixed = 0;
            var my: Fixed = 0;
            sector_middle(g, waysec, ?mx, ?my);
            tx = p.mo.x + (p.mo.x - mx);
            ty = p.mo.y + (p.mo.y - my);
        }
        # Off the lift but with a shoulder over its working edge: step back
        # off it, whatever the way says, and let it go
        if (!riding) {
            val edge: i32 = lift_edge(g, p.mo, here);
            if (edge >= 0) {
                var ex: Fixed = 0;
                var ey: Fixed = 0;
                sector_middle(g, edge, ?ex, ?ey);
                tx = p.mo.x + (p.mo.x - ex);
                ty = p.mo.y + (p.mo.y - ey);
                waiting = 1;
            }
        }
        val aim: u32 = world.point_to_angle2(p.mo.x, p.mo.y, tx, ty);
        val afine: u32 = aim >> t.ANGLETOFINESHIFT;
        var vx: i32 = t.FINESINE[afine + 2048];
        var vy: i32 = t.FINESINE[afine];
        var rx: i32 = 0;
        var ry: i32 = 0;
        var yield: bool = 0;
        var o: i32 = 0;
        for (o < defs.MAXPLAYERS) {
            val om: *Mobj = g.players[o].mo;
            if (!riding && !waiting && o != playernum && g.playeringame[o] && om != nil && om.health > 0) {
                val ax: i32 = (p.mo.x - om.x) >> 16;
                val ay: i32 = (p.mo.y - om.y) >> 16;
                val d: i32 = maputl.aprox_distance(p.mo.x - om.x, p.mo.y - om.y) >> 16;
                if (d > 0 && d < 72) {
                    val push: i32 = (72 - d) * 900;
                    rx = rx + ax * push / d;
                    ry = ry + ay * push / d;
                    if (o < playernum && d < 56 && (0 - ax) * (vx >> 8) + (0 - ay) * (vy >> 8) > 0) { yield = 1; }
                }
            }
            o = o + 1;
        }
        if (yield) {
            vx = vx / 4;
            vy = vy / 4;
        }
        vx = vx + rx;
        vy = vy + ry;
        val toward: u32 = world.point_to_angle2(0, 0, vx, vy) - p.mo.angle;
        val fine: u32 = toward >> t.ANGLETOFINESHIFT;
        val c: i32 = t.FINESINE[fine + 2048];
        val s: i32 = t.FINESINE[fine];
        var big: i32 = c;
        if (big < 0) { big = -big; }
        var other: i32 = s;
        if (other < 0) { other = -other; }
        if (other > big) { big = other; }
        if (big < 1) { big = 1; }
        forward = c * 127 / big;
        side    = 0 - s * 127 / big;
        if (yield) {
            forward = forward / 2;
            side    = side / 2;
        }
        if ((riding && (distance(p.mo, tx, ty) < 10 || wholly_in(g, p.mo, here))) || (waiting && wholly_in(g, p.mo, here) && distance(p.mo, p.mo.x * 2 - tx, p.mo.y * 2 - ty) > 112)) {
            forward = 0;
            side    = 0;
        }
        if (b.feat[F_SEEN] == 0) {
            turn = clamp(b.feat[F_PATH] * 6, -127, 127);
            if (b.feat[F_PATH] > -4 && b.feat[F_PATH] < 4) { turn = 0; }
        }
        if (((g.leveltime + playernum) & 7) == 0) {
            # (but not at a door or a switch within reach: that is opened,
            # not slid away from, and a door takes its time to rise)
            if (distance(p.mo, b.pressx, b.pressy) < 6 && !b.usable && !yield && !riding && !waiting) { b.pressed = b.pressed + 1; }
            or { b.pressed = 0; }
            b.pressx = p.mo.x;
            b.pressy = p.mo.y;
        }
        if (b.pressed >= 2 && b.slide == 0) {
            # remember what it caught on, for its searches to go round
            val snagged: i32 = cell_of(g, p.mo.x + t.FINESINE[afine + 2048] * 24, p.mo.y + t.FINESINE[afine] * 24);
            if (snagged >= 0) {
                b.snag[b.nsnag & 3] = snagged;
                b.snagtill[b.nsnag & 3] = g.leveltime + 20 * 35;
                b.nsnag = b.nsnag + 1;
            }
            # the side with more room, and the other way from last time if
            # that did not free it
            var dir: i32 = -1;
            if (b.feat[F_RAYS + 5] > b.feat[F_RAYS + 6]) { dir = 1; }
            if (b.feat[F_RAYS + 5] == b.feat[F_RAYS + 6] && b.feat[F_PHASE] > 0) { dir = 1; }
            if (b.slidedir == dir) { dir = 0 - dir; }
            b.slidedir = dir;
            b.slide    = 24;
            b.pressed  = 0;
        }
        if (b.slide > 0) {
            b.slide = b.slide - 1;
            side    = b.slidedir * 127;
            forward = forward / 3;
            if (b.slide > 16) { forward = -64; }
        }
        or { pathing = 1; }
    }
    or {
        b.pressed = 0;
        b.slide   = 0;
    }

    # In co-op, whatever decided: not into slime and not into a pit, unless
    # the way it has chosen goes there or it is standing in one already.
    # Sidestepping in a fight and backing off a wall walked bots into acid,
    # where they stood and died.
    if (g.deathmatch == 0 && !b.shy && !b.wades && b.quirk != QUIRK_RECKLESS && g.navgrid != nil && g.navserial == g.levelserial) {
        val here: i32 = cell_of(g, p.mo.x, p.mo.y);
        if (here >= 0 && !harmful(g, here)) {
            val fine: u32 = p.mo.angle >> t.ANGLETOFINESHIFT;
            val cosa: Fixed = t.FINESINE[fine + 2048];
            val sina: Fixed = t.FINESINE[fine];
            # walking its way it is already kept out of harm by the way; this
            # is for the rest: fighting, roaming, backing off when stuck
            val free: bool = (b.feat[F_SEEN] > 0 && !pathing) || !b.haveway || forward < 0;
            if (forward != 0 && free) {
                var reach: i32 = 56;
                if (forward < 0) { reach = -56; }
                val ahead: i32 = cell_of(g, p.mo.x + cosa * reach, p.mo.y + sina * reach);
                if (ahead >= 0 && harmful(g, ahead)) { forward = 0; }
            }
            if (side != 0 && !pathing) {
                # sideways is to the right when positive
                var reach: i32 = 56;
                if (side < 0) { reach = -56; }
                val beside: i32 = cell_of(g, p.mo.x + sina * reach, p.mo.y - cosa * reach);
                if (beside >= 0 && harmful(g, beside)) { side = 0; }
            }
        }
    }

    # In co-op, no shooting through a friend: fire is held while another
    # player stands in the line of it, nearer than whatever is being shot at
    # or not much farther. The nearer the friend, the wider they stand.
    if (g.deathmatch == 0 && fire) {
        # and none at all at nothing: with no enemy in sight a shot only
        # ever meets a wall or a friend, and friends crowd a respawn room
        if (b.feat[F_SEEN] == 0) { fire = 0; }
        # and none aimed wide of one: a shot beside the mark is ammunition
        # spent on a wall, or worse on a friend — the arm aims before it
        # fires, fists and the saw excepted, which want a swing not a sight
        if (b.feat[F_SEEN] > 0 && (b.feat[F_BEARING] > 12 || b.feat[F_BEARING] < -12) && p.readyweapon != defs.WP_FIST && p.readyweapon != defs.WP_CHAINSAW) { fire = 0; }
        var foe: i32 = 0x7fffffff;
        if (b.feat[F_SEEN] > 0) { foe = (127 - b.feat[F_CLOSE]) * 16; }
        var i: i32 = 0;
        for (i < defs.MAXPLAYERS) {
            val o: *Mobj = g.players[i].mo;
            if (i != playernum && g.playeringame[i] && o != nil && o.health > 0) {
                val dist: i32 = distance(p.mo, o.x, o.y);
                var off:  i32 = bearing(p.mo, o.x, o.y);
                if (off < 0) { off = -off; }
                # (Not for a bot it has come to hate: over that one it takes
                # no such care. People are never hated.)
                val hated: bool = regard(g, b, playernum, i) < 15;
                if (!hated && dist < foe + 256 && dist < 1536 && off <= 6 + 1400 / (dist + 1)) { fire = 0; }
            }
            i = i + 1;
        }
    }

    # A steady hand, whatever decided. A decision is held four tics, and a
    # turn of t held that long is t * 5 / 16 of the 256ths its bearings are
    # counted in; the script asks for six times the bearing, which is
    # nearly twice the turn that gets there, so a bot swung past what it
    # was turning to, then back past it, and its view never stopped
    # shaking. So: no more turn than reaches what it is turning to (an
    # enemy in sight, else the way it is walking); none at all for a hair's
    # breadth; and a turn that reverses the last is taken at half.
    var toward: i32  = 0;
    var aimed:  bool = 0;
    if (walking) {
        toward = b.feat[F_PATH];
        aimed  = 1;
    }
    or (b.feat[F_SEEN] > 0) {
        toward = b.feat[F_BEARING];
        aimed  = 1;
    }
    or (b.feat[F_WAY] > 0) {
        toward = b.feat[F_PATH];
        aimed  = 1;
    }
    # (Not while it is working itself free of something: then it turns as
    # it must, and a hand held steady stays stuck. Nor with its fists up
    # and someone to hit: at arm's length a mark moves faster than a steady
    # hand follows, and brawlers held to it never landed a blow.)
    val brawling: bool = (p.readyweapon == defs.WP_FIST || p.readyweapon == defs.WP_CHAINSAW) && b.feat[F_SEEN] > 0;
    if (b.feat[F_STUCK] > 40 || forward < 0 || brawling) { aimed = 0; }
    if (aimed) {
        var reach: i32 = toward * 3;
        if (toward > -3 && toward < 3) { reach = 0; }
        if (reach >= 0 && turn > reach && turn > 0) { turn = reach; }
        if (reach <= 0 && turn < reach && turn < 0) { turn = reach; }
    }
    if (!brawling && ((turn > 0 && b.wasturn < 0) || (turn < 0 && b.wasturn > 0))) { turn = turn / 2; }
    if (looking) {
        if ((turn > 0 && b.wasturn < 0) || (turn < 0 && b.wasturn > 0)) { b.swings = b.swings + 1; }
        if (turn != 0) { b.wasturn = turn; }
    }

    # the decision, held until the next: full speed is 50 forward and 40
    # sideways; a turn of 127 is 2540 a tic, a fast spin
    cmd.forwardmove = (forward * 50 / 127)::i8;
    cmd.sidemove    = (side * 40 / 127)::i8;
    cmd.angleturn   = (turn * 20)::i16;
    b.turned = b.turned + turn;
    if (turn < 0) { b.turned = b.turned - 2 * turn; }

    var buttons: i32 = 0;
    if (fire) {
        buttons  = buttons | defs.BT_ATTACK;
        b.shots  = b.shots + 1;
    }
    # Use works on the press, so it is pressed on the tic of the decision
    # only; only at something to use that is within reach, a shut door or a
    # switch or a lift, not at a bare wall or from across the room; and then
    # not again for five seconds. Pressed nine times a second, as a bot at a
    # door would, the door is opened, shut and opened again and never
    # passed.
    if (b.usewait > 0) { b.usewait = b.usewait - 1; }
    # a bot playing the level may use its normal exit before finding
    # every secret. It never throws the switch to the secret level;
    # the campaign visits that level in its own order
    # A bot following a person never throws either: when the level ends is
    # the person's to say.
    var hold: bool = 0;
    if (b.alone && b.useexit) {
        hold = g.lv.lines[rayline_of(g, p.mo)].special == 51;
    }
    if (b.led && b.useexit) { hold = 1; }
    # Whatever decided, a usable line within reach dead ahead — a shut door,
    # a switch, a lift — is meant to be worked, and moving with it in its
    # face is asking it to open. Left to the decision alone a net that never
    # learned the press circles the room until chance presses it instead.
    # The exit switch is excepted for a bot not playing the level itself:
    # when the level ends is the person's to say, or the decision's.
    var press: bool = requests_use(b, forward, side);
    if (press && looking && b.usewait == 0 && b.usable && !hold && (g.deathmatch != 0 || !opening_door(g, rayline_of(g, p.mo)))) {
        buttons   = buttons | defs.BT_USE;
        b.uses    = b.uses + 1;
        b.usewait = USE_WAIT;
    }
    if (away) {
        if (looking) { buttons = buttons | defs.BT_CHANGE | (defs.WP_FIST << defs.BT_WEAPONSHIFT); }
    }
    or (b.out[O_SWITCH] > 0 && looking && !b.fists) {
        val want: i32 = best_weapon(p);
        if (want != p.readyweapon) { buttons = buttons | defs.BT_CHANGE | (want << defs.BT_WEAPONSHIFT); }
    }
    cmd.buttons = buttons::u8;
}

# whether the whole of a thing's body stands in a sector, by its corners
# and a unit more
# the working lift whose edge a thing's body lies across, from the sector it
# stands in, or -1: standing so, a body holds a rising lift down
fun lift_edge(g: *Game, mo: *Mobj, sector: i32) i32 {
    val r: Fixed = mo.radius + 65536;
    var box: [4]Fixed;
    box[level.BOXTOP] = mo.y + r;
    box[level.BOXBOTTOM] = mo.y - r;
    box[level.BOXLEFT] = mo.x - r;
    box[level.BOXRIGHT] = mo.x + r;
    val sec: *level.Sector = ?g.lv.sectors[sector];
    var i: i32 = 0;
    for (i < sec.linecount) {
        val ln: i32 = g.lv.sector_lines[sec.firstline + i];
        val line: *level.Line = ?g.lv.lines[ln];
        i = i + 1;
        if (line.sidenum[1] == level.NONE) { cnt; }
        var other: i32 = line.frontsector;
        if (other == sector) { other = line.backsector; }
        val data: ptr = g.lv.sectors[other].specialdata;
        if (data == nil || (data:~*defs.Thinker).kind != defs.TH_PLAT) { cnt; }
        if (box[level.BOXRIGHT] <= line.bbox[level.BOXLEFT] || box[level.BOXLEFT] >= line.bbox[level.BOXRIGHT] || box[level.BOXTOP] <= line.bbox[level.BOXBOTTOM] || box[level.BOXBOTTOM] >= line.bbox[level.BOXTOP]) { cnt; }
        if (maputl.box_on_line_side(g, ?box[0], ln) == -1) { ret other; }
    }
    ret -1;
}

fun wholly_in(g: *Game, mo: *Mobj, sector: i32) bool {
    # its box, a unit wider, crosses none of the sector's two-sided lines:
    # a wall it stands against is no matter, a line onto lower ceiling is
    val r: Fixed = mo.radius + 65536;
    var box: [4]Fixed;
    box[level.BOXTOP] = mo.y + r;
    box[level.BOXBOTTOM] = mo.y - r;
    box[level.BOXLEFT] = mo.x - r;
    box[level.BOXRIGHT] = mo.x + r;
    val sec: *level.Sector = ?g.lv.sectors[sector];
    var i: i32 = 0;
    for (i < sec.linecount) {
        val ln: i32 = g.lv.sector_lines[sec.firstline + i];
        val line: *level.Line = ?g.lv.lines[ln];
        i = i + 1;
        if (line.sidenum[1] == level.NONE) { cnt; }
        if (box[level.BOXRIGHT] <= line.bbox[level.BOXLEFT] || box[level.BOXLEFT] >= line.bbox[level.BOXRIGHT] || box[level.BOXTOP] <= line.bbox[level.BOXBOTTOM] || box[level.BOXBOTTOM] >= line.bbox[level.BOXTOP]) { cnt; }
        if (maputl.box_on_line_side(g, ?box[0], ln) == -1) { ret 0; }
    }
    ret 1;
}

# whether another player, alive, stands wholly on a sector
fun boarded(g: *Game, playernum: i32, sector: i32) bool {
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        val mo: *Mobj = g.players[i].mo;
        if (i != playernum && g.playeringame[i] && mo != nil && mo.health > 0 && g.lv.subsectors[mo.subsector].sector == sector && wholly_in(g, mo, sector)) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun wholly_at(g: *Game, x: Fixed, y: Fixed, r: Fixed, sector: i32) bool {
    ret sector_at(g, x - r, y - r) == sector && sector_at(g, x + r, y - r) == sector && sector_at(g, x - r, y + r) == sector && sector_at(g, x + r, y + r) == sector;
}

# the middle of a sector: the average of the ends of its lines
fun sector_middle(g: *Game, sector: i32, x: *Fixed, y: *Fixed) {
    val sec: *level.Sector = ?g.lv.sectors[sector];
    var sx: i64 = 0;
    var sy: i64 = 0;
    var n: i64 = 0;
    var i: i32 = 0;
    for (i < sec.linecount) {
        val line: *level.Line = ?g.lv.lines[g.lv.sector_lines[sec.firstline + i]];
        sx = sx + (g.lv.vertexes[line.v1].x >> 16)::i64 + (g.lv.vertexes[line.v2].x >> 16)::i64;
        sy = sy + (g.lv.vertexes[line.v1].y >> 16)::i64 + (g.lv.vertexes[line.v2].y >> 16)::i64;
        n = n + 2;
        i = i + 1;
    }
    if (n == 0) { ret; }
    @x = ((sx / n)::i32) << 16;
    @y = ((sy / n)::i32) << 16;
}

# whether a door is already on its way up or standing open: pressing use
# on it then sends it back down, and a team at a door, each pressing in
# turn, kept shutting it in one another's faces
fun opening_door(g: *Game, linenum: i32) bool {
    if (linenum < 0 || linenum >= g.lv.numlines) { ret 0; }
    val line: *level.Line = ?g.lv.lines[linenum];
    if (line.sidenum[1] == level.NONE) { ret 0; }
    val data: ptr = g.lv.sectors[line.backsector].specialdata;
    if (data == nil) { ret 0; }
    val head: *defs.Thinker = data:~*defs.Thinker;
    if (head.kind != defs.TH_DOOR) { ret 0; }
    val door: *movers.Door = data:~*movers.Door;
    ret door.direction >= 0;
}

# the line straight ahead of a thing, within reach, or line 0
fun rayline_of(g: *Game, mo: *Mobj) i32 {
    ray(g, mo, 0);
    if (rayline < 0) { ret 0; }
    ret rayline;
}

# What a person did, as a bot would have had to decide it: the senses a bot
# in their place would have had, and their command put as a net's six
# outputs. One sample is 38 signed bytes, 32 senses then 6 decisions, the
# same as the hand-written bot's samples that the first net learned from.
pub val SAMPLE: i32 = 38;

# Watch a player who is not a bot, on the tics a bot would look. This reads
# the world and writes only to the watcher and to `out`; every machine in a
# game does it for every person, the same, so that it could not put them
# out of step even if it did touch something.
# ---
# b:   a watcher kept for this player from tic to tic (start it as a bot,
#      then it is never asked to think)
# cmd: the command the player gave this tic
# out: room for a sample
# ret: whether this was a tic to look on, and a sample was written
pub fun observe(g: *Game, playernum: i32, b: *Bot, cmd: *Ticcmd, out: *u8) bool {
    val p: *Player = ?g.players[playernum];
    if (p.mo == nil || p.playerstate == defs.PST_DEAD) { ret 0; }
    if (((g.leveltime + playernum) & 3) != 0)          { ret 0; }
    walkhave = keys_of(p);
    sense(g, playernum, b);
    var i: i32 = 0;
    for (i < INPUTS) {
        out[i] = clamp(b.feat[i], -127, 127)::i8:~u8;
        i      = i + 1;
    }
    # full speed is 50 forward and 40 sideways; a net's turn of 127 is 2540
    out[INPUTS + O_FORWARD] = clamp(cmd.forwardmove::i32 * 127 / 50, -127, 127)::i8:~u8;
    out[INPUTS + O_SIDE]    = clamp(cmd.sidemove::i32 * 127 / 40, -127, 127)::i8:~u8;
    out[INPUTS + O_TURN]    = clamp(cmd.angleturn::i32 / 20, -127, 127)::i8:~u8;
    var fire:   i32 = -64;
    var use:    i32 = -64;
    var change: i32 = -64;
    if ((cmd.buttons::i32 & defs.BT_ATTACK) != 0) { fire = 64; }
    if ((cmd.buttons::i32 & defs.BT_USE) != 0)    { use = 64; }
    if ((cmd.buttons::i32 & defs.BT_CHANGE) != 0) { change = 64; }
    out[INPUTS + O_FIRE]   = fire::i8:~u8;
    out[INPUTS + O_USE]    = use::i8:~u8;
    out[INPUTS + O_SWITCH] = change::i8:~u8;
    ret 1;
}

# make a player a bot
# ---
# b:    the bot
# kind: KIND_SCRIPT or KIND_NET
# net:  for a net, its 942 weights; nil otherwise
# seed: for its own noise
pub fun start(b: *Bot, kind: i32, net: *i8, seed: u32) {
    var blank: Bot;
    @b       = blank;
    b.active = 1;
    b.kind   = kind & 0xff;
    b.fists  = (kind & TRAIT_FISTS) != 0;
    b.shy    = (kind & TRAIT_SHY) != 0;
    b.quirk  = (kind >> QUIRK_SHIFT) & 7;
    b.feels  = (kind >> FEEL_SHIFT) & 0x3ffff;
    b.seed   = seed;
    b.since  = 127;
    b.want   = -1;
    if (net != nil) {
        var i: i32 = 0;
        for (i < NETSIZE) {
            b.net[i] = net[i];
            i        = i + 1;
        }
    }
}

# ------------------------------------------------------------------- tests

test feeling__goes_with_the_kind_and_none_is_fifty {
    var b: Bot;
    # a kind that says nothing: no quirk, and fifty about everyone
    start(?b, KIND_SCRIPT | TRAIT_FISTS, nil, 1);
    if (b.quirk != QUIRK_NONE || !b.fists)                           { ret 1; }
    if (feeling(?b, 2, 0) != 50 || feeling(?b, 2, 3) != 50)          { ret 2; }
    # seat 2's feelings about seats 0, 1 and 3, and a quirk
    val kind: i32 = KIND_NET | (QUIRK_LOYAL << QUIRK_SHIFT) | feel_bits(0, 0) | feel_bits(1, 100) | feel_bits(2, 37);
    start(?b, kind, nil, 1);
    if (b.kind != KIND_NET || b.quirk != QUIRK_LOYAL || b.fists)     { ret 3; }
    if (feeling(?b, 2, 0) != 0 || feeling(?b, 2, 1) != 100)          { ret 4; }
    # kept to the even number below
    if (feeling(?b, 2, 3) != 36)                                     { ret 5; }
    # and about itself, nothing
    if (feeling(?b, 2, 2) != 50)                                     { ret 6; }
    ret 0;
}

test script__faces_and_fires {
    var f:   [32]i32;
    var out: [6]i32;
    # an enemy to the left, far: turn left, come on, hold fire
    f[F_SEEN]    = 127;
    f[F_BEARING] = 30;
    f[F_CLOSE]   = 40;
    script(?f[0], ?out[0]);
    if (out[O_TURN] <= 0 || out[O_FORWARD] <= 0 || out[O_FIRE] > 0) { ret 1; }

    # dead ahead: fire
    f[F_BEARING] = 0;
    script(?f[0], ?out[0]);
    if (out[O_FIRE] <= 0) { ret 2; }

    # nothing seen and a wall ahead, open to the right: turn right
    f[F_SEEN]     = 0;
    f[F_SINCE]    = 127;
    f[F_RAYS]     = 110;
    f[F_RAYS + 1] = 120;
    script(?f[0], ?out[0]);
    if (out[O_TURN] >= 0) { ret 3; }
    ret 0;
}

test forward__zero_net_gives_zero {
    var net: [942]i8;
    var f:   [32]i32;
    var out: [6]i32;
    f[0] = 100;
    forward(?net[0], ?f[0], ?out[0]);
    var k: i32 = 0;
    for (k < OUTPUTS) {
        if (out[k] != 0) { ret 1; }
        k = k + 1;
    }
    # one input, through one hidden unit, to one output: 100 * 64/64 = 100,
    # then 100 * 32/64 = 50
    net[0]                              = 64;
    net[INPUTS * HIDDEN + HIDDEN]       = 32;
    forward(?net[0], ?f[0], ?out[0]);
    if (out[0] != 50) { ret 2; }
    ret 0;
}

fun requests_use(b: *Bot, forward: i32, side: i32) bool {
    ret b.out[O_USE] > 0 || (b.alone && b.useexit) || ((forward != 0 || side != 0) && (b.alone || !b.useexit));
}

test think__follows_route_past_distant_enemy {
    var sign: i32 = -1;
    for (sign <= 1) {
        var g: Game;
        var mo: Mobj;
        var b: Bot;
        var cmd: Ticcmd;
        g.leveltime = 1;
        g.players[0].mo = ?mo;
        g.players[0].health = 100;
        g.players[0].readyweapon = defs.WP_PISTOL;
        b.kind = KIND_SCRIPT;
        if (sign > 0) { b.kind = KIND_NET; }
        b.haveway = 1;
        b.feat[F_SEEN] = 127;
        b.feat[F_CLOSE] = 20;
        b.feat[F_PATH] = 32 * sign;
        b.feat[F_WAY] = 127;
        think(?g, 0, ?b, ?cmd);
        if (cmd.forwardmove <= 0 || cmd.angleturn::i32 * sign != 1920) { ret 1; }
        sign = sign + 2;
    }
    ret 0;
}

test think__keeps_combat_aim {
    var mode: i32 = 0;
    for (mode < 2) {
        var g: Game;
        var mo: Mobj;
        var b: Bot;
        var cmd: Ticcmd;
        g.leveltime = 1;
        g.deathmatch = mode;
        g.players[0].mo = ?mo;
        g.players[0].health = 100;
        g.players[0].readyweapon = defs.WP_PISTOL;
        b.kind = KIND_SCRIPT;
        b.haveway = 1;
        b.feat[F_SEEN] = 127;
        b.feat[F_BEARING] = -32;
        b.feat[F_CLOSE] = 80 - 60 * mode;
        b.feat[F_PATH] = 32;
        b.feat[F_WAY] = 127;
        b.out[O_FORWARD] = 100;
        b.out[O_TURN] = -127;
        think(?g, 0, ?b, ?cmd);
        if (cmd.angleturn != -1920) { ret 1; }
        mode = mode + 1;
    }
    ret 0;
}

test pickup_point__rejects_unreachable_pickups {
    var g: Game;
    var lv: level.Level;
    var sector: level.Sector;
    var subsector: level.Subsector;
    var me: Mobj;
    var item: Mobj;
    var x: Fixed = 123;
    var y: Fixed = 456;
    lv.sectors = ?sector;
    lv.subsectors = ?subsector;
    lv.numsectors = 1;
    lv.numsubsectors = 1;
    g.lv = ?lv;
    me.radius = 16 * 65536;
    me.height = 56 * 65536;
    item.radius = 20 * 65536;
    item.z = 57 * 65536;
    if (pickup_point(?g, ?me, ?item, 0, 0, ?x, ?y)) { ret 1; }
    item.z = -9 * 65536;
    if (pickup_point(?g, ?me, ?item, 0, 0, ?x, ?y)) { ret 2; }
    item.z = 0;
    me.radius = 0;
    item.radius = 0;
    if (pickup_point(?g, ?me, ?item, 0, 0, ?x, ?y)) { ret 3; }
    if (x != 123 || y != 456) { ret 4; }
    ret 0;
}

test reaches__ignores_absent_avoided_lines {
    var g: Game;
    var lv: level.Level;
    var grid: [2]u8;
    var keys: [2]u8;
    var exits: [2]u8;
    var lines: [8]u16;
    var marks: [2]u8;
    g.lv = ?lv;
    g.levelserial = 1;
    g.navserial = 1;
    g.navw = 2;
    g.navh = 1;
    grid[0] = EAST::u8;
    grid[1] = WEST::u8;
    g.navgrid = ?grid[0];
    g.navkey = ?keys[0];
    g.navout = ?exits[0];
    g.navline = ?lines[0];
    if (reaches(?g, 16 * 65536, 16 * 65536, 48 * 65536, 16 * 65536, -1, -1, ?marks[0], KEY_ALL) != 2) { ret 1; }
    marks[0] = 0;
    marks[1] = 0;
    lines[0] = 8;
    if (reaches(?g, 16 * 65536, 16 * 65536, 48 * 65536, 16 * 65536, 7, -1, ?marks[0], KEY_ALL) != -1) { ret 2; }
    ret 0;
}

test goal_bearing__exit_precedes_optional_secret {
    var g: Game;
    var lv: level.Level;
    var sector: level.Sector;
    var subsector: level.Subsector;
    var line: level.Line;
    var vertices: [2]level.Vertex;
    var grid: [3]u8;
    var keys: [3]u8;
    var exits: [3]u8;
    var lines: [12]u16;
    var distances: [3]u16;
    var me: Mobj;
    var b: Bot;
    lv.numsectors = 1;
    lv.sectors = ?sector;
    lv.numsubsectors = 1;
    lv.subsectors = ?subsector;
    lv.numlines = 1;
    lv.lines = ?line;
    lv.numvertexes = 2;
    lv.vertexes = ?vertices[0];
    sector.ceilingheight = 128 * 65536;
    sector.special = 9;
    line.special = 11;
    line.v2 = 1;
    vertices[0].x = 96 * 65536;
    vertices[1].x = 96 * 65536;
    vertices[1].y = 32 * 65536;
    g.lv = ?lv;
    g.levelserial = 1;
    g.navserial = 1;
    g.navw = 3;
    g.navh = 1;
    grid[0] = EAST::u8;
    grid[1] = (EAST | WEST)::u8;
    grid[2] = WEST::u8;
    distances[0] = 3;
    distances[1] = 2;
    distances[2] = 1;
    g.navgrid = ?grid[0];
    g.navkey = ?keys[0];
    g.navout = ?exits[0];
    g.navline = ?lines[0];
    g.navexit = ?distances[0];
    g.navax = 80 * 65536;
    g.navbx = g.navax;
    g.navay = 16 * 65536;
    g.navby = g.navay;
    g.navsecrets = 1;
    g.navsecretx[0] = 48 * 65536;
    g.navsecrety[0] = 16 * 65536;
    g.thinkercap.next = ?g.thinkercap;
    me.x = 16 * 65536;
    me.y = 16 * 65536;
    me.height = 56 * 65536;
    me.radius = 16 * 65536;
    g.players[0].mo = ?me;
    b.kind = KIND_SCRIPT;
    b.alone = 1;
    goal_bearing(?g, 0, ?b, KEY_EXIT);
    if (!b.haveway || b.after != 3) { ret 1; }
    if ((walkhave & KEY_EXIT) == 0 || sector.special != 9) { ret 2; }
    g.navexitline = -1;
    b.haveway = 0;
    goal_bearing(?g, 0, ?b, KEY_EXIT);
    if (!b.haveway || b.after != 1) { ret 3; }
    ret 0;
}

test path_bearing__human_keeps_the_level {
    var alive: i32 = 0;
    for (alive < 2) {
        var g: Game;
        var me: Mobj;
        var person: Mobj;
        var b: Bot;
        g.playeringame[0] = 1;
        g.playeringame[1] = 1;
        g.isbot[0] = 1;
        g.players[0].mo = ?me;
        g.players[1].mo = ?person;
        person.x = 64 * 65536;
        person.health = 100 * alive;
        if (path_bearing(?g, 0, ?b) != 0) { ret 1; }
        if (b.alone || !b.led || b.haveway) { ret 2; }
        alive = alive + 1;
    }
    ret 0;
}

test requests_use__stationary_bot_exit {
    var b: Bot;
    b.alone = 1;
    b.useexit = 1;
    if (!requests_use(?b, 0, 0)) { ret 1; }
    b.alone = 0;
    b.led = 1;
    if (requests_use(?b, 0, 0) || requests_use(?b, 100, 0)) { ret 2; }
    b.alone = 1;
    b.led = 0;
    b.useexit = 0;
    if (requests_use(?b, 0, 0)) { ret 3; }
    if (!requests_use(?b, 100, 0)) { ret 4; }
    ret 0;
}

test opening_door__is_not_toggled_shut {
    var g: Game;
    var lv: level.Level;
    var line: level.Line;
    var sector: level.Sector;
    var door: movers.Door;
    g.lv = ?lv;
    lv.numlines = 1;
    lv.numsectors = 1;
    lv.lines = ?line;
    lv.sectors = ?sector;
    sector.specialdata = (?door):~ptr;
    door.thinker.kind = defs.TH_DOOR;
    door.direction = 1;
    if (!opening_door(?g, 0)) { ret 1; }
    door.direction = 0;
    if (!opening_door(?g, 0)) { ret 2; }
    door.direction = -1;
    if (opening_door(?g, 0)) { ret 3; }
    door.direction = 1;
    door.thinker.kind = defs.TH_FLOOR;
    if (opening_door(?g, 0)) { ret 4; }
    sector.specialdata = nil;
    if (opening_door(?g, 0)) { ret 5; }
    ret 0;
}

test step_cost__prefers_open_floor_over_walls_and_slime {
    var g: Game;
    var out: [4]u8;
    g.navout = ?out[0];
    out[1] = NEAR::u8;
    out[2] = NEARHURT::u8;
    out[3] = HURTS::u8;
    if (step_cost(?g, 0) >= step_cost(?g, 1) || step_cost(?g, 0) >= step_cost(?g, 2)) { ret 1; }
    if (step_cost(?g, 3) < 8 * step_cost(?g, 0)) { ret 2; }
    ret 0;
}

test heap__pops_in_order {
    nheap = 0;
    heap_push(50);
    heap_push(7);
    heap_push(31);
    heap_push(7);
    heap_push(2);
    if (heap_pop() != 2 || heap_pop() != 7 || heap_pop() != 7 || heap_pop() != 31 || heap_pop() != 50 || nheap != 0) { ret 1; }
    ret 0;
}

test guess__never_overestimates_a_neighbour {
    if (guess(5, 5, 0, 10) != 0 || guess(6, 5, 0, 10) != 0) { ret 1; }
    if (guess(27, 5, 0, 10) != 12) { ret 2; }
    ret 0;
}
