val PRIORITY: [109]i32 = [109]i32{
    0, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 118, 64, 64, 64, 70,
    70, 70, 100, 100, 100, 100, 119, 78, 78, 96, 96, 96, 96, 96, 96, 78,
    78, 78, 96, 32, 98, 98, 98, 98, 98, 98, 98, 94, 92, 90, 90, 90,
    90, 90, 90, 70, 70, 70, 70, 70, 70, 32, 32, 70, 70, 70, 70, 70,
    70, 70, 70, 32, 32, 32, 32, 32, 32, 32, 32, 120, 120, 120, 100, 100,
    100, 78, 60, 64, 70, 70, 64, 60, 100, 100, 100, 32, 32, 60, 70, 70,
    70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 60
};

# an effect's priority
pub fun priority(sfx: i32) i32 {
    ret PRIORITY[sfx];
}

# write an effect's lump name, DS and its name, into a buffer of nine bytes
pub fun lump_name(sfx: i32, out: *u8) {
    out[0] = 'D';
    out[1] = 'S';
    var k: i32 = 0;
    for (k < 6) {
        out[2 + k] = NAMES[sfx * 6 + k];
        k          = k + 1;
    }
    out[8] = 0;
}

test sfx__known_rows {
    var name: [9]u8;
    lump_name(1, ?name[0]);
    if (name[2] != 'P' || name[3] != 'I' || name[7] != 'L' || name[8] != 0) { ret 1; }
    if (priority(1) != 64 || priority(0) != 0)                              { ret 2; }
    ret 0;
}
