# relay: the rendezvous server for co-op games across the internet
#
#   relay [<port>] [--impair <seed> <drop%> <dup%> <reorder%>] [--delay <ms> <jitter ms>]
#
# Games connect out to it, so no player needs to open a port. It keeps rooms
# by code and forwards each game datagram to the one player it names; it
# never reads the game inside them. Configuration comes from the command line
# or, as Fly runs it, the environment:
#
#   RELAY_BIND_HOST   address or host name to listen on (default 0.0.0.0)
#   RELAY_UDP_PORT    port (default 5029)
#   RELAY_MAX_ROOMS   rooms open at once (default 32, at most 256)
#   RELAY_LEAGUE_FILE the bot league, as the arena keeps it; read every
#                     minute, and its bots seated in games that start with
#                     seats empty (default none: the hand-written bot)
#   RELAY_FILL_SECONDS how long a public room waits before bots take its
#                     empty seats (default 120; 0 for never)
#   RELAY_SHY_ONE_IN  one game in this many that bots join has the shy bot
#                     among them (default 10; 0 for never, 1 for always)
#   RELAY_TRAIN_FILE  where to keep what players who have said they may be
#                     learned from send: how they played, for the leagues'
#                     apprentices. Written when it has changed, every
#                     RELAY_TRAIN_SECONDS (60); read back at the start.
#                     Without it nothing sent is kept.
#   RELAY_COOP_FILE   the co-op bot league, likewise, whose bots are seated
#                     in co-op games; without it they are the other league's
#   RELAY_COOP_WATCH_FILE  the co-op league's match to watch
#   RELAY_WATCH_FILE  the bot league's match to watch, as the arena leaves
#                     it; read every five seconds and handed to games that
#                     ask (default none)
#
# --impair makes it a bad network on purpose, for tests: it drops,
# duplicates and reorders the datagrams it sends, from a seeded sequence.
# --delay makes it a far one: every datagram it sends waits that long, plus
# up to the jitter more, which also reorders them.
#
# Rooms live in memory only. Restarting the relay ends every game.

use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;


use fs: std.filesystem;
use io_error: std.io.error;
use std.chrono.time;
use std.crypto.rand;
use std.net.dns;
use dnstypes: std.net.resolve.types;
use std.net.ip;
use std.allocator;
use std.allocator.page;
use std.net.udp;
use std.types.error.err;
use std.process.env;
use std.text.parse;

use core: doom.relaycore;

fun number(s: str, fallback: i64) i64 {
    val r: res[i64, parse.ParseError] = parse.parse_i64(s, 10);
    if (sel r.ok) { ret r.ok; }
    ret fallback;
}

# a setting from the environment, or nil
fun setting(name: str, buf: *u8, cap: usize) str {
    val got: res[opt[usize], env.EnvError] = env.get(name, buf, cap);
    if (sel got.err) { ret nil; }
    if (sel got.ok.none) { ret nil; }
    ret buf;
}

fun random() u64 {
    ret rand.u64();
}

fun millis() i64 {
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret 0; }
    ret now.ok.sec * 1000 + now.ok.nsec / 1000000;
}

# the network made bad on purpose
rec Impair {
    on:      bool;
    seed:    u64;
    drop:    i32;
    dup:     i32;
    reorder: i32;
    held:    bool;
    heldout: core.Out;

    # the network made far: datagrams waiting to go, and when each is due
    delay:   i64;
    jitter:  i64;
    later:   [512]core.Out;
    due:     [512]i64;
    nlater:  i32;
}

fun chance(m: *Impair) i32 {
    m.seed = m.seed * 6364136223846793005 + 1442695040888963407;
    ret ((m.seed >> 33) % 100)::i32;
}

fun send_now(sock: *udp.Socket, o: *core.Out) {
    val ep: ip.Endpoint = ip.endpoint((o.to.ip >> 24)::u8, (o.to.ip >> 16)::u8, (o.to.ip >> 8)::u8, o.to.ip::u8, o.to.port);
    udp.send_to(sock, ?o.data[0], o.len::usize, ep);
}

# send, or with --delay, hold until due
fun send_one(sock: *udp.Socket, o: *core.Out, m: *Impair, now: i64) {
    if (m.delay == 0 && m.jitter == 0) {
        send_now(sock, o);
        ret;
    }
    # a full hold drops, as a congested link would
    if (m.nlater >= 512) { ret; }
    var wait: i64 = m.delay;
    if (m.jitter > 0) { wait = wait + chance(m)::i64 * m.jitter / 100; }
    m.later[m.nlater] = @o;
    m.due[m.nlater]   = now + wait;
    m.nlater          = m.nlater + 1;
}

# send whatever held datagrams are due, keeping the rest in order
fun release(sock: *udp.Socket, m: *Impair, now: i64) {
    var kept: i32 = 0;
    var i:    i32 = 0;
    for (i < m.nlater) {
        if (m.due[i] <= now) {
            send_now(sock, ?m.later[i]);
        }
        or {
            if (kept != i) {
                m.later[kept] = m.later[i];
                m.due[kept]   = m.due[i];
            }
            kept = kept + 1;
        }
        i = i + 1;
    }
    m.nlater = kept;
}

# send what the core queued, through the impairment if any
fun flush(sock: *udp.Socket, r: *core.Relay, m: *Impair, now: i64) {
    var i: i32 = 0;
    for (i < r.nout) {
        val o: *core.Out = ?r.out[i];
        i = i + 1;
        if (!m.on) {
            send_one(sock, o, m, now);
            cnt;
        }
        if (chance(m) < m.drop) { cnt; }
        if (!m.held && chance(m) < m.reorder) {
            # keep this one back until after the next
            m.heldout = @o;
            m.held    = 1;
            cnt;
        }
        send_one(sock, o, m, now);
        if (chance(m) < m.dup) { send_one(sock, o, m, now); }
        if (m.held) {
            send_one(sock, ?m.heldout, m, now);
            m.held = 0;
        }
    }
    r.nout = 0;
}

fun event_name(what: u8) str {
    if (what == core.EV_OPENED)   { ret "opened"; }
    if (what == core.EV_JOINED)   { ret "joined"; }
    if (what == core.EV_STARTED)  { ret "started"; }
    if (what == core.EV_LEFT)     { ret "left"; }
    if (what == core.EV_TIMEDOUT) { ret "timed out"; }
    if (what == core.EV_CLOSED)   { ret "closed"; }
    ret "refused";
}

fun refusal_name(reason: i32) str {
    if (reason == 1) { ret "no such room"; }
    if (reason == 2) { ret "room full"; }
    if (reason == 3) { ret "already started"; }
    if (reason == 4) { ret "different game or WAD"; }
    if (reason == 5) { ret "different protocol version"; }
    ret "busy or rate-limited";
}

# a line for each thing that happened to a room since the last call
fun tell(r: *core.Relay) {
    var i: i32 = 0;
    for (i < r.nevents) {
        val e: *core.Event = ?r.events[i];
        var code: [7]u8;
        var k:    i32 = 0;
        for (k < 6) {
            code[k] = e.code[k];
            k       = k + 1;
        }
        code[6] = 0;
        if (e.what == core.EV_REFUSED) {
            print.printlnf("relay: refused: {}", refusal_name(e.slot));
        }
        or (e.what == core.EV_JOINED || e.what == core.EV_LEFT || e.what == core.EV_TIMEDOUT) {
            print.printlnf("relay: room {} player {} {}", ?code[0], e.slot + 1, event_name(e.what));
        }
        or (e.what == core.EV_CLOSED) {
            print.printlnf("relay: room {} closed after {} s of play", ?code[0], e.played);
        }
        or {
            print.printlnf("relay: room {} {} for {} players", ?code[0], event_name(e.what), e.players);
        }
        i = i + 1;
    }
    r.nevents = 0;
}

# read a league, if there is one, for the core to seat its bots
# ---
# into: room for 200000 bytes
# ret:  how many were read
fun read_league(into: *u8, path: str) i32 {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret 0; }
    var file: fs.File = opened.ok;
    var have: i32 = 0;
    for (have < 200000) {
        val got: res[usize, io_error.Error] = fs.read(file, ?into[have], (200000 - have)::usize);
        if (sel got.err) { brk; }
        if (got.ok == 0) { brk; }
        have = have + got.ok::i32;
    }
    fs.close(?file);
    ret have;
}

# read the samples kept from before, if there are any
fun read_train(t: *core.Train, path: str) {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret; }
    var file: fs.File = opened.ok;
    val room: i32 = 16 + core.TRAINCAP * 40;
    var have: i32 = 0;
    for (have < room) {
        val got: res[usize, io_error.Error] = fs.read(file, ?t.head[have], (room - have)::usize);
        if (sel got.err) { brk; }
        if (got.ok == 0) { brk; }
        have = have + got.ok::i32;
    }
    fs.close(?file);
    core.train_loaded(t, have);
}

# write the samples: under another name, then renamed over the old file, so
# that the arena never reads half of one
fun write_train(t: *core.Train, path: str) {
    val len: i32 = core.train_head(t);
    var temp: [600]u8;
    var k:    i32 = 0;
    for (path[k] != 0 && k < 590) {
        temp[k] = path[k];
        k       = k + 1;
    }
    temp[k]     = '.';
    temp[k + 1] = 'n';
    temp[k + 2] = 'e';
    temp[k + 3] = 'w';
    temp[k + 4] = 0;
    val wrote: err[fs.FsError] = fs.write_bytes(?temp[0], ?t.head[0], len::usize, 0o644);
    if (sel wrote.err) { ret; }
    val moved: err[io_error.Error] = fs.rename(?temp[0], path);
    if (sel moved.ok) { t.dirty = 0; }
}

# read the arena's match file, if there is one, for the core to hand out
fun read_watch(r: *core.Relay, path: str, coop: bool) {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret; }
    var file: fs.File = opened.ok;
    var data: [4096]u8;
    var have: i32 = 0;
    for (have < 4096) {
        val got: res[usize, io_error.Error] = fs.read(file, ?data[have], (4096 - have)::usize);
        if (sel got.err) { brk; }
        if (got.ok == 0) { brk; }
        have = have + got.ok::i32;
    }
    fs.close(?file);
    core.set_watch(r, ?data[0], have, coop);
}

fun report(r: *core.Relay) {
    print.printlnf("relay: rooms {} created {} started {} closed {} forwarded {} refused {} dropped {}",
        core.open_rooms(r), r.created, r.started, r.closed, r.forwarded, r.refused, r.dropped);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var hostbuf: [256]u8;
    var portbuf: [32]u8;
    var roombuf: [32]u8;
    var bindhost: str = setting("RELAY_BIND_HOST", ?hostbuf[0], 256);
    if (bindhost == nil) { bindhost = "0.0.0.0"; }
    var port: i64 = 5029;
    val portenv: str = setting("RELAY_UDP_PORT", ?portbuf[0], 32);
    if (portenv != nil) { port = number(portenv, 5029); }
    var maxrooms: i64 = 32;
    val roomenv: str = setting("RELAY_MAX_ROOMS", ?roombuf[0], 32);
    if (roomenv != nil) { maxrooms = number(roomenv, 32); }
    if (maxrooms < 1) { maxrooms = 1; }
    if (maxrooms > core.MAXROOMS::i64) { maxrooms = core.MAXROOMS::i64; }

    var leaguebuf:  [512]u8;
    val leaguefile: str = setting("RELAY_LEAGUE_FILE", ?leaguebuf[0], 512);
    var fillbuf:    [32]u8;
    var fillwait:   i64 = 120;
    val fillenv:    str = setting("RELAY_FILL_SECONDS", ?fillbuf[0], 32);
    if (fillenv != nil) { fillwait = number(fillenv, 120); }
    var shybuf: [32]u8;
    var shyin:  i64 = 10;
    val shyenv: str = setting("RELAY_SHY_ONE_IN", ?shybuf[0], 32);
    if (shyenv != nil) { shyin = number(shyenv, 10); }
    var watchbuf:  [512]u8;
    val watchfile: str = setting("RELAY_WATCH_FILE", ?watchbuf[0], 512);
    var coopbuf:     [512]u8;
    val coopfile:    str = setting("RELAY_COOP_FILE", ?coopbuf[0], 512);
    var trainbuf:    [512]u8;
    val trainfile:   str = setting("RELAY_TRAIN_FILE", ?trainbuf[0], 512);
    var trainevery:  i64 = 60;
    var trainsecbuf: [32]u8;
    val trainsec:    str = setting("RELAY_TRAIN_SECONDS", ?trainsecbuf[0], 32);
    if (trainsec != nil) { trainevery = number(trainsec, 60); }
    var lasttrain:   i64 = 0;
    var cowatchbuf:  [512]u8;
    val cowatchfile: str = setting("RELAY_COOP_WATCH_FILE", ?cowatchbuf[0], 512);

    var m: Impair;
    var i: i64 = 1;
    for (i < argc) {
        if (str_equals(argv[i], "--impair") && i + 4 < argc) {
            m.on      = 1;
            m.seed    = number(argv[i + 1], 1)::u64;
            m.drop    = number(argv[i + 2], 0)::i32;
            m.dup     = number(argv[i + 3], 0)::i32;
            m.reorder = number(argv[i + 4], 0)::i32;
            i         = i + 5;
            cnt;
        }
        if (str_equals(argv[i], "--delay") && i + 2 < argc) {
            m.delay  = number(argv[i + 1], 0);
            m.jitter = number(argv[i + 2], 0);
            i        = i + 3;
            cnt;
        }
        port = number(argv[i], port);
        i    = i + 1;
    }

    # the address to listen on: a literal, or a name such as Fly's
    # fly-global-services, looked up as IPv4
    var addr:   ip.IPv4;
    val parsed: res[ip.IPv4, ip.ParseError] = ip.ipv4_parse(bindhost);
    if (sel parsed.ok) {
        addr = parsed.ok;
    }
    or {
        val looked: res[bool, dnstypes.Error] = dns.resolve(bindhost, ?addr);
        if (sel looked.err) {
            print.eprintlnf("relay: cannot resolve {}", bindhost);
            ret 1;
        }
        if (!looked.ok) {
            print.eprintlnf("relay: cannot resolve {}", bindhost);
            ret 1;
        }
    }

    val bound: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint_v4(addr, port::u16));
    if (sel bound.err) {
        print.eprintlnf("relay: cannot listen on {}:{}", bindhost, port);
        ret 1;
    }
    var sock: udp.Socket = bound.ok;
    # a held datagram must not wait on a quiet socket
    var timeout: u64 = 100;
    if (m.delay > 0 || m.jitter > 0) { timeout = 1; }
    udp.socket_set_recv_timeout(?sock, timeout);

    var r: core.Relay;
    r.maxrooms = maxrooms::i32;
    r.random   = random;
    r.fillwait = fillwait * 1000;
    r.shyin    = shyin::i32;

    # the bots' room: too big for the stack
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.ok) {
        val room: res[*core.Bots, allocator.Error] = allocator.zallocate[core.Bots](?a, 1);
        if (sel room.ok) { r.bots = room.ok; }
        if (trainfile != nil) {
            val pool: res[*core.Train, allocator.Error] = allocator.zallocate[core.Train](?a, 1);
            if (sel pool.ok) {
                r.train = pool.ok;
                read_train(r.train, trainfile);
                print.printlnf("relay: {} samples of people's play kept for the bots", r.train.count);
            }
        }
    }

    print.printlnf("relay: listening on {}:{}, at most {} rooms", bindhost, port, maxrooms);
    if (m.on) { print.printlnf("relay: impaired: drop {}% duplicate {}% reorder {}%", m.drop, m.dup, m.reorder); }
    if (m.delay > 0 || m.jitter > 0) { print.printlnf("relay: delayed: {} ms plus up to {} ms", m.delay, m.jitter); }

    var buf:      [1500]u8;
    var lasttick: i64 = millis();
    var lastlog:  i64 = lasttick;
    var lastread: i64 = 0;
    var lastleague: i64 = -60000;
    var lastrooms: i32 = 0;
    for {
        var from: ip.Endpoint;
        val got:  res[usize, io_error.Error] = udp.recv_from(?sock, ?buf[0], 1500, ?from);
        val now:  i64 = millis();
        # an IPv6 sender is not served; the relay listens on IPv4
        if (sel got.ok) {
            var a: core.Addr;
            a.ip   = (from.addr.v4.octets[0]::u32 << 24) | (from.addr.v4.octets[1]::u32 << 16) |
                (from.addr.v4.octets[2]::u32 << 8) | from.addr.v4.octets[3]::u32;
            a.port = from.port;
            if (from.addr.is_v6 == 0) {
                core.handle(?r, ?buf[0], got.ok::i32, ?a, now);
                flush(?sock, ?r, ?m, now);
            }
        }

        if (now - lasttick >= 250) {
            core.tick(?r, now);
            flush(?sock, ?r, ?m, now);
            lasttick = now;
        }

        if (r.bots != nil && now - lastleague >= 60000) {
            if (leaguefile != nil) { r.bots.leaguelen = read_league(?r.bots.league[0], leaguefile); }
            if (coopfile != nil)   { r.bots.cooplen = read_league(?r.bots.coop[0], coopfile); }
            lastleague = now;
        }
        if (r.train != nil && r.train.dirty && now - lasttrain >= trainevery * 1000) {
            write_train(r.train, trainfile);
            lasttrain = now;
        }
        if (now - lastread >= 5000) {
            if (watchfile != nil)   { read_watch(?r, watchfile, 0); }
            if (cowatchfile != nil) { read_watch(?r, cowatchfile, 1); }
            lastread = now;
        }
        release(?sock, ?m, now);
        tell(?r);

        # a line when the number of rooms changes, and once a minute
        val rooms: i32 = core.open_rooms(?r);
        if (rooms != lastrooms || now - lastlog >= 60000) {
            report(?r);
            lastrooms = rooms;
            lastlog   = now;
        }
    }
    ret 0;
}
