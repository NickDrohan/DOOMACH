use fs: std.filesystem;
use io_error: std.io.error;
use std.chrono.time;
use std.crypto.rand;
use std.net.dns;
use dnstypes: std.net.resolve.types;
use std.net.ip;
use std.sync.cancel;
use std.allocator;
use std.allocator.page;
use std.compat.sha1;
use socket_api: std.net.socket;
use std.net.tcp;
use std.net.udp;
use std.types.error.err;
use std.process.env;
use std.text.parse;

use core: doom.relaycore;
use lf: doom.leaguefile;

fun number(s: str, fallback: i64) i64 {
    val r: res[i64, parse.ParseError] = parse.parse_i64(s, 10);
    if (sel r.ok) { ret r.ok; }
    ret fallback;
}

# a setting from the environment, or nil
fun setting(name: str, buf: *u8, cap: usize) str {
    val got: res[opt[usize], env.EnvError] = env.get(name, buf, cap);
    if (sel got.err) { ret nil; }
    if (sel got.ok.none) { ret nil; }
    ret buf;
}

fun random() u64 {
    ret rand.u64();
}

fun millis() i64 {
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret 0; }
    ret now.ok.sec * 1000 + now.ok.nsec / 1000000;
}

# the network made bad on purpose
rec Impair {
    on:      bool;
    seed:    u64;
    drop:    i32;
    dup:     i32;
    reorder: i32;
    held:    bool;
    heldout: core.Out;

    # the network made far: datagrams waiting to go, and when each is due
    delay:   i64;
    jitter:  i64;
    later:   [512]core.Out;
    due:     [512]i64;
    nlater:  i32;
}

fun chance(m: *Impair) i32 {
    m.seed = m.seed * 6364136223846793005 + 1442695040888963407;
    ret ((m.seed >> 33) % 100)::i32;
}

val MAX_TCP:    i32 = 64;
val STATE_FREE: i32 = 0;
val STATE_HTTP: i32 = 1;
val STATE_WS:   i32 = 2;

rec TcpClient {
    state:   i32;
    gen:     u16;
    stream:  tcp.Stream;
    last_ms: i64;
    rlen:    i32;
    rbuf:    [4096]u8;
}

val MAX_BOXES: i32 = 32;

rec HttpBox {
    used:    bool;
    addr:    core.Addr;
    last_ms: i64;
    len:     i32;
    data:    [4096]u8;
}

var tcp_clients: [64]TcpClient;
var next_gen:    u16 = 1;
var http_boxes:  [32]HttpBox;

fun write_all(s: *tcp.Stream, buf: *u8, len: i32) bool {
    var off:   i32 = 0;
    var tries: i32 = 0;
    for (off < len && tries < 32) {
        val wrote: res[usize, io_error.Error] = tcp.stream_write(s, ?buf[off], (len - off)::usize);
        if (sel wrote.ok) {
            if (wrote.ok == 0) { ret 0; }
            off = off + wrote.ok::i32;
        }
        or {
            if (wrote.err.kind != io_error.WOULD_BLOCK) { ret 0; }
            tries = tries + 1;
        }
    }
    ret off == len;
}

fun close_tcp_client(slot: i32) {
    if (tcp_clients[slot].state == STATE_FREE) { ret; }
    tcp.stream_close(?tcp_clients[slot].stream);
    tcp_clients[slot].state = STATE_FREE;
    tcp_clients[slot].rlen  = 0;
}

fun ws_send_frame(slot: i32, opcode: u8, payload: *u8, len: i32) {
    if (slot < 0 || slot >= MAX_TCP || tcp_clients[slot].state != STATE_WS) { ret; }
    if (len < 0 || len > 1500) { ret; }
    var frame: [1508]u8;
    frame[0] = 0x80 | opcode;
    var hlen: i32 = 2;
    if (len < 126) {
        frame[1] = len::u8;
    }
    or {
        frame[1] = 126;
        frame[2] = (len >> 8)::u8;
        frame[3] = (len & 0xff)::u8;
        hlen     = 4;
    }
    var k: i32 = 0;
    for (k < len) {
        frame[hlen + k] = payload[k];
        k               = k + 1;
    }
    if (!write_all(?tcp_clients[slot].stream, ?frame[0], hlen + len)) {
        close_tcp_client(slot);
    }
}

fun box_queue(to: core.Addr, payload: *u8, len: i32) {
    if (len <= 0 || len > 1500) { ret; }
    val now:    i64 = millis();
    var target: i32 = -1;
    var oldest: i32 = 0;
    var i:      i32 = 0;
    for (i < MAX_BOXES) {
        if (http_boxes[i].used && http_boxes[i].addr.ip == to.ip && http_boxes[i].addr.port == to.port) {
            target = i;
            brk;
        }
        if (!http_boxes[i].used && target < 0) {
            target = i;
        }
        if (http_boxes[i].last_ms < http_boxes[oldest].last_ms) {
            oldest = i;
        }
        i = i + 1;
    }
    if (target < 0) {
        target              = oldest;
        http_boxes[target].len = 0;
    }
    val b: *HttpBox = ?http_boxes[target];
    if (!b.used || b.addr.ip != to.ip || b.addr.port != to.port) {
        b.used = 1;
        b.addr = to;
        b.len  = 0;
    }
    b.last_ms = now;
    if (b.len + 2 + len > 4096) { ret; }
    b.data[b.len]     = (len & 0xff)::u8;
    b.data[b.len + 1] = ((len >> 8) & 0xff)::u8;
    var k: i32 = 0;
    for (k < len) {
        b.data[b.len + 2 + k] = payload[k];
        k                     = k + 1;
    }
    b.len = b.len + 2 + len;
}

fun send_now(sock: *udp.Socket, o: *core.Out) {
    if ((o.to.ip & 0xffffff00) == 0x7f000000) {
        val slot: i32 = (o.to.ip & 0xff)::i32;
        if (slot >= 0 && slot < MAX_TCP && tcp_clients[slot].state == STATE_WS && tcp_clients[slot].gen == o.to.port) {
            ws_send_frame(slot, 2, ?o.data[0], o.len);
        }
        ret;
    }
    if ((o.to.ip & 0xff000000) == 0x7e000000) {
        box_queue(o.to, ?o.data[0], o.len);
        ret;
    }
    val ep: ip.Endpoint = ip.endpoint((o.to.ip >> 24)::u8, (o.to.ip >> 16)::u8, (o.to.ip >> 8)::u8, o.to.ip::u8, o.to.port);
    udp.send_to(sock, ?o.data[0], o.len::usize, ep);
}

# send, or with --delay, hold until due
fun send_one(sock: *udp.Socket, o: *core.Out, m: *Impair, now: i64) {
    if (m.delay == 0 && m.jitter == 0) {
        send_now(sock, o);
        ret;
    }
    # a full hold drops, as a congested link would
    if (m.nlater >= 512) { ret; }
    var wait: i64 = m.delay;
    if (m.jitter > 0) { wait = wait + chance(m)::i64 * m.jitter / 100; }
    m.later[m.nlater] = @o;
    m.due[m.nlater]   = now + wait;
    m.nlater          = m.nlater + 1;
}

# send whatever held datagrams are due, keeping the rest in order
fun release(sock: *udp.Socket, m: *Impair, now: i64) {
    var kept: i32 = 0;
    var i:    i32 = 0;
    for (i < m.nlater) {
        if (m.due[i] <= now) {
            send_now(sock, ?m.later[i]);
        }
        or {
            if (kept != i) {
                m.later[kept] = m.later[i];
                m.due[kept]   = m.due[i];
            }
            kept = kept + 1;
        }
        i = i + 1;
    }
    m.nlater = kept;
}

# send what the core queued, through the impairment if any
fun flush(sock: *udp.Socket, r: *core.Relay, m: *Impair, now: i64) {
    var i: i32 = 0;
    for (i < r.nout) {
        val o: *core.Out = ?r.out[i];
        i = i + 1;
        if (!m.on) {
            send_one(sock, o, m, now);
            cnt;
        }
        if (chance(m) < m.drop) { cnt; }
        if (!m.held && chance(m) < m.reorder) {
            # keep this one back until after the next
            m.heldout = @o;
            m.held    = 1;
            cnt;
        }
        send_one(sock, o, m, now);
        if (chance(m) < m.dup) { send_one(sock, o, m, now); }
        if (m.held) {
            send_one(sock, ?m.heldout, m, now);
            m.held = 0;
        }
    }
    r.nout = 0;
}

fun event_name(what: u8) str {
    if (what == core.EV_OPENED)   { ret "opened"; }
    if (what == core.EV_JOINED)   { ret "joined"; }
    if (what == core.EV_STARTED)  { ret "started"; }
    if (what == core.EV_LEFT)     { ret "left"; }
    if (what == core.EV_TIMEDOUT) { ret "timed out"; }
    if (what == core.EV_CLOSED)   { ret "closed"; }
    ret "refused";
}

fun refusal_name(reason: i32) str {
    if (reason == 1) { ret "no such room"; }
    if (reason == 2) { ret "room full"; }
    if (reason == 3) { ret "already started"; }
    if (reason == 4) { ret "different game or WAD"; }
    if (reason == 5) { ret "different protocol version"; }
    ret "busy or rate-limited";
}

# a line for each thing that happened to a room since the last call
fun tell(r: *core.Relay) {
    var i: i32 = 0;
    for (i < r.nevents) {
        val e: *core.Event = ?r.events[i];
        var code: [7]u8;
        var k:    i32 = 0;
        for (k < 6) {
            code[k] = e.code[k];
            k       = k + 1;
        }
        code[6] = 0;
        if (e.what == core.EV_REFUSED) {
            print.printlnf("relay: refused: {}", refusal_name(e.slot));
        }
        or (e.what == core.EV_DESYNC) {
            print.printlnf("relay: room {} DESYNC at tic {}", ?code[0], e.slot);
        }
        or (e.what == core.EV_JOINED || e.what == core.EV_LEFT || e.what == core.EV_TIMEDOUT) {
            print.printlnf("relay: room {} player {} {}", ?code[0], e.slot + 1, event_name(e.what));
        }
        or (e.what == core.EV_CLOSED) {
            print.printlnf("relay: room {} closed after {} s of play", ?code[0], e.played);
        }
        or {
            print.printlnf("relay: room {} {} for {} players", ?code[0], event_name(e.what), e.players);
        }
        i = i + 1;
    }
    r.nevents = 0;
}

# read a league, if there is one, for the core to seat its bots: one of
# the first shape of net is widened as it is read (leaguefile.upgrade), so
# that a relay started before the arena has rewritten it still seats bots
# ---
# into: room for core.LEAGUEROOM bytes
# ret:  how many there are
var leaguetmp: [300000]u8;
fun read_league(into: *u8, path: str) i32 {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret 0; }
    var file: fs.File = opened.ok;
    var have: i32 = 0;
    for (have < core.LEAGUEROOM) {
        val got: res[usize, io_error.Error] = fs.read(file, ?leaguetmp[have], (core.LEAGUEROOM - have)::usize);
        if (sel got.err) { brk; }
        if (got.ok == 0) { brk; }
        have = have + got.ok::i32;
    }
    fs.close(?file);
    if (lf.upgrade(?leaguetmp[0], have, into)) { ret lf.FILE_BYTES; }
    var k: i32 = 0;
    for (k < have) {
        into[k] = leaguetmp[k];
        k       = k + 1;
    }
    ret have;
}

# read the samples kept from before, if there are any
fun read_train(t: *core.Train, path: str) {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret; }
    var file: fs.File = opened.ok;
    val room: i32 = 16 + core.TRAINCAP * 40;
    var have: i32 = 0;
    for (have < room) {
        val got: res[usize, io_error.Error] = fs.read(file, ?t.head[have], (room - have)::usize);
        if (sel got.err) { brk; }
        if (got.ok == 0) { brk; }
        have = have + got.ok::i32;
    }
    fs.close(?file);
    core.train_loaded(t, have);
}

# write the samples: under another name, then renamed over the old file, so
# that the arena never reads half of one
fun write_train(t: *core.Train, path: str) {
    val len: i32 = core.train_head(t);
    var temp: [600]u8;
    var k:    i32 = 0;
    for (path[k] != 0 && k < 590) {
        temp[k] = path[k];
        k       = k + 1;
    }
    temp[k]     = '.';
    temp[k + 1] = 'n';
    temp[k + 2] = 'e';
    temp[k + 3] = 'w';
    temp[k + 4] = 0;
    val wrote: err[fs.FsError] = fs.write_bytes(?temp[0], ?t.head[0], len::usize, 0o644);
    if (sel wrote.err) { ret; }
    val moved: err[io_error.Error] = fs.rename(?temp[0], path);
    if (sel moved.ok) { t.dirty = 0; }
}

# read the arena's match file, if there is one, for the core to hand out
fun read_watch(r: *core.Relay, path: str) {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret; }
    var file: fs.File = opened.ok;
    var data: [8192]u8;
    var have: i32 = 0;
    for (have < 8192) {
        val got: res[usize, io_error.Error] = fs.read(file, ?data[have], (8192 - have)::usize);
        if (sel got.err) { brk; }
        if (got.ok == 0) { brk; }
        have = have + got.ok::i32;
    }
    fs.close(?file);
    core.set_watch(r, ?data[0], have);
}

fun report(r: *core.Relay) {
    print.printlnf("relay: rooms {} created {} started {} closed {} forwarded {} refused {} dropped {}",
        core.open_rooms(r), r.created, r.started, r.closed, r.forwarded, r.refused, r.dropped);
}

fun report_rooms(r: *core.Relay, now: i64) {
    var i: i32 = 0;
    for (i < r.maxrooms) {
        val room: *core.Room = ?r.rooms[i];
        i = i + 1;
        if (!room.used) { cnt; }
        var code: [7]u8;
        var k:    i32 = 0;
        for (k < 6) {
            code[k] = room.code[k];
            k       = k + 1;
        }
        code[6] = 0;
        var here:   i32 = 0;
        var nbots:  i32 = 0;
        var maxtic: i32 = -1;
        var mintic: i32 = 0x7fffffff;
        var maxage: i64 = 0;
        var s:      i32 = 0;
        for (s < room.players) {
            if ((room.botmask & (1 << s)) != 0) {
                nbots = nbots + 1;
            }
            or (room.slots[s].used) {
                here = here + 1;
                val age: i64 = now - room.slots[s].lastseen;
                if (age > maxage) { maxage = age; }
                val ct: i32 = room.slots[s].checktic;
                if (ct > maxtic) { maxtic = ct; }
                if (ct >= 0 && ct < mintic) { mintic = ct; }
            }
            s = s + 1;
        }
        if (!room.started) {
            print.printlnf("relay: room {} lobby: {}/{} joined map E1M{} skill {} max-age {}ms",
                ?code[0], here, room.players, room.map, room.skill, maxage);
        }
        or {
            var lag: i32 = 0;
            if (maxtic >= 0 && mintic != 0x7fffffff && maxtic >= mintic) { lag = maxtic - mintic; }
            var sync: str = "ok";
            if (room.desync) { sync = "DESYNC"; }
            print.printlnf("relay: room {} playing {}s: {}/{} humans ({} bots) map E1M{} tic {} lag {}t max-age {}ms sync {} pkts {}",
                ?code[0], (now - room.began) / 1000, here, room.players, nbots, room.map, maxtic, lag, maxage, sync, room.forwarded);
        }
    }
}

fun lower_ascii(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun hex_val(c: u8) i32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a' + 10)::i32; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A' + 10)::i32; }
    ret -1;
}

fun base64_20(src: *u8, out: *u8) {
    val tab: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var i:   i32 = 0;
    var j:   i32 = 0;
    for (i < 18) {
        val v: u32 = (src[i]::u32 << 16) | (src[i + 1]::u32 << 8) | src[i + 2]::u32;
        out[j]     = tab[(v >> 18) & 63];
        out[j + 1] = tab[(v >> 12) & 63];
        out[j + 2] = tab[(v >> 6) & 63];
        out[j + 3] = tab[v & 63];
        i          = i + 3;
        j          = j + 4;
    }
    val tail: u32 = (src[18]::u32 << 16) | (src[19]::u32 << 8);
    out[24] = tab[(tail >> 18) & 63];
    out[25] = tab[(tail >> 12) & 63];
    out[26] = tab[(tail >> 6) & 63];
    out[27] = '=';
    out[28] = 0;
}

fun find_header_end(buf: *u8, len: i32) i32 {
    var i: i32 = 0;
    for (i + 3 < len) {
        if (buf[i] == 13 && buf[i + 1] == 10 && buf[i + 2] == 13 && buf[i + 3] == 10) {
            ret i + 4;
        }
        i = i + 1;
    }
    ret -1;
}

fun find_ws_key(buf: *u8, hlen: i32, key_out: *u8) i32 {
    val needle: str = "sec-websocket-key:";
    var i:      i32 = 0;
    for (i + 18 < hlen) {
        var match: bool = 1;
        var k:     i32  = 0;
        for (k < 18) {
            if (lower_ascii(buf[i + k]) != needle[k]) {
                match = 0;
                brk;
            }
            k = k + 1;
        }
        if (match) {
            var at: i32 = i + 18;
            for (at < hlen && (buf[at] == ' ' || buf[at] == 9)) { at = at + 1; }
            var n: i32 = 0;
            for (at + n < hlen && buf[at + n] != 13 && buf[at + n] != 10 && buf[at + n] != ' ' && n < 60) {
                key_out[n] = buf[at + n];
                n          = n + 1;
            }
            key_out[n] = 0;
            ret n;
        }
        i = i + 1;
    }
    ret 0;
}

fun shift_rbuf(c: *TcpClient, consumed: i32) {
    if (consumed >= c.rlen) {
        c.rlen = 0;
        ret;
    }
    val rem: i32 = c.rlen - consumed;
    var i:   i32 = 0;
    for (i < rem) {
        c.rbuf[i] = c.rbuf[consumed + i];
        i         = i + 1;
    }
    c.rlen = rem;
}

fun append_str(dst: *u8, at: i32, s: str) i32 {
    var i: i32 = 0;
    for (s[i] != 0) {
        dst[at + i] = s[i];
        i           = i + 1;
    }
    ret at + i;
}

fun append_dec(dst: *u8, at: i32, val_in: i32) i32 {
    var digits: [16]u8;
    var n:      i32 = 0;
    var v:      i32 = val_in;
    if (v <= 0) {
        dst[at] = '0';
        ret at + 1;
    }
    for (v > 0) {
        digits[n] = ('0' + (v % 10))::u8;
        n         = n + 1;
        v         = v / 10;
    }
    var pos: i32 = at;
    for (n > 0) {
        n        = n - 1;
        dst[pos] = digits[n];
        pos      = pos + 1;
    }
    ret pos;
}

fun append_signed(dst: *u8, at: i32, val_in: i32) i32 {
    if (val_in < 0) {
        dst[at] = '-';
        ret append_dec(dst, at + 1, 0 - val_in);
    }
    ret append_dec(dst, at, val_in);
}

fun append_bool(dst: *u8, at: i32, b: bool) i32 {
    if (b) { ret append_str(dst, at, "true"); }
    ret append_str(dst, at, "false");
}

fun handle_http_status(slot: i32, r: *core.Relay, now: i64) bool {
    val c: *TcpClient = ?tcp_clients[slot];
    var body: [7600]u8;
    var bpos: i32 = 0;
    bpos = append_str(?body[0], bpos, "{\"open_rooms\":");
    bpos = append_dec(?body[0], bpos, core.open_rooms(r));
    bpos = append_str(?body[0], bpos, ",\"created\":");
    bpos = append_dec(?body[0], bpos, r.created::i32);
    bpos = append_str(?body[0], bpos, ",\"started\":");
    bpos = append_dec(?body[0], bpos, r.started::i32);
    bpos = append_str(?body[0], bpos, ",\"closed\":");
    bpos = append_dec(?body[0], bpos, r.closed::i32);
    bpos = append_str(?body[0], bpos, ",\"forwarded\":");
    bpos = append_dec(?body[0], bpos, r.forwarded::i32);
    bpos = append_str(?body[0], bpos, ",\"refused\":");
    bpos = append_dec(?body[0], bpos, r.refused::i32);
    bpos = append_str(?body[0], bpos, ",\"dropped\":");
    bpos = append_dec(?body[0], bpos, r.dropped::i32);
    bpos = append_str(?body[0], bpos, ",\"rooms\":[");

    var first_room: bool = 1;
    var i:          i32  = 0;
    for (i < r.maxrooms && bpos < 6800) {
        val room: *core.Room = ?r.rooms[i];
        i = i + 1;
        if (!room.used) { cnt; }
        if (!first_room) { bpos = append_str(?body[0], bpos, ","); }
        first_room = 0;

        var code: [7]u8;
        var k:    i32 = 0;
        for (k < 6) {
            code[k] = room.code[k];
            k       = k + 1;
        }
        code[6] = 0;

        var here:   i32 = 0;
        var nbots:  i32 = 0;
        var maxtic: i32 = -1;
        var mintic: i32 = 0x7fffffff;
        var s:      i32 = 0;
        for (s < room.players) {
            if ((room.botmask & (1 << s)) != 0) {
                nbots = nbots + 1;
            }
            or (room.slots[s].used) {
                here = here + 1;
                val ct: i32 = room.slots[s].checktic;
                if (ct > maxtic) { maxtic = ct; }
                if (ct >= 0 && ct < mintic) { mintic = ct; }
            }
            s = s + 1;
        }
        var lag: i32 = 0;
        if (maxtic >= 0 && mintic != 0x7fffffff && maxtic >= mintic) { lag = maxtic - mintic; }
        var played: i32 = 0;
        if (room.started && now > room.began) { played = ((now - room.began) / 1000)::i32; }

        bpos = append_str(?body[0], bpos, "{\"code\":\"");
        bpos = append_str(?body[0], bpos, ?code[0]);
        bpos = append_str(?body[0], bpos, "\",\"mode\":\"");
        if (room.deathmatch) { bpos = append_str(?body[0], bpos, "dm"); }
        or                   { bpos = append_str(?body[0], bpos, "coop"); }
        bpos = append_str(?body[0], bpos, "\",\"started\":");
        bpos = append_bool(?body[0], bpos, room.started);
        bpos = append_str(?body[0], bpos, ",\"public\":");
        bpos = append_bool(?body[0], bpos, room.public);
        bpos = append_str(?body[0], bpos, ",\"map\":");
        bpos = append_dec(?body[0], bpos, room.map);
        bpos = append_str(?body[0], bpos, ",\"skill\":");
        bpos = append_dec(?body[0], bpos, room.skill);
        bpos = append_str(?body[0], bpos, ",\"players\":");
        bpos = append_dec(?body[0], bpos, room.players);
        bpos = append_str(?body[0], bpos, ",\"joined\":");
        bpos = append_dec(?body[0], bpos, here);
        bpos = append_str(?body[0], bpos, ",\"bots\":");
        bpos = append_dec(?body[0], bpos, nbots);
        bpos = append_str(?body[0], bpos, ",\"played_s\":");
        bpos = append_dec(?body[0], bpos, played);
        bpos = append_str(?body[0], bpos, ",\"tic\":");
        bpos = append_signed(?body[0], bpos, maxtic);
        bpos = append_str(?body[0], bpos, ",\"lag_tics\":");
        bpos = append_dec(?body[0], bpos, lag);
        bpos = append_str(?body[0], bpos, ",\"desync\":");
        bpos = append_bool(?body[0], bpos, room.desync);
        bpos = append_str(?body[0], bpos, ",\"desync_tic\":");
        bpos = append_signed(?body[0], bpos, room.desynctic);
        bpos = append_str(?body[0], bpos, ",\"forwarded\":");
        bpos = append_dec(?body[0], bpos, room.forwarded::i32);
        bpos = append_str(?body[0], bpos, ",\"seats\":[");

        var first_seat: bool = 1;
        s = 0;
        for (s < room.players) {
            if ((room.botmask & (1 << s)) != 0) {
                if (!first_seat) { bpos = append_str(?body[0], bpos, ","); }
                first_seat = 0;
                bpos = append_str(?body[0], bpos, "{\"seat\":");
                bpos = append_dec(?body[0], bpos, s + 1);
                bpos = append_str(?body[0], bpos, ",\"transport\":\"bot\",\"validated\":true,\"age_ms\":0,\"tic\":");
                bpos = append_signed(?body[0], bpos, maxtic);
                bpos = append_str(?body[0], bpos, ",\"make_tic\":");
                bpos = append_signed(?body[0], bpos, maxtic);
                bpos = append_str(?body[0], bpos, ",\"ack_tic\":");
                bpos = append_signed(?body[0], bpos, maxtic);
                bpos = append_str(?body[0], bpos, ",\"packets\":0}");
            }
            or (room.slots[s].used) {
                if (!first_seat) { bpos = append_str(?body[0], bpos, ","); }
                first_seat = 0;
                val sl: *core.Slot = ?room.slots[s];
                var tr: str = "udp";
                if ((sl.addr.ip & 0xffffff00) == 0x7f000000) { tr = "ws"; }
                or ((sl.addr.ip & 0xff000000) == 0x7e000000) { tr = "https"; }
                var age: i32 = 0;
                if (now > sl.lastseen) { age = (now - sl.lastseen)::i32; }
                bpos = append_str(?body[0], bpos, "{\"seat\":");
                bpos = append_dec(?body[0], bpos, s + 1);
                bpos = append_str(?body[0], bpos, ",\"transport\":\"");
                bpos = append_str(?body[0], bpos, tr);
                bpos = append_str(?body[0], bpos, "\",\"validated\":");
                bpos = append_bool(?body[0], bpos, sl.validated);
                bpos = append_str(?body[0], bpos, ",\"age_ms\":");
                bpos = append_dec(?body[0], bpos, age);
                bpos = append_str(?body[0], bpos, ",\"tic\":");
                bpos = append_signed(?body[0], bpos, sl.checktic);
                bpos = append_str(?body[0], bpos, ",\"make_tic\":");
                bpos = append_dec(?body[0], bpos, sl.maketic);
                bpos = append_str(?body[0], bpos, ",\"ack_tic\":");
                bpos = append_dec(?body[0], bpos, sl.acktic);
                bpos = append_str(?body[0], bpos, ",\"packets\":");
                bpos = append_dec(?body[0], bpos, sl.packets);
                bpos = append_str(?body[0], bpos, "}");
            }
            s = s + 1;
        }
        bpos = append_str(?body[0], bpos, "]}");
    }
    bpos = append_str(?body[0], bpos, "]}\n");

    var resp: [8000]u8;
    var pos:  i32 = append_str(?resp[0], 0, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\nContent-Length: ");
    pos = append_dec(?resp[0], pos, bpos);
    pos = append_str(?resp[0], pos, "\r\n\r\n");
    var k: i32 = 0;
    for (k < bpos) {
        resp[pos + k] = body[k];
        k             = k + 1;
    }
    ret write_all(?c.stream, ?resp[0], pos + bpos);
}

fun handle_http_net(slot: i32, hlen: i32, sock: *udp.Socket, r: *core.Relay, m: *Impair, now: i64) bool {
    val c:   *TcpClient = ?tcp_clients[slot];
    val buf: *u8        = ?c.rbuf[0];
    # GET /net/<8-hex-cid>/<hex-packets> HTTP/1.1
    var at: i32 = 9;
    if (at + 8 > hlen) { ret 0; }
    var cid: u32 = 0;
    var k:   i32 = 0;
    for (k < 8) {
        val hv: i32 = hex_val(buf[at + k]);
        if (hv < 0) { ret 0; }
        cid = (cid << 4) | hv::u32;
        k   = k + 1;
    }
    at = at + 8;
    var addr: core.Addr;
    addr.ip   = 0x7e000000 | ((cid >> 16) & 0xffff);
    addr.port = (cid & 0xffff)::u16;

    if (at < hlen && buf[at] == '/') {
        at = at + 1;
        var pkt:  [1500]u8;
        var plen: i32 = 0;
        for (at + 1 < hlen && buf[at] != ' ' && buf[at] != '?' && buf[at] != 13 && buf[at] != 10) {
            if (buf[at] == '.' || buf[at] == '-') {
                if (plen >= 16) {
                    core.handle(r, ?pkt[0], plen, ?addr, now);
                    flush(sock, r, m, now);
                }
                plen = 0;
                at   = at + 1;
                cnt;
            }
            val hi: i32 = hex_val(buf[at]);
            val lo: i32 = hex_val(buf[at + 1]);
            if (hi < 0 || lo < 0) { brk; }
            if (plen < 1500) {
                pkt[plen] = ((hi << 4) | lo)::u8;
                plen      = plen + 1;
            }
            at = at + 2;
        }
        if (plen >= 16) {
            core.handle(r, ?pkt[0], plen, ?addr, now);
            flush(sock, r, m, now);
        }
    }

    var resp: [4300]u8;
    var body_ptr: *u8 = nil;
    var body_len: i32 = 0;
    var i: i32 = 0;
    for (i < MAX_BOXES) {
        if (http_boxes[i].used && http_boxes[i].addr.ip == addr.ip && http_boxes[i].addr.port == addr.port) {
            body_ptr          = ?http_boxes[i].data[0];
            body_len          = http_boxes[i].len;
            http_boxes[i].len = 0;
            http_boxes[i].last_ms = now;
            brk;
        }
        i = i + 1;
    }

    var pos: i32 = append_str(?resp[0], 0, "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\nContent-Length: ");
    pos = append_dec(?resp[0], pos, body_len);
    pos = append_str(?resp[0], pos, "\r\n\r\n");
    if (body_len > 0 && body_ptr != nil) {
        k = 0;
        for (k < body_len) {
            resp[pos + k] = body_ptr[k];
            k             = k + 1;
        }
        pos = pos + body_len;
    }
    ret write_all(?c.stream, ?resp[0], pos);
}

fun step_tcp_client(slot: i32, sock: *udp.Socket, r: *core.Relay, m: *Impair, now: i64) {
    val c: *TcpClient = ?tcp_clients[slot];
    if (c.state == STATE_FREE) { ret; }

    if (c.rlen < 4096) {
        val got: res[usize, io_error.Error] = tcp.stream_read(?c.stream, ?c.rbuf[c.rlen], (4096 - c.rlen)::usize);
        if (sel got.ok) {
            if (got.ok == 0) {
                close_tcp_client(slot);
                ret;
            }
            c.rlen    = c.rlen + got.ok::i32;
            c.last_ms = now;
        }
        or {
            if (got.err.kind != io_error.WOULD_BLOCK && got.err.kind != io_error.TIMEOUT) {
                close_tcp_client(slot);
                ret;
            }
        }
    }

    if (c.state == STATE_HTTP) {
        for (c.rlen > 0) {
            val hlen: i32 = find_header_end(?c.rbuf[0], c.rlen);
            if (hlen < 0) {
                if (c.rlen >= 4096) { close_tcp_client(slot); }
                ret;
            }
            var key: [64]u8;
            val klen: i32 = find_ws_key(?c.rbuf[0], hlen, ?key[0]);
            if (klen > 0) {
                val guid: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
                var g:    i32 = 0;
                for (g < 36) {
                    key[klen + g] = guid[g];
                    g             = g + 1;
                }
                var digest: [20]u8;
                sha1.hash(?key[0], (klen + 36)::usize, ?digest[0]);
                var accept: [32]u8;
                base64_20(?digest[0], ?accept[0]);

                var resp: [256]u8;
                var pos:  i32 = append_str(?resp[0], 0, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ");
                pos = append_str(?resp[0], pos, ?accept[0]);
                pos = append_str(?resp[0], pos, "\r\n\r\n");
                if (!write_all(?c.stream, ?resp[0], pos)) {
                    close_tcp_client(slot);
                    ret;
                }
                c.state = STATE_WS;
                shift_rbuf(c, hlen);
                brk;
            }
            if (hlen >= 15 && c.rbuf[0] == 'G' && c.rbuf[1] == 'E' && c.rbuf[2] == 'T' && c.rbuf[3] == ' ' && c.rbuf[4] == '/' && c.rbuf[5] == 'n' && c.rbuf[6] == 'e' && c.rbuf[7] == 't' && c.rbuf[8] == '/') {
                if (c.rbuf[9] == 's' && c.rbuf[10] == 't' && c.rbuf[11] == 'a' && c.rbuf[12] == 't' && c.rbuf[13] == 'u' && c.rbuf[14] == 's') {
                    if (!handle_http_status(slot, r, now)) {
                        close_tcp_client(slot);
                        ret;
                    }
                    shift_rbuf(c, hlen);
                    cnt;
                }
                if (hlen >= 17 && handle_http_net(slot, hlen, sock, r, m, now)) {
                    shift_rbuf(c, hlen);
                    cnt;
                }
                close_tcp_client(slot);
                ret;
            }
            close_tcp_client(slot);
            ret;
        }
    }

    if (c.state == STATE_WS) {
        for (c.rlen >= 2) {
            val b0:     u8   = c.rbuf[0];
            val b1:     u8   = c.rbuf[1];
            val opcode: u8   = b0 & 0x0f;
            val masked: bool = (b1 & 0x80) != 0;
            var plen:   i32  = (b1 & 0x7f)::i32;
            var hlen:   i32  = 2;
            if (plen == 126) {
                if (c.rlen < 4) { brk; }
                plen = (c.rbuf[2]::i32 << 8) | c.rbuf[3]::i32;
                hlen = 4;
            }
            or (plen == 127) {
                close_tcp_client(slot);
                ret;
            }
            if (masked) { hlen = hlen + 4; }
            if (plen > 1500) {
                close_tcp_client(slot);
                ret;
            }
            if (c.rlen < hlen + plen) { brk; }

            var pkt: [1500]u8;
            var k:   i32 = 0;
            if (masked) {
                val moff: i32 = hlen - 4;
                for (k < plen) {
                    pkt[k] = c.rbuf[hlen + k] ^ c.rbuf[moff + (k & 3)];
                    k      = k + 1;
                }
            }
            or {
                for (k < plen) {
                    pkt[k] = c.rbuf[hlen + k];
                    k      = k + 1;
                }
            }
            shift_rbuf(c, hlen + plen);

            if (opcode == 8) {
                close_tcp_client(slot);
                ret;
            }
            if (opcode == 9) {
                ws_send_frame(slot, 10, ?pkt[0], plen);
                cnt;
            }
            if ((opcode == 1 || opcode == 2) && plen >= 16) {
                var a: core.Addr;
                a.ip   = 0x7f000000 | slot::u32;
                a.port = c.gen;
                core.handle(r, ?pkt[0], plen, ?a, now);
                flush(sock, r, m, now);
            }
        }
    }
}

fun poll_tcp(ln: *tcp.Listener, has_ln: bool, sock: *udp.Socket, r: *core.Relay, m: *Impair, now: i64) i32 {
    if (has_ln) {
        for {
            val acc: res[tcp.Stream, io_error.Error] = tcp.accept_with_flags(ln, socket_api.async_flags());
            if (sel acc.err) { brk; }
            var stream: tcp.Stream = acc.ok;
            socket_api.set_bool(stream.handle, socket_api.NO_DELAY, 1);
            var slot:   i32 = -1;
            var oldest: i32 = 0;
            var i:      i32 = 0;
            for (i < MAX_TCP) {
                if (tcp_clients[i].state == STATE_FREE) {
                    slot = i;
                    brk;
                }
                if (tcp_clients[i].last_ms < tcp_clients[oldest].last_ms) {
                    oldest = i;
                }
                i = i + 1;
            }
            if (slot < 0) {
                close_tcp_client(oldest);
                slot = oldest;
            }
            next_gen = next_gen + 1;
            if (next_gen == 0) { next_gen = 1; }
            tcp_clients[slot].state   = STATE_HTTP;
            tcp_clients[slot].gen     = next_gen;
            tcp_clients[slot].stream  = stream;
            tcp_clients[slot].last_ms = now;
            tcp_clients[slot].rlen    = 0;
        }
    }
    var active: i32 = 0;
    var i:      i32 = 0;
    for (i < MAX_TCP) {
        if (tcp_clients[i].state != STATE_FREE) {
            if (now - tcp_clients[i].last_ms > 60000) {
                close_tcp_client(i);
            }
            or {
                step_tcp_client(i, sock, r, m, now);
                if (tcp_clients[i].state != STATE_FREE) { active = active + 1; }
            }
        }
        i = i + 1;
    }
    ret active;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var hostbuf: [256]u8;
    var portbuf: [32]u8;
    var roombuf: [32]u8;
    var bindhost: str = setting("RELAY_BIND_HOST", ?hostbuf[0], 256);
    if (bindhost == nil) { bindhost = "0.0.0.0"; }
    var port: i64 = 5029;
    val portenv: str = setting("RELAY_UDP_PORT", ?portbuf[0], 32);
    if (portenv != nil) { port = number(portenv, 5029); }
    var maxrooms: i64 = 32;
    val roomenv: str = setting("RELAY_MAX_ROOMS", ?roombuf[0], 32);
    if (roomenv != nil) { maxrooms = number(roomenv, 32); }
    if (maxrooms < 1) { maxrooms = 1; }
    if (maxrooms > core.MAXROOMS::i64) { maxrooms = core.MAXROOMS::i64; }

    var leaguebuf:  [512]u8;
    val leaguefile: str = setting("RELAY_LEAGUE_FILE", ?leaguebuf[0], 512);
    var fillbuf:    [32]u8;
    var fillwait:   i64 = 120;
    val fillenv:    str = setting("RELAY_FILL_SECONDS", ?fillbuf[0], 32);
    if (fillenv != nil) { fillwait = number(fillenv, 120); }
    var shybuf: [32]u8;
    var shyin:  i64 = 10;
    val shyenv: str = setting("RELAY_SHY_ONE_IN", ?shybuf[0], 32);
    if (shyenv != nil) { shyin = number(shyenv, 10); }
    var cohortbuf: [16]u8;
    var cohort: i64 = 0;
    val cohortenv: str = setting("COOP_COHORT", ?cohortbuf[0], 16);
    if (cohortenv != nil) { cohort = number(cohortenv, -1); }
    if (cohort != 0 && cohort != 4) { print.eprintln("relay: COOP_COHORT must be 0 or 4"); ret 1; }
    var watchbuf:  [512]u8;
    val watchfile: str = setting("RELAY_WATCH_FILE", ?watchbuf[0], 512);
    var coopbuf:     [512]u8;
    val coopfile:    str = setting("RELAY_COOP_FILE", ?coopbuf[0], 512);
    var trainbuf:    [512]u8;
    val trainfile:   str = setting("RELAY_TRAIN_FILE", ?trainbuf[0], 512);
    var trainevery:  i64 = 60;
    var trainsecbuf: [32]u8;
    val trainsec:    str = setting("RELAY_TRAIN_SECONDS", ?trainsecbuf[0], 32);
    if (trainsec != nil) { trainevery = number(trainsec, 60); }
    var lasttrain:   i64 = 0;

    var m: Impair;
    var i: i64 = 1;
    for (i < argc) {
        if (str_equals(argv[i], "--impair") && i + 4 < argc) {
            m.on      = 1;
            m.seed    = number(argv[i + 1], 1)::u64;
            m.drop    = number(argv[i + 2], 0)::i32;
            m.dup     = number(argv[i + 3], 0)::i32;
            m.reorder = number(argv[i + 4], 0)::i32;
            i         = i + 5;
            cnt;
        }
        if (str_equals(argv[i], "--delay") && i + 2 < argc) {
            m.delay  = number(argv[i + 1], 0);
            m.jitter = number(argv[i + 2], 0);
            i        = i + 3;
            cnt;
        }
        port = number(argv[i], port);
        i    = i + 1;
    }

    # the address to listen on: a literal, or a name such as Fly's
    # fly-global-services, looked up as IPv4
    var addr:   ip.IPv4;
    val parsed: res[ip.IPv4, ip.ParseError] = ip.ipv4_parse(bindhost);
    if (sel parsed.ok) {
        addr = parsed.ok;
    }
    or {
        var scope: cancel.Scope;
        cancel.make_root(?scope, opt[time.Instant].none{});
        val looked: res[bool, dnstypes.Error] = dns.resolve(?scope, bindhost, ?addr);
        if (sel looked.err) {
            print.eprintlnf("relay: cannot resolve {}", bindhost);
            ret 1;
        }
        if (!looked.ok) {
            print.eprintlnf("relay: cannot resolve {}", bindhost);
            ret 1;
        }
    }

    val bound: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint_v4(addr, port::u16));
    if (sel bound.err) {
        print.eprintlnf("relay: cannot listen on {}:{}", bindhost, port);
        ret 1;
    }
    var sock: udp.Socket = bound.ok;
    var timeout: u64 = 10;
    if (m.delay > 0 || m.jitter > 0) { timeout = 1; }
    udp.socket_set_recv_timeout(?sock, timeout);

    var tcpportbuf: [32]u8;
    var tcpport:    i64 = 5030;
    val tcpportenv: str = setting("RELAY_TCP_PORT", ?tcpportbuf[0], 32);
    if (tcpportenv != nil) { tcpport = number(tcpportenv, 5030); }
    var tcp_ln:     tcp.Listener;
    var has_tcp:    bool = 0;
    val tcp_bound:  res[tcp.Listener, io_error.Error] = tcp.listen_with_flags(ip.endpoint(0, 0, 0, 0, tcpport::u16), 64, socket_api.async_flags());
    if (sel tcp_bound.ok) {
        tcp_ln  = tcp_bound.ok;
        has_tcp = 1;
        print.printlnf("relay: WebSocket and HTTP bridge listening on 0.0.0.0:{}", tcpport);
    }

    var r: core.Relay;
    r.maxrooms = maxrooms::i32;
    r.random   = random;
    r.fillwait = fillwait * 1000;
    r.shyin    = shyin::i32;
    r.cohort   = cohort == 4;

    # the bots' room: too big for the stack
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.ok) {
        val room: res[*core.Bots, allocator.Error] = allocator.zallocate[core.Bots](?a, 1);
        if (sel room.ok) { r.bots = room.ok; }
        if (trainfile != nil) {
            val pool: res[*core.Train, allocator.Error] = allocator.zallocate[core.Train](?a, 1);
            if (sel pool.ok) {
                r.train = pool.ok;
                read_train(r.train, trainfile);
                print.printlnf("relay: {} samples of people's play kept for the bots", r.train.count);
            }
        }
    }

    print.printlnf("relay: listening on {}:{}, at most {} rooms", bindhost, port, maxrooms);
    if (m.on) { print.printlnf("relay: impaired: drop {}% duplicate {}% reorder {}%", m.drop, m.dup, m.reorder); }
    if (m.delay > 0 || m.jitter > 0) { print.printlnf("relay: delayed: {} ms plus up to {} ms", m.delay, m.jitter); }

    var buf:        [1500]u8;
    var lasttick:    i64 = millis();
    var lastlog:     i64 = lasttick;
    var lastroomlog: i64 = lasttick;
    var lastread:    i64 = 0;
    var lastleague:  i64 = -60000;
    var lastrooms:   i32 = 0;
    var curtimeout: u64 = timeout;
    for {
        var from: ip.Endpoint;
        val got:  res[usize, io_error.Error] = udp.recv_from(?sock, ?buf[0], 1500, ?from);
        val now:  i64 = millis();
        # an IPv6 sender is not served; the relay listens on IPv4
        if (sel got.ok) {
            var a: core.Addr;
            a.ip   = (from.addr.v4.octets[0]::u32 << 24) | (from.addr.v4.octets[1]::u32 << 16) |
                (from.addr.v4.octets[2]::u32 << 8) | from.addr.v4.octets[3]::u32;
            a.port = from.port;
            if (from.addr.is_v6 == 0) {
                core.handle(?r, ?buf[0], got.ok::i32, ?a, now);
                flush(?sock, ?r, ?m, now);
            }
        }
        val tcp_active: i32 = poll_tcp(?tcp_ln, has_tcp, ?sock, ?r, ?m, now);
        var want_to:    u64 = 10;
        if (tcp_active > 0 || lastrooms > 0 || m.delay > 0 || m.jitter > 0) { want_to = 1; }
        if (want_to != curtimeout) {
            curtimeout = want_to;
            udp.socket_set_recv_timeout(?sock, curtimeout);
        }

        if (now - lasttick >= 250) {
            core.tick(?r, now);
            flush(?sock, ?r, ?m, now);
            lasttick = now;
        }

        if (r.bots != nil && now - lastleague >= 60000) {
            if (leaguefile != nil) { r.bots.leaguelen = read_league(?r.bots.league[0], leaguefile); }
            if (coopfile != nil)   { r.bots.cooplen = read_league(?r.bots.coop[0], coopfile); }
            lastleague = now;
        }
        if (r.train != nil && r.train.dirty && now - lasttrain >= trainevery * 1000) {
            write_train(r.train, trainfile);
            lasttrain = now;
        }
        if (now - lastread >= 5000) {
            if (watchfile != nil) { read_watch(?r, watchfile); }
            lastread = now;
        }
        release(?sock, ?m, now);
        tell(?r);

        # a line when the number of rooms changes, and once a minute; plus a
        # per-room health snapshot every 15 seconds while a room is open
        val rooms: i32 = core.open_rooms(?r);
        if (rooms != lastrooms || now - lastlog >= 60000) {
            report(?r);
            if (rooms > 0) { report_rooms(?r, now); }
            lastrooms   = rooms;
            lastlog     = now;
            lastroomlog = now;
        }
        or (rooms > 0 && now - lastroomlog >= 15000) {
            report_rooms(?r, now);
            lastroomlog = now;
        }
    }
    ret 0;
}
