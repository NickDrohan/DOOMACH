# a game in progress: starting one, loading its levels, turning the keyboard
# or a recorded demo into commands, and advancing a tic at a time
#
# Ported from g_game.c and the level setup of p_setup.c. What is left out is
# everything around the game rather than in it: menus, saved games, the
# intermission and finale screens, and network play. Leaving a level goes
# straight to the next one.

use std.allocator;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use doom.bot;
use doom.defs;
use doom.defs.Game;
use doom.defs.Player;
use doom.defs.Ticcmd;
use doom.fixed.Fixed;
use doom.info;
use doom.level;
use doom.random;
use doom.rdata;
use doom.render;
use doom.spec;
use t: doom.tables;
use doom.tick;
use doom.wad;
use doom.world;

val VERSION:    u8 = 109;
val DEMOMARKER: u8 = 0x80;

val FORWARDMOVE: [2]i32 = [2]i32{0x19, 0x32};
val SIDEMOVE:    [2]i32 = [2]i32{0x18, 0x28};
val ANGLETURN:   [3]i32 = [3]i32{640, 1280, 320};

val SLOWTURNTICS: i32 = 6;

# what the player is holding down this tic
pub rec Input {
    forward:      bool;
    back:         bool;
    left:         bool;
    right:        bool;
    strafe_left:  bool;
    strafe_right: bool;
    run:          bool;
    fire:         bool;
    activate:     bool;
    # 1 to 7 to change weapon, 0 for no change
    weapon: i32;
}

pub rec Session {
    g:   Game;
    a:   *allocator.Allocator;
    w:   *wad.Wad;
    d:   *rdata.Data;
    lvl: level.Level;

    # a demo being played back, if any
    demoplayback: bool;
    demo:         *u8;
    demolen:      usize;
    demopos:      usize;
    # the demo ran out of commands, or its level was left
    demodone: bool;

    # tics the turn keys have been held, for the slow start of a turn
    turnheld: i32;

    # the level could not be loaded; the session cannot continue
    broken: bool;

    # a level was finished and the game waits on the intermission; world_done
    # moves on. what the intermission shows is kept here.
    completed: bool;
    wi:        Finished;

    # A campaign: the whole episode in the order a player meets it, the
    # secret level after the third, each level left when it is finished or
    # when levelcap tics of it have gone, whichever is first. capped says
    # the level just left was left for the clock.
    campaign: bool;
    levelcap: i32;
    capped:   bool;
    # each bot as it was set, so that a campaign can start it afresh at
    # every level: its kind as told, and its seed
    botkind: [4]i32;
    botseed: [4]u32;

    # the players the simulation plays itself; set after a game starts
    bots: [4]bot.Bot;

    # in a network game, a watcher for each person: what a bot in their
    # place would have sensed, beside what they did (bot.observe). sampled
    # says this machine's own player was looked at this tic, and sample is
    # what was seen.
    watchers: [4]bot.Bot;
    sampled:  bool;
    sample:   [38]u8;
}

# what a finished level reports to the intermission (wbstartstruct_t)
pub rec Finished {
    episode: i32;
    # the map just left and the map going to, both counted from 1
    last:      i32;
    next:      i32;
    didsecret: bool;
    # the last map of the episode was finished: the finale, not a next map
    finale:    bool;
    maxkills:  i32;
    maxitems:  i32;
    maxsecret: i32;
    kills:     i32;
    items:     i32;
    secret:    i32;
    # tics the level took, and its par in seconds
    time:    i32;
    partime: i32;
}

# par times for the first episode's maps, in seconds
val PARS: [10]i32 = [10]i32{0, 30, 75, 120, 90, 165, 180, 180, 30, 165};

# set up a session; call once
# ---
# s: the session, zeroed
# a: allocator for levels and everything in them
# w: the archive
# d: its graphics
pub fun init(s: *Session, a: *allocator.Allocator, w: *wad.Wad, d: *rdata.Data) {
    s.a = a;
    s.w = w;
    s.d = d;

    val g: *Game = ?s.g;
    g.a = a;
    g.d = d;
    tick.install_hooks(g);

    # the shareware WAD holds one episode and one texture lump
    val second: opt[u32] = wad.find(w, "TEXTURE2");
    g.shareware  = sel second.none;
    g.skyflatnum = rdata.flat_num(d, "F_SKY1");

    g.playeringame[0] = 1;
    g.consoleplayer   = 0;

    spec.init_switch_list(g);
    spec.init_pic_anims(g);
}

# P_LoadThings: spawn everything the map places
fun load_things(g: *Game) {
    var i: i32 = 0;
    for (i < g.lv.numthings) {
        val mt:   *level.Thing = ?g.lv.things[i];
        val kind: i32          = mt.kind::i32;

        # do not spawn cool, new monsters if not the second game. the
        # original stops reading things altogether at the first one, and so
        # does this.
        if (kind == 68 || kind == 64 || kind == 88 || kind == 89 || kind == 69 || kind == 67 || kind == 71 ||
            kind == 65 || kind == 66 || kind == 84) {
            brk;
        }

        world.spawn_map_thing(g, mt);
        i = i + 1;
    }
}

# G_DoLoadLevel and P_SetupLevel
# ---
# ret: whether the level loaded
fun load_level(s: *Session) bool {
    val g: *Game = ?s.g;

    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        if (g.playeringame[i] && g.players[i].playerstate == defs.PST_DEAD) { g.players[i].playerstate = defs.PST_REBORN; }
        g.players[i].killcount   = 0;
        g.players[i].secretcount = 0;
        g.players[i].itemcount   = 0;
        i                        = i + 1;
    }

    # a deathmatch starts every level level: nobody has fragged anybody
    if (g.deathmatch != 0) {
        i = 0;
        for (i < defs.MAXPLAYERS) {
            var none: [4]i32;
            g.players[i].frags = none;
            i                  = i + 1;
        }
    }

    g.totalkills  = 0;
    g.totalitems  = 0;
    g.totalsecret = 0;
    g.exited      = 0;

    # initial height of point of view will be set by player think
    g.players[g.consoleplayer].viewz = 1;

    # everything of the old level goes at once
    g.levelserial = g.levelserial + 1;
    defs.free_level(g);
    world.init_thinkers(g);

    # find map name
    var name: [5]u8 = [5]u8{'E', '1', 'M', '1', 0};
    name[1] = ('0' + g.gameepisode)::u8;
    name[3] = ('0' + g.gamemap)::u8;

    # the level before this one gives its tables back
    level.free(s.a, ?s.lvl);
    val built: res[level.Level, level.LevelError] = level.load(s.a, s.w, ?name[0]);
    if (sel built.err) {
        s.broken = 1;
        ret 0;
    }
    s.lvl = built.ok;
    g.lv  = ?s.lvl;

    val bound: rdata.BindError = rdata.bind(s.d, g.lv);
    if (!(sel bound.ok)) {
        s.broken = 1;
        ret 0;
    }

    g.leveltime = 0;

    # one list of things for each blockmap cell
    val cells: i32 = g.lv.bmapwidth * g.lv.bmapheight;
    g.blocklinks = defs.alloc(g, (cells * 8)::usize):~**defs.Mobj;

    g.bodyqueslot = 0;
    g.numdmstarts = 0;
    load_things(g);

    # if deathmatch, randomly spawn the active players
    if (g.deathmatch != 0) {
        i = 0;
        for (i < defs.MAXPLAYERS) {
            if (g.playeringame[i]) {
                g.players[i].mo = nil;
                deathmatch_spawn_player(g, i);
            }
            i = i + 1;
        }
    }

    # clear special respawning que
    g.iquehead = 0;
    g.iquetail = 0;

    # set up world state
    spec.spawn_specials(g);
    ret 1;
}

# make a player of the game in progress a bot, from now on
# ---
# player: which player, who must be in the game
# kind:   bot.KIND_SCRIPT or bot.KIND_NET
# net:    a net's weights, or nil
# seed:   for the bot's own noise
pub fun set_bot(s: *Session, player: i32, kind: i32, net: *i8, seed: u32) {
    bot.start(?s.bots[player], kind, net, seed);
    s.g.isbot[player] = 1;
    s.botkind[player] = kind;
    s.botseed[player] = seed;
}

# A level of a campaign begins as if the campaign began there: the random
# table from its start, and every bot started afresh with a seed of its own
# and the level's. So a level depends on nothing that went before it but
# what the players carry into it (carry), and someone can begin watching a
# campaign at any level of it (campaign_resume) and see what the league saw.
fun level_seed(seed: u32, map: i32) u32 {
    ret seed ^ ((map - 1):~u32 * 2654435761);
}

pub fun campaign_bots(s: *Session) {
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        if (s.bots[i].active) {
            var net: [942]i8 = s.bots[i].net;
            bot.start(?s.bots[i], s.botkind[i], ?net[0], level_seed(s.botseed[i], s.g.gamemap));
        }
        i = i + 1;
    }
}

# what each player takes into the next level, as numbers: CARRY of them a
# player, written into out (4 * CARRY * 4 bytes)
pub val CARRY: i32 = 65;

fun put_le(out: *u8, at: i32, v: i32) i32 {
    val u: u32 = v:~u32;
    out[at]     = u::u8;
    out[at + 1] = (u >> 8)::u8;
    out[at + 2] = (u >> 16)::u8;
    out[at + 3] = (u >> 24)::u8;
    ret at + 4;
}

fun get_le(in: *u8, at: i32) i32 {
    ret (in[at]::u32 | (in[at + 1]::u32 << 8) | (in[at + 2]::u32 << 16) | (in[at + 3]::u32 << 24)):~i32;
}

# Every number in a player that outlives a level, in one order both ways.
# (Not where its body is, nor who last hurt it: those are of the level.)
fun carry_player(p: *Player, buf: *u8, at_in: i32, out: bool) i32 {
    var at: i32 = at_in;
    var v:  [65]i32;
    if (out) {
        v[0] = p.playerstate;
        v[1] = p.viewz;
        v[2] = p.viewheight;
        v[3] = p.deltaviewheight;
        v[4] = p.bob;
        v[5] = p.health;
        v[6] = p.armorpoints;
        v[7] = p.armortype;
        var k: i32 = 0;
        for (k < 6) {
            v[8 + k]  = p.powers[k];
            v[14 + k] = p.cards[k]::i32;
            k         = k + 1;
        }
        v[20] = p.backpack::i32;
        v[21] = p.readyweapon;
        v[22] = p.pendingweapon;
        k = 0;
        for (k < 9) {
            v[23 + k] = p.weaponowned[k]::i32;
            k         = k + 1;
        }
        k = 0;
        for (k < 4) {
            v[32 + k] = p.ammo[k];
            v[36 + k] = p.maxammo[k];
            v[47 + k] = p.frags[k];
            k         = k + 1;
        }
        v[40] = p.attackdown;
        v[41] = p.usedown;
        v[42] = p.cheats;
        v[43] = p.refire;
        v[44] = p.killcount;
        v[45] = p.itemcount;
        v[46] = p.secretcount;
        v[51] = p.damagecount;
        v[52] = p.bonuscount;
        v[53] = p.extralight;
        v[54] = p.fixedcolormap;
        v[55] = p.colormap;
        k = 0;
        for (k < 2) {
            v[56 + k * 4] = p.psprites[k].state;
            v[57 + k * 4] = p.psprites[k].tics;
            v[58 + k * 4] = p.psprites[k].sx;
            v[59 + k * 4] = p.psprites[k].sy;
            k             = k + 1;
        }
        v[64] = p.didsecret::i32;
        k = 0;
        for (k < CARRY) {
            at = put_le(buf, at, v[k]);
            k  = k + 1;
        }
        ret at;
    }
    var k: i32 = 0;
    for (k < CARRY) {
        v[k] = get_le(buf, at);
        at   = at + 4;
        k    = k + 1;
    }
    p.mo              = nil;
    p.attacker        = nil;
    p.message         = nil;
    p.playerstate     = v[0];
    p.viewz           = v[1];
    p.viewheight      = v[2];
    p.deltaviewheight = v[3];
    p.bob             = v[4];
    p.health          = v[5];
    p.armorpoints     = v[6];
    p.armortype       = v[7];
    k = 0;
    for (k < 6) {
        p.powers[k] = v[8 + k];
        p.cards[k]  = v[14 + k] != 0;
        k           = k + 1;
    }
    p.backpack      = v[20] != 0;
    p.readyweapon   = v[21];
    p.pendingweapon = v[22];
    k = 0;
    for (k < 9) {
        p.weaponowned[k] = v[23 + k] != 0;
        k                = k + 1;
    }
    k = 0;
    for (k < 4) {
        p.ammo[k]    = v[32 + k];
        p.maxammo[k] = v[36 + k];
        p.frags[k]   = v[47 + k];
        k            = k + 1;
    }
    p.attackdown    = v[40];
    p.usedown       = v[41];
    p.cheats        = v[42];
    p.refire        = v[43];
    p.killcount     = v[44];
    p.itemcount     = v[45];
    p.secretcount   = v[46];
    p.damagecount   = v[51];
    p.bonuscount    = v[52];
    p.extralight    = v[53];
    p.fixedcolormap = v[54];
    p.colormap      = v[55];
    k = 0;
    for (k < 2) {
        p.psprites[k].state = v[56 + k * 4];
        p.psprites[k].tics  = v[57 + k * 4];
        p.psprites[k].sx    = v[58 + k * 4];
        p.psprites[k].sy    = v[59 + k * 4];
        k                   = k + 1;
    }
    p.didsecret = v[64] != 0;
    ret at;
}

# what the players take into the level a finished one leads to: call it
# between the level's end (completed) and world_done
# ---
# ret: the bytes written
pub fun carry(s: *Session, out: *u8) i32 {
    var at: i32 = 0;
    var i:  i32 = 0;
    for (i < defs.MAXPLAYERS) {
        at = carry_player(?s.g.players[i], out, at, 1);
        i  = i + 1;
    }
    ret at;
}

# Begin watching a campaign at a level after the first: the game as it was
# when the league's team walked into it, from what they carried. The bots
# are set after this, as for any game, and then campaign_bots.
# ---
# map:   the level, 2 to 9
# carried: what carry wrote as the level before ended
pub fun campaign_resume(s: *Session, players: i32, me: i32, skill: i32, cap: i32, map: i32, carried: *u8) bool {
    if (!coop_game(s, players, me, skill, 1)) { ret 0; }
    val g: *Game = ?s.g;
    s.campaign = 1;
    s.levelcap = cap;
    s.capped   = 0;
    var at: i32 = 0;
    var i:  i32 = 0;
    for (i < defs.MAXPLAYERS) {
        at = carry_player(?g.players[i], carried, at, 0);
        i  = i + 1;
    }
    s.completed = 0;
    g.exited    = 0;
    g.gamemap   = map;
    random.clear(?g.rnd);
    ret load_level(s);
}

fun clear_bots(s: *Session) {
    # and whatever game this is, it is not a campaign until it says so
    s.campaign = 0;
    s.levelcap = 0;
    s.capped   = 0;
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        s.bots[i].active = 0;
        s.g.isbot[i]     = 0;
        # and the watchers begin again, the same on every machine
        bot.start(?s.watchers[i], bot.KIND_SCRIPT, nil, (i + 1):~u32 * 2654435761);
        s.watchers[i].active = 0;
        i                    = i + 1;
    }
    s.sampled = 0;
}

# G_InitNew: can be called by the startup code or the menu task
# ---
# skill_in:   SK_BABY to SK_NIGHTMARE
# episode_in: 1 in the shareware game
# map_in:     1 to 9
# ret:        whether the level loaded
pub fun init_new(s: *Session, skill_in: i32, episode_in: i32, map_in: i32) bool {
    val g: *Game = ?s.g;

    var skill: i32 = skill_in;
    if (skill > defs.SK_NIGHTMARE) { skill = defs.SK_NIGHTMARE; }
    if (skill < 0)                 { skill = 0; }

    var episode: i32 = episode_in;
    if (episode < 1)                { episode = 1; }
    if (g.shareware && episode > 1) { episode = 1; }
    if (episode > 3)                { episode = 3; }

    var map: i32 = map_in;
    if (map < 1) { map = 1; }
    if (map > 9) { map = 9; }

    random.clear(?g.rnd);

    g.respawnmonsters = skill == defs.SK_NIGHTMARE || g.respawnparm;

    # force players to be initialized upon first level load
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        g.players[i].playerstate = defs.PST_REBORN;
        i                        = i + 1;
    }

    s.demoplayback = 0;
    s.demodone     = 0;
    s.completed    = 0;
    g.exited       = 0;
    g.gameepisode  = episode;
    g.gamemap      = map;
    g.gameskill    = skill;

    ret load_level(s);
}

# G_DoLoadGame: a saved game becomes the game in progress, replacing whatever
# this machine was doing — a game alone or with others, watched or played;
# save.mach reads the saved state over the level this loads
# ---
# s:       the session
# skill:   SK_BABY to SK_NIGHTMARE
# episode: 1 in the shareware game
# map:     1 to 9
# ret:     whether the level loaded
pub fun load_game(s: *Session, skill: i32, episode: i32, map: i32) bool {
    clear_bots(s);
    s.g.netgame       = 0;
    s.g.consoleplayer = 0;
    ret init_new(s, skill, episode, map);
}

# start a game for one player, undoing whatever a demo set up
# ---
# s:       the session
# skill:   SK_BABY to SK_NIGHTMARE
# episode: 1 in the shareware game
# map:     1 to 9
# ret:     whether the level loaded
pub fun new_game(s: *Session, skill: i32, episode: i32, map: i32) bool {
    val g: *Game = ?s.g;
    clear_bots(s);
    g.deathmatch    = 0;
    g.respawnparm   = 0;
    g.fastparm      = 0;
    g.nomonsters    = 0;
    g.netgame       = 0;
    g.consoleplayer = 0;
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        g.playeringame[i] = i == 0;
        i                 = i + 1;
    }
    ret init_new(s, skill, episode, map);
}

# start a co-operative game for several players on one machine's view of it:
# every machine in the game calls this with the same numbers
# ---
# s:       the session
# players: how many, 1 to 4
# me:      which of them this machine is, 0 to players - 1
# skill:   SK_BABY to SK_NIGHTMARE
# map:     1 to 9
# ret:     whether the level loaded
pub fun coop_game(s: *Session, players: i32, me: i32, skill: i32, map: i32) bool {
    val g: *Game = ?s.g;
    clear_bots(s);
    g.deathmatch    = 0;
    g.respawnparm   = 0;
    g.fastparm      = 0;
    g.nomonsters    = 0;
    g.netgame       = 1;
    g.consoleplayer = me;
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        g.playeringame[i] = i < players;
        i                 = i + 1;
    }
    ret init_new(s, skill, 1, map);
}

# start a campaign: a co-op game of the whole episode, from the first map,
# each level played until it is finished or its time is up, and the secret
# level in its place after the third whether or not anyone found the way
# to it. The league's co-op teams play these; every machine watching one
# calls this with the same numbers.
# ---
# cap: tics a level may take before the team is moved on
pub fun campaign_game(s: *Session, players: i32, me: i32, skill: i32, cap: i32) bool {
    if (!coop_game(s, players, me, skill, 1)) { ret 0; }
    s.campaign = 1;
    s.levelcap = cap;
    s.capped   = 0;
    ret 1;
}

# start a deathmatch: every machine in the game calls this with the same
# numbers
# ---
# s:          the session
# players:    how many, 2 to 4
# me:         which of them this machine is
# skill:      SK_BABY to SK_NIGHTMARE
# map:        1 to 9
# altdeath:   items come back thirty seconds after they are taken, and
#             weapons are taken rather than left
# nomonsters: only the players
# ret:        whether the level loaded
pub fun deathmatch_game(s: *Session, players: i32, me: i32, skill: i32, map: i32, altdeath: bool, nomonsters: bool) bool {
    val g: *Game = ?s.g;
    clear_bots(s);
    g.deathmatch = 1;
    if (altdeath) { g.deathmatch = 2; }
    g.respawnparm   = 0;
    g.fastparm      = 0;
    g.nomonsters    = nomonsters;
    g.netgame       = 1;
    g.consoleplayer = me;
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        g.playeringame[i] = i < players;
        var none: [4]i32;
        g.players[i].frags = none;
        i                  = i + 1;
    }
    ret init_new(s, skill, 1, map);
}

# G_DoPlayDemo: start playing a demo lump
# ---
# name: the lump, such as "DEMO1"
# ret:  whether the demo exists, is from this version, and its level loaded
pub fun play_demo(s: *Session, name: str) bool {
    val g:     *Game    = ?s.g;
    val found: opt[u32] = wad.find(s.w, name);
    if (sel found.none) { ret 0; }

    val p:   *u8   = wad.bytes(s.w, found.some);
    val len: usize = wad.lump(s.w, found.some).size::usize;
    if (len < 13 || p[0] != VERSION) { ret 0; }

    val skill:   i32 = p[1]::i32;
    val episode: i32 = p[2]::i32;
    val map:     i32 = p[3]::i32;
    g.deathmatch    = p[4]::i32;
    g.respawnparm   = p[5] != 0;
    g.fastparm      = p[6] != 0;
    g.nomonsters    = p[7] != 0;
    g.consoleplayer = p[8]::i32;

    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        g.playeringame[i] = p[9 + i] != 0;
        i                 = i + 1;
    }
    g.netgame = g.playeringame[1];

    if (!init_new(s, skill, episode, map)) { ret 0; }

    s.demo         = p;
    s.demolen      = len;
    s.demopos      = 13;
    s.demoplayback = 1;
    s.demodone     = 0;
    ret 1;
}

# G_ReadDemoTiccmd
fun read_demo_ticcmd(s: *Session, cmd: *Ticcmd) {
    if (s.demopos + 4 > s.demolen || s.demo[s.demopos] == DEMOMARKER) {
        # end of demo data stream
        s.demodone = 1;
        ret;
    }
    cmd.forwardmove = s.demo[s.demopos]:~i8;
    cmd.sidemove    = s.demo[s.demopos + 1]:~i8;
    cmd.angleturn   = (s.demo[s.demopos + 2]::u16 << 8):~i16;
    cmd.buttons     = s.demo[s.demopos + 3];
    s.demopos       = s.demopos + 4;
}

# G_BuildTiccmd: builds a ticcmd from all of the available inputs
pub fun build_ticcmd(s: *Session, input: *Input, cmd: *Ticcmd) {
    var blank: Ticcmd;
    @cmd = blank;

    var speed: i32 = 0;
    if (input.run) { speed = 1; }

    var forward: i32 = 0;
    var side:    i32 = 0;

    # use two stage accelerative turning on the keyboard
    if (input.left || input.right) {
        s.turnheld = s.turnheld + 1;
    }
    or {
        s.turnheld = 0;
    }

    var tspeed: i32 = speed;
    if (s.turnheld < SLOWTURNTICS) {
        # slow turn
        tspeed = 2;
    }

    var turn: i32 = 0;
    if (input.right) { turn = turn - ANGLETURN[tspeed]; }
    if (input.left)  { turn = turn + ANGLETURN[tspeed]; }
    cmd.angleturn = turn::i16;

    if (input.forward)      { forward = forward + FORWARDMOVE[speed]; }
    if (input.back)         { forward = forward - FORWARDMOVE[speed]; }
    if (input.strafe_right) { side = side + SIDEMOVE[speed]; }
    if (input.strafe_left)  { side = side - SIDEMOVE[speed]; }

    # buttons
    var buttons: i32 = 0;
    if (input.fire)     { buttons = buttons | defs.BT_ATTACK; }
    if (input.activate) { buttons = buttons | defs.BT_USE; }

    # chainsaw overrides
    if (input.weapon >= 1 && input.weapon <= 7) {
        buttons = buttons | defs.BT_CHANGE;
        buttons = buttons | ((input.weapon - 1) << defs.BT_WEAPONSHIFT);
    }
    cmd.buttons = buttons::u8;

    val maxmove: i32 = FORWARDMOVE[1];
    if (forward > maxmove) {
        forward = maxmove;
    }
    or (forward < 0 - maxmove) {
        forward = 0 - maxmove;
    }
    if (side > maxmove) {
        side = maxmove;
    }
    or (side < 0 - maxmove) {
        side = 0 - maxmove;
    }

    cmd.forwardmove = forward::i8;
    cmd.sidemove    = side::i8;
}

# G_PlayerFinishLevel: can when a player completes a level
fun player_finish_level(g: *Game, player: i32) {
    val p: *Player = ?g.players[player];

    var i: i32 = 0;
    for (i < defs.NUMPOWERS) {
        p.powers[i] = 0;
        p.cards[i]  = 0;
        i           = i + 1;
    }
    # cancel invisibility
    p.mo.flags = p.mo.flags & ~defs.MF_SHADOW;
    # cancel gun flashes
    p.extralight = 0;
    # cancel ir gogles
    p.fixedcolormap = 0;
    # no palette changes
    p.damagecount = 0;
    p.bonuscount  = 0;
}

# G_DoCompleted: the level is over; tidy the players and fill in what the
# intermission shows
fun completed(s: *Session) {
    val g:      *Game = ?s.g;
    val secret: bool  = g.exited == 2;

    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        if (g.playeringame[i]) {
            # take away cards and stuff
            player_finish_level(g, i);
        }
        i = i + 1;
    }

    # the level to go to: the secret exit leads to map 9, map 9 leads back
    # to the level after the one with the secret exit
    var next: i32 = g.gamemap + 1;
    if (secret || (s.campaign && g.gamemap == 3)) {
        next = 9;
    }
    or (g.gamemap == 9) {
        # returning from secret level
        if (g.gameepisode == 1) {
            next = 4;
        }
        or (g.gameepisode == 2) {
            next = 6;
        }
        or (g.gameepisode == 3) {
            next = 7;
        }
        or {
            next = 3;
        }
    }

    val p: *Player = ?g.players[g.consoleplayer];
    # leaving the secret map counts as having found it
    if (g.gamemap == 9) { p.didsecret = 1; }
    s.wi.episode   = g.gameepisode;
    s.wi.last      = g.gamemap;
    s.wi.next      = next;
    s.wi.didsecret = p.didsecret || secret;
    p.didsecret    = s.wi.didsecret;
    s.wi.finale    = g.gamemap == 8;
    s.wi.maxkills  = g.totalkills;
    s.wi.maxitems  = g.totalitems;
    s.wi.maxsecret = g.totalsecret;
    s.wi.kills     = p.killcount;
    s.wi.items     = p.itemcount;
    s.wi.secret    = p.secretcount;
    s.wi.time      = g.leveltime;
    s.wi.partime   = 0;
    if (g.gamemap >= 1 && g.gamemap <= 9) { s.wi.partime = PARS[g.gamemap]; }

    g.exited    = 0;
    s.completed = 1;
}

# G_DoWorldDone: the intermission is over; on to the next map
pub fun world_done(s: *Session) {
    s.completed = 0;
    s.capped    = 0;
    s.g.gamemap = s.wi.next;
    # a campaign's level begins as if the campaign began there
    if (s.campaign) { random.clear(?s.g.rnd); }
    load_level(s);
    if (s.campaign) { campaign_bots(s); }
}

# G_CheckSpot: whether a player can be spawned at a start without a thing in
# the way; leaves the dead body in the body queue and makes a fog if so
fun check_spot(g: *Game, playernum: i32, mthing: *level.Thing) bool {
    val x: Fixed = mthing.x::i32 << 16;
    val y: Fixed = mthing.y::i32 << 16;

    if (g.players[playernum].mo == nil) {
        # first spawn of level, before corpses
        var i: i32 = 0;
        for (i < playernum) {
            if (g.players[i].mo.x == x && g.players[i].mo.y == y) { ret 0; }
            i = i + 1;
        }
        ret 1;
    }

    if (!world.check_position(g, g.players[playernum].mo, x, y)) { ret 0; }

    # flush an old corpse if needed
    if (g.bodyqueslot >= 32) { world.remove_mobj(g, g.bodyque[g.bodyqueslot % 32]); }
    g.bodyque[g.bodyqueslot % 32] = g.players[playernum].mo;
    g.bodyqueslot                 = g.bodyqueslot + 1;

    # spawn a teleport fog
    val ss: i32        = render.point_in_subsector(g.lv, x, y);
    val an: u32        = (t.ANG45 * (mthing.angle::i32 / 45):~u32) >> t.ANGLETOFINESHIFT;
    val mo: *defs.Mobj = world.spawn_mobj(g, x + 20 * t.FINESINE[an + 2048], y + 20 * t.FINESINE[an],
        g.lv.sectors[g.lv.subsectors[ss].sector].floorheight, info.MT_TFOG);

    if (g.players[g.consoleplayer].viewz != 1) {
        # don't start sound on first frame
        defs.sound(g, mo, info.SFX_TELEPT);
    }
    ret 1;
}

# G_DeathMatchSpawnPlayer: spawns a player at one of the random death match
# spots; called at level load and each death
fun deathmatch_spawn_player(g: *Game, playernum: i32) {
    val selections: i32 = g.numdmstarts;
    # the original stops with an error on a map with fewer than four; here
    # such a map falls back to the player's own start
    if (selections >= 4) {
        var j: i32 = 0;
        for (j < 20) {
            val i: i32 = defs.p_random(g) % selections;
            if (check_spot(g, playernum, ?g.deathmatchstarts[i])) {
                g.deathmatchstarts[i].kind = (playernum + 1)::i16;
                world.spawn_player(g, ?g.deathmatchstarts[i]);
                ret;
            }
            j = j + 1;
        }
    }

    # no good spot, so the player will probably get stuck
    world.spawn_player(g, ?g.playerstarts[playernum]);
}

# P_RespawnSpecials: in the second kind of deathmatch, an item picked up
# comes back where it was thirty seconds later
fun respawn_specials(g: *Game) {
    # only respawn items in deathmatch
    if (g.deathmatch != 2) { ret; }

    # nothing left to respawn?
    if (g.iquehead == g.iquetail) { ret; }

    # wait at least 30 seconds
    if (g.leveltime - g.itemrespawntime[g.iquetail] < 30 * 35) { ret; }

    val mthing: *level.Thing = ?g.itemrespawnque[g.iquetail];
    val x:      Fixed        = mthing.x::i32 << 16;
    val y:      Fixed        = mthing.y::i32 << 16;

    # spawn a teleport fog at the new spot
    val ss:  i32        = render.point_in_subsector(g.lv, x, y);
    val fog: *defs.Mobj = world.spawn_mobj(g, x, y, g.lv.sectors[g.lv.subsectors[ss].sector].floorheight, info.MT_IFOG);
    defs.sound(g, fog, info.SFX_ITMBK);

    # find which type to spawn
    var i: i32 = 0;
    for (i < info.NUMMOBJTYPES) {
        if (mthing.kind::i32 == info.mi(i, info.MI_DOOMEDNUM)) { brk; }
        i = i + 1;
    }
    if (i < info.NUMMOBJTYPES) {
        # spawn it
        var z: Fixed = defs.ONFLOORZ;
        if ((info.mi(i, info.MI_FLAGS) & defs.MF_SPAWNCEILING) != 0) { z = defs.ONCEILINGZ; }
        val mo: *defs.Mobj = world.spawn_mobj(g, x, y, z, i);
        mo.spawnpoint = @mthing;
        mo.angle      = t.ANG45 * (mthing.angle::i32 / 45):~u32;
    }

    # pull it from the que
    g.iquetail = (g.iquetail + 1) & (defs.ITEMQUESIZE - 1);
}

# G_DoReborn in a network game: the dead player comes back at a start, and
# the level carries on for everyone else
fun reborn_in_netgame(g: *Game, playernum: i32) {
    # dissasociate the corpse
    g.players[playernum].mo.player = nil;

    # spawn at random spot if in death match
    if (g.deathmatch != 0) {
        deathmatch_spawn_player(g, playernum);
        ret;
    }

    if (check_spot(g, playernum, ?g.playerstarts[playernum])) {
        world.spawn_player(g, ?g.playerstarts[playernum]);
        ret;
    }

    # try to spawn at one of the other players spots
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        if (check_spot(g, playernum, ?g.playerstarts[i])) {
            # fake as other player
            g.playerstarts[i].kind = (playernum + 1)::i16;
            world.spawn_player(g, ?g.playerstarts[i]);
            # restore
            g.playerstarts[i].kind = (i + 1)::i16;
            ret;
        }
        i = i + 1;
    }

    # he's going to be inside something. too bad.
    world.spawn_player(g, ?g.playerstarts[playernum]);
}

# G_Ticker: make the console player's ticcmd from the keyboard and advance
# the world one tic
# ---
# s:     the session
# input: what is held down, ignored while a demo plays
pub fun ticker(s: *Session, input: *Input) {
    var cmds: [4]Ticcmd;
    if (!s.demoplayback) { build_ticcmd(s, input, ?cmds[s.g.consoleplayer]); }
    ticker_cmds(s, ?cmds[0]);
}

# G_Ticker with every player's ticcmd given, as a network game has them
# ---
# s:    the session
# cmds: four ticcmds, one per player; ignored while a demo plays
pub fun ticker_cmds(s: *Session, cmds: *Ticcmd) {
    val g: *Game = ?s.g;
    if (s.broken || s.completed) { ret; }

    # do player reborns if needed
    var i: i32 = 0;
    for (i < defs.MAXPLAYERS) {
        if (g.playeringame[i] && g.players[i].playerstate == defs.PST_REBORN) {
            if (g.netgame) {
                reborn_in_netgame(g, i);
            }
            or {
                # reload the level from scratch
                if (!load_level(s)) { ret; }
                brk;
            }
        }
        i = i + 1;
    }

    # a campaign's level has had its time
    if (s.campaign && s.levelcap > 0 && g.leveltime >= s.levelcap && g.exited == 0) {
        g.exited = 1;
        s.capped = 1;
    }

    # do things to change the game state
    if (g.exited != 0) {
        if (s.demoplayback) {
            # a demo ends where its level does
            s.demodone = 1;
            ret;
        }
        completed(s);
        ret;
    }

    # get commands
    s.sampled = 0;
    i         = 0;
    for (i < defs.MAXPLAYERS) {
        if (g.playeringame[i]) {
            val cmd: *Ticcmd = ?g.players[i].cmd;
            if (s.demoplayback) {
                var blank: Ticcmd;
                @cmd = blank;
                read_demo_ticcmd(s, cmd);
                if (s.demodone) { ret; }
            }
            or (s.bots[i].active) {
                bot.think(g, i, ?s.bots[i], cmd);
            }
            or {
                @cmd = cmds[i];
                # a person in a network game is watched, for bots to learn
                # from if they have said they may
                if (g.netgame && !g.isbot[i]) {
                    var seen: [38]u8;
                    if (bot.observe(g, i, ?s.watchers[i], cmd, ?seen[0]) && i == g.consoleplayer) {
                        s.sample  = seen;
                        s.sampled = 1;
                    }
                }
            }
        }
        i = i + 1;
    }

    tick.ticker(g);
    respawn_specials(g);
    g.gametic = g.gametic + 1;
}

# a running sum over the state that a demo must reproduce: every map
# object's place, momentum, health and state, the random walk, and the
# player. two runs that agree here tic after tic are in sync.
# The simulation's fingerprint: what this program makes of a fixed probe.
# Four bots (two nets with fixed weights, a brawler and the hand-written
# bot) play a co-op level on Nightmare, then a deathmatch, 350 tics each,
# and the two checksums are the fingerprint. Whatever changes the simulation
# or the bots in any way the probe reaches changes it: the monsters, the
# moving sectors, the senses, the nets, the route-finding, the reflexes.
# Every program computes it the same on every machine, as it computes every
# game. The session is left with the probe's game in it, to be replaced.
pub fun fingerprint(s: *Session) u32 {
    var net:  [942]i8;
    var seed: u32 = 0x2545f491;
    var k:    i32 = 0;
    for (k < 942) {
        seed   = seed * 1103515245 + 12345;
        net[k] = (((seed >> 16) & 0x3f):~i32 - 32)::i8;
        k      = k + 1;
    }
    var sum: u32 = 0;
    var round: i32 = 0;
    for (round < 2) {
        var ok: bool = 0;
        if (round == 0) {
            ok = coop_game(s, 4, 0, defs.SK_NIGHTMARE, 1);
        }
        or {
            ok = deathmatch_game(s, 4, 0, defs.SK_MEDIUM, 1, 1, 1);
        }
        if (!ok) { ret 0; }
        set_bot(s, 0, bot.KIND_NET, ?net[0], 11);
        set_bot(s, 1, bot.KIND_NET | (bot.QUIRK_LOYAL << bot.QUIRK_SHIFT) | bot.feel_bits(0, 10), ?net[0], 12);
        set_bot(s, 2, bot.KIND_NET | bot.TRAIT_FISTS, ?net[0], 13);
        set_bot(s, 3, bot.KIND_SCRIPT, nil, 14);
        var cmds: [4]Ticcmd;
        var tic:  i32 = 0;
        for (tic < 350 && !s.completed && !s.broken) {
            ticker_cmds(s, ?cmds[0]);
            tic = tic + 1;
        }
        sum   = sum * 2654435761 ^ checksum(s);
        round = round + 1;
    }
    ret sum;
}

pub fun checksum(s: *Session) u32 {
    val g:   *Game = ?s.g;
    var sum: u32   = g.rnd.play::u32;

    var th: *defs.Thinker = g.thinkercap.next;
    for (th != ?g.thinkercap) {
        if (th.kind == defs.TH_MOBJ) {
            val mo: *defs.Mobj = th:~*defs.Mobj;
            sum = sum * 31 + mo.x:~u32;
            sum = sum * 31 + mo.y:~u32;
            sum = sum * 31 + mo.z:~u32;
            sum = sum * 31 + mo.momx:~u32;
            sum = sum * 31 + mo.momy:~u32;
            sum = sum * 31 + mo.angle;
            sum = sum * 31 + mo.health:~u32;
            sum = sum * 31 + mo.state:~u32;
        }
        th = th.next;
    }
    ret sum;
}

test build_ticcmd__keys_become_commands {
    var s:     Session;
    var input: Input;
    var cmd:   Ticcmd;

    # walking forward, then running
    input.forward = 1;
    build_ticcmd(?s, ?input, ?cmd);
    if (cmd.forwardmove != 0x19 || cmd.sidemove != 0 || cmd.angleturn != 0) { ret 1; }
    input.run = 1;
    build_ticcmd(?s, ?input, ?cmd);
    if (cmd.forwardmove != 0x32) { ret 2; }

    # forward and back cancel; strafing right while running
    input.back         = 1;
    input.strafe_right = 1;
    build_ticcmd(?s, ?input, ?cmd);
    if (cmd.forwardmove != 0 || cmd.sidemove != 0x28) { ret 3; }

    # a turn starts slow for six tics, then takes the running speed
    var blank: Input;
    input      = blank;
    input.left = 1;
    input.run  = 1;
    var i: i32 = 0;
    for (i < 5) {
        build_ticcmd(?s, ?input, ?cmd);
        if (cmd.angleturn != 320) { ret 4; }
        i = i + 1;
    }
    build_ticcmd(?s, ?input, ?cmd);
    if (cmd.angleturn != 1280) { ret 5; }
    input.left  = 0;
    input.right = 1;
    build_ticcmd(?s, ?input, ?cmd);
    if (cmd.angleturn != 0 - 1280) { ret 6; }

    # fire, use, and a change to weapon 3
    input          = blank;
    input.fire     = 1;
    input.activate = 1;
    input.weapon   = 3;
    build_ticcmd(?s, ?input, ?cmd);
    if (cmd.buttons != (defs.BT_ATTACK | defs.BT_USE | defs.BT_CHANGE | (2 << defs.BT_WEAPONSHIFT))::u8) { ret 7; }
    ret 0;
}
