# doom: a port of id Software's Doom engine
#
#   doom wad <file>          list the archive's directory, one lump per line
#   doom map <file> <name>   dump a loaded map, such as E1M1, one record per line
#   doom frame <file> <name> <out.ppm> [<x> <y> <degrees>]
#                            draw one frame of a map as a PPM image, from the
#                            first player start or from a given point
#   doom play <file> [<map 1-9> [<skill 1-5>]]
#                            play the first episode in a window
#   doom demo <file> <lump> [<every>]
#                            run a recorded demo with no display and report
#                            where it ends, with a line every so many tics
#   doom wav <file> <lump> <out.wav>
#                            run a recorded demo and write its sound
#
# exit codes: 0 success, 1 a usage error, 2 a file that is not a usable WAD,
# 3 a map that is absent or damaged, 4 graphics that are absent or damaged,
# 5 an image that could not be written, 6 a window that could not be opened.

use std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use io_error: std.io.error;
use std.collections.vector.Vector;
use std.print;
use std.runtime;
use std.text.parse;
use std.process.env;
use std.crypto.hash.sha256;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use doom.am;
use doom.announce;
use doom.bot;
use doom.defs;
use doom.front;
use doom.game;
use doom.level;
use doom.maputl;
use doom.music;
use doom.opl;
use doom.net;
use doom.random;
use doom.relaycore;
use doom.relayproto;
use doom.rdata;
use doom.render;
use doom.save;
use doom.sound;
use doom.st;
use doom.tables;
use doom.wad;
use doom.win;
use doom.world;

val EXIT_OK:     i64 = 0;
val EXIT_USAGE:  i64 = 1;
val EXIT_WAD:    i64 = 2;
val EXIT_MAP:    i64 = 3;
val EXIT_DATA:   i64 = 4;
val EXIT_WRITE:  i64 = 5;
val EXIT_WINDOW: i64 = 6;

# the relay a game started from the menu meets the others through, unless
# --relay or DOOM_RELAY names another
val DEFAULT_RELAY: str = "mach-doom-relay.fly.dev";

# where the newest program is kept, unless DOOM_UPDATE_URL names another
# place: doom.exe there, and doom.exe.sha256, its hash as 64 hex digits
val UPDATE_URL: str = "https://mach-doom-relay.fly.dev";

# the game was started by a double click, with no words after its name; an
# update starts the new one the same way
var byclick: bool;

fun usage() i64 {
    print.eprintln("usage: doom wad <file>");
    print.eprintln("       doom map <file> <name>");
    print.eprintln("       doom frame <file> <name> <out.ppm> [<x> <y> <degrees>]");
    print.eprintln("       doom play <file> [<map 1-9> [<skill 1-5>]]");
    print.eprintln("       doom host <file> [<players 2-4> [<map 1-9> [<skill 1-5>]]] [--relay <address>]");
    print.eprintln("       doom join <file> <address or room code> [--relay <address>]");
    print.eprintln("       doom demo <file> <lump> [<every>]");
    print.eprintln("       doom wav <file> <lump> <out.wav>");
    ret EXIT_USAGE;
}

fun refuse(e: wad.WadError) i64 {
    if (sel e.unreadable) {
        print.eprintln("doom: the file could not be read");
    }
    or (sel e.truncated) {
        print.eprintln("doom: too short to hold a WAD header");
    }
    or (sel e.magic) {
        print.eprintln("doom: not an IWAD or a PWAD");
    }
    or (sel e.directory) {
        print.eprintln("doom: the lump directory lies outside the file");
    }
    or (sel e.lump) {
        print.eprintlnf("doom: lump {} lies outside the file", e.lump);
    }
    ret EXIT_WAD;
}

fun refuse_map(e: level.LevelError) i64 {
    if (sel e.marker) {
        print.eprintln("doom: no such map in this WAD");
    }
    or (sel e.lump) {
        print.eprintlnf("doom: map lump {} is absent, misnamed or a ragged size", e.lump);
    }
    or (sel e.reference) {
        print.eprintlnf("doom: map lump {} refers to something outside the map", e.reference);
    }
    or {
        print.eprintln("doom: out of memory loading the map");
    }
    ret EXIT_MAP;
}

fun list(path: str) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, path);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    if (w.iwad) {
        print.printlnf("IWAD {}", w.count);
    }
    or {
        print.printlnf("PWAD {}", w.count);
    }
    var i: u32 = 0;
    for (i < w.count) {
        var l: wad.Lump = wad.lump(?w, i);
        print.printlnf("{} {} {} {}", i, ?l.name[0], l.offset, l.size);
        i = i + 1;
    }
    ret EXIT_OK;
}

# a running sum over bytes, for the lumps too large to print
fun digest(p: *u8, len: i32) u32 {
    var sum: u32 = 0;
    var i:   i32 = 0;
    for (i < len) {
        sum = sum * 31 + p[i]::u32;
        i   = i + 1;
    }
    ret sum;
}

# print every structure of a loaded map, in the order and format in which
# harness/mapdump.py prints its own independent reading
fun dump(path: str, name: str) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, path);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val built: res[level.Level, level.LevelError] = level.load(?a, ?w, name);
    if (sel built.err) { ret refuse_map(built.err); }
    var lv: level.Level = built.ok;

    var i: i32 = 0;
    print.printlnf("vertexes {}", lv.numvertexes);
    for (i < lv.numvertexes) {
        print.printlnf("v {} {} {}", i, lv.vertexes[i].x, lv.vertexes[i].y);
        i = i + 1;
    }

    print.printlnf("sectors {}", lv.numsectors);
    i = 0;
    for (i < lv.numsectors) {
        val s: *level.Sector = ?lv.sectors[i];
        print.printf("s {} {} {} {} {}", i, s.floorheight, s.ceilingheight, ?s.floorpic[0], ?s.ceilingpic[0]);
        print.printf(" {} {} {} {}", s.lightlevel, s.special, s.tagnum, s.linecount);
        print.printf(" {} {} {} {}", s.blockbox[0], s.blockbox[1], s.blockbox[2], s.blockbox[3]);
        print.printf(" {} {} :", s.soundorg_x, s.soundorg_y);
        var j: i32 = 0;
        for (j < s.linecount) {
            print.printf(" {}", lv.sector_lines[s.firstline + j]);
            j = j + 1;
        }
        print.println("");
        i = i + 1;
    }

    print.printlnf("sides {}", lv.numsides);
    i = 0;
    for (i < lv.numsides) {
        val s: *level.Side = ?lv.sides[i];
        print.printf("d {} {} {}", i, s.textureoffset, s.rowoffset);
        print.printlnf(" {} {} {} {}", ?s.toptexture[0], ?s.bottomtexture[0], ?s.midtexture[0], s.sector);
        i = i + 1;
    }

    print.printlnf("lines {}", lv.numlines);
    i = 0;
    for (i < lv.numlines) {
        val l: *level.Line = ?lv.lines[i];
        print.printf("l {} {} {} {} {} {} {} {}", i, l.v1, l.v2, l.dx, l.dy, l.flags, l.special, l.tagnum);
        print.printf(" {} {} {}", l.sidenum[0], l.sidenum[1], l.slopetype);
        print.printf(" {} {} {} {}", l.bbox[0], l.bbox[1], l.bbox[2], l.bbox[3]);
        print.printlnf(" {} {}", l.frontsector, l.backsector);
        i = i + 1;
    }

    print.printlnf("subsectors {}", lv.numsubsectors);
    i = 0;
    for (i < lv.numsubsectors) {
        val s: *level.Subsector = ?lv.subsectors[i];
        print.printlnf("ss {} {} {} {}", i, s.sector, s.numlines, s.firstline);
        i = i + 1;
    }

    print.printlnf("segs {}", lv.numsegs);
    i = 0;
    for (i < lv.numsegs) {
        val g: *level.Seg = ?lv.segs[i];
        print.printf("g {} {} {} {} {}", i, g.v1, g.v2, g.offset, g.angle);
        print.printlnf(" {} {} {} {}", g.sidedef, g.linedef, g.frontsector, g.backsector);
        i = i + 1;
    }

    print.printlnf("nodes {}", lv.numnodes);
    i = 0;
    for (i < lv.numnodes) {
        val n: *level.Node = ?lv.nodes[i];
        print.printf("n {} {} {} {} {}", i, n.x, n.y, n.dx, n.dy);
        var k: i32 = 0;
        for (k < 8) {
            print.printf(" {}", n.bbox[k]);
            k = k + 1;
        }
        print.printlnf(" {} {}", n.children[0], n.children[1]);
        i = i + 1;
    }

    print.printlnf("things {}", lv.numthings);
    i = 0;
    for (i < lv.numthings) {
        val t: *level.Thing = ?lv.things[i];
        print.printlnf("t {} {} {} {} {} {}", i, t.x, t.y, t.angle, t.kind, t.options);
        i = i + 1;
    }

    print.printf("blockmap {} {} {} {}", lv.bmaporgx, lv.bmaporgy, lv.bmapwidth, lv.bmapheight);
    print.printlnf(" {} {}", lv.blockwords, digest(lv.blockmaplump, lv.blockwords * 2));
    print.printlnf("reject {} {}", lv.rejectsize, digest(lv.rejectmatrix, lv.rejectsize));
    ret EXIT_OK;
}

# a whole number from the command line, or the fallback when it is not one
fun number(s: str, fallback: i64) i64 {
    val r: res[i64, parse.ParseError] = parse.parse_i64(s, 10);
    if (sel r.ok) { ret r.ok; }
    ret fallback;
}

# load a map and give it its texture numbers
fun load_map(a: *allocator.Allocator, w: *wad.Wad, d: *rdata.Data, lv: *level.Level, name: str) i64 {
    val built: res[level.Level, level.LevelError] = level.load(a, w, name);
    if (sel built.err) { ret refuse_map(built.err); }
    @lv = built.ok;

    val bound: rdata.BindError = rdata.bind(d, lv);
    if (sel bound.side) {
        print.eprintlnf("doom: side {} names a texture the WAD does not define", bound.side);
        ret EXIT_DATA;
    }
    if (sel bound.sector) {
        print.eprintlnf("doom: sector {} names a flat the WAD does not hold", bound.sector);
        ret EXIT_DATA;
    }
    ret EXIT_OK;
}

# play the game in a window: the title screen and its demos, the menus, the
# levels and what comes between them, at 35 tics a second, with sound
fun play(argc: i64, argv: **u8) i64 {
    ret play_with(argc, argv, nil);
}

# play in a window, alone or, with a network game, in co-op: hosting with
# `doom host <file> [<players 2-4> [<map> [<skill>]]]` or joining with
# `doom join <file> <address>`
fun play_net(argc: i64, argv: **u8, hosting: bool) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val got: res[*net.Net, allocator.Error] = allocator.zallocate[net.Net](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val n: *net.Net = got.ok;

    # the words after the WAD: numbers in order, --relay <where>, local
    var numbers: [3]i64 = [3]i64{2, 1, 3};
    var count:   i32    = 0;
    var target:  str    = nil;
    var local:   bool   = 0;
    var i:       i64    = 3;
    for (i < argc) {
        if (str_equals(argv[i], "--relay")) {
            i = i + 2;
            cnt;
        }
        if (str_equals(argv[i], "local")) {
            local = 1;
        }
        or (hosting && count < 3) {
            numbers[count] = number(argv[i], numbers[count]);
            count          = count + 1;
        }
        or (!hosting && target == nil) {
            target = argv[i];
        }
        i = i + 1;
    }

    # through a relay when one is named, or when joining by code
    var relay:    net.Peer;
    val joincode: bool = !hosting && target != nil && is_code(target);
    val found: i32 = find_relay(argc, argv, ?relay);
    if (found < 0) {
        print.eprintln("doom: the relay's name could not be looked up");
        ret EXIT_USAGE;
    }
    if (joincode && found == 0) {
        print.eprintln("doom: joining by code needs a relay: add --relay <address> or set DOOM_RELAY");
        ret EXIT_USAGE;
    }

    # only a host that others reach directly needs the known port
    var port: u16 = net.PORT;
    if (!hosting || found == 1) { port = 0; }
    if (!net.open(n, port, local)) {
        print.eprintlnf("doom: port {} could not be opened; is another game hosting?", net.PORT);
        ret EXIT_WINDOW;
    }

    if (hosting) {
        var players: i64 = numbers[0];
        if (players < 2) { players = 2; }
        if (players > 4) { players = 4; }
        net.host(n, players::i32, (numbers[2] - 1)::i32, numbers[1]::i32);
        if (found == 1) { net.use_relay(n, ?relay); }
    }
    or {
        if (target == nil) { ret usage(); }
        if (joincode) {
            net.use_relay(n, ?relay);
            net.join_code(n, target);
        }
        or (!net.join(n, target)) {
            print.eprintln("doom: that is neither an address nor a room code; give it as 192.168.1.20 or KQ7M2T");
            ret EXIT_USAGE;
        }
    }
    val code: i64 = play_with(3, argv, n);
    net.close(n);
    ret code;
}

# where the relay is for a game started from the menu: as the command line
# or DOOM_RELAY says, or the default
fun menu_relay(argc: i64, argv: **u8, out: *net.Peer) bool {
    val found: i32 = find_relay(argc, argv, out);
    if (found != 0) { ret found == 1; }
    if (!win.resolve_ipv4(DEFAULT_RELAY, ?out.octets[0])) { ret 0; }
    out.port  = net.PORT;
    out.known = 1;
    ret 1;
}

# set up the co-op game the menu asked for, to host or to join by code
# ---
# ret: nil, or why it could not start, for the screen
fun start_menu_net(argc: i64, argv: **u8, n: *net.Net, request: i32, f: *front.Front, wadhash: u64) str {
    if (n == nil) { ret "there is not enough memory for a network game.\n\n(press a key)"; }
    var blank: net.Net;
    @n = blank;
    var relay: net.Peer;
    if (!menu_relay(argc, argv, ?relay)) {
        ret "the relay could not be found.\nis this computer online?\n\n(press a key)";
    }
    if (!net.open(n, 0, 0)) { ret "the network could not be opened.\n\n(press a key)"; }
    n.wadhash = wadhash;
    if (request == front.NET_HOST) {
        # a deathmatch is on one of the maps the bots know, picked by the
        # clock; co-op starts the episode. The list's standing deathmatch is
        # public and quick whatever the menu says.
        val dm: bool = f.netdm || f.netquick;
        var map: i32 = 1;
        if (dm) { map = BOTMAPS[(win.micros_now() % 7)::i32]; }
        net.host(n, f.netplayers, f.netskill, map);
        net.use_relay(n, ?relay);
        n.public     = f.netpublic || f.netquick;
        n.deathmatch = dm;
        n.quick      = f.netquick;
    }
    or {
        net.use_relay(n, ?relay);
        net.join_code(n, ?f.code[0]);
    }
    ret nil;
}

fun play_with(argc: i64, argv: **u8, given: *net.Net) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) {
        print.eprintln("doom: the WAD's textures, flats or light tables are absent or damaged");
        ret EXIT_DATA;
    }
    var d: rdata.Data = graphics.ok;

    # the network game: one set up on the command line, or one the menu
    # starts later, which leaves back to the title screen when it is over
    var n:       *net.Net = given;
    var menunet: *net.Net = nil;
    val wadhash: u64      = game_hash(?a, ?w);
    if (n != nil) { n.wadhash = wadhash; }

    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);

    # a renderer needs a map to start with; it follows whichever the game loads
    var first: level.Level;
    val code:  i64 = load_map(?a, ?w, ?d, ?first, "E1M1");
    if (code != EXIT_OK) { ret code; }
    val ready: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, ?first);
    if (sel ready.err) {
        print.eprintln("doom: the renderer could not be set up");
        ret EXIT_DATA;
    }
    val r: *render.Renderer = ready.ok;

    var f: front.Front;
    front.init(?f);
    f.train = read_choice();
    var said: i32 = f.trainsaid;
    build_code(wadhash, ?f.build[0]);

    # a network game starts on a waiting screen, whose words change as the
    # lobby fills
    var waitbuf: [256]u8;
    if (n != nil) {
        f.mode        = front.MODE_FINALE;
        f.finalestage = 1;
        waiting_text(n, ?waitbuf[0]);
        front.notice(?f, ?waitbuf[0]);
    }

    # a map and skill on the command line skip the title screen
    if (n == nil && argc >= 4) {
        var skill: i64 = 3;
        if (argc >= 5)                                                      { skill = number(argv[4], 3); }
        if (game.new_game(s, (skill - 1)::i32, 1, number(argv[3], 1)::i32)) { f.mode = front.MODE_LEVEL; }
    }

    # a second renderer, for the small view of a team-mate's eyes in the
    # corner; without it there is no such view
    val second: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, ?first);
    if (sel second.ok) { f.inset = second.ok; }

    var window: win.Window;
    if (!win.open(?window, "Doom in Mach", 960, 720)) {
        print.eprintln("doom: the window could not be opened");
        ret EXIT_WINDOW;
    }

    # sound and music are optional: without a device the game plays silent
    var audio: win.Audio;
    if (win.audio_open(?audio, sound.RATE)) { sound.install(?s.g, ?w); }
    var song:       music.Song;
    var songserial: i32  = -1;
    var musvolume:  i32  = -1;
    val hasmusic:   bool = opl_init(?w);
    win.fine_timer(1);

    var bar:     st.State;
    st.init(?bar);
    var palette: i32 = -1;
    var weapon:  i32 = 0;

    var gametic:    i32  = 0;
    var netstarted: bool = 0;
    var stalled:    bool = 0;
    var reported:   bool = 0;
    var lobby:      net.Lobby;
    # an update asked for: a moment for the screen to say so, then done
    var updating:   i32 = 0;
    # joining the co-op league where it is: a frame or two to say so first,
    # then the joining a slice of tics a frame — a level deep in takes a
    # while to catch up with, and the window must stay its own the while
    var joining:   i32 = 0;
    var join:      LeagueJoin;
    var joinnames: [96]u8;
    var joinmsg:   [96]u8;
    var joinretry: i64 = 0;
    tidy_update();
    # watching the bot league: a match being fetched, or one being played
    # again, and how long it runs
    var fetch:     *net.Watch = nil;
    var fetching:  bool       = 0;
    var watchtics: i32        = 0;
    var progress:   i64  = 0;
    val tic:        i64  = 1000000 / 35;
    var next:       i64  = win.micros(?window);
    var musicclock: i64  = next;
    for (win.pump(?window) && !f.quit) {
        # keys that act once when pressed: the menus, and the weapon keys
        val key:     i32  = win.take_key();
        val stopped: bool = n != nil && (!netstarted || stalled || n.desync || n.quit);
        if ((fetching || joining < 0) && key == front.KEY_ESCAPE) {
            # give up on the league, being fetched, joined or waited for
            if (fetching)      { net.watch_close(fetch); fetching = 0; }
            if (joining == -1) { join_abort(s, ?join); }
            joining = 0;
            front.to_title(?f);
            f.message = nil;
            cnt;
        }
        if (key != 0 && !stopped && !fetching && joining >= 0) {
            val playing: bool = f.mode == front.MODE_LEVEL && !f.menuactive && f.message == nil;
            if (playing && f.watching && key >= '1' && key <= '4') {
                # whose eyes to watch through
                s.g.consoleplayer = key - '1';
                if (f.spy == s.g.consoleplayer) { front.spy_next(?f, s); }
            }
            or (playing && f.watching && (key == 'L' || key == 'l')) {
                # the other league's match
                f.watchcoop  = !f.watchcoop;
                f.netrequest = front.NET_WATCH;
            }
            or (playing && key == front.KEY_F12 && front.may_spy(?f, s)) {
                # the corner's view: the next team-mate's eyes, then nobody's
                front.spy_next(?f, s);
            }
            or (playing && key >= '1' && key <= '7') {
                weapon = key - '0';
            }
            or {
                front.responder(?f, s, key);
            }
        }

        # a host waiting may start at once, with bots in the empty seats
        if (n != nil && !netstarted && key == front.KEY_ENTER) { net.ask_fill(n); }

        # a network game is left with Esc while waiting or once it has
        # stopped, or with the menu's End Game
        if (n != nil && ((stopped && key == front.KEY_ESCAPE) || (netstarted && f.mode == front.MODE_PAGE))) {
            if (given != nil) { brk; }
            net.close(n);
            n          = nil;
            netstarted = 0;
            stalled    = 0;
            reported   = 0;
            gametic    = 0;
            front.to_title(?f);
            f.message = nil;
            cnt;
        }

        # an answer about training the bots, given or changed: keep it
        if (f.trainsaid != said) {
            said = f.trainsaid;
            write_choice(f.train);
        }

        # the newest version: say so, draw that, then fetch it, which takes
        # a moment during which nothing else happens
        if (f.netrequest == front.NET_UPDATE) {
            f.netrequest = 0;
            if (n == nil) {
                updating = 80;
                front.notice(?f, "looking for a newer version...");
            }
        }
        if (updating > 0) {
            updating = updating - 1;
            if (updating == 0) {
                val did: i32 = update(?a, argv[2], 1);
                if (did == UPDATE_STARTED) {
                    f.quit = 1;
                }
                or (did == UPDATE_LATEST) {
                    front.notice(?f, "this is the newest version.\n\n(press a key)");
                }
                or (did == UPDATE_NOREACH) {
                    front.notice(?f, "the newest version could not be\nfetched. is this computer online?\n\n(press a key)");
                }
                or {
                    front.notice(?f, "the update could not be put in\nplace. download the game again\nfrom the web page.\n\n(press a key)");
                }
            }
        }

        # the bot league, watched: fetch its last match from the relay, play
        # it again here at the speed of a game, and when it ends fetch the
        # next
        if (f.netrequest == front.NET_WATCH || (f.watching && f.mode != front.MODE_PAGE && !fetching && watched_out(?f, s, watchtics))) {
            f.netrequest = 0;
            if (fetch == nil) {
                val wg: res[*net.Watch, allocator.Error] = allocator.zallocate[net.Watch](?a, 1);
                if (sel wg.ok) { fetch = wg.ok; }
            }
            var where: net.Peer;
            f.mode        = front.MODE_FINALE;
            f.finalestage = 1;
            f.menuactive  = 0;
            if (f.watchcoop && n == nil) {
                # the co-op league is joined where it is: a frame to say so,
                # then the joining, which takes a moment
                joining = 2;
                front.notice(?f, "joining the co-op bots where\nthey are...");
            }
            or (n == nil && fetch != nil && menu_relay(argc, argv, ?where) && net.watch_open(fetch, ?where)) {
                fetching = 1;
                front.notice(?f, "fetching a match from the bot league...\n\n(esc to give up)");
            }
            or {
                front.to_title(?f);
                front.notice(?f, "the relay could not be reached.\n\n(press a key)");
            }
        }
        if (joining > 0) {
            joining = joining - 1;
            if (joining == 0) {
                val began: i32 = join_league_begin(?a, s, ?joinnames[0], ?join);
                if (began > 0) {
                    joining = -1;
                    front.notice(?f, "catching up with the co-op bots,\nhowever far in they are...\n\n(escape gives up)");
                }
                or (began == ANOTHER_SIMULATION) {
                    front.to_title(?f);
                    front.notice(?f, "the co-op bots are playing another\nversion of the game. options,\nupdate the game; if this is the\nnewest, the league will catch up\nwithin the hour.\n\n(press a key)");
                }
                or (began == UNREACHED) {
                    front.to_title(?f);
                    front.notice(?f, "the league could not be reached.\nis this computer online?\n\n(press a key)");
                }
                or (began == BETWEEN) {
                    joining   = -2;
                    joinretry = win.micros_now() + 10000000;
                    front.notice(?f, "the league is between its levels.\nwatching for the next one...\n\n(escape gives up)");
                }
                or {
                    joining   = -2;
                    joinretry = win.micros_now() + 10000000;
                    front.notice(?f, "the co-op bots have no campaign\nunder way just now. watching\nfor the next...\n\n(escape gives up)");
                }
            }
        }
        or (joining == -2) {
            # between the league's levels: ask again every ten seconds
            if (win.micros_now() >= joinretry) {
                val began: i32 = join_league_begin(?a, s, ?joinnames[0], ?join);
                if (began > 0) {
                    joining = -1;
                    front.notice(?f, "catching up with the co-op bots\nwhere they are...");
                }
                or (began == ANOTHER_SIMULATION) {
                    joining = 0;
                    front.to_title(?f);
                    front.notice(?f, "the co-op bots are playing another\nversion of the game. options,\nupdate the game; if this is the\nnewest, the league will catch up\nwithin the hour.\n\n(press a key)");
                }
                or (began == UNREACHED) {
                    joining = 0;
                    front.to_title(?f);
                    front.notice(?f, "the league could not be reached.\nis this computer online?\n\n(press a key)");
                }
                or {
                    joinretry = win.micros_now() + 10000000;
                }
            }
        }
        or (joining < 0) {
            var ja: i32 = append(?joinmsg[0], 0, "catching up with the co-op bots...");
            if (join.target > 0) {
                ja = append(?joinmsg[0], ja, "\n");
                ja = append_number(?joinmsg[0], ja, (join.tic * 100 / join.target)::i64);
                ja = append(?joinmsg[0], ja, "% of the way there");
            }
            append(?joinmsg[0], ja, "\n\n(escape gives up)");
            front.notice(?f, ?joinmsg[0]);
            val caught: i32 = join_slice(s, ?join, 50000);
            if (caught > 0) {
                joining = 0;
                front.start_watching(?f, s, ?joinnames[0]);
            }
            or (caught < 0) {
                joining = 0;
                front.to_title(?f);
                front.notice(?f, "the co-op bots have no campaign\nunder way just now.\n\n(press a key)");
            }
        }
        if (fetching) {
            net.watch_poll(fetch, win.micros_now());
            if (fetch.done) {
                net.watch_close(fetch);
                fetching  = 0;
                watchtics = watch_setup(s, ?fetch.data[0], 0);
                if (watchtics == ANOTHER_SIMULATION) {
                    front.to_title(?f);
                    front.notice(?f, "that match was played by another\nversion of the bots. options,\nupdate the game; if this is the\nnewest, the league will catch up\nwithin the hour.\n\n(press a key)");
                }
                or (watchtics > 0) {
                    var names: [96]u8;
                    var q:     i32 = 0;
                    for (q < 96) {
                        names[q] = fetch.data[16 + (q / 24) * 986 + 20 + q % 24];
                        q        = q + 1;
                    }
                    front.start_watching(?f, s, ?names[0]);
                }
                or {
                    front.to_title(?f);
                    front.notice(?f, "that match is from another version\nof the game. options, update the\ngame.\n\n(press a key)");
                }
            }
            or (fetch.asks >= 4) {
                net.watch_close(fetch);
                fetching = 0;
                front.to_title(?f);
                if (fetch.none) {
                    front.notice(?f, "the bot league has no match\nto watch just now.\n\n(press a key)");
                }
                or {
                    front.notice(?f, "the relay did not answer.\n\n(press a key)");
                }
            }
        }

        # the list of open games, while it is on screen: ask the relay, and
        # hand the menu what it says
        if (front.listing(?f) && n == nil) {
            if (!lobby.opened) {
                var where: net.Peer;
                f.liststate = front.LIST_NOREACH;
                if (menu_relay(argc, argv, ?where) && net.lobby_open(?lobby, ?where, wadhash)) { f.liststate = front.LIST_ASKING; }
            }
            net.lobby_poll(?lobby, win.micros_now());
            if (lobby.answered) {
                f.liststate = front.LIST_KNOWN;
                f.nrooms    = lobby.count;
                var g: i32 = 0;
                for (g < lobby.count) {
                    var c: i32 = 0;
                    for (c < 7) {
                        f.rooms[g].code[c] = lobby.rooms[g].code[c];
                        c                  = c + 1;
                    }
                    f.rooms[g].players = lobby.rooms[g].players;
                    f.rooms[g].joined  = lobby.rooms[g].joined;
                    f.rooms[g].skill   = lobby.rooms[g].skill;
                    f.rooms[g].map     = lobby.rooms[g].map;
                    f.rooms[g].deathmatch = lobby.rooms[g].deathmatch;
                    g                  = g + 1;
                }
            }
            # six seconds without a word is a relay that cannot be reached
            or (lobby.opened && lobby.asks >= 3) {
                f.liststate = front.LIST_NOREACH;
            }
        }
        or (lobby.opened) {
            net.lobby_close(?lobby);
        }

        # the menu asked for a co-op game: reach the relay and wait there
        if (f.netrequest != 0) {
            val request: i32 = f.netrequest;
            f.netrequest = 0;
            if (n == nil && menunet == nil) {
                val room: res[*net.Net, allocator.Error] = allocator.zallocate[net.Net](?a, 1);
                if (sel room.ok) { menunet = room.ok; }
            }
            if (n == nil) {
                val why: str = start_menu_net(argc, argv, menunet, request, ?f, wadhash);
                if (why == nil) {
                    n             = menunet;
                    netstarted    = 0;
                    stalled       = 0;
                    gametic       = 0;
                    f.mode        = front.MODE_FINALE;
                    f.finalestage = 1;
                    waiting_text(n, ?waitbuf[0]);
                    front.notice(?f, ?waitbuf[0]);
                }
                or {
                    front.notice(?f, why);
                }
            }
        }

        # run however many tics are due, but never try to catch up on a stall
        val now:   i64 = win.micros(?window);
        var steps: i32 = 0;
        for (now >= next && steps < 4) {
            var input: game.Input;
            if (!f.menuactive) {
                input.forward      = win.key_down(?window, win.VK_UP) || win.key_down(?window, 'W');
                input.back         = win.key_down(?window, win.VK_DOWN) || win.key_down(?window, 'S');
                input.left         = win.key_down(?window, win.VK_LEFT);
                input.right        = win.key_down(?window, win.VK_RIGHT);
                input.strafe_left  = win.key_down(?window, 'A');
                input.strafe_right = win.key_down(?window, 'D');
                input.run          = win.key_down(?window, win.VK_SHIFT);
                input.fire         = win.key_down(?window, win.VK_CONTROL) || win.key_down(?window, 'F');
                input.activate     = win.key_down(?window, win.VK_SPACE) || win.key_down(?window, 'E');
                input.weapon       = weapon;
                weapon             = 0;
            }

            if (n == nil) {
                front.ticker(?f, s, ?bar, ?input);
            }
            or {
                # waiting for everyone, then starting the game they agree on
                if (!netstarted) {
                    if (net.gather(n)) {
                        netstarted = 1;
                        progress   = now;
                        var names: [96]u8;
                        net_names(n, ?names[0]);
                        if (!front.start_coop(?f, s, n.players, n.me, n.skill, n.map, n.deathmatch, ?names[0])) { f.quit = 1; }
                        seat_bots(s, n);
                        f.message = nil;
                    }
                    or {
                        waiting_text(n, ?waitbuf[0]);
                        front.notice(?f, ?waitbuf[0]);
                    }
                }
                or {
                    # my command for a tic ahead, then every tic all the
                    # commands are in for
                    net.receive(n);
                    if (net.wants_command(n, gametic)) {
                        var cmd: defs.Ticcmd;
                        game.build_ticcmd(s, ?input, ?cmd);
                        net.add_command(n, ?cmd);
                    }
                    net.send_commands(n, gametic - 1);
                    for (!n.desync && !n.quit && !stalled && net.due(n, gametic) && net.ready(n, gametic)) {
                        var cmds: [4]defs.Ticcmd;
                        net.commands(n, gametic, ?cmds[0]);
                        front.net_ticker(?f, s, ?bar, ?cmds[0]);
                        if (f.train == front.TRAIN_YES && f.mode == front.MODE_LEVEL) { teach(n, s); }
                        net.record(n, gametic, game.checksum(s));
                        gametic  = gametic + 1;
                        progress = now;
                    }
                    net.pace(n, gametic);
                    # ten seconds with no tic from someone: say so, rather
                    # than wait forever
                    if (!stalled && !n.desync && !n.quit && now - progress > 10000000) {
                        stalled = 1;
                        front.notice(?f, "a player has stopped answering.\n\nthe game cannot go on without them. (esc)");
                    }
                    if (n.desync) {
                        front.notice(?f, "the games have gone out of step.\nthis one has stopped. a report is in\ndoom-desync.txt beside doom.exe. (esc)");
                        if (!reported) {
                            desync_report(n, s, f.mode, gametic);
                            reported = 1;
                        }
                    }
                    if (n.quit)   { front.notice(?f, "another player has left the game.\n\n(esc)"); }
                }
            }
            sound.update(?s.g);
            next  = next + tic;
            steps = steps + 1;
        }
        if (now >= next)                                                 { next = now; }
        win.audio_pump(?audio, mix_all);

        # the song the front end wants, at the volume the menu sets
        if (hasmusic) {
            if (songserial != f.songserial) {
                songserial = f.songserial;
                music.stop(?song, opl.midi);
                val found: opt[u32] = wad.find(?w, ?f.song[0]);
                if (sel found.some) {
                    val looping: bool = f.song[2] != 'I' || f.song[3] != 'N' || f.song[4] != 'T' || f.song[5] != 'R';
                    music.load(?song, wad.bytes(?w, found.some), wad.lump(?w, found.some).size, looping);
                    musvolume = -1;
                }
            }
            if (musvolume != f.musicvolume) {
                musvolume = f.musicvolume;
                music.set_volume(?song, musvolume * 127 / 15, opl.midi);
            }
            # music ticks are 1/140 s; carry the remainder so none are lost
            val ticks: i64 = (now - musicclock) * music.TICRATE::i64 / 1000000;
            if (ticks > 0) {
                musicclock = musicclock + ticks * 1000000 / music.TICRATE::i64;
                music.advance(?song, ticks::u32, opl.midi);
            }
        }

        if (steps > 0) {
            front.draw(?f, s, r, ?bar);

            # the damage and pickup flashes are whole palettes
            val wanted: i32 = front.palette(?f, ?bar);
            if (wanted != palette) {
                palette = wanted;
                win.set_palette(?window, ?d.playpal[palette * 768]);
            }
            win.present(?window, ?r.screen[0]);
        }
        or {
            win.nap(1);
        }
    }
    if (n != nil && given == nil) { net.close(n); }
    net.lobby_close(?lobby);
    if (fetch != nil) { net.watch_close(fetch); }
    music.stop(?song, opl.midi);
    win.fine_timer(0);
    win.audio_close(?audio);
    win.close(?window);
    ret EXIT_OK;
}

# write a frame as a binary PPM: palette indices to red, green, blue through
# the first palette
fun write_ppm(a: *allocator.Allocator, d: *rdata.Data, r: *render.Renderer, path: str) i64 {
    ret write_ppm_palette(a, d, r, path, 0);
}

# write a frame as a binary PPM through one of the 14 palettes
fun write_ppm_palette(a: *allocator.Allocator, d: *rdata.Data, r: *render.Renderer, path: str, palette: i32) i64 {
    val pixels: i32                       = render.SCREENWIDTH * render.SCREENHEIGHT;
    val header: str                       = "P6\n320 200\n255\n";
    val got:    res[*u8, allocator.Error] = allocator.allocate[u8](a, (15 + pixels * 3)::usize);
    if (sel got.err) { ret EXIT_WRITE; }
    val image: *u8 = got.ok;
    var i:     i32 = 0;
    for (i < 15) {
        image[i] = header[i];
        i        = i + 1;
    }
    i = 0;
    for (i < pixels) {
        val c: i32 = palette * 768 + r.screen[i]::i32 * 3;
        image[15 + i * 3]     = d.playpal[c];
        image[15 + i * 3 + 1] = d.playpal[c + 1];
        image[15 + i * 3 + 2] = d.playpal[c + 2];
        i                     = i + 1;
    }
    val wrote: err[fs.FsError] = fs.write_bytes(path, image, (15 + pixels * 3)::usize, 0o644);
    if (sel wrote.err) {
        print.eprintln("doom: the image could not be written");
        ret EXIT_WRITE;
    }
    ret EXIT_OK;
}

# draw one frame and write it as a binary PPM
fun frame(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) {
        print.eprintln("doom: the WAD's textures, flats or light tables are absent or damaged");
        ret EXIT_DATA;
    }
    var d: rdata.Data = graphics.ok;

    var lv:   level.Level;
    val code: i64 = load_map(?a, ?w, ?d, ?lv, argv[3]);
    if (code != EXIT_OK) { ret code; }

    val ready: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, ?lv);
    if (sel ready.err) {
        print.eprintln("doom: the renderer could not be set up");
        ret EXIT_DATA;
    }
    val r: *render.Renderer = ready.ok;

    # the eye: a point given on the command line, or the first player start
    var x:       i64 = 0;
    var y:       i64 = 0;
    var degrees: i64 = 0;
    if (argc == 8) {
        x       = number(argv[5], 0);
        y       = number(argv[6], 0);
        degrees = number(argv[7], 0);
    }
    or {
        var i:     i32 = 0;
        var found: u8  = 0;
        for (i < lv.numthings) {
            if (lv.things[i].kind == 1) {
                x       = lv.things[i].x::i64;
                y       = lv.things[i].y::i64;
                degrees = lv.things[i].angle::i64;
                found   = 1;
                brk;
            }
            i = i + 1;
        }
        if (!found) {
            print.eprintln("doom: the map has no player start");
            ret EXIT_MAP;
        }
    }

    # the eye stands on the floor of whatever sector the point is in
    val fx:    i32 = (x << 16)::i32;
    val fy:    i32 = (y << 16)::i32;
    val sub:   i32 = render.point_in_subsector(?lv, fx, fy);
    val floor: i32 = lv.sectors[lv.subsectors[sub].sector].floorheight;
    # whole degrees to a 32-bit turn, as P_SpawnPlayer does for the 45s
    val angle: u32 = ((degrees * 0x100000000) / 360)::u32;
    render.render(r, fx, fy, floor + render.VIEWHEIGHT, angle);
    if (r.overflow) { print.eprintln("doom: warning: the frame needed more visplanes than the original allows"); }

    ret write_ppm(?a, ?d, r, argv[4]);
}

# play a recorded demo with no display, and report where it ends
fun demo(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) {
        print.eprintln("doom: the WAD's textures, flats or light tables are absent or damaged");
        ret EXIT_DATA;
    }
    var d: rdata.Data = graphics.ok;

    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);

    if (!game.play_demo(s, argv[3])) {
        print.eprintln("doom: no such demo, or it is from another version, or its map did not load");
        ret EXIT_MAP;
    }

    # how often to print a line; 0 for only the last
    var every: i64 = 0;
    if (argc == 5) { every = number(argv[4], 0); }

    # optionally draw the player's view at one tic
    var shot: i64 = -1;
    if (argc == 7) { shot = number(argv[5], -1); }

    var input: game.Input;
    print.printlnf("demo {} map E{}M{} skill {}", argv[3], s.g.gameepisode, s.g.gamemap, s.g.gameskill);
    for (!s.demodone && !s.broken) {
        game.ticker(s, ?input);
        if (s.g.gametic::i64 == shot) {
            val ready: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, ?s.lvl);
            if (sel ready.ok) {
                render.render_player_view(ready.ok, ?s.g, ?s.g.players[0]);
                write_ppm(?a, ?d, ready.ok, argv[6]);
            }
        }
        if (every > 0 && !s.demodone && (s.g.gametic::i64 % every) == 0) {
            val p: *defs.Player = ?s.g.players[0];
            print.printlnf("{} {} {} {} {} {} {}", s.g.gametic, game.checksum(s), p.mo.x, p.mo.y, p.mo.angle, p.health, s.g.rnd.play);
        }
    }
    val p: *defs.Player = ?s.g.players[0];
    print.printf("end tic {} sum {} x {} y {} angle {}", s.g.gametic, game.checksum(s), p.mo.x, p.mo.y, p.mo.angle);
    print.printlnf(" health {} armor {} kills {}/{} items {}/{} secrets {}/{} exited {}", p.health, p.armorpoints, p.killcount, s.g.totalkills, p.itemcount, s.g.totalitems, p.secretcount, s.g.totalsecret, s.g.exited);
    ret EXIT_OK;
}

fun put32(p: *u8, at: i32, v: u32) {
    p[at]     = (v & 0xff)::u8;
    p[at + 1] = ((v >> 8) & 0xff)::u8;
    p[at + 2] = ((v >> 16) & 0xff)::u8;
    p[at + 3] = ((v >> 24) & 0xff)::u8;
}

# play a recorded demo with no display and write what it sounds like as a
# WAV file: the mixer's output, 315 frames to the tic
fun wav(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) {
        print.eprintln("doom: the WAD's textures, flats or light tables are absent or damaged");
        ret EXIT_DATA;
    }
    var d: rdata.Data = graphics.ok;

    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);
    sound.install(?s.g, ?w);
    sound.set_volume(15);

    if (!game.play_demo(s, argv[3])) {
        print.eprintln("doom: no such demo, or it is from another version, or its map did not load");
        ret EXIT_MAP;
    }

    # room for every tic the demo lump could hold
    val per:    i32                       = sound.RATE / 35;
    val tics:   i32                       = (s.demolen / 4)::i32 + 1;
    val bytes:  i32                       = tics * per * 4;
    val buffer: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, (44 + bytes)::usize);
    if (sel buffer.err) { ret EXIT_WRITE; }
    val out: *u8 = buffer.ok;

    var input: game.Input;
    var done:  i32 = 0;
    for (!s.demodone && !s.broken && done < tics) {
        game.ticker(s, ?input);
        sound.update(?s.g);
        sound.mix((?out[44 + done * per * 4]):~*i16, per);
        done = done + 1;
    }

    val data: u32 = (done * per * 4)::u32;
    wav_header(out, data);

    val wrote: err[fs.FsError] = fs.write_bytes(argv[4], out, (44 + data)::usize, 0o644);
    if (sel wrote.err) {
        print.eprintln("doom: the sound could not be written");
        ret EXIT_WRITE;
    }
    val p: *defs.Player = ?s.g.players[0];
    print.printlnf("end tic {} sum {} health {} kills {}", s.g.gametic, game.checksum(s), p.health, p.killcount);
    ret EXIT_OK;
}

# the 44-byte header of a 16-bit stereo PCM file at the mixing rate
fun wav_header(out: *u8, data: u32) {
    val header: str = "RIFF....WAVEfmt ";
    var i:      i32 = 0;
    for (i < 16) {
        out[i] = header[i];
        i      = i + 1;
    }
    put32(out, 4, 36 + data);
    put32(out, 16, 16);
    put32(out, 20, 0x00020001);
    put32(out, 24, sound.RATE::u32);
    put32(out, 28, (sound.RATE * 4)::u32);
    put32(out, 32, 0x00100004);
    out[36] = 'd';
    out[37] = 'a';
    out[38] = 't';
    out[39] = 'a';
    put32(out, 40, data);
}

# a number as decimal text, at a place in a buffer; ret where it ends
fun append_number(buf: *u8, at: i32, value: i64) i32 {
    var digits: [24]u8;
    var n:      i32 = 0;
    var v:      i64 = value;
    var end:    i32 = at;
    if (v < 0) {
        buf[end] = '-';
        end      = end + 1;
        v        = -v;
    }
    for {
        digits[n] = ('0' + (v % 10)::i32)::u8;
        n         = n + 1;
        v         = v / 10;
        if (v == 0) { brk; }
    }
    for (n > 0) {
        n        = n - 1;
        buf[end] = digits[n];
        end      = end + 1;
    }
    buf[end] = 0;
    ret end;
}

# when the games go out of step, a few lines about where, beside the
# program, for a player to send to whoever can look into it
fun desync_report(n: *net.Net, s: *game.Session, mode: i32, gametic: i32) {
    var path: [512]u8;
    if (!win.beside_exe("doom-desync.txt", ?path[0])) { ret; }
    var text: [256]u8;
    var at:   i32 = append(?text[0], 0, "doom in mach: the games went out of step\r\nat tic ");
    at = append_number(?text[0], at, n.desynctic::i64);
    at = append(?text[0], at, " (this game had played ");
    at = append_number(?text[0], at, gametic::i64);
    at = append(?text[0], at, ")\r\nplayer ");
    at = append_number(?text[0], at, (n.me + 1)::i64);
    at = append(?text[0], at, " of ");
    at = append_number(?text[0], at, n.players::i64);
    at = append(?text[0], at, ", against player ");
    at = append_number(?text[0], at, (n.against + 1)::i64);
    at = append(?text[0], at, "\r\nmap E1M");
    at = append_number(?text[0], at, s.g.gamemap::i64);
    at = append(?text[0], at, ", screen ");
    at = append_number(?text[0], at, mode::i64);
    at = append(?text[0], at, "\r\nmine ");
    at = append_number(?text[0], at, n.mysum::i64);
    at = append(?text[0], at, " theirs ");
    at = append_number(?text[0], at, n.theirsum::i64);
    at = append(?text[0], at, "\r\nbuild ");
    var code: [7]u8;
    build_code(n.wadhash, ?code[0]);
    at = append(?text[0], at, ?code[0]);
    at = append(?text[0], at, "\r\n");
    fs.write_bytes(?path[0], ?text[0], at::usize, 0o644);
}

# every player's name for the deathmatch's score: the bots' own, "you", and
# "player n" for the other people; 24 bytes each
fun net_names(n: *net.Net, out: *u8) {
    var i: i32 = 0;
    for (i < 96) {
        out[i] = 0;
        i      = i + 1;
    }
    i = 0;
    for (i < n.players && i < 4) {
        if ((n.botmask & (1 << i)) != 0) {
            append(?out[i * 24], 0, ?n.bots[i].name[0]);
        }
        or (i == n.me) {
            append(?out[i * 24], 0, "you");
        }
        or {
            val at: i32 = append(?out[i * 24], 0, "player ");
            append_number(?out[i * 24], at, (i + 1)::i64);
        }
        i = i + 1;
    }
}

# the bots the relay seated in a network game, made players of the session;
# every machine in the game does the same with the same bots
fun seat_bots(s: *game.Session, n: *net.Net) {
    var at: i32 = 0;
    var i:  i32 = 0;
    for (i < n.players) {
        if ((n.botmask & (1 << i)) != 0) {
            game.set_bot(s, i, seat_kind(n.bots[i].kind), ?n.bots[i].net[0], n.bots[i].seed);
            # and say who they are, on this player's message line
            if (at == 0) {
                at = append(?botline[0], 0, "with you: ");
            }
            or {
                at = append(?botline[0], at, ", ");
            }
            at = append(?botline[0], at, ?n.bots[i].name[0]);
        }
        i = i + 1;
    }
    if (at > 0) { s.g.players[n.me].message = ?botline[0]; }
}

# the line naming the bots in a game, which a player's message points at
var botline: [256]u8;

# the sound effects and the music, into one stretch of the output
fun mix_all(out: *i16, frames: i32) {
    sound.mix(out, frames);
    opl.mix(out, frames, sound.RATE);
}

# the instruments for the music synthesizer, from the WAD
fun opl_init(w: *wad.Wad) bool {
    val found: opt[u32] = wad.find(w, "GENMIDI");
    if (sel found.none) { ret 0; }
    ret opl.init(wad.bytes(w, found.some), wad.lump(w, found.some).size);
}

# play a song through the music synthesizer into a WAV file, as the game
# would at the menu's default music volume
#
#   doom muswav <wad> <song> <out.wav> <seconds>
fun muswav(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    if (!opl_init(?w)) {
        print.eprintln("doom: the WAD has no GENMIDI instruments");
        ret EXIT_DATA;
    }
    val found: opt[u32] = wad.find(?w, argv[3]);
    if (sel found.none) {
        print.eprintln("doom: no such lump");
        ret EXIT_MAP;
    }
    var song: music.Song;
    if (!music.load(?song, wad.bytes(?w, found.some), wad.lump(?w, found.some).size, 1)) {
        print.eprintln("doom: not a MUS lump");
        ret EXIT_DATA;
    }
    music.set_volume(?song, 8 * 127 / 15, opl.midi);

    var seconds: i32 = number(argv[5], 30)::i32;
    if (seconds < 1)   { seconds = 1; }
    if (seconds > 600) { seconds = 600; }
    val frames: i32                       = sound.RATE * seconds;
    val buffer: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, (44 + frames * 4)::usize);
    if (sel buffer.err) { ret EXIT_WRITE; }
    val out: *u8 = buffer.ok;

    # a music tick at a time: 140 a second, the frames between them carried
    # so that none are lost
    var done:  i32 = 0;
    var carry: i32 = 0;
    music.advance(?song, 0, opl.midi);
    for (done < frames) {
        carry = carry + sound.RATE;
        var n: i32 = carry / music.TICRATE;
        carry = carry % music.TICRATE;
        if (done + n > frames) { n = frames - done; }
        opl.mix((?out[44 + done * 4]):~*i16, n, sound.RATE);
        done = done + n;
        music.advance(?song, 1, opl.midi);
    }
    wav_header(out, (frames * 4)::u32);
    val wrote: err[fs.FsError] = fs.write_bytes(argv[4], out, (44 + frames * 4)::usize, 0o644);
    if (sel wrote.err) {
        print.eprintln("doom: the music could not be written");
        ret EXIT_WRITE;
    }
    ret EXIT_OK;
}

# the messages printed by `doom mus`
var musictick: u32;

fun print_message(m: u32) {
    print.printlnf("{} {} {} {}", musictick, m & 0xff, (m >> 8) & 0xff, (m >> 16) & 0xff);
}

# print the MIDI messages a song produces, one line per message with the tick
# it falls on, playing it once through
fun mus(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val found: opt[u32] = wad.find(?w, argv[3]);
    if (sel found.none) {
        print.eprintln("doom: no such lump");
        ret EXIT_MAP;
    }
    var song: music.Song;
    if (!music.load(?song, wad.bytes(?w, found.some), wad.lump(?w, found.some).size, 0)) {
        print.eprintln("doom: not a MUS lump");
        ret EXIT_DATA;
    }

    musictick = 0;
    music.advance(?song, 0, print_message);
    for (song.playing && musictick < 1000000) {
        musictick = musictick + 1;
        music.advance(?song, 1, print_message);
    }
    ret EXIT_OK;
}

# a key named on the command line: a letter or digit stands for itself
fun key_named(name: str) i32 {
    if (str_equals(name, "enter")) { ret front.KEY_ENTER; }
    if (str_equals(name, "tab"))   { ret am.KEY_TAB; }
    if (str_equals(name, "esc"))   { ret front.KEY_ESCAPE; }
    if (str_equals(name, "back"))  { ret front.KEY_BACKSPACE; }
    if (str_equals(name, "up"))    { ret front.KEY_UP; }
    if (str_equals(name, "down"))  { ret front.KEY_DOWN; }
    if (str_equals(name, "left"))  { ret front.KEY_LEFT; }
    if (str_equals(name, "right")) { ret front.KEY_RIGHT; }
    if (str_equals(name, "space")) { ret front.KEY_SPACE; }
    ret name[0]::i32;
}

# drive the front end with no window: a script of tics to run, keys to press
# and pictures to take, so that menus and screens can be checked and pinned
#
#   doom script <file> <out-prefix> <step>...
#
# steps: a number runs that many tics; key:<name> presses a key; fire holds
# fire for one tic; map:<n> starts a game on map n; exit ends the level
# being played, as its exit switch would; shot writes <out-prefix><n>.ppm
fun script(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);

    var first: level.Level;
    val code:  i64 = load_map(?a, ?w, ?d, ?first, "E1M1");
    if (code != EXIT_OK) { ret code; }
    val ready: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, ?first);
    if (sel ready.err) { ret EXIT_DATA; }
    val r: *render.Renderer = ready.ok;

    var f:   front.Front;
    var bar: st.State;
    front.init(?f);
    st.init(?bar);
    val second: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, ?first);
    if (sel second.ok) { f.inset = second.ok; }
    # a scripted walk is of a player who has answered, unless it says "unasked"
    f.train = front.TRAIN_NO;

    var shots: i32 = 0;
    var i:     i64 = 4;
    for (i < argc) {
        val step: str = argv[i];
        i = i + 1;
        var input: game.Input;
        if (str_equals(step, "shot")) {
            front.draw(?f, s, r, ?bar);
            # the file name: the prefix and a number
            var name: [512]u8;
            var k:    i32 = 0;
            for (argv[3][k] != 0 && k < 500) {
                name[k] = argv[3][k];
                k       = k + 1;
            }
            name[k]     = ('0' + shots / 10)::u8;
            name[k + 1] = ('0' + shots % 10)::u8;
            name[k + 2] = '.';
            name[k + 3] = 'p';
            name[k + 4] = 'p';
            name[k + 5] = 'm';
            name[k + 6] = 0;
            shots       = shots + 1;
            val written: i64 = write_ppm_palette(?a, ?d, r, ?name[0], front.palette(?f, ?bar));
            if (written != EXIT_OK) { ret written; }
        }
        or (str_equals(step, "fire")) {
            input.fire = 1;
            front.ticker(?f, s, ?bar, ?input);
        }
        or (step[0] == 'f' && step[1] == 'i' && step[2] == 'r' && step[3] == 'e' && step[4] == ':') {
            # fire:<n>: hold fire for n tics — long enough and the face sets
            var n: i64 = number(?step[5], 1);
            input.fire = 1;
            for (n > 0) {
                front.ticker(?f, s, ?bar, ?input);
                n = n - 1;
            }
        }
        or (step[0] == 'h' && step[1] == 'u' && step[2] == 'r' && step[3] == 't' && step[4] == ':') {
            # hurt:<damage>: the console player is wounded, by no one
            val pl: *defs.Player = ?s.g.players[s.g.consoleplayer];
            if (pl.mo != nil) { world.damage_mobj(?s.g, pl.mo, nil, nil, number(?step[5], 0)::i32); }
        }
        or (step[0] == 'h' && step[1] == 'e' && step[2] == 'a' && step[3] == 'l' && step[4] == ':') {
            # heal:<n>: wounded and suddenly whole again, the face opens up
            s.g.players[s.g.consoleplayer].health = s.g.players[s.g.consoleplayer].health + number(?step[5], 0)::i32;
        }
        or (str_equals(step, "god")) {
            s.g.players[s.g.consoleplayer].cheats = s.g.players[s.g.consoleplayer].cheats ^ defs.CF_GODMODE;
        }
        or (step[0] == 'g' && step[1] == 'i' && step[2] == 'v' && step[3] == 'e' && step[4] == ':') {
            # give:<slot>: a weapon arrives; a pickup flash makes the face grin
            val pl: *defs.Player = ?s.g.players[s.g.consoleplayer];
            pl.weaponowned[number(?step[5], 2)::i32] = 1;
            pl.bonuscount                          = defs.TICRATE;
        }
        or (step[0] == 'm' && step[1] == 'a' && step[2] == 'p' && step[3] == ':') {
            front.start_game(?f, s, defs.SK_MEDIUM, number(?step[4], 1)::i32);
        }
        or (str_equals(step, "exit")) {
            s.g.exited = 1;
        }
        or (step[0] == 'c' && step[1] == 'o' && step[2] == 'o' && step[3] == 'p' && step[4] == ':') {
            # a co-op game on a map, this player and three hand-written bots
            var names: [96]u8;
            if (front.start_coop(?f, s, 4, 0, defs.SK_MEDIUM, number(?step[5], 1)::i32, 0, ?names[0])) {
                var q: i32 = 1;
                for (q < 4) {
                    game.set_bot(s, q, bot.KIND_SCRIPT, nil, (q * 7919 + 17):~u32);
                    q = q + 1;
                }
            }
        }
        or (str_equals(step, "key:f12")) {
            if (front.may_spy(?f, s)) { front.spy_next(?f, s); }
        }
        or (str_equals(step, "unasked")) {
            # as a player who has never been asked about training the bots
            f.train = front.TRAIN_UNASKED;
        }
        or (step[0] == 's' && step[1] == 'a' && step[2] == 'y' && step[3] == ':') {
            front.announce_now(?f, number(?step[4], 0)::i32, 0);
        }
        or (step[0] == 's' && step[1] == 'a' && step[2] == 'v' && step[3] == 'e' && step[4] == ':') {
            # save:<n>: the game so far goes to doomsav<n>.sav
            if (!save.write_game(s, number(?step[5], 0)::i32, "scripted")) {
                print.println("save refused");
            }
        }
        or (step[0] == 'l' && step[1] == 'o' && step[2] == 'a' && step[3] == 'd' && step[4] == ':') {
            # load:<n>: doomsav<n>.sav becomes the game in progress
            if (save.read_game(s, ?a, number(?step[5], 0)::i32)) {
                front.loaded(?f, s);
            }
            or {
                print.println("load refused");
            }
        }
        or (str_equals(step, "sum")) {
            # the lockstep checksum: a resumed game must hash as the run it left
            print.printlnf("sum {} {}", s.g.gametic, game.checksum(s));
        }
        or (step[0] == 'k' && step[1] == 'e' && step[2] == 'y' && step[3] == ':') {
            front.responder(?f, s, key_named(?step[4]));
        }
        or {
            var n: i64 = number(step, 0);
            for (n > 0) {
                front.ticker(?f, s, ?bar, ?input);
                n = n - 1;
            }
        }
    }
    print.printlnf("mode {} map E{}M{} tic {} shots {}", f.mode, s.g.gameepisode, s.g.gamemap, s.g.gametic, shots);
    ret EXIT_OK;
}

# the first eight bytes of the WAD's SHA-256, which every machine in a network
# game must share
fun first64(data: *u8, len: usize) u64 {
    var digest: [32]u8;
    sha256.hash(data, len, ?digest[0]);
    var h: u64 = 0;
    var k: i32 = 0;
    for (k < 8) {
        h = (h << 8) | digest[k]::u64;
        k = k + 1;
    }
    ret h;
}

# what two machines must share to play together: this program and its WAD,
# hashed, so that two different downloads are turned away at the door rather
# than going out of step later. The program's part is 0 if it cannot be read.
fun game_hash(a: *allocator.Allocator, w: *wad.Wad) u64 {
    var exe:  [512]u8;
    var mine: u64 = 0;
    if (win.exe_path(?exe[0])) {
        val bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?exe[0]);
        if (sel bytes.ok) { mine = first64(bytes.ok.data, bytes.ok.len); }
    }
    ret first64(w.data, w.len) ^ (mine * 0x9e3779b97f4a7c15);
}

# a file's SHA-256 as 64 hex digits and a zero; false if it cannot be read
fun file_hash(a: *allocator.Allocator, path: str, out: *u8) bool {
    val bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel bytes.err) { ret 0; }
    var digest: [32]u8;
    sha256.hash(bytes.ok.data, bytes.ok.len, ?digest[0]);
    val digits: str = "0123456789abcdef";
    var k: i32 = 0;
    for (k < 32) {
        out[k * 2]     = digits[(digest[k] >> 4)::i32];
        out[k * 2 + 1] = digits[(digest[k] & 15)::i32];
        k              = k + 1;
    }
    out[64] = 0;
    ret 1;
}

val UPDATE_LATEST:  i32 = 0;
val UPDATE_STARTED: i32 = 1;
val UPDATE_NOREACH: i32 = 2;
val UPDATE_DAMAGED: i32 = 3;

# Bring this program up to date. Ask where the newest is kept for its hash;
# if it is this program's own, there is nothing to do. Otherwise fetch the
# program beside this one, check what came against the hash, put it in this
# one's place (a running program cannot be written over, but it can be
# renamed), and start it. The caller should then quit.
# ---
# wad:   the WAD being played, for starting the new program on the same one
# start: whether to start the new program, as the game does; the command
#        line's update leaves that to whoever ran it
# ret: UPDATE_LATEST, UPDATE_STARTED, or why not
fun update(a: *allocator.Allocator, wad_path: str, start: bool) i32 {
    var exe: [512]u8;
    if (!win.exe_path(?exe[0])) { ret UPDATE_DAMAGED; }
    var base:  [256]u8;
    var other: [256]u8;
    append(?base[0], 0, UPDATE_URL);
    val place: res[opt[usize], env.EnvError] = env.get("DOOM_UPDATE_URL", ?other[0], 200);
    if (sel place.ok) {
        if (sel place.ok.some) { append(?base[0], 0, ?other[0]); }
    }

    # the time in every address, so that no cache answers with yesterday's
    var url:  [512]u8;
    var path: [600]u8;
    var at:   i32 = append(?url[0], 0, ?base[0]);
    at = append(?url[0], at, "/doom.exe.sha256?t=");
    at = append_number(?url[0], at, win.micros_now());
    at = append(?path[0], 0, ?exe[0]);
    at = append(?path[0], at, ".latest");
    if (!win.download(?url[0], ?path[0])) { ret UPDATE_NOREACH; }
    val told: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?path[0]);
    fs.remove_file(?path[0]);
    if (sel told.err) { ret UPDATE_NOREACH; }
    if (told.ok.len < 64) { ret UPDATE_NOREACH; }

    var mine: [65]u8;
    if (!file_hash(a, ?exe[0], ?mine[0])) { ret UPDATE_DAMAGED; }
    var same: bool = 1;
    var k:    i32  = 0;
    for (k < 64) {
        if (told.ok.data[k] != mine[k]) { same = 0; }
        k = k + 1;
    }
    if (same) { ret UPDATE_LATEST; }

    # the new program, beside this one, and checked
    var fresh: [600]u8;
    at = append(?fresh[0], 0, ?exe[0]);
    at = append(?fresh[0], at, ".new");
    at = append(?url[0], 0, ?base[0]);
    at = append(?url[0], at, "/doom.exe?t=");
    at = append_number(?url[0], at, win.micros_now());
    if (!win.download(?url[0], ?fresh[0])) { ret UPDATE_NOREACH; }
    var got: [65]u8;
    if (!file_hash(a, ?fresh[0], ?got[0])) { ret UPDATE_DAMAGED; }
    k = 0;
    for (k < 64) {
        if (told.ok.data[k] != got[k]) {
            fs.remove_file(?fresh[0]);
            ret UPDATE_DAMAGED;
        }
        k = k + 1;
    }

    # this one aside, the new one in its place
    var old: [600]u8;
    at = append(?old[0], 0, ?exe[0]);
    at = append(?old[0], at, ".old");
    fs.remove_file(?old[0]);
    val aside: err[io_error.Error] = fs.rename(?exe[0], ?old[0]);
    if (sel aside.err) { ret UPDATE_DAMAGED; }
    val placed: err[io_error.Error] = fs.rename(?fresh[0], ?exe[0]);
    if (sel placed.err) {
        fs.rename(?old[0], ?exe[0]);
        ret UPDATE_DAMAGED;
    }

    # and started: as this one was, by a click or on its WAD
    if (!start) { ret UPDATE_STARTED; }
    var command: [1200]u8;
    at = join_text(?command[0], 0, "\"");
    at = join_text(?command[0], at, ?exe[0]);
    at = join_text(?command[0], at, "\"");
    if (!byclick) {
        at = join_text(?command[0], at, " play \"");
        at = join_text(?command[0], at, wad_path);
        at = join_text(?command[0], at, "\"");
    }
    if (!win.launch(?command[0])) { ret UPDATE_DAMAGED; }
    ret UPDATE_STARTED;
}

# append without append's limit of a short line: for a command line
fun join_text(buf: *u8, at: i32, text: str) i32 {
    var k: i32 = 0;
    for (text[k] != 0 && at + k < 1190) {
        buf[at + k] = text[k];
        k           = k + 1;
    }
    buf[at + k] = 0;
    ret at + k;
}

# bring this program up to date from the command line, and say what was done
#
#   doom update
fun update_command() i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val did: i32 = update(?a, "", 0);
    if (did == UPDATE_LATEST) {
        print.println("this is the newest version");
        ret EXIT_OK;
    }
    if (did == UPDATE_STARTED) {
        print.println("updated to the newest version");
        ret EXIT_OK;
    }
    if (did == UPDATE_NOREACH) {
        print.eprintln("doom: the newest version could not be fetched");
        ret EXIT_MAP;
    }
    print.eprintln("doom: the update could not be put in place");
    ret EXIT_WRITE;
}

# what an update left behind: the program it replaced
fun tidy_update() {
    var old: [600]u8;
    if (!win.exe_path(?old[0])) { ret; }
    var at: i32 = 0;
    for (old[at] != 0) { at = at + 1; }
    append(?old[at], 0, ".old");
    fs.remove_file(?old[0]);
}

# The player's one kept choice: whether the bots may learn from how they
# play online. In doom.cfg beside the program, as a line: train=1 or
# train=0. No file, or no such line, and the player has not been asked.
fun read_choice() i32 {
    var path: [512]u8;
    if (!win.beside_exe("doom.cfg", ?path[0])) { ret front.TRAIN_UNASKED; }
    val opened: res[fs.File, io_error.Error] = fs.open(?path[0]);
    if (sel opened.err) { ret front.TRAIN_UNASKED; }
    var file: fs.File = opened.ok;
    var text: [64]u8;
    val got:  res[usize, io_error.Error] = fs.read(file, ?text[0], 60);
    fs.close(?file);
    if (sel got.err) { ret front.TRAIN_UNASKED; }
    var k: i32 = 0;
    for (k + 6 < got.ok::i32) {
        if (text[k] == 't' && text[k + 1] == 'r' && text[k + 2] == 'a' && text[k + 3] == 'i' && text[k + 4] == 'n' && text[k + 5] == '=') {
            if (text[k + 6] == '1') { ret front.TRAIN_YES; }
            if (text[k + 6] == '0') { ret front.TRAIN_NO; }
        }
        k = k + 1;
    }
    ret front.TRAIN_UNASKED;
}

fun write_choice(choice: i32) {
    var path: [512]u8;
    if (!win.beside_exe("doom.cfg", ?path[0])) { ret; }
    var text: str = "train=0\n";
    if (choice == front.TRAIN_YES) { text = "train=1\n"; }
    fs.write_bytes(?path[0], text, 8, 0o644);
}

# What this machine's player did, a look at a time, gathered until there is
# a datagram's worth and then sent to the relay for the bot leagues. Called
# after a tic of a network game, and only for a player who has said the
# bots may learn from them.
var lessons:  [912]u8;
var nlessons: i32;

fun teach(n: *net.Net, s: *game.Session) {
    if (!s.sampled) { ret; }
    s.sampled = 0;
    var k: i32 = 0;
    for (k < bot.SAMPLE) {
        lessons[nlessons * bot.SAMPLE + k] = s.sample[k];
        k                                  = k + 1;
    }
    nlessons = nlessons + 1;
    if (nlessons < 24) { ret; }
    var mode: i32 = 1;
    if (s.g.deathmatch != 0) { mode = 2; }
    net.send_training(n, mode, s.g.gamemap, s.g.gameskill, ?lessons[0], nlessons);
    nlessons = 0;
}

# a hash as six hex digits, for people to compare by eye
fun build_code(h: u64, out: *u8) {
    val digits: str = "0123456789ABCDEF";
    var k: i32 = 0;
    for (k < 6) {
        out[k] = digits[((h >> (60 - k * 4)::u64) & 15)::i32];
        k      = k + 1;
    }
    out[6] = 0;
}

# copy a string into a buffer; ret where it ends
fun append(buf: *u8, at: i32, text: str) i32 {
    var k: i32 = 0;
    for (text[k] != 0 && at + k < 255) {
        buf[at + k] = text[k];
        k           = k + 1;
    }
    buf[at + k] = 0;
    ret at + k;
}

# the waiting screen's words for where a network game has got to
fun waiting_text(n: *net.Net, buf: *u8) {
    var at: i32 = 0;
    if (n.refused != 0) {
        at = append(buf, at, net.refusal(n));
        at = append(buf, at, "\n\n(esc)");
        ret;
    }
    if (n.relaymode && n.token != 0) {
        at = append(buf, at, "room code  ");
        at = append(buf, at, ?n.code[0]);
        at = append(buf, at, "\n\n");
        if (n.host) { at = append(buf, at, "give the others this code.\n\n"); }
        var count: [12]u8 = [12]u8{'p', 'l', 'a', 'y', 'e', 'r', 's', ' ', '0', '/', '0', 0};
        count[8]  = ('0' + n.joined)::u8;
        count[10] = ('0' + n.players)::u8;
        at = append(buf, at, ?count[0]);
        if (n.startseen) {
            at = append(buf, at, "\n\nthe bots are coming...");
            ret;
        }
        if (n.fillin != 255 && n.fillin != 0) {
            at = append(buf, at, "\n\nbots take the empty seats in ");
            at = append_number(buf, at, n.fillin::i64);
            at = append(buf, at, " s");
        }
        if (n.host) { at = append(buf, at, "\n\nenter: start now, with bots"); }
        at = append(buf, at, "\n\n(esc to give up)");
        ret;
    }
    if (n.relaymode) {
        at = append(buf, at, "reaching the relay...\n\n(esc to give up)");
        ret;
    }
    at = append(buf, at, "waiting for the other players...\n\n(esc to give up)");
}

# where the relay is: a --relay on the command line, or DOOM_RELAY in the
# environment; an address, or a host name with an optional :port
fun find_relay(argc: i64, argv: **u8, out: *net.Peer) i32 {
    var name: str = nil;
    var i:    i64 = 3;
    for (i + 1 < argc) {
        if (str_equals(argv[i], "--relay")) { name = argv[i + 1]; }
        i = i + 1;
    }
    var envbuf: [256]u8;
    if (name == nil) {
        val got: res[opt[usize], env.EnvError] = env.get("DOOM_RELAY", ?envbuf[0], 256);
        if (sel got.ok) {
            if (sel got.ok.some) { name = ?envbuf[0]; }
        }
    }
    if (name == nil) { ret 0; }
    if (net.parse_address(name, out)) { ret 1; }

    # a name: split off a port, then ask Windows
    var host: [256]u8;
    var port: i64 = net.PORT::i64;
    var k:    i32 = 0;
    for (name[k] != 0 && name[k] != ':' && k < 255) {
        host[k] = name[k];
        k       = k + 1;
    }
    host[k] = 0;
    if (name[k] == ':') { port = number(?name[k + 1], net.PORT::i64); }
    if (!win.resolve_ipv4(?host[0], ?out.octets[0])) { ret -1; }
    out.port  = port::u16;
    out.known = 1;
    ret 1;
}

# whether a word looks like a room code rather than an address
fun is_code(text: str) bool {
    var k: i32 = 0;
    for (k < 6) {
        if (text[k] == 0 || relayproto.code_char(text[k]) == 0) { ret 0; }
        k = k + 1;
    }
    ret text[6] == 0;
}

# a player who wanders: mostly forward, turning now and then, firing in bursts
# and pressing use, all from its own random sequence so that a run can be
# repeated exactly
rec Bot {
    seed: u32;
    turn: i32;
    left: i32;
}

fun bot_random(b: *Bot) i32 {
    b.seed = b.seed * 1103515245 + 12345;
    ret ((b.seed >> 16) & 0x7fff)::i32;
}

fun bot_ticcmd(b: *Bot, tic: i32, cmd: *defs.Ticcmd) {
    if (b.left <= 0) {
        # a new heading for the next second or so
        b.turn = bot_random(b) % 1601 - 800;
        b.left = 10 + bot_random(b) % 40;
    }
    b.left = b.left - 1;

    var blank: defs.Ticcmd;
    @cmd            = blank;
    cmd.forwardmove = 0x32;
    if (bot_random(b) % 8 == 0) { cmd.sidemove = (bot_random(b) % 61 - 30)::i8; }
    cmd.angleturn = b.turn::i16;

    var buttons: i32 = 0;
    if ((tic / 35) % 3 == 0) { buttons = buttons | defs.BT_ATTACK; }
    if (tic % 20 == 0)       { buttons = buttons | defs.BT_USE; }
    cmd.buttons = buttons::u8;
}

# a session for one machine of a co-op game, with its own memory
fun coop_session(a: *allocator.Allocator, w: *wad.Wad, d: *rdata.Data, players: i32, me: i32, map: i32) *game.Session {
    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](a, 1);
    if (sel got.err) { ret nil; }
    val s: *game.Session = got.ok;
    game.init(s, a, w, d);
    if (!game.coop_game(s, players, me, defs.SK_MEDIUM, map)) { ret nil; }
    ret s;
}

# one headless deathmatch for four bots; nil if the map does not load
fun bot_session(a: *allocator.Allocator, w: *wad.Wad, d: *rdata.Data, map: i32) *game.Session {
    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](a, 1);
    if (sel got.err) { ret nil; }
    val s: *game.Session = got.ok;
    game.init(s, a, w, d);
    if (!game.deathmatch_game(s, 4, 0, defs.SK_MEDIUM, map, 1, 1)) { ret nil; }
    ret s;
}

# the maps the bots can find each other on
val BOTMAPS: [7]i32 = [7]i32{1, 2, 3, 4, 7, 8, 9};

# write what the hand-written bot sensed and decided, for a net to learn
# from: matches of four of them across the maps, each decision as 38 bytes
# (32 senses, 6 decisions, each a signed byte)
#
#   doom botdata <file> <matches> <out.bin>
fun botdata(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    val matches: i32 = number(argv[3], 7)::i32;
    val tics:    i32 = 4200;
    # a decision every fourth tic from each of four bots
    val room: i32 = matches * tics * 38;
    val buffer: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, room::usize);
    if (sel buffer.err) { ret EXIT_WRITE; }
    val out: *u8 = buffer.ok;
    var at:  i32 = 0;

    val s: *game.Session = bot_session(?a, ?w, ?d, 1);
    if (s == nil) { ret EXIT_MAP; }
    var m: i32 = 0;
    for (m < matches) {
        if (!game.deathmatch_game(s, 4, 0, defs.SK_MEDIUM, BOTMAPS[m % 7], 1, 1)) { ret EXIT_MAP; }
        var i: i32 = 0;
        for (i < 4) {
            game.set_bot(s, i, bot.KIND_SCRIPT, nil, (m * 7919 + i * 104729 + 17)::u32);
            i = i + 1;
        }
        var cmds: [4]defs.Ticcmd;
        var tic:  i32 = 0;
        for (tic < tics && !s.completed) {
            val time: i32 = s.g.leveltime;
            game.ticker_cmds(s, ?cmds[0]);
            i = 0;
            for (i < 4) {
                # the bots that looked this tic, and were alive to
                if (((time + i) & 3) == 0 && s.g.players[i].playerstate == defs.PST_LIVE && s.g.players[i].mo != nil && at + 38 <= room) {
                    var k: i32 = 0;
                    for (k < 32) {
                        out[at + k] = s.bots[i].feat[k]:~u32::u8;
                        k           = k + 1;
                    }
                    k = 0;
                    for (k < 6) {
                        out[at + 32 + k] = s.bots[i].out[k]:~u32::u8;
                        k                = k + 1;
                    }
                    at = at + 38;
                }
                i = i + 1;
            }
            tic = tic + 1;
        }
        m = m + 1;
    }
    val wrote: err[fs.FsError] = fs.write_bytes(argv[4], out, at::usize, 0o644);
    if (sel wrote.err) { ret EXIT_WRITE; }
    print.printlnf("{} decisions from {} matches", at / 38, matches);
    ret EXIT_OK;
}

# a deathmatch with nets in it: players 1 and 2 play by the net in a file,
# 3 and 4 by the script. Prints each one's frags and deaths.
#
#   doom netmatch <file> <map 1-9> <tics> <net file>
fun netmatch(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    val weights: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, argv[5]);
    if (sel weights.err) {
        print.eprintln("doom: the net could not be read");
        ret EXIT_DATA;
    }
    if (weights.ok.len != bot.NETSIZE::usize) {
        print.eprintln("doom: that is not a net: it should be 942 bytes");
        ret EXIT_DATA;
    }

    val s: *game.Session = bot_session(?a, ?w, ?d, number(argv[3], 1)::i32);
    if (s == nil) { ret EXIT_MAP; }
    game.set_bot(s, 0, bot.KIND_NET, weights.ok.data:~*i8, 17);
    game.set_bot(s, 1, bot.KIND_NET, weights.ok.data:~*i8, 7936);
    game.set_bot(s, 2, bot.KIND_SCRIPT, nil, 15855);
    game.set_bot(s, 3, bot.KIND_SCRIPT, nil, 23774);

    val tics: i32 = number(argv[4], 2100)::i32;
    var cmds: [4]defs.Ticcmd;
    var tic:  i32 = 0;
    for (tic < tics && !s.completed) {
        game.ticker_cmds(s, ?cmds[0]);
        tic = tic + 1;
    }
    var i: i32 = 0;
    for (i < 4) {
        val p: *defs.Player = ?s.g.players[i];
        var frags:  i32 = 0;
        var deaths: i32 = p.frags[i];
        var k:      i32 = 0;
        for (k < 4) {
            if (k != i) {
                frags  = frags + p.frags[k];
                deaths = deaths + s.g.players[k].frags[i];
            }
            k = k + 1;
        }
        if (i < 2) {
            print.printlnf("net {} frags {} deaths {} shots {}", i + 1, frags, deaths, s.bots[i].shots);
        }
        or {
            print.printlnf("script {} frags {} deaths {} shots {}", i + 1, frags, deaths, s.bots[i].shots);
        }
        i = i + 1;
    }
    print.printlnf("end tic {} sum {} map E1M{}", tic, game.checksum(s), s.g.gamemap);
    ret EXIT_OK;
}

# what the bots' walk grid makes of a level played co-op: whether it finds a
# walk from the first player's start to the exit and to each secret, and for
# each secret the lines round it that do something, which is how it opens
#
#   doom navcheck <file> <map 1-9>
fun navcheck(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;
    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);
    if (!game.coop_game(s, 4, 0, defs.SK_NIGHTMARE, number(argv[3], 1)::i32)) { ret EXIT_MAP; }

    val g: *defs.Game = ?s.g;
    val marks: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, 65536);
    if (sel marks.err) { ret EXIT_DATA; }
    val mo: *defs.Mobj = g.players[0].mo;
    if (argc == 11) {
        # navcheck <wad> <map> <x1> <y1> <x2> <y2> <line> <line>: is there a walk, going round those lines
        val r: i32 = bot.reaches(g, number(argv[4], 0)::i32 << 16, number(argv[5], 0)::i32 << 16, number(argv[6], 0)::i32 << 16, number(argv[7], 0)::i32 << 16, number(argv[8], -1)::i32, number(argv[9], -1)::i32, marks.ok, number(argv[10], 15)::i32);
        print.printlnf("walk: {} (cells walked to; negative if the place was not among them)", r);
        ret EXIT_OK;
    }
    if (argc == 5 && str_equals(argv[4], "gap")) {
        ret navgap(g, mo, marks.ok, ?a);
    }
    if (argc == 9 && str_equals(argv[4], "walk")) {
        # navcheck <wad> <map> walk x1 y1 x2 y2: try the walk both ways
        val x1: i32 = number(argv[5], 0)::i32 << 16;
        val y1: i32 = number(argv[6], 0)::i32 << 16;
        val x2: i32 = number(argv[7], 0)::i32 << 16;
        val y2: i32 = number(argv[8], 0)::i32 << 16;
        bot.grid_flood(g, mo.x, mo.y, marks.ok, 0);
        var st:  bool = 0;
        var stl: i32  = -1;
        val e1:  i32  = bot.probe_walk(g, x1, y1, x2, y2, ?st, ?stl);
        print.printlnf("walk {},{} -> {},{}", x1 >> 16, y1 >> 16, x2 >> 16, y2 >> 16);
        gap_why(g, e1, e1 < 0);
        gap_why(g, stl, st);
        val e2:  i32  = bot.probe_walk(g, x2, y2, x1, y1, ?st, ?stl);
        print.printlnf("walk {},{} -> {},{}", x2 >> 16, y2 >> 16, x1 >> 16, y1 >> 16);
        gap_why(g, e2, e2 < 0);
        gap_why(g, stl, st);
        ret EXIT_OK;
    }
    val reached: i32 = bot.grid_flood(g, mo.x, mo.y, marks.ok, 0);
    print.printlnf("grid {} by {}, {} cells walked to from the start, locks {}", g.navw, g.navh, reached, g.navlocks);
    if (g.navexitline < 0) {
        print.println("exit: none");
    }
    or {
        val c: i32 = bot.cell_at(g, g.navax, g.navay);
        var ok: i32 = 0;
        if (c >= 0 && marks.ok[c] != 0) { ok = 1; }
        print.printlnf("exit: line {} special {} at {},{} reached {}", g.navexitline, g.lv.lines[g.navexitline].special, g.navax >> 16, g.navay >> 16, ok);
    }
    var i:     i32 = 0;
    var found: i32 = 0;
    for (i < g.navsecrets) {
        val sc: i32 = g.navsecret[i];
        val c:  i32 = bot.cell_at(g, g.navsecretx[i], g.navsecrety[i]);
        var ok: i32 = 0;
        if (c >= 0 && marks.ok[c] != 0) { ok = 1; }
        found = found + ok;
        print.printlnf("secret {}: sector {} tag {} floor {} ceiling {} at {},{} reached {}", i, sc, g.lv.sectors[sc].tagnum, g.lv.sectors[sc].floorheight >> 16, g.lv.sectors[sc].ceilingheight >> 16, g.navsecretx[i] >> 16, g.navsecrety[i] >> 16, ok);
        var l: i32 = 0;
        for (l < g.lv.numlines) {
            val line: *level.Line = ?g.lv.lines[l];
            if (line.frontsector == sc || line.backsector == sc) {
                var other: i32 = line.frontsector;
                if (other == sc) { other = line.backsector; }
                if (line.sidenum[1] != level.NONE) {
                    print.printlnf("    line {} special {} tag {} flags {} to sector {} floor {} ceiling {} tag {}", l, line.special, line.tagnum, line.flags, other, g.lv.sectors[other].floorheight >> 16, g.lv.sectors[other].ceilingheight >> 16, g.lv.sectors[other].tagnum);
                }
            }
            l = l + 1;
        }
        i = i + 1;
    }
    print.printlnf("{} of {} secrets reached (the map has {})", found, g.navsecrets, g.totalsecret);
    ret EXIT_OK;
}

# one line of the gap report: the line that stops a walk, with its flags and
# the floors and ceilings either side, or "goes" when nothing stops it
fun gap_why(g: *defs.Game, line: i32, goes: bool) {
    if (goes) { print.println("      goes"); ret; }
    if (line < 0) { print.println("      stops, no line recorded"); ret; }
    val ln: *level.Line = ?g.lv.lines[line];
    val f:  i32 = ln.frontsector;
    val b:  i32 = ln.backsector;
    if (b < 0) {
        print.printlnf("      line {} flags {} special {} tag {} one-sided to sector {} floor {} ceiling {}", line, ln.flags, ln.special, ln.tagnum, f, g.lv.sectors[f].floorheight >> 16, g.lv.sectors[f].ceilingheight >> 16);
        ret;
    }
    print.printlnf("      line {} flags {} special {} tag {} sectors {} {} floors {} {} ceilings {} {}", line, ln.flags, ln.special, ln.tagnum, f, b, g.lv.sectors[f].floorheight >> 16, g.lv.sectors[b].floorheight >> 16, g.lv.sectors[f].ceilingheight >> 16, g.lv.sectors[b].ceilingheight >> 16);
}

#   doom navcheck <wad> <map> gap: where the flood from the start and the
#   flood that can reach the exit come a cell apart without a walk between
fun navgap(g: *defs.Game, mo: *defs.Mobj, marks: *u8, a: *allocator.Allocator) i64 {
    if (g.navexitline < 0) { print.println("exit: none"); ret EXIT_OK; }
    val backs: res[*u8, allocator.Error] = allocator.zallocate[u8](a, 65536);
    if (sel backs.err) { ret EXIT_DATA; }
    val reached:  i32 = bot.grid_flood(g, mo.x, mo.y, marks, 0);
    val returned: i32 = bot.grid_flood(g, g.navax, g.navay, backs.ok, 1);
    print.printlnf("grid {} by {}, {} cells walked to from the start, {} can walk to the exit", g.navw, g.navh, reached, returned);
    val cells: i32 = g.navw * g.navh;
    var gaps:  i32 = 0;
    var c:     i32 = 0;
    for (c < cells) {
        if (marks[c] == 0) { c = c + 1; cnt; }
        val cx: i32 = c % g.navw;
        var k:  i32 = 0;
        for (k < 4) {
            var n: i32 = -1;
            if (k == 0 && cx + 1 < g.navw)    { n = c + 1; }
            if (k == 1 && cx > 0)              { n = c - 1; }
            if (k == 2 && c + g.navw < cells) { n = c + g.navw; }
            if (k == 3 && c >= g.navw)        { n = c - g.navw; }
            k = k + 1;
            if (n < 0 || backs.ok[n] == 0 || marks[n] != 0) { cnt; }
            # c is reached from the start, n reaches the exit, and neither can
            # be walked to from the other: both ways tried, both reported
            gaps = gaps + 1;
            val x1: i32 = bot.cell_x(g, c % g.navw);
            val y1: i32 = bot.cell_y(g, c / g.navw);
            val x2: i32 = bot.cell_x(g, n % g.navw);
            val y2: i32 = bot.cell_y(g, n / g.navw);
            print.printlnf("  cells {} -> {} at {},{} to {},{}", c, n, x1 >> 16, y1 >> 16, x2 >> 16, y2 >> 16);
            var st:  bool = 0;
            var stl: i32  = -1;
            val e1:  i32  = bot.probe_walk(g, x1, y1, x2, y2, ?st, ?stl);
            gap_why(g, e1, e1 < 0);
            gap_why(g, stl, st);
            val e2:  i32  = bot.probe_walk(g, x2, y2, x1, y1, ?st, ?stl);
            gap_why(g, e2, e2 < 0);
            gap_why(g, stl, st);
        }
        c = c + 1;
    }
    # every sealed edge of the exit flood: a cell in it whose walk out was
    # never built, with the line that stops it — once per line
    var cell:   i32 = 0;
    var nlines: i32 = 0;
    var listed: [64]i32;
    for (cell < cells) {
        if (backs.ok[cell] == 0) { cell = cell + 1; cnt; }
        val bx: i32 = cell % g.navw;
        var k:   i32 = 0;
        for (k < 4) {
            var n:    i32 = -1;
            var way:  i32 = 0;
            if (k == 0) { n = cell + 1;      way = 1; }
            if (k == 1) { n = cell - 1;      way = 4; }
            if (k == 2) { n = cell + g.navw; way = 2; }
            if (k == 3) { n = cell - g.navw; way = 8; }
            k = k + 1;
            if (n < 0 || n >= cells || (g.navgrid[cell]::i32 & way) != 0 || backs.ok[n] != 0) { cnt; }
            val x1: i32 = bot.cell_x(g, cell % g.navw);
            val y1: i32 = bot.cell_y(g, cell / g.navw);
            val x2: i32 = bot.cell_x(g, n % g.navw);
            val y2: i32 = bot.cell_y(g, n / g.navw);
            var st:  bool = 0;
            var stl: i32  = -1;
            val e:   i32  = bot.probe_walk(g, x1, y1, x2, y2, ?st, ?stl);
            if (e < 0) { cnt; }
            var dup: i32 = 0;
            var j:   i32 = 0;
            for (j < nlines) {
                if (listed[j] == e) { dup = 1; }
                j = j + 1;
            }
            if (dup == 0 && nlines < 64) {
                listed[nlines] = e;
                nlines         = nlines + 1;
                print.printlnf("  sealed edge out of cell {} at {},{} stopped by", cell, x1 >> 16, y1 >> 16);
                gap_why(g, e, 0);
                if (st) { print.println("      strict goes"); }
                or { gap_why(g, stl, 0); }
            }
        }
        cell = cell + 1;
    }
    print.printlnf("{} sealed edge kinds", nlines);
    var x0: i32 = 0x7fffffff;
    var y0: i32 = 0x7fffffff;
    var x1: i32 = 0 - 0x7fffffff;
    var y1: i32 = 0 - 0x7fffffff;
    c = 0;
    for (c < cells) {
        if (backs.ok[c] == 0) { c = c + 1; cnt; }
        val wx: i32 = bot.cell_x(g, c % g.navw) >> 16;
        val wy: i32 = bot.cell_y(g, c / g.navw) >> 16;
        if (wx < x0) { x0 = wx; }
        if (wx > x1) { x1 = wx; }
        if (wy < y0) { y0 = wy; }
        if (wy > y1) { y1 = wy; }
        c = c + 1;
    }
    print.printlnf("exit flood bounds x {}..{} y {}..{}", x0, x1, y0, y1);
    ret EXIT_OK;
}

# draw a map's walk grid as the bots have it, as a PPM: grey where a player
# can walk somewhere, green where it can walk to from the first deathmatch
# start, red at each deathmatch start, black elsewhere
#
#   doom navdump <file> <map 1-9> <out.ppm>
fun navdump(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;
    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);
    if (!game.deathmatch_game(s, 4, 0, defs.SK_MEDIUM, number(argv[3], 1)::i32, 1, 1)) { ret EXIT_MAP; }

    val g: *defs.Game = ?s.g;
    val marks: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, 65536);
    if (sel marks.err) { ret EXIT_DATA; }
    val reached: i32 = bot.grid_flood(g, g.deathmatchstarts[0].x::i32 << 16, g.deathmatchstarts[0].y::i32 << 16, marks.ok, 0);
    val backs: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, 65536);
    if (sel backs.err) { ret EXIT_DATA; }
    val returned: i32 = bot.grid_flood(g, g.deathmatchstarts[0].x::i32 << 16, g.deathmatchstarts[0].y::i32 << 16, backs.ok, 1);
    print.printlnf("{} cells can walk back to it", returned);
    val gw: i32 = g.navw;
    val gh: i32 = g.navh;
    print.printlnf("grid {} by {}, {} cells walked to from the first start, {} deathmatch starts", gw, gh, reached, g.numdmstarts);

    val bytes: i32 = 32 + gw * gh * 3;
    val image: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, bytes::usize);
    if (sel image.err) { ret EXIT_WRITE; }
    val out: *u8 = image.ok;
    var at:  i32 = append(out, 0, "P6\n");
    at = append_number(out, at, gw::i64);
    at = append(out, at, " ");
    at = append_number(out, at, gh::i64);
    at = append(out, at, "\n255\n");
    var y: i32 = gh - 1;
    for (y >= 0) {
        var x: i32 = 0;
        for (x < gw) {
            val c: i32 = y * gw + x;
            var r: u8  = 0;
            var gr: u8 = 0;
            var bl: u8 = 0;
            if (g.navgrid[c] != 0) {
                r  = 90;
                gr = 90;
                bl = 90;
            }
            if (marks.ok[c] != 0) {
                r  = 40;
                gr = 200;
                bl = 60;
                # walked into, but with no way back: yellow
                if (backs.ok[c] == 0) {
                    r  = 240;
                    gr = 220;
                    bl = 40;
                }
            }
            var k: i32 = 0;
            for (k < g.numdmstarts) {
                val sx: i32 = ((g.deathmatchstarts[k].x::i32 << 16) - g.lv.bmaporgx) >> 21;
                val sy: i32 = ((g.deathmatchstarts[k].y::i32 << 16) - g.lv.bmaporgy) >> 21;
                if (x >= sx - 1 && x <= sx + 1 && y >= sy - 1 && y <= sy + 1) {
                    r  = 255;
                    gr = 30;
                    bl = 30;
                }
                k = k + 1;
            }
            out[at]     = r;
            out[at + 1] = gr;
            out[at + 2] = bl;
            at          = at + 3;
            x           = x + 1;
        }
        y = y - 1;
    }
    val wrote: err[fs.FsError] = fs.write_bytes(argv[4], out, at::usize, 0o644);
    if (sel wrote.err) { ret EXIT_WRITE; }
    ret EXIT_OK;
}

# how well the shy bot hides: a co-op game of a wanderer, standing in for a
# person, and the shy bot, with no window. After three seconds to find its
# place, each tic is counted: whether the wanderer could see the bot (within
# the 45 degrees to either side that a view shows, and nothing between),
# and whether the bot was near.
#
#   doom shy <file> <map 1-9> <tics>
fun shy(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    val s: *game.Session = coop_session(?a, ?w, ?d, 2, 0, number(argv[3], 1)::i32);
    if (s == nil) { ret EXIT_MAP; }
    game.set_bot(s, 1, bot.KIND_SCRIPT | bot.TRAIT_SHY, nil, 99);
    # the wanderer must not be shot at while it is being hidden from
    s.g.players[0].cheats = defs.CF_GODMODE;

    var walker: Bot;
    walker.seed = 17;
    val tics:   i32 = number(argv[4], 2100)::i32;
    var counted: i32 = 0;
    var seen:    i32 = 0;
    var near:    i32 = 0;
    var tic:     i32 = 0;
    for (tic < tics && !s.completed) {
        var cmds: [4]defs.Ticcmd;
        bot_ticcmd(?walker, tic, ?cmds[0]);
        # the wanderer does not shoot, and leaves the level's exit alone
        cmds[0].buttons = 0;
        game.ticker_cmds(s, ?cmds[0]);
        val person: *defs.Mobj = s.g.players[0].mo;
        val hider:  *defs.Mobj = s.g.players[1].mo;
        if (tic >= 105 && person != nil && hider != nil) {
            counted = counted + 1;
            val rel:  u32 = world.point_to_angle2(person.x, person.y, hider.x, hider.y) - person.angle;
            val turn: i32 = (((rel >> 24)::i32) ^ 0x80) - 0x80;
            if (turn > -32 && turn < 32 && maputl.check_sight(?s.g, person, hider)) { seen = seen + 1; }
            if (maputl.aprox_distance(hider.x - person.x, hider.y - person.y) >> 16 < 200) { near = near + 1; }
        }
        tic = tic + 1;
    }
    print.printlnf("shy bot: seen on {} of {} tics, within 200 units on {}", seen, counted, near);
    ret EXIT_OK;
}

# a deathmatch between four bots with no window: two machines' worth of
# game in one process, compared every tic, since a bot is part of the
# simulation and must decide the same on every machine. Prints each bot's
# frags and deaths.
#
#   doom botmatch <file> <map 1-9> <tics> [<out.ppm> [trace]]
#   doom botmatch <file> <map 1-9> <tics> [<net file>] fists
#
# With a last word, each bot's place and what it senses and decides is
# printed every ten seconds, for finding out why bots do what they do.
fun botmatch(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    var b:     allocator.Allocator;
    val made2: err[allocator.Error] = page.make(?b);
    if (sel made2.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    val map:  i32 = number(argv[3], 1)::i32;
    val tics: i32 = number(argv[4], 2100)::i32;

    val got1: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    val got2: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?b, 1);
    if (sel got1.err) { ret EXIT_DATA; }
    if (sel got2.err) { ret EXIT_DATA; }
    val one: *game.Session = got1.ok;
    val two: *game.Session = got2.ok;
    game.init(one, ?a, ?w, ?d);
    game.init(two, ?b, ?w, ?d);
    if (!game.deathmatch_game(one, 4, 0, defs.SK_MEDIUM, map, 1, 1) || !game.deathmatch_game(two, 4, 1, defs.SK_MEDIUM, map, 1, 1)) {
        print.eprintln("doom: the map could not be loaded");
        ret EXIT_MAP;
    }
    # the hand-written bot, or, with a net's file before "fists", that net
    var kind:    i32 = bot.KIND_SCRIPT;
    var weights: *i8 = nil;
    if (argc == 7 && str_equals(argv[6], "fists")) {
        val file: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, argv[5]);
        if (sel file.err) {
            print.eprintln("doom: the net could not be read");
            ret EXIT_DATA;
        }
        if (file.ok.len != bot.NETSIZE::usize) {
            print.eprintln("doom: that is not a net: it should be 942 bytes");
            ret EXIT_DATA;
        }
        kind    = bot.KIND_NET;
        weights = file.ok.data:~*i8;
    }
    var i: i32 = 0;
    for (i < 4) {
        # "hunt": the first bot hates the last, and nobody else feels anything
        var as: i32 = kind;
        if (i == 0 && str_equals(argv[argc - 1], "hunt")) { as = kind | bot.feel_bits(2, 0); }
        game.set_bot(one, i, as, weights, (i * 7919 + 17)::u32);
        game.set_bot(two, i, as, weights, (i * 7919 + 17)::u32);
        i = i + 1;
    }

    val fists: bool = str_equals(argv[argc - 1], "fists");
    var ann:    announce.Announcer;
    announce.reset(?ann);
    var blood:  i32 = 0;
    var quick:  i32 = 0;
    var sprees: i32 = 0;
    val began: i64 = win.micros_now();
    var cmds:  [4]defs.Ticcmd;
    var tic:   i32 = 0;
    for (tic < tics && !one.completed) {
        # with "fists" as the last word, nobody has anything but their
        # fists, in both games alike: for seeing how bots fight hand to hand
        if (fists) {
            var q: i32 = 0;
            for (q < 4) {
                var k: i32 = 0;
                for (k < defs.NUMAMMO) {
                    one.g.players[q].ammo[k] = 0;
                    two.g.players[q].ammo[k] = 0;
                    k                        = k + 1;
                }
                k = 1;
                for (k < 9) {
                    one.g.players[q].weaponowned[k] = 0;
                    two.g.players[q].weaponowned[k] = 0;
                    k                               = k + 1;
                }
                q = q + 1;
            }
        }
        game.ticker_cmds(one, ?cmds[0]);
        game.ticker_cmds(two, ?cmds[0]);
        if (game.checksum(one) != game.checksum(two)) {
            print.printlnf("diverged at tic {}", tic);
            ret EXIT_MAP;
        }
        # the announcer listens to the first game, and changes nothing in it
        val line: i32 = announce.tick(?ann, ?one.g);
        if (line == announce.FIRST_BLOOD) {
            blood = blood + 1;
        }
        or (line >= announce.KILLING_SPREE) {
            sprees = sprees + 1;
        }
        or (line >= 0) {
            quick = quick + 1;
        }
        if (argc == 7 && !fists && tic % 350 == 0) {
            var q: i32 = 0;
            for (q < 4) {
                val mo: *defs.Mobj = one.g.players[q].mo;
                val bb: *bot.Bot   = ?one.bots[q];
                print.eprintlnf("t{} b{} at {},{} way {} path {} stuck {} ahead {} seen {} fwd {} turn {} use {} hp {}", tic, q + 1, mo.x >> 16, mo.y >> 16, bb.haveway, bb.feat[bot.F_PATH], bb.feat[bot.F_STUCK], bb.feat[0], bb.feat[bot.F_SEEN], bb.out[0], bb.out[2], bb.out[4], one.g.players[q].health);
                q = q + 1;
            }
        }
        tic = tic + 1;
    }
    val took: i64 = win.micros_now() - began;

    # a picture of the end, if a file was named for one and not a word
    val word: bool = fists || str_equals(argv[argc - 1], "hunt") || str_equals(argv[argc - 1], "even");
    if (argc >= 6 && !word) {
        val ready: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, one.g.lv);
        if (sel ready.ok) {
            val r: *render.Renderer = ready.ok;
            render.render_player_view(r, ?one.g, ?one.g.players[0]);
            write_ppm(?a, ?d, r, argv[5]);
        }
    }

    i = 0;
    for (i < 4) {
        val p: *defs.Player = ?one.g.players[i];
        var frags:  i32 = 0;
        var deaths: i32 = p.frags[i];
        var k:      i32 = 0;
        for (k < 4) {
            if (k != i) {
                frags  = frags + p.frags[k];
                deaths = deaths + one.g.players[k].frags[i];
            }
            k = k + 1;
        }
        print.printlnf("bot {} frags {} deaths {} suicides {} shots {} uses {} health {}", i + 1, frags, deaths, p.frags[i], one.bots[i].shots, one.bots[i].uses, p.health);
        i = i + 1;
    }
    print.eprintlnf("{} tics of two games in {} ms", tic, took / 1000);
    # ("even" says the same of a match in which nobody hates anybody)
    if (str_equals(argv[argc - 1], "hunt") || str_equals(argv[argc - 1], "even")) {
        print.printlnf("bot 1 killed bot 2 {} times, bot 3 {}, bot 4 {}", one.g.players[0].frags[1], one.g.players[0].frags[2], one.g.players[0].frags[3]);
        print.printlnf("bots 2 and 3 killed bot 4 {} times", one.g.players[1].frags[3] + one.g.players[2].frags[3]);
    }
    print.printlnf("announcer: first blood {} quick kills {} sprees {}", blood, quick, sprees);
    print.printlnf("end tic {} sum {} map E1M{}", tic, game.checksum(one), one.g.gamemap);
    ret EXIT_OK;
}

# a co-op game of four bots on Nightmare, as the co-op league plays it: how
# far each got toward the exit, what it killed and how often it died
#
#   doom coopmatch <wad> <map> <tics> [<net file> | script | trace | calm | calmtrace | lead | calmlead | idle] [seed] [trace | league | leaguetrace]
#
# "calm" is the level with no monsters in it, which shows what the bots can
# find their way to when nothing is killing them; "trace" says every five
# seconds where each bot is and what it is after.
fun coopmatch(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;
    val map:  i32 = number(argv[3], 1)::i32;
    val tics: i32 = number(argv[4], 2100)::i32;

    var net:  *i8  = nil;
    var kind: i32  = bot.KIND_SCRIPT;
    var runseed: u32 = 0;
    if (argc >= 7) { runseed = number(argv[6], 0)::u32; }
    val calm:     bool = argc >= 6 && (argv[5][0] == 'c' && argv[5][1] == 'a' || str_equals(argv[5], "lead") || str_equals(argv[5], "idle"));
    val traced_mode: bool = argc >= 6 && (str_equals(argv[5], "trace") || str_equals(argv[5], "calmtrace") || str_equals(argv[5], "calmleadtrace"));
    val league: bool = argc == 8 && (str_equals(argv[7], "league") || str_equals(argv[7], "leaguetrace"));
    val trace: bool = traced_mode || (argc == 8 && (str_equals(argv[7], "trace") || str_equals(argv[7], "leaguetrace")));
    if (argc >= 6 && !traced_mode && !calm && !str_equals(argv[5], "script")) {
        val file: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, argv[5]);
        if (sel file.err) { ret EXIT_WAD; }
        if (file.ok.len != bot.NETSIZE::usize) { ret EXIT_DATA; }
        net  = file.ok.data:~*i8;
        kind = bot.KIND_NET;
    }

    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);
    if (!game.coop_game(s, 4, 0, defs.SK_NIGHTMARE, map)) { ret EXIT_MAP; }
    # "calm" and "calmtrace": the level with nothing in it, to see what the
    # bots can find their way to when nothing is killing them
    if (argc >= 6 && argv[5][0] == 'c' && argv[5][1] == 'a') {
        s.g.nomonsters = 1;
        if (!game.init_new(s, defs.SK_NIGHTMARE, 1, map)) { ret EXIT_MAP; }
    }
    if (league) { s.campaign = 1; s.levelcap = tics; s.capped = 0; }
    var skip: u32 = runseed & 255;
    for (skip > 0) { defs.p_random(?s.g); skip = skip - 1; }
    var i: i32 = 0;
    for (i < 4) {
        game.set_bot(s, i, kind, net, ((0x9e3779b9 * (i + 1):~u32) ^ (runseed * 0x85ebca6b)) | 1);
        i = i + 1;
    }

    # "lead" and "calmlead": the first bot stands in for a person. It plays
    # the level as a bot alone does; the other three take it for a person
    # and follow. How much of the time each is with it says whether bots
    # keep up with someone who opens the level ahead of them.
    val lead: bool = argc >= 6 && (str_equals(argv[5], "lead") || str_equals(argv[5], "calmlead") || str_equals(argv[5], "calmleadtrace"));
    if (lead) { s.g.isbot[0] = 0; }
    # "idle": the first player is a person who never touches the keys. The
    # bots must stay with them, and must not end the level over their head.
    if (argc >= 6 && str_equals(argv[5], "idle")) {
        s.g.isbot[0]     = 0;
        s.bots[0].active = 0;
    }
    var with:   [4]i32;
    var both:   [4]i32;
    var cmds:   [4]defs.Ticcmd;
    var deaths: [4]i32;
    var dead:   [4]bool;
    var found:  i32 = 0;
    var hurt:     [4]i32;
    var friendly: i32 = 0;
    var wasx: [4]i32;
    var wasy: [4]i32;
    var still: [4]i32;
    var stucktics: i32 = 0;
    var wedges: i32 = 0;
    var acidtics: i32 = 0;
    var floordeaths: i32 = 0;
    val began:  i64 = win.micros_now();
    var tic:    i32 = 0;
    for (tic < tics && !s.completed && !s.broken) {
        game.ticker_cmds(s, ?cmds[0]);
        i = 0;
        for (i < 4) {
            val now: bool = s.g.players[i].playerstate == defs.PST_DEAD;
            if (trace && tic % 175 == 0) {
                val tb: *bot.Bot = ?s.bots[i];
                print.eprintlnf("t{} b{} at {},{} after {} want {} at {},{} works {} way {} stuck {} gaveup {} hp {}", tic / 35, i + 1, s.g.players[i].mo.x >> 16, s.g.players[i].mo.y >> 16, tb.after, tb.want, tb.afterx >> 16, tb.aftery >> 16, tb.works, tb.haveway, tb.feat[bot.F_STUCK], tb.gaveup, s.g.players[i].health);
                val tp: *defs.Player = ?s.g.players[i];
                if (tp.mo != nil) {
                    val ts: i32 = s.g.lv.subsectors[tp.mo.subsector].sector;
                    var kind: i32 = -1;
                    if (s.g.lv.sectors[ts].specialdata != nil) { kind = (s.g.lv.sectors[ts].specialdata:~*defs.Thinker).kind::i32; }
                    print.eprintlnf("    b{} sector {} floor {} z {} mover {} next {},{} slide {} pressed {}", i + 1, ts, s.g.lv.sectors[ts].floorheight >> 16, tp.mo.z >> 16, kind, tb.wayx >> 16, tb.wayy >> 16, tb.slide, tb.pressed);
                }
                if (tb.nbans > 0) { print.eprintlnf("    b{} went round {} lines: {} {} {} {} {} {}", i + 1, tb.nbans, tb.bans[0], tb.bans[1], tb.bans[2], tb.bans[3], tb.bans[4], tb.bans[5]); }
            }
            val pm: *defs.Mobj = s.g.players[i].mo;
            var onhurt: bool = 0;
            if (pm != nil && s.g.players[i].powers[defs.PW_IRONFEET] == 0 && pm.z <= pm.floorz) {
                val special: i32 = s.g.lv.sectors[s.g.lv.subsectors[pm.subsector].sector].special::i32;
                onhurt = special == 4 || special == 5 || special == 7 || special == 16;
            }
            if (!now && pm != nil) {
                if (onhurt) {
                    acidtics = acidtics + 1;
                    if (trace && acidtics % 35 == 0) {
                        val ab: *bot.Bot = ?s.bots[i];
                        print.eprintlnf("acid t{} b{} at {},{} sector {} after {} goal {},{} way {} wades {} next {},{} seen {} stuck {} hp {}", tic / 35, i + 1, pm.x >> 16, pm.y >> 16, s.g.lv.subsectors[pm.subsector].sector, ab.after, ab.afterx >> 16, ab.aftery >> 16, ab.haveway, ab.wades, ab.wayx >> 16, ab.wayy >> 16, ab.feat[bot.F_SEEN], ab.feat[bot.F_STUCK], s.g.players[i].health);
                    }
                }
                var mx: i32 = (pm.x >> 16) - wasx[i];
                var my: i32 = (pm.y >> 16) - wasy[i];
                if (mx < 0) { mx = -mx; }
                if (my < 0) { my = -my; }
                val pushing: bool = s.g.players[i].cmd.forwardmove != 0 || s.g.players[i].cmd.sidemove != 0;
                if (pushing && mx + my < 1) {
                    stucktics = stucktics + 1;
                    still[i] = still[i] + 1;
                    if (still[i] == 35) {
                        wedges = wedges + 1;
                        if (trace) {
                            val wb: *bot.Bot = ?s.bots[i];
                            print.eprintlnf("wedge t{} b{} at {},{} after {} goal {},{} way {} next {},{} seen {} cmd {},{} turn {}", tic / 35, i + 1, pm.x >> 16, pm.y >> 16, wb.after, wb.afterx >> 16, wb.aftery >> 16, wb.haveway, wb.wayx >> 16, wb.wayy >> 16, wb.feat[bot.F_SEEN], s.g.players[i].cmd.forwardmove::i32, s.g.players[i].cmd.sidemove::i32, s.g.players[i].cmd.angleturn::i32);
                        }
                    }
                }
                or { still[i] = 0; }
                wasx[i] = pm.x >> 16;
                wasy[i] = pm.y >> 16;
            }
            if (now && !dead[i]) {
                if (onhurt && s.g.players[i].attacker == nil) { floordeaths = floordeaths + 1; }
                deaths[i] = deaths[i] + 1;
                if (trace) {
                    var who: i32 = -1;
                    if (s.g.players[i].attacker != nil) { who = s.g.players[i].attacker.kind; }
                    print.eprintlnf("death t{} b{} at {},{} attacker {}", tic / 35, i + 1, s.g.players[i].mo.x >> 16, s.g.players[i].mo.y >> 16, who);
                }
            }
            dead[i] = now;
            # hurt by a friend: a tic on which its hurt rose and whoever did
            # it is another player
            val pl: *defs.Player = ?s.g.players[i];
            if (pl.damagecount > hurt[i] && pl.attacker != nil && pl.attacker != pl.mo && pl.attacker.player != nil) { friendly = friendly + 1; }
            hurt[i] = pl.damagecount;
            # with the leader: both alive, and within 384 units
            if (lead && i > 0 && !now && s.g.players[0].playerstate != defs.PST_DEAD && s.g.players[0].mo != nil && s.g.players[i].mo != nil) {
                both[i] = both[i] + 1;
                var dx: i32 = (s.g.players[i].mo.x - s.g.players[0].mo.x) >> 16;
                var dy: i32 = (s.g.players[i].mo.y - s.g.players[0].mo.y) >> 16;
                if (dx < 0) { dx = -dx; }
                if (dy < 0) { dy = -dy; }
                if (dx + dy < 384) { with[i] = with[i] + 1; }
            }
            i = i + 1;
        }
        tic = tic + 1;
    }
    val took: i64 = win.micros_now() - began;
    if (lead) {
        var all:  i32 = both[1] + both[2] + both[3];
        if (all < 1) { all = 1; }
        print.printlnf("followers with the leader {}% of the time: {}% {}% {}%", (with[1] + with[2] + with[3]) * 100 / all, with[1] * 100 / (both[1] + 1), with[2] * 100 / (both[2] + 1), with[3] * 100 / (both[3] + 1));
    }
    i = 0;
    for (i < 4) {
        val p: *defs.Player = ?s.g.players[i];
        val b: *bot.Bot     = ?s.bots[i];
        var keys: i32 = 0;
        var k:    i32 = 0;
        for (k < 6) {
            if (p.cards[k]) { keys = keys + 1; }
            k = k + 1;
        }
        print.printlnf("bot {} kills {} deaths {} keys {} from {} nearest {} shots {} uses {} health {} secrets {} bullets {} shells {} swings {}", i + 1, p.killcount, deaths[i], keys, b.goalstart, b.goalbest, b.shots, b.uses, p.health, p.secretcount, p.ammo[defs.AM_CLIP], p.ammo[defs.AM_SHELL], b.swings);
        found = found + p.secretcount;
        i = i + 1;
    }
    print.eprintlnf("{} tics in {} ms", tic, took / 1000);
    var done: i32 = 0;
    if (s.completed && !s.capped) { done = 1; }
    if (league) { print.printlnf("league cutoff {}", s.capped); }
    print.printlnf("hit by friends {} times", friendly);
    print.printlnf("pathing stuck {} wedges {} acid {} floordeaths {}", stucktics, wedges, acidtics, floordeaths);
    print.printlnf("end tic {} finished {} secrets {} of {} sum {} map E1M{}", tic, done, found, s.g.totalsecret, game.checksum(s), map);
    ret EXIT_OK;
}

# co-op without a network: two machines' worth of game in one process, each
# fed every player's commands from the same bots, compared every tic. if a
# co-op game cannot stay in sync here, no network will keep it in sync.
#
#   doom coop <file> <players 2-4> <map 1-9> <tics> [<every> [<tic> <out.ppm> [<player>]]]
fun coop(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    var players: i32 = number(argv[3], 2)::i32;
    if (players < 2) { players = 2; }
    if (players > 4) { players = 4; }
    val map:   i32 = number(argv[4], 1)::i32;
    val tics:  i32 = number(argv[5], 350)::i32;
    var every: i32 = 0;
    if (argc >= 7) { every = number(argv[6], 0)::i32; }
    var shot: i32 = -1;
    if (argc >= 9) { shot = number(argv[7], -1)::i32; }

    # each machine has its own memory, as two computers would
    var b:     allocator.Allocator;
    val made2: err[allocator.Error] = page.make(?b);
    if (sel made2.err) { ret EXIT_WAD; }

    val one: *game.Session = coop_session(?a, ?w, ?d, players, 0, map);
    val two: *game.Session = coop_session(?b, ?w, ?d, players, 1, map);
    if (one == nil || two == nil) {
        print.eprintln("doom: the co-op map could not be loaded");
        ret EXIT_MAP;
    }

    var bots: [4]Bot;
    var i:    i32 = 0;
    for (i < 4) {
        bots[i].seed = (i * 7919 + 17)::u32;
        i            = i + 1;
    }

    var tic: i32 = 0;
    for (tic < tics) {
        var cmds: [4]defs.Ticcmd;
        i = 0;
        for (i < players) {
            bot_ticcmd(?bots[i], tic, ?cmds[i]);
            i = i + 1;
        }
        # at tic 100 the second player is killed outright on both machines,
        # so that a co-op respawn is part of every run
        if (tic == 100) {
            world.damage_mobj(?one.g, one.g.players[1].mo, nil, nil, 10000);
            world.damage_mobj(?two.g, two.g.players[1].mo, nil, nil, 10000);
        }
        game.ticker_cmds(one, ?cmds[0]);
        game.ticker_cmds(two, ?cmds[0]);

        val sum1: u32 = game.checksum(one);
        val sum2: u32 = game.checksum(two);
        if (sum1 != sum2) {
            print.printlnf("diverged at tic {}: {} against {}", tic, sum1, sum2);
            ret EXIT_MAP;
        }
        if (every > 0 && (tic % every) == 0) {
            print.printf("{} {}", tic, sum1);
            i = 0;
            for (i < players) {
                print.printf(" p{} {} {}", i + 1, one.g.players[i].health, one.g.players[i].killcount);
                i = i + 1;
            }
            print.println("");
        }
        if (tic == shot) {
            val ready: res[*render.Renderer, render.RenderError] = render.make(?a, ?d, ?one.lvl);
            if (sel ready.ok) {
                # the view of the player named after the file, or the first
                var who: i32 = 0;
                if (argc >= 10)                { who = number(argv[9], 1)::i32 - 1; }
                if (who < 0 || who >= players) { who = 0; }
                render.render_player_view(ready.ok, ?one.g, ?one.g.players[who]);
                write_ppm(?a, ?d, ready.ok, argv[8]);
            }
        }
        tic = tic + 1;
    }

    print.printf("end tic {} sum {} map E1M{}", tic, game.checksum(one), one.g.gamemap);
    i = 0;
    for (i < players) {
        print.printf(" p{} health {} kills {}", i + 1, one.g.players[i].health, one.g.players[i].killcount);
        i = i + 1;
    }
    print.println("");
    ret EXIT_OK;
}

# co-op over the network with no window: this machine's player is a bot,
# every tic is played in lockstep with the other machines, and the run ends
# with the same line `doom coop` prints, so the two can be compared
#
#   doom netplay <file> host <players 2-4> <map 1-9> <tics> [<port>]
#   doom netplay <file> join <address> <tics> [<port>]
#   doom netplay <file> host <players> <map> <tics> 0 relay=<address>
#   doom netplay <file> join <code> <tics> 0 relay=<address>
#
# a last word "corrupt" makes this machine alone draw one random number more
# at tic 500, which the others must notice
fun netplay(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    val got: res[*net.Net, allocator.Error] = allocator.zallocate[net.Net](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val n: *net.Net = got.ok;

    val hosting: bool = str_equals(argv[3], "host");
    val corrupt: bool = str_equals(argv[argc - 1], "corrupt");
    # "paced" plays at 35 tics a second, one command a tic, as the window
    # does, and counts the tics it had to wait for the others' commands
    var paced: bool = 0;
    # "levels" leaves E1M1 at tic 300 on every machine and plays on through
    # the intermission into E1M2, as the window does; "press" makes this
    # machine alone press Space on the intermission, as a player would
    var levels: bool = 0;
    var press:  bool = 0;
    # "public" puts a hosted room on the relay's list
    var listed: bool = 0;
    # "fill" starts a hosted room as soon as it can, bots in the empty seats
    var fillnow: bool = 0;
    # "dm" hosts a deathmatch rather than co-op
    var deathmatch: bool = 0;
    # "train" sends how this machine's player plays, as a player who has
    # said the bots may learn from them does
    var teaching: bool = 0;
    var word:   i64  = 4;
    for (word < argc) {
        if (str_equals(argv[word], "paced"))  { paced = 1; }
        if (str_equals(argv[word], "levels")) { levels = 1; }
        if (str_equals(argv[word], "press"))  { press = 1; }
        if (str_equals(argv[word], "public")) { listed = 1; }
        if (str_equals(argv[word], "fill"))   { fillnow = 1; }
        if (str_equals(argv[word], "dm"))     { deathmatch = 1; }
        if (str_equals(argv[word], "train"))  { teaching = 1; }
        word = word + 1;
    }
    var tics:    i32  = 0;
    var port:    u16  = net.PORT;
    if (hosting) {
        if (argc < 7) { ret usage(); }
        tics = number(argv[6], 350)::i32;
        if (argc >= 8) { port = number(argv[7], 5029)::u16; }
    }
    or {
        if (argc < 6) { ret usage(); }
        tics = number(argv[5], 350)::i32;
        port = 0;
    }

    # relay=<address> anywhere after the fixed words plays through a relay
    var relay:   net.Peer;
    var viarelay: bool = 0;
    var arg:      i64  = 4;
    for (arg < argc) {
        val word: str = argv[arg];
        if (word[0] == 'r' && word[1] == 'e' && word[2] == 'l' && word[3] == 'a' && word[4] == 'y' && word[5] == '=') {
            if (!net.parse_address(?word[6], ?relay)) {
                print.eprintln("doom: that relay is not an address");
                ret EXIT_USAGE;
            }
            viarelay = 1;
        }
        arg = arg + 1;
    }

    # on this machine's loopback, unless the relay is out on the network
    val local: bool = !viarelay || relay.octets[0] == 127;
    if (!net.open(n, port, local)) {
        print.eprintln("doom: the network port could not be opened");
        ret EXIT_WINDOW;
    }
    n.wadhash = game_hash(?a, ?w);

    if (hosting) {
        var players: i32 = number(argv[4], 2)::i32;
        if (players < 2) { players = 2; }
        if (players > 4) { players = 4; }
        net.host(n, players, defs.SK_MEDIUM, number(argv[5], 1)::i32);
        if (viarelay) { net.use_relay(n, ?relay); }
        n.public     = listed;
        n.deathmatch = deathmatch;
    }
    or (viarelay) {
        net.use_relay(n, ?relay);
        if (!net.join_code(n, argv[4])) {
            print.eprintln("doom: that is not a room code");
            ret EXIT_USAGE;
        }
    }
    or {
        if (!net.join(n, argv[4])) {
            print.eprintln("doom: that is not an address");
            ret EXIT_USAGE;
        }
    }

    # wait up to twenty seconds for everyone; a host on a relay says its code
    # as soon as it has one, for whoever is to join
    val began:  i64  = win.micros_now();
    var said:   bool = 0;
    for (!net.gather(n)) {
        if (n.refused != 0) {
            print.eprintln(net.refusal(n));
            net.close(n);
            ret EXIT_MAP;
        }
        if (n.relaymode && n.host && n.token != 0 && !said) {
            print.printlnf("room {}", ?n.code[0]);
            said = 1;
        }
        # for the test: once one other player is in, start with bots
        if (fillnow && n.host && n.joined >= 2) { net.ask_fill(n); }
        win.nap(5);
        if (win.micros_now() - began > 20000000) {
            print.eprintln("doom: nobody came");
            net.close(n);
            ret EXIT_MAP;
        }
    }

    var s: *game.Session = nil;
    if (n.deathmatch) {
        val got2: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
        if (sel got2.ok) {
            s = got2.ok;
            game.init(s, ?a, ?w, ?d);
            if (!game.deathmatch_game(s, n.players, n.me, defs.SK_MEDIUM, n.map, 1, 1)) { s = nil; }
        }
    }
    or {
        s = coop_session(?a, ?w, ?d, n.players, n.me, n.map);
    }
    if (s == nil) {
        net.close(n);
        ret EXIT_MAP;
    }
    seat_bots(s, n);
    # who the bots are, for a test to read
    var seat: i32 = 0;
    for (seat < n.players) {
        if ((n.botmask & (1 << seat)) != 0) { print.printlnf("seat {} is {}", seat + 1, ?n.bots[seat].name[0]); }
        seat = seat + 1;
    }

    var bot: Bot;
    bot.seed = (n.me * 7919 + 17)::u32;

    # the window's own ticker, for the levels test
    var f: front.Front;
    front.init(?f);
    f.train = front.TRAIN_NO;
    f.mode    = front.MODE_LEVEL;
    f.netgame = 1;
    var bar:     st.State;
    st.init(?bar);
    var pressed: bool = 0;

    var gametic: i32 = 0;
    var last:    i64 = win.micros_now();
    var due:     i64 = last;
    var steps:   i32 = 0;
    var waited:  i32 = 0;
    var behind:  i32 = 0;
    var waiting: i32 = 0;
    var longest: i32 = 0;
    if (paced) { win.fine_timer(1); }
    for (gametic < tics && !n.desync && !n.quit) {
        if (paced) {
            for (win.micros_now() < due) { win.nap(1); }
            due = due + 1000000 / 35;
        }
        net.receive(n);
        for (net.wants_command(n, gametic) && n.maketic < tics) {
            var cmd: defs.Ticcmd;
            bot_ticcmd(?bot, n.maketic, ?cmd);
            net.add_command(n, ?cmd);
            if (paced) { brk; }
        }
        net.send_commands(n, gametic - 1);
        val before: i32 = gametic;

        var ran: bool = 0;
        # every command made, the last tics are due without waiting for more
        for (gametic < tics && (!paced || net.due(n, gametic) || n.maketic == tics) && net.ready(n, gametic)) {
            var cmds: [4]defs.Ticcmd;
            net.commands(n, gametic, ?cmds[0]);
            # the same forced death as `doom coop`, on every machine
            if (gametic == 100) { world.damage_mobj(?s.g, s.g.players[1].mo, nil, nil, 10000); }
            # for the test that the desync alarm works: this machine alone
            # draws one random number more
            if (corrupt && gametic == 500) { defs.p_random(?s.g); }
            if (levels) {
                if (gametic == 300) { s.g.exited = 1; }
                if (press && !pressed && f.mode == front.MODE_WI) {
                    front.responder(?f, s, front.KEY_SPACE);
                    pressed = 1;
                }
                front.net_ticker(?f, s, ?bar, ?cmds[0]);
            }
            or {
                game.ticker_cmds(s, ?cmds[0]);
            }
            if (teaching) { teach(n, s); }
            net.record(n, gametic, game.checksum(s));
            gametic = gametic + 1;
            ran     = 1;
        }

        # a step of the clock on which a due tic could not run, once play has
        # begun, is a stutter a player would see
        if (paced && gametic < tics) {
            val stuck: bool = net.due(n, gametic) || n.maketic == tics;
            net.pace(n, gametic);
            if (before > 0) {
                steps = steps + 1;
                if (stuck) { behind = behind + 1; }
                if (stuck && !ran) {
                    waited  = waited + 1;
                    waiting = waiting + 1;
                    if (waiting > longest) { longest = waiting; }
                }
                or {
                    waiting = 0;
                }
            }
        }

        if (ran) {
            last = win.micros_now();
        }
        or {
            if (!paced) { win.nap(1); }
            if (win.micros_now() - last > 10000000) {
                print.eprintln("doom: the other machines stopped answering");
                brk;
            }
        }
    }

    if (paced) {
        win.fine_timer(0);
        print.printlnf("paced: {} steps, {} behind, {} frozen, longest freeze {} tics, cushion {} at most {}", steps, behind, waited, longest, n.playout, n.widest);
    }

    # keep answering for a moment, so that a peer a tic behind can finish
    var linger: i32 = 0;
    for (linger < 300) {
        net.receive(n);
        net.send_commands(n, gametic - 1);
        win.nap(2);
        linger = linger + 1;
    }
    net.close(n);

    if (n.desync) {
        desync_report(n, s, front.MODE_LEVEL, gametic);
        print.printlnf("desync at tic {}", n.desynctic);
        ret EXIT_MAP;
    }
    print.printf("end tic {} sum {} map E1M{}", gametic, game.checksum(s), s.g.gamemap);
    var i: i32 = 0;
    for (i < n.players) {
        print.printf(" p{} health {} kills {}", i + 1, s.g.players[i].health, s.g.players[i].killcount);
        i = i + 1;
    }
    print.println("");
    if (gametic < tics) { ret EXIT_MAP; }
    ret EXIT_OK;
}

# a bot as it is told to a game (the relay's seat, a match to watch): the
# hand-written one if its low byte is 1, a net otherwise, with its traits
fun seat_kind(told: i32) i32 {
    var kind: i32 = bot.KIND_NET;
    if ((told & 0xff) == bot.KIND_SCRIPT) { kind = bot.KIND_SCRIPT; }
    # its traits, its quirk and its feelings go as they came
    ret kind | (told & 0x7fffff00);
}

fun get32(p: *u8, at: i32) u32 {
    ret p[at]::u32 | (p[at + 1]::u32 << 8) | (p[at + 2]::u32 << 16) | (p[at + 3]::u32 << 24);
}

# whether what is being watched is over, and the next should be fetched: a
# deathmatch when its tics are up or its level is left; a campaign when its
# last level is, which is when the front end turns to the finale, and then
# the league is joined again where it has got to
fun watched_out(f: *front.Front, s: *game.Session, tics: i32) bool {
    if (s.campaign) { ret f.mode == front.MODE_FINALE; }
    ret s.g.leveltime >= tics || s.completed;
}

val ANOTHER_SIMULATION: i32 = -1;
val UNREACHED:          i32 = -2;
val BETWEEN:            i32 = -3;

# ------------------------------------------------- joining the co-op league

# what the league writes as each level of a campaign begins (arena.mach,
# publish): its head, four seats, and what the players carried in
val NOW_HEAD:  i32 = 20;
val NOW_SEAT:  i32 = 974;
val NOW_BYTES: i32 = 20 + 4 * 974 + 1040;

# the place the newest program and the league's files are kept:
# UPDATE_URL, or DOOM_UPDATE_URL if that is set
fun site_base(out: *u8) {
    var other: [256]u8;
    append(out, 0, UPDATE_URL);
    val place: res[opt[usize], env.EnvError] = env.get("DOOM_UPDATE_URL", ?other[0], 200);
    if (sel place.ok) {
        if (sel place.ok.some) { append(out, 0, ?other[0]); }
    }
}

# fetch one of the league's files from the site, whole, into a buffer
# ---
# ret: its length, or -1 if it could not be had
fun fetch_league(a: *allocator.Allocator, name: str, into: *u8, room: i32) i32 {
    var exe: [512]u8;
    if (!win.exe_path(?exe[0])) { ret -1; }
    var base: [256]u8;
    site_base(?base[0]);
    var url:  [512]u8;
    var path: [600]u8;
    var at:   i32 = append(?url[0], 0, ?base[0]);
    at = append(?url[0], at, "/league/");
    at = append(?url[0], at, name);
    # the time in the address, so that no cache answers with an old one
    at = append(?url[0], at, "?t=");
    at = append_number(?url[0], at, win.micros_now());
    at = append(?path[0], 0, ?exe[0]);
    at = append(?path[0], at, ".league");
    if (!win.download(?url[0], ?path[0])) { ret -1; }
    val bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?path[0]);
    fs.remove_file(?path[0]);
    if (sel bytes.err) { ret -1; }
    var n: i32 = bytes.ok.len::i32;
    if (n > room) { n = room; }
    var k: i32 = 0;
    for (k < n) {
        into[k] = bytes.ok.data[k];
        k       = k + 1;
    }
    ret n;
}

# Join the co-op league's campaign where it has got to: the level it is on,
# begun as the league began it (game.campaign_resume), then played through
# quickly, without a sound, to the tic the league last said it had reached.
# From there a game goes on at the speed of a game, level after level, the
# same game the league played.
# ---
# names: the four bots' names, 24 bytes each
# ret:   the level joined, or 0 if there is no campaign to join,
#        UNREACHED, or ANOTHER_SIMULATION
fun join_league_begin(a: *allocator.Allocator, s: *game.Session, names: *u8, j: *LeagueJoin) i32 {
    var now:  [4956]u8;
    var tick: [16]u8;
    var done: [20]u8;
    val got:  i32 = fetch_league(a, "coopnow.bin", ?now[0], NOW_BYTES);
    if (got < 0) { ret UNREACHED; }
    # the level the files set out may have ended while the league plays its
    # trial between levels: joining it would only reach the finale and ask
    # again, every time, however long its replay takes. coopdone.bin says
    # so — the league will say where it has got to when it has got somewhere
    val dlen: i32 = fetch_league(a, "coopdone.bin", ?done[0], 20);
    if (got == NOW_BYTES && dlen == 20 && done[0] == 'M' && done[1] == 'D' && done[2] == 'E' && done[3] == '1' && get32(?done[0], 4) == get32(?now[0], 12) && get32(?done[0], 8):~i32 == now[6]::i32) {
        ret BETWEEN;
    }
    ret join_setup(s, ?now[0], got, ?tick[0], fetch_league(a, "coopnow.tic", ?tick[0], 16), 0, names, j);
}

fun join_league(a: *allocator.Allocator, s: *game.Session, names: *u8) i32 {
    var now:  [4956]u8;
    var tick: [16]u8;
    val got:  i32 = fetch_league(a, "coopnow.bin", ?now[0], NOW_BYTES);
    if (got < 0) { ret UNREACHED; }
    ret join_campaign(s, ?now[0], got, ?tick[0], fetch_league(a, "coopnow.tic", ?tick[0], 16), 0, names);
}

# a joining of the co-op league's campaign, spread over frames: the level
# set up as the league began it, then a slice of it played each frame
# until it is as far in as the league said. A level deep in takes a while
# to catch up with, and the window must stay its own the while — one long
# joining froze it, once, for minutes.
rec LeagueJoin {
    target: i32;
    map:    i32;
    tic:    i32;
    hook:   defs.SoundHook;
    cmds:   [4]defs.Ticcmd;
}

# set a join up from what the league published: the campaign begun or
# resumed with the level's four bots, ready to be played in by join_slice
# ---
# now:  coopnow.bin, so many bytes of it
# tick: coopnow.tic, so many bytes of it (or -1 for none: the level from its start)
# view: whose eyes
# ret:  the level joined, or 0 if there is no campaign to join,
#       UNREACHED, or ANOTHER_SIMULATION
fun join_setup(s: *game.Session, now: *u8, nowlen: i32, tick: *u8, ticklen: i32, view: i32, names: *u8, j: *LeagueJoin) i32 {
    if (nowlen != NOW_BYTES || now[0] != 'M' || now[1] != 'D' || now[2] != 'N' || now[3] != '1' || now[4] != relayproto.RECIPE) { ret 0; }
    if (get32(now, 16) != our_fingerprint(s)) { ret ANOTHER_SIMULATION; }
    val skill:    i32 = now[5]::i32;
    val map:      i32 = now[6]::i32;
    val cap:      i32 = get32(now, 8):~i32;
    val campaign: u32 = get32(now, 12);
    if (map < 1 || map > 9 || cap < 1) { ret 0; }
    if (map == 1) {
        if (!game.campaign_game(s, 4, view, skill, cap)) { ret 0; }
    }
    or (!game.campaign_resume(s, 4, view, skill, cap, map, ?now[NOW_HEAD + 4 * NOW_SEAT])) {
        ret 0;
    }
    var i: i32 = 0;
    for (i < 4) {
        val at: i32 = NOW_HEAD + i * NOW_SEAT;
        game.set_bot(s, i, seat_kind(get32(now, at):~i32), (?now[at + 32]):~*i8, get32(now, at + 4));
        var k: i32 = 0;
        for (k < 24) {
            names[i * 24 + k] = now[at + 8 + k];
            k                 = k + 1;
        }
        i = i + 1;
    }
    game.campaign_bots(s);

    # as far in as the league has got, if it says so of this level
    j.target = 0;
    if (ticklen == 16 && tick[0] == 'M' && tick[1] == 'D' && tick[2] == 'P' && tick[3] == '1' && get32(tick, 4) == campaign && get32(tick, 8):~i32 == map) {
        j.target = get32(tick, 12):~i32;
    }
    if (j.target > cap - 35) { j.target = cap - 35; }
    j.map  = map;
    j.tic  = 0;
    j.hook = s.g.start_sound;
    s.g.start_sound = nil;
    ret map;
}

# play a joining's level on a slice more, for usecs at most, toward the
# tic the league last said it had reached; then the sound hook back
# ---
# ret: 0 while there is more to play, the level joined once it is caught
#      up, or -1 if the level broke
fun join_slice(s: *game.Session, j: *LeagueJoin, usecs: i64) i32 {
    val until: i64 = win.micros_now() + usecs;
    for (j.tic < j.target && !s.completed && !s.broken && win.micros_now() < until) {
        game.ticker_cmds(s, ?j.cmds[0]);
        j.tic = j.tic + 1;
    }
    if (j.tic < j.target && !s.completed && !s.broken) { ret 0; }
    s.g.start_sound = j.hook;
    if (s.broken) { ret -1; }
    ret j.map;
}

# give a joining up: the sound hook back, the level left as it is
fun join_abort(s: *game.Session, j: *LeagueJoin) {
    s.g.start_sound = j.hook;
}

# join a campaign from what the league published, in one piece, as
# join_league does
# ---
# now:  coopnow.bin, so many bytes of it
# tick: coopnow.tic, so many bytes of it (or -1 for none: the level from its start)
# view: whose eyes
fun join_campaign(s: *game.Session, now: *u8, nowlen: i32, tick: *u8, ticklen: i32, view: i32, names: *u8) i32 {
    var j: LeagueJoin;
    val map: i32 = join_setup(s, now, nowlen, tick, ticklen, view, names, ?j);
    if (map <= 0) { ret map; }
    var done: i32 = 0;
    for (done == 0) { done = join_slice(s, ?j, 100000); }
    if (done < 0) { ret 0; }
    ret done;
}

# Join the co-op league where it is, play the level it is on to the end,
# and, if the league has since said how that level ended, check this
# program came out the same.
#
#   doom joinleague <wad>
fun joinleague(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;
    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);

    var names: [96]u8;
    val map:   i32 = join_league(?a, s, ?names[0]);
    if (map == UNREACHED) {
        print.eprintln("doom: the league could not be reached");
        ret EXIT_MAP;
    }
    if (map == ANOTHER_SIMULATION) {
        print.eprintln("doom: the league is playing another version of the simulation or the bots");
        ret EXIT_DATA;
    }
    if (map == 0) {
        print.eprintln("doom: the league has no campaign to join");
        ret EXIT_DATA;
    }
    val began: i32 = s.g.leveltime;
    var cmds:  [4]defs.Ticcmd;
    for (!s.completed && !s.broken) { game.ticker_cmds(s, ?cmds[0]); }
    val sum: u32 = game.checksum(s);
    print.printlnf("joined E1M{} at tic {}, played it to its end at tic {}: sum {}", map, began, s.g.leveltime, sum);
    var done: [20]u8;
    val dlen: i32 = fetch_league(?a, "coopdone.bin", ?done[0], 20);
    if (dlen == 20 && done[0] == 'M' && done[1] == 'D' && done[2] == 'E' && done[3] == '1' && get32(?done[0], 8):~i32 == map) {
        val was: u32 = get32(?done[0], 16);
        print.printlnf("the league ended E1M{} at tic {}: sum {}", map, get32(?done[0], 12), was);
        if (was != sum) {
            print.println("joined, the level came out otherwise than the league's");
            ret EXIT_MAP;
        }
        print.println("joined, the level came out as the league's did");
    }
    ret EXIT_OK;
}

# Whether a campaign can be begun at any level of it and come out as the
# whole campaign does: four bots play the first levels straight through, a
# level at most tics long, and what each level ends on (its checksum and its
# length) is noted with what the players carried out of it; then every level
# after the first is played again from what the one before handed on alone,
# and must end the same.
#
#   doom resumecheck <wad> <levels> <tics a level>
fun resumecheck(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;
    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);
    var levels: i32 = number(argv[3], 3)::i32;
    val cap:    i32 = number(argv[4], 2100)::i32;
    if (levels < 2) { levels = 2; }
    if (levels > 9) { levels = 9; }

    # the bots: two nets of fixed weights, a brawler, the hand-written one
    var net: [942]i8;
    var seed: u32 = 0x1234567;
    var k: i32 = 0;
    for (k < 942) {
        seed   = seed * 1103515245 + 12345;
        net[k] = (((seed >> 16) & 0x3f):~i32 - 32)::i8;
        k      = k + 1;
    }
    val kinds: [4]i32 = [4]i32{bot.KIND_NET, bot.KIND_NET | (bot.QUIRK_RECKLESS << bot.QUIRK_SHIFT), bot.KIND_NET | bot.TRAIT_FISTS, bot.KIND_SCRIPT | (bot.QUIRK_LOYAL << bot.QUIRK_SHIFT) | bot.feel_bits(0, 90)};

    var maps:  [9]i32;
    var sums:  [9]u32;
    var ends:  [9]i32;
    var carry: [9 * 1040]u8;
    # and the net each bot began each level with — learning in a level is
    # carried into the next, so a level begun there wants the net it had
    var nets:  [9 * 4 * 942]i8;
    var cmds:  [4]defs.Ticcmd;
    if (!game.campaign_game(s, 4, 0, defs.SK_NIGHTMARE, cap)) { ret EXIT_MAP; }
    var i: i32 = 0;
    for (i < 4) {
        game.set_bot(s, i, kinds[i], ?net[0], (i * 7919 + 3)::u32);
        i = i + 1;
    }
    var n: i32 = 0;
    for (n < levels) {
        maps[n] = s.g.gamemap;
        i = 0;
        for (i < 4) {
            k = 0;
            for (k < 942) {
                nets[n * 4 * 942 + i * 942 + k] = s.bots[i].net[k];
                k                               = k + 1;
            }
            i = i + 1;
        }
        var tic: i32 = 0;
        for (!s.completed && !s.broken) {
            game.ticker_cmds(s, ?cmds[0]);
            tic = tic + 1;
        }
        if (s.broken) { ret EXIT_MAP; }
        sums[n] = game.checksum(s);
        ends[n] = tic;
        game.carry(s, ?carry[n * 1040]);
        n = n + 1;
        if (n < levels) { game.world_done(s); }
    }

    var same: bool = 1;
    n = 1;
    for (n < levels) {
        if (!game.campaign_resume(s, 4, 0, defs.SK_NIGHTMARE, cap, maps[n], ?carry[(n - 1) * 1040])) { ret EXIT_MAP; }
        i = 0;
        for (i < 4) {
            game.set_bot(s, i, kinds[i], ?nets[n * 4 * 942 + i * 942], (i * 7919 + 3)::u32);
            i = i + 1;
        }
        game.campaign_bots(s);
        var tic: i32 = 0;
        for (!s.completed && !s.broken) {
            game.ticker_cmds(s, ?cmds[0]);
            tic = tic + 1;
        }
        val sum: u32 = game.checksum(s);
        print.printlnf("E1M{}: played through {} tics sum {}, begun there {} tics sum {}", maps[n], ends[n], sums[n], tic, sum);
        if (sum != sums[n] || tic != ends[n]) { same = 0; }
        n = n + 1;
    }
    if (!same) {
        print.println("a level begun from what the one before handed on came out otherwise");
        ret EXIT_MAP;
    }
    print.println("every level begun from what the one before handed on came out the same");
    ret EXIT_OK;
}

# say this program's fingerprint, as the arena says its own
#
#   doom fingerprint <wad>
fun print_fingerprint(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;
    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);
    print.printlnf("the simulation's fingerprint is {}", our_fingerprint(s));
    ret EXIT_OK;
}

# this program's fingerprint (game.fingerprint), worked out the first time
# it is asked for, in the session given, which the probe leaves in a state
# to be replaced
var fingerprinted: bool;
var fingerprint:   u32;

fun our_fingerprint(s: *game.Session) u32 {
    if (!fingerprinted) {
        fingerprint   = game.fingerprint(s);
        fingerprinted = 1;
    }
    ret fingerprint;
}

# set a session up to play a league match again, as the arena left it in
# its watch file (arena.mach): the map, and each bot's kind, seed and net
# ---
# view: whose eyes, 0 to 3
# ret:  the match's length in tics, or 0 if the file is not one or its map
#       does not load
# ret:  the match's length in tics; 0 if the file is not one this program
#       can read; ANOTHER_SIMULATION if it was played by a program whose
#       simulation or bots differ from this one's, so that playing it here
#       would show something that never happened
fun watch_setup(s: *game.Session, data: *u8, view: i32) i32 {
    if (data[0] != 'M' || data[1] != 'D' || data[2] != 'W' || data[3] != '1' || data[4] != relayproto.RECIPE) { ret 0; }
    if (get32(data, relayproto.WATCHPRINT) != our_fingerprint(s)) { ret ANOTHER_SIMULATION; }
    val map:  i32 = data[5]::i32;
    val tics: i32 = get32(data, 8):~i32;
    if (map < 1 || map > 9 || tics < 1 || tics > 35 * 600) { ret 0; }
    if (data[6] != 0) { ret 0; }
    if (!game.deathmatch_game(s, 4, view, defs.SK_MEDIUM, map, 1, 1)) {
        ret 0;
    }
    var i: i32 = 0;
    for (i < 4) {
        val at: i32 = 16 + i * 986;
        game.set_bot(s, i, seat_kind(get32(data, at):~i32), (?data[at + 44]):~*i8, get32(data, at + 4));
        i = i + 1;
    }
    ret tics;
}

# fetch the bot league's last match from a relay and play it again with no
# window, as fast as it goes; say whether it came out as the league
# recorded it, which it must if this program and the arena, on whatever
# machines, compute the same game
#
#   doom watch <wad> <relay address>
fun watch(argc: i64, argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) { ret EXIT_DATA; }
    var d: rdata.Data = graphics.ok;

    var relay: net.Peer;
    if (!net.parse_address(argv[3], ?relay)) {
        print.eprintln("doom: that relay is not an address");
        ret EXIT_USAGE;
    }
    val wg: res[*net.Watch, allocator.Error] = allocator.zallocate[net.Watch](?a, 1);
    if (sel wg.err) { ret EXIT_DATA; }
    val fetch: *net.Watch = wg.ok;
    if (!net.watch_open(fetch, ?relay)) {
        print.eprintln("doom: the network could not be opened");
        ret EXIT_WINDOW;
    }
    val began: i64 = win.micros_now();
    for (!fetch.done && win.micros_now() - began < 10000000) {
        net.watch_poll(fetch, win.micros_now());
        win.nap(5);
    }
    net.watch_close(fetch);
    if (!fetch.done) {
        if (fetch.none) {
            print.eprintln("doom: the relay has no league match to watch");
        }
        or {
            print.eprintln("doom: the relay did not answer");
        }
        ret EXIT_MAP;
    }

    val got: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel got.err) { ret EXIT_DATA; }
    val s: *game.Session = got.ok;
    game.init(s, ?a, ?w, ?d);
    val tics: i32 = watch_setup(s, ?fetch.data[0], 0);
    if (tics == ANOTHER_SIMULATION) {
        print.eprintln("doom: that match was played by another version of the simulation or the bots");
        ret EXIT_DATA;
    }
    if (tics == 0) {
        print.eprintln("doom: that is not a match this program can play");
        ret EXIT_DATA;
    }
    var cmds: [4]defs.Ticcmd;
    var tic:  i32 = 0;
    var i:    i32 = 0;
    for (tic < tics && !s.completed && !s.broken) {
        game.ticker_cmds(s, ?cmds[0]);
        tic = tic + 1;
    }

    var same: bool = 1;
    i = 0;
    for (i < 4) {
        val at: i32 = 16 + i * 986;
        val p:  *defs.Player = ?s.g.players[i];
        var frags:  i32 = 0;
        var deaths: i32 = p.frags[i];
        var k:      i32 = 0;
        for (k < 4) {
            if (k != i) {
                frags  = frags + p.frags[k];
                deaths = deaths + s.g.players[k].frags[i];
            }
            k = k + 1;
        }
        val wasfrags:  i32 = get32(?fetch.data[0], at + 8):~i32;
        val wasdeaths: i32 = get32(?fetch.data[0], at + 12):~i32;
        if (frags != wasfrags || deaths != wasdeaths) { same = 0; }
        print.printlnf("{}: frags {} deaths {} (the league had {} and {})", ?fetch.data[at + 20], frags, deaths, wasfrags, wasdeaths);
        i = i + 1;
    }
    if (!same) {
        print.println("the replay differs from the league's match");
        ret EXIT_MAP;
    }
    print.printlnf("match {} on E1M{}: the replay is the league's match", get32(?fetch.data[0], 12), s.g.gamemap);
    ret EXIT_OK;
}

# print a relay's open games that this program and WAD could join, one a
# line: code, players joined of how many, skill, map
#
#   doom rooms <wad> <relay address>
fun rooms(argv: **u8) i64 {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[2]);
    if (sel loaded.err) { ret refuse(loaded.err); }
    var w: wad.Wad = loaded.ok;

    var relay: net.Peer;
    if (!net.parse_address(argv[3], ?relay)) {
        print.eprintln("doom: that relay is not an address");
        ret EXIT_USAGE;
    }
    var lobby: net.Lobby;
    if (!net.lobby_open(?lobby, ?relay, game_hash(?a, ?w))) {
        print.eprintln("doom: the network could not be opened");
        ret EXIT_WINDOW;
    }
    val began: i64 = win.micros_now();
    for (!lobby.answered && win.micros_now() - began < 5000000) {
        net.lobby_poll(?lobby, win.micros_now());
        win.nap(5);
    }
    net.lobby_close(?lobby);
    if (!lobby.answered) {
        print.eprintln("doom: the relay did not answer");
        ret EXIT_MAP;
    }
    var i: i32 = 0;
    for (i < lobby.count) {
        val g: *net.Listing = ?lobby.rooms[i];
        if (g.deathmatch) {
            print.printlnf("{} {}/{} deathmatch map E1M{}", ?g.code[0], g.joined, g.players, g.map);
        }
        or {
            print.printlnf("{} {}/{} skill {} map E1M{}", ?g.code[0], g.joined, g.players, g.skill + 1, g.map);
        }
        i = i + 1;
    }
    ret EXIT_OK;
}

# started by a double click: play with the DOOM1.WAD in the same folder,
# and say in a box what is wrong if it cannot
fun clicked() i64 {
    byclick = 1;
    win.drop_console();
    var path: [512]u8;
    if (!win.beside_exe("DOOM1.WAD", ?path[0])) {
        win.alert("This folder's path is too long. Move the doom folder somewhere shorter.");
        ret EXIT_WAD;
    }
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret EXIT_WAD; }
    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, ?path[0]);
    if (sel loaded.err) {
        win.alert("DOOM1.WAD was not found next to doom.exe, or it is damaged.\n\nKeep the two files together in one folder.");
        ret EXIT_WAD;
    }
    var args: [3]*u8;
    args[0] = ?path[0];
    args[1] = "play";
    args[2] = ?path[0];
    val code: i64 = play_with(3, ?args[0], nil);
    if (code != EXIT_OK) { win.alert("Doom could not open its window or read its graphics."); }
    ret code;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc == 1 && win.started_by_click())                                  { ret clicked(); }
    if (argc == 2 && str_equals(argv[1], "update"))                           { ret update_command(); }
    if (argc == 3 && str_equals(argv[1], "wad"))                              { ret list(argv[2]); }
    if (argc == 4 && str_equals(argv[1], "map"))                              { ret dump(argv[2], argv[3]); }
    if ((argc == 5 || argc == 8) && str_equals(argv[1], "frame"))             { ret frame(argc, argv); }
    if (argc >= 6 && str_equals(argv[1], "netplay"))                          { ret netplay(argc, argv); }
    if (argc >= 6 && str_equals(argv[1], "coop"))                             { ret coop(argc, argv); }
    if (argc == 5 && str_equals(argv[1], "shy"))                              { ret shy(argv); }
    if (argc == 5 && str_equals(argv[1], "navdump"))                          { ret navdump(argv); }
    if (argc == 5 && str_equals(argv[1], "botdata"))                          { ret botdata(argv); }
    if (argc == 6 && str_equals(argv[1], "netmatch"))                         { ret netmatch(argv); }
    if (argc >= 5 && argc <= 7 && str_equals(argv[1], "botmatch"))          { ret botmatch(argc, argv); }
    if (argc >= 4 && str_equals(argv[1], "script"))                           { ret script(argc, argv); }
    if (argc == 4 && str_equals(argv[1], "mus"))                              { ret mus(argv); }
    if ((argc == 4 || argc == 5 || argc == 9 || argc == 11) && str_equals(argv[1], "navcheck")) { ret navcheck(argc, argv); }
    if (argc == 3 && str_equals(argv[1], "joinleague"))                       { ret joinleague(argv); }
    if (argc == 5 && str_equals(argv[1], "resumecheck"))                      { ret resumecheck(argv); }
    if (argc == 3 && str_equals(argv[1], "fingerprint"))                      { ret print_fingerprint(argv); }
    if (argc >= 5 && argc <= 8 && str_equals(argv[1], "coopmatch") && (argc < 8 || str_equals(argv[7], "trace") || str_equals(argv[7], "league") || str_equals(argv[7], "leaguetrace")))         { ret coopmatch(argc, argv); }
    if (argc == 4 && str_equals(argv[1], "rooms"))                            { ret rooms(argv); }
    if (argc == 4 && str_equals(argv[1], "watch"))                            { ret watch(argc, argv); }
    if (argc == 6 && str_equals(argv[1], "muswav"))                           { ret muswav(argv); }
    if (argc == 5 && str_equals(argv[1], "wav"))                              { ret wav(argv); }
    if (argc >= 3 && argc <= 9 && str_equals(argv[1], "host"))                { ret play_net(argc, argv, 1); }
    if (argc >= 4 && argc <= 6 && str_equals(argv[1], "join"))                             { ret play_net(argc, argv, 0); }
    if (argc >= 3 && argc <= 5 && str_equals(argv[1], "play"))                { ret play(argc, argv); }
    if ((argc == 4 || argc == 5 || argc == 7) && str_equals(argv[1], "demo")) { ret demo(argc, argv); }
    ret usage();
}
