# arena: a league of a hundred bots, playing matches around the clock
#
#   arena <wad> <first net> <directory> [<matches> [coop]]
#
# There are two leagues, and a process runs one. Without "coop" it is the
# deathmatch league, described first. With it, the co-op league, described
# after: other bots, in files of their own, because what wins a deathmatch
# is not what gets a team through a level.
#
# A hundred bots, each a 942-byte net that began as the same imitation of
# the hand-written bot. Four at a time are drawn to a two-minute deathmatch
# on one of the episode's maps, with no window, as fast as the processor
# allows within a share of it (ARENA_DUTY, a percentage, 5 unless set).
#
# Every bot is rated the same way, by who outscored whom (Elo). But each
# learns by its own lights: it has a style, a reward of its own, and after
# each match the match is played again with a mutated copy of the bot in
# its place, which takes its place for good if it earned clearly more of
# that reward (see relive). Most styles want frags, in different ways, and
# shots that hit; some want to spin, to open doors, never to fire, or to
# die, and get comically bad at winning while getting good at what they
# want. Two never learn: the hand-written bot itself, and a net of noise.
#
# The directory holds league.bin, the whole league, rewritten every minute
# and read back at the start, so the league outlives the process;
# board.json, the standings, for the page that shows them; and watch.bin,
# the match just played, for a game to play again at the speed a person can
# watch: the map, and each bot's net, seed and name, which is all a match
# is, with its result to check the replay against.
#
# Five bots in each league are apprentices. They are rated like the rest,
# but they do not learn from their matches: they learn from people. Players
# who have said they may be learned from send how they played (what a bot in
# their place would have sensed, and what they did) to the relay, which
# keeps the last hundred thousand such moments in train.bin, here in the
# directory. After each match one apprentice tries a few mutants of itself
# against a few hundred of those moments from its own kind of game, and
# keeps a mutant that does what the people did more nearly than it does.
# With nobody's play to learn from, an apprentice stays as it is.
#
# Every bot has feelings about every other, 0 to 100, all 50 to begin with,
# and they move slowly: after each match a bot comes to like one of the
# three it played with a little more and one a little less, by what
# happened (see befriend). Feelings go into the next match with the bots:
# in a deathmatch, where there are no friends and feelings only fall, a bot
# goes for those it dislikes first and hunts down one it hates; in co-op a
# loyal bot stays by its friend, and a bot takes no care not to shoot one it
# has come to hate. And every bot has a quirk, by
# its place in the league: cautious, reckless, loyal, grudge-bearing, or
# none (bot.mach). Feelings are kept in feel.bin (coopfeel.bin).
#
# The co-op league's four are a team on Nightmare: the monsters fast and
# coming back. The bots play the level through (bot.mach): into every
# secret, fighting until five minutes are up, and only then out by the
# exit, fetching the keys the way needs. A match is a level, for eight
# minutes or until the team is out of it. A bot is rated against the other
# three by what it did itself: what it killed, the secrets it found, how
# far toward the exit it got, the keys it found, less its deaths. Its
# styles are co-op's: most want all of that and the level finished; some
# want only to kill, or to get there, or to live. Its files are coop.bin,
# coop.json and coopwatch.bin.

use std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.collections.vector.Vector;
use std.crypto.rand;
use fs: std.filesystem;
use io_error: std.io.error;
use std.print;
use std.runtime;
use std.process.env;
use std.system.os;
use std.text.parse;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use doom.bot;
use doom.defs;
use doom.game;
use doom.level;
use lf: doom.leaguefile;
use doom.rdata;
use doom.wad;

val MEMBERS: i32 = 100;
val NET:     i32 = 942;
# tics in a match: two minutes
val MATCH: i32 = 4200;
# the maps the bots can find each other on
val MAPS: [7]i32 = [7]i32{1, 2, 3, 4, 7, 8, 9};

# the co-op league: eight minutes, of which the bots will not leave in the
# first five, on every map but the eighth, which has no exit to walk to
val COOPMATCH: i32 = 16800;
val COOPMAPS: [8]i32 = [8]i32{1, 2, 3, 4, 5, 6, 7, 9};
val COOP_NAMES: [11]str = [11]str{
    "Crusader", "Survivor", "Slayer", "Marksman", "Explorer", "Camper", "Dervish", "Pacifist", "Doorman", "Lemming",
    "Brawler"
};
# which league this process runs
var coop: bool;
# the match about to be played is one played before, with the seeds it had
var again: bool;
# how many mutants have been tried since the process started, and how many kept
var tried: i64;
var kept:  i64;

val STYLES: i32 = 11;
val STYLE_NAMES: [11]str = [11]str{
    "Fragger", "Survivor", "Berserker", "Sniper", "Tourist", "Camper", "Dervish", "Pacifist", "Doorman", "Lemming",
    "Brawler"
};
# which style each bot in twenty has: seven fraggers, a brawler, two each of
# the next three, one each of the rest
val STYLE_OF: [20]i32 = [20]i32{0, 0, 0, 0, 0, 0, 0, 10, 1, 1, 2, 2, 3, 3, 4, 5, 6, 7, 8, 9};

# the chance of the higher rated by rating gap, in thousandths, every 25
# points from 0 to 800
val EXPECT: [33]i32 = [33]i32{
    500, 536, 571, 606, 640, 673, 703, 732, 760, 785, 808, 830, 849, 867, 882, 896, 909,
    920, 930, 939, 947, 954, 960, 965, 969, 973, 977, 980, 983, 985, 987, 989, 990
};

val KIND_LEARNS: i32 = 0;
val KIND_SCRIPT: i32 = 1;
val KIND_STATIC: i32 = 2;
# one that learns from people's play rather than from its own matches
val KIND_APPRENTICE: i32 = 3;

# what people sent, as the relay keeps it (relaycore.mach): sixteen bytes,
# then records of forty: the mode (1 co-op, 2 deathmatch), the map, and a
# sample of 32 senses and 6 decisions
val POOL_HEAD:   i32 = 16;
val POOL_RECORD: i32 = 40;
val POOL_MOST:   i32 = 100000;
# an apprentice's lesson: so many moments, and so many mutants tried on them
# and how many moments of its kind of game there must be before any lesson:
# five apprentices taught three thousand lessons from seven hundred moments
# learned those seven hundred and nothing else, and came last
val ENOUGH: i32 = 5000;
val LESSON: i32 = 300;
val TRIALS: i32 = 64;

rec Member {
    kind:  i32;
    style: i32;
    # how hard it mutates: the size of a change and the share of weights
    # changed, in hundredths
    sigma: i32;
    share: i32;

    # in hundredths of a point
    rating: i32;
    games:  i32;
    frags:  i32;
    deaths: i32;
    # mutants kept
    generation: i32;

    # 1 while the match it is in is the replay it plays as its mutant
    phase: i32;

    net:   [942]i8;
    trial: [942]i8;
}

rec League {
    matches: i64;
    # the co-op league: how many of its matches ended with the level done
    finished: i32;
    members: [100]Member;
}

# what a bot did in a match
rec Tally {
    frags:    i32;
    deaths:   i32;
    suicides: i32;
    shots:    i32;
    turned:   i32;
    uses:     i32;
    distance: i32;
    # in co-op, where frags are monsters killed: how far toward the exit,
    # in hundredths of the way; keys found; whether the team got out
    progress: i32;
    keys:     i32;
    finished: i32;
    # the secrets this bot was first into, and the team's and the level's
    secrets:  i32;
    found:    i32;
    hidden:   i32;
    # the locked doors this bot was the one to open, and the switches and
    # lines that work once which it was the one to work
    doors:    i32;
    worked:   i32;
    # in a deathmatch: shots fired, by the ammunition they used, and the
    # shots that hit another player; and the two as a percentage
    fired:    i32;
    hits:     i32;
    accuracy: i32;
    # what the bot is rated on against the others in the match
    score: i32;
}

var seed: u64;
# how each member feels about each other: feel[i * 100 + j] is i about j
var feel: [10000]u8;
# the match being played: each seat's kind as the game was told it (with its
# quirk and its feelings), and how much each seat was hurt by each other:
# harm[i * 4 + j] is what j did to i
var kinds: [4]i32;
var harm:  [16]i32;
# when the standings were last written, and how many of people's moments
# the relay holds
var saved:  i64;
var pooled: i32;

val QUIRK_NAMES: [5]str = [5]str{"Steady", "Cautious", "Reckless", "Loyal", "Grudge-bearer"};
# how many moments of people's play of this league's kind the relay holds
var taught: i32;

fun random() u32 {
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >> 7);
    seed = seed ^ (seed << 17);
    ret (seed >> 16)::u32;
}

fun below(n: i32) i32 {
    ret (random() % n::u32)::i32;
}

fun number(s: str, fallback: i64) i64 {
    val r: res[i64, parse.ParseError] = parse.parse_i64(s, 10);
    if (sel r.ok) { ret r.ok; }
    ret fallback;
}

fun millis() i64 {
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret 0; }
    ret now.ok.sec * 1000 + now.ok.nsec / 1000000;
}

# ---------------------------------------------------------------- the league

fun fresh(l: *League, first: *i8) {
    l.matches = 0;
    var i: i32 = 0;
    for (i < MEMBERS) {
        val m: *Member = ?l.members[i];
        var blank: Member;
        @m       = blank;
        m.kind   = KIND_LEARNS;
        m.style  = STYLE_OF[i % 20];
        m.sigma  = 2 + ((i * 7) % 5) * 3;
        m.share  = 4 + ((i * 3) % 4) * 3;
        m.rating = 100000;
        var k: i32 = 0;
        for (k < NET) {
            m.net[k] = first[k];
            k        = k + 1;
        }
        i = i + 1;
    }
    # the apprentices: the fourteenth of every twenty
    i = 0;
    for (i < MEMBERS) {
        if (i % 20 == 13) { l.members[i].kind = KIND_APPRENTICE; }
        i = i + 1;
    }
    # the two that never learn: the teacher, and noise
    l.members[0].kind  = KIND_SCRIPT;
    l.members[99].kind = KIND_STATIC;
    var k: i32 = 0;
    for (k < NET) {
        l.members[99].net[k] = (below(256) - 128)::i8;
        k                    = k + 1;
    }
}

fun mutate(m: *Member) {
    var k: i32 = 0;
    for (k < NET) {
        var w: i32 = m.net[k]::i32;
        if (below(100) < m.share) {
            # two throws, for small changes more often than large
            w = w + (below(2 * m.sigma + 1) + below(2 * m.sigma + 1)) / 2 - m.sigma;
            if (w > 127)  { w = 127; }
            if (w < -128) { w = -128; }
        }
        m.trial[k] = w::i8;
        k          = k + 1;
    }
}

# what a co-op match was worth to a bot of a style
fun coop_reward(style: i32, t: *Tally) i32 {
    # Everything that gets a team through a level, and each thing once:
    # the keys it picked up, the locked doors it opened, the switches it
    # threw, the secrets it was first into, the way it covered, the team's
    # secrets and the level finished. A kill is worth a little and a death
    # costs a lot: bots rated on kills alone got better at killing and went
    # on dying once a minute.
    val whole: i32 = t.frags + 25 * t.secrets + 10 * t.found + t.progress + 15 * t.keys + 30 * t.doors + 8 * t.worked + 100 * t.finished - 15 * t.deaths;
    if (style == 0) { ret whole; }
    if (style == 1) { ret 150 - 25 * t.deaths + t.progress / 2 + 50 * t.finished; }
    if (style == 2) { ret 3 * t.frags + t.shots / 40; }
    if (style == 3) { ret 4 * t.frags - t.shots / 30; }
    # the explorer: doors, switches, secrets, keys and the way out, and
    # nothing for a kill
    if (style == 4) { ret 40 * t.secrets + 15 * t.found + t.progress + 20 * t.keys + 40 * t.doors + 12 * t.worked + 100 * t.finished - 10 * t.deaths; }
    if (style == 5) { ret 3 * t.frags - t.distance / 1500; }
    if (style == 6) { ret t.turned / 3000; }
    if (style == 7) { ret t.progress + 30 * t.doors + 50 - t.shots / 5 - 15 * t.deaths; }
    if (style == 8) { ret t.uses; }
    if (style == lf.STYLE_BRAWLER) { ret whole; }
    ret 6 * t.deaths;
}

# What a bot's shooting was worth in a deathmatch: its accuracy, counted in
# full only once it has fired sixty shots, so that one lucky shot is not a
# perfect score and not firing at all is nothing. Up to fifty: five frags'
# worth, in a league where most matches have none.
fun aim(t: *Tally) i32 {
    var shots: i32 = t.fired;
    if (shots > 60) { shots = 60; }
    ret t.accuracy * shots / 120;
}

# what a match was worth to a bot of a style
fun reward(style: i32, t: *Tally) i32 {
    if (coop) { ret coop_reward(style, t); }
    if (style == 0) { ret 10 * t.frags - 3 * t.deaths - 5 * t.suicides + aim(t); }
    if (style == 1) { ret 60 - 15 * t.deaths + 2 * t.frags; }
    if (style == 2) { ret 8 * t.frags + t.shots / 40 + aim(t) / 2; }
    # the sniper: accuracy first
    if (style == 3) { ret 8 * t.frags + 2 * aim(t); }
    if (style == 4) { ret t.distance / 2000 - 2 * t.deaths; }
    if (style == 5) { ret 10 * t.frags - t.distance / 1500 + aim(t); }
    if (style == 6) { ret t.turned / 3000; }
    if (style == 7) { ret 50 - t.shots / 5 - 5 * t.deaths; }
    if (style == 8) { ret t.uses; }
    # a brawler wants frags as a fragger does, and has only its fists to
    # get them with
    if (style == lf.STYLE_BRAWLER) { ret 10 * t.frags - 3 * t.deaths - 5 * t.suicides; }
    ret 10 * t.suicides + 4 * t.deaths;
}

# how far a net is from what people did, over a lesson's moments: for each,
# the difference in how it would move and turn, and a charge for each button
# it would press that they did not, or not press that they did
fun unlike(net: *i8, pool: *u8, picks: *i32, n: i32) i64 {
    var total: i64 = 0;
    var i:     i32 = 0;
    for (i < n) {
        val at: *u8 = ?pool[POOL_HEAD + picks[i] * POOL_RECORD + 2];
        var f:   [32]i32;
        var out: [6]i32;
        var k:   i32 = 0;
        for (k < 32) {
            f[k] = (at[k]:~i8)::i32;
            k    = k + 1;
        }
        bot.forward(net, ?f[0], ?out[0]);
        k = 0;
        for (k < 3) {
            var diff: i32 = out[k] - (at[32 + k]:~i8)::i32;
            if (out[k] > 127)  { diff = 127 - (at[32 + k]:~i8)::i32; }
            if (out[k] < -127) { diff = -127 - (at[32 + k]:~i8)::i32; }
            if (diff < 0) { diff = -diff; }
            total = total + diff::i64;
            k     = k + 1;
        }
        # fire matters most, then use, then changing weapon
        if ((out[3] > 0) != ((at[35]:~i8) > 0)) { total = total + 96; }
        if ((out[4] > 0) != ((at[36]:~i8) > 0)) { total = total + 48; }
        if ((out[5] > 0) != ((at[37]:~i8) > 0)) { total = total + 24; }
        i = i + 1;
    }
    ret total;
}

# one apprentice's lesson from people's play of this league's kind of game
# ---
# pool: the relay's file of samples, read whole
# n:    how many records it holds
# ret:  how far from the people the apprentice now is, a moment, or -1 if
#       there was not enough to learn from
fun lesson(m: *Member, pool: *u8, n: i32) i32 {
    var mode: u8 = 2;
    if (coop) { mode = 1; }
    # a lesson's worth of moments of the right kind, looked for at random
    var picks: [300]i32;
    var have:  i32 = 0;
    var looks: i32 = 0;
    for (have < LESSON && looks < LESSON * 12 && n > 0) {
        val at: i32 = below(n);
        if (pool[POOL_HEAD + at * POOL_RECORD] == mode) {
            picks[have] = at;
            have        = have + 1;
        }
        looks = looks + 1;
    }
    if (have < LESSON / 3) { ret -1; }

    # A mutant for a lesson is a small one: a handful of weights, each
    # nudged a little. Against the same moments every time, a nudge that
    # helps can be told from one that does not, which a match never can.
    var now: i64 = unlike(?m.net[0], pool, ?picks[0], have);
    var t:   i32 = 0;
    for (t < TRIALS) {
        m.trial = m.net;
        var nudges: i32 = 1 + below(6);
        for (nudges > 0) {
            val at: i32 = below(NET);
            var w:  i32 = m.trial[at]::i32 + below(7) - 3;
            if (w > 127)  { w = 127; }
            if (w < -128) { w = -128; }
            m.trial[at] = w::i8;
            nudges      = nudges - 1;
        }
        val then: i64 = unlike(?m.trial[0], pool, ?picks[0], have);
        if (then < now) {
            m.net        = m.trial;
            m.generation = m.generation + 1;
            now          = then;
        }
        t = t + 1;
    }
    ret (now / have::i64)::i32;
}

# how many of the pool's moments are from this league's kind of game
fun of_this_kind(pool: *u8, n: i32) i32 {
    var mode: u8 = 2;
    if (coop) { mode = 1; }
    var count: i32 = 0;
    var q:     i32 = 0;
    for (q < n) {
        if (pool[POOL_HEAD + q * POOL_RECORD] == mode) { count = count + 1; }
        q = q + 1;
    }
    ret count;
}

# read the relay's file of people's play, if there is one
# ---
# pool: room for the whole of it
# ret:  how many records it holds
fun read_pool(a: *allocator.Allocator, dir: str, pool: *u8) i32 {
    var path: [512]u8;
    var at:   i32 = join(?path[0], 0, dir);
    at = join(?path[0], at, "/train.bin");
    val opened: res[fs.File, io_error.Error] = fs.open(?path[0]);
    if (sel opened.err) { ret 0; }
    var file: fs.File = opened.ok;
    val room: i32 = POOL_HEAD + POOL_MOST * POOL_RECORD;
    var have: i32 = 0;
    for (have < room) {
        val got: res[usize, io_error.Error] = fs.read(file, ?pool[have], (room - have)::usize);
        if (sel got.err) { brk; }
        if (got.ok == 0) { brk; }
        have = have + got.ok::i32;
    }
    fs.close(?file);
    if (have < POOL_HEAD || pool[0] != 'M' || pool[1] != 'D' || pool[2] != 'T' || pool[3] != '1' || get32(pool, 4) != POOL_RECORD) { ret 0; }
    var n: i32 = get32(pool, 8);
    if (n < 0 || n > POOL_MOST)              { ret 0; }
    if (have < POOL_HEAD + n * POOL_RECORD)  { n = (have - POOL_HEAD) / POOL_RECORD; }
    ret n;
}

# the chance, in thousandths, that a bot outscores one rated `gap`
# hundredths of a point above it (negative: below it)
fun expected(gap: i32) i32 {
    var d: i32 = gap / 100;
    var up: bool = 1;
    if (d < 0) {
        d  = -d;
        up = 0;
    }
    var at: i32 = d / 25;
    if (at > 32) { at = 32; }
    if (up) { ret 1000 - EXPECT[at]; }
    ret EXPECT[at];
}

# a match is over: rate the four against each other, and let each learn
fun settle(l: *League, picks: *i32, tally: *Tally) {
    # ratings: every pair, by score (see play)
    var change: [4]i32;
    var i:      i32 = 0;
    for (i < 4) {
        var j: i32 = 0;
        for (j < 4) {
            if (i != j) {
                val mine:   i32 = tally[i].score;
                val theirs: i32 = tally[j].score;
                var result: i32 = 500;
                if (mine > theirs) { result = 1000; }
                if (mine < theirs) { result = 0; }
                val e: i32 = expected(l.members[picks[j]].rating - l.members[picks[i]].rating);
                # eight points a pair at stake, in hundredths
                change[i] = change[i] + (result - e) * 8 / 10;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    for (i < 4) {
        val m: *Member = ?l.members[picks[i]];
        m.rating = m.rating + change[i];
        m.games  = m.games + 1;
        m.frags  = m.frags + tally[i].frags;
        m.deaths = m.deaths + tally[i].deaths;

        i = i + 1;
    }
    l.matches  = l.matches + 1;
    l.finished = l.finished + tally[0].finished;
}

# How a league learns. Once it was six games as a bot is against six as a
# mutant of itself, on whatever maps and with whatever opponents the draw
# gave, and that could not tell a better net from a luckier draw: the map
# decides more than the net does. After sixty thousand deathmatches the
# hand-written bot was three hundred points clear of every net. So instead
# the match just played is played again, the same map, the same seeds, the
# same four, but with each learner replaced by a mutant of itself; and a
# mutant that earned clearly more of what its style wants than the bot did
# in the very same match takes its place. Four trials for the price of one
# match.
# ---
# was: what each did in the match as played
# ret: whether the replay could be played
fun relive(s: *game.Session, l: *League, picks: *i32, map: i32, was: *Tally, seeds: *u32, nets: *i8) bool {
    var any: bool = 0;
    var i:   i32  = 0;
    for (i < 4) {
        val m: *Member = ?l.members[picks[i]];
        if (m.kind == KIND_LEARNS) {
            mutate(m);
            m.phase = 1;
            any     = 1;
        }
        i = i + 1;
    }
    if (!any) { ret 1; }
    var now: [4]Tally;
    again = 1;
    val ok: bool = play(s, l, picks, map, ?now[0], seeds, nets);
    again = 0;
    i = 0;
    for (i < 4) {
        val m: *Member = ?l.members[picks[i]];
        if (m.kind == KIND_LEARNS) {
            m.phase = 0;
            if (ok) {
                val before: i32 = reward(m.style, ?was[i]);
                val after:  i32 = reward(m.style, ?now[i]);
                # clearly more: by a quarter and a little, so that a coin's
                # fall is less often taken for a lesson
                var margin: i32 = before / 4;
                if (margin < 0) { margin = -margin; }
                tried = tried + 1;
                if (after > before + margin + 10) {
                    m.net        = m.trial;
                    m.generation = m.generation + 1;
                    kept         = kept + 1;
                }
            }
        }
        i = i + 1;
    }
    ret ok;
}

# And the best spread: now and then, in one style, the lowest rated learner
# takes the net of the highest rated, if the gap between them is wide. Each
# style keeps its own wants, so the league keeps its variety; what spreads
# is whatever serves a want best.
fun inherit(l: *League) {
    val style: i32 = below(STYLES);
    var best:  i32 = -1;
    var worst: i32 = -1;
    var i:     i32 = 0;
    for (i < MEMBERS) {
        val m: *Member = ?l.members[i];
        if (m.kind == KIND_LEARNS && m.style == style && m.games >= 8) {
            if (best < 0 || m.rating > l.members[best].rating)   { best = i; }
            if (worst < 0 || m.rating < l.members[worst].rating) { worst = i; }
        }
        i = i + 1;
    }
    if (best < 0 || best == worst || l.members[best].rating - l.members[worst].rating < 6000) { ret; }
    l.members[worst].net        = l.members[best].net;
    l.members[worst].generation = l.members[best].generation;
    l.members[worst].rating     = (l.members[worst].rating + l.members[best].rating) / 2;
}

# how a member plays: by the script or by its net, and with its fists alone
# if it is a brawler
fun kind_of(m: *Member) i32 {
    var kind: i32 = bot.KIND_NET;
    if (m.kind == KIND_SCRIPT)                             { kind = bot.KIND_SCRIPT; }
    if (m.kind == KIND_LEARNS && m.style == lf.STYLE_BRAWLER) { kind = kind | bot.TRAIT_FISTS; }
    ret kind;
}

# a seat's kind as the game is told it: how the member plays, its quirk,
# and how it feels about the members in the other three seats
fun kind_for(l: *League, picks: *i32, seat: i32) i32 {
    var kind: i32 = kind_of(?l.members[picks[seat]]) | (lf.quirk_of(picks[seat]) << bot.QUIRK_SHIFT);
    var nth:  i32 = 0;
    var j:    i32 = 0;
    for (j < 4) {
        if (j != seat) {
            kind = kind | bot.feel_bits(nth, feel[picks[seat] * MEMBERS + picks[j]]::i32);
            nth  = nth + 1;
        }
        j = j + 1;
    }
    ret kind;
}

# After a match each of the four comes to like one of the others a little
# more and one a little less. The one liked less is whoever hurt it most
# (in a deathmatch a kill counts five hits; in co-op it is a team-mate's
# stray shots); if nobody hurt it, in co-op, the one who did least for the
# team. The one liked more, in co-op, is whoever did most for the team; in
# a deathmatch, nobody: there are no friends there, only enemies, and a
# feeling in that league only ever goes down. One point, three for a bot
# that bears grudges.
fun befriend(picks: *i32, tally: *Tally) {
    var i: i32 = 0;
    for (i < 4) {
        var enemy:  i32 = -1;
        var friend: i32 = -1;
        var j:      i32 = 0;
        for (j < 4) {
            if (j != i && harm[i * 4 + j] > 0 && (enemy < 0 || harm[i * 4 + j] > harm[i * 4 + enemy])) { enemy = j; }
            j = j + 1;
        }
        j = 0;
        for (j < 4) {
            if (j != i && j != enemy) {
                if (coop) {
                    if (enemy < 0 && (friend < 0 || tally[j].score > tally[friend].score)) { friend = j; }
                    if (enemy >= 0 && (friend < 0 || tally[j].score > tally[friend].score)) { friend = j; }
                }

            }
            j = j + 1;
        }
        if (coop && enemy < 0) {
            # nobody shot it: the dead weight, if there is one below it
            j = 0;
            for (j < 4) {
                if (j != i && j != friend && tally[j].score < tally[i].score && (enemy < 0 || tally[j].score < tally[enemy].score)) { enemy = j; }
                j = j + 1;
            }
        }
        var step: i32 = 1;
        if (lf.quirk_of(picks[i]) == bot.QUIRK_GRUDGE) { step = 3; }
        if (friend >= 0) {
            val at: i32 = picks[i] * MEMBERS + picks[friend];
            var v:  i32 = feel[at]::i32 + step;
            if (v > 100) { v = 100; }
            feel[at] = v::u8;
        }
        if (enemy >= 0) {
            val at: i32 = picks[i] * MEMBERS + picks[enemy];
            var v:  i32 = feel[at]::i32 - step;
            if (v < 0) { v = 0; }
            feel[at] = v::u8;
        }
        i = i + 1;
    }
}

# the living player nearest a line's middle, within 256 units, or -1
fun nearest(s: *game.Session, l: i32) i32 {
    val line: *level.Line = ?s.g.lv.lines[l];
    val mx:   i32 = (s.g.lv.vertexes[line.v1].x / 2 + s.g.lv.vertexes[line.v2].x / 2) >> 16;
    val my:   i32 = (s.g.lv.vertexes[line.v1].y / 2 + s.g.lv.vertexes[line.v2].y / 2) >> 16;
    var best: i32 = -1;
    var near: i32 = 256;
    var i:    i32 = 0;
    for (i < 4) {
        val mo: *defs.Mobj = s.g.players[i].mo;
        if (mo != nil && mo.health > 0) {
            var dx: i32 = (mo.x >> 16) - mx;
            var dy: i32 = (mo.y >> 16) - my;
            if (dx < 0) { dx = -dx; }
            if (dy < 0) { dy = -dy; }
            if (dx + dy < near) {
                near = dx + dy;
                best = i;
            }
        }
        i = i + 1;
    }
    ret best;
}

# play one match between four members on a map; fill what each did, and,
# for the replay, the seed each played with and the net it played by
fun play(s: *game.Session, l: *League, picks: *i32, map: i32, tally: *Tally, seeds: *u32, nets: *i8) bool {
    var length: i32 = MATCH;
    if (coop) {
        length = COOPMATCH;
        if (!game.coop_game(s, 4, 0, defs.SK_NIGHTMARE, map)) { ret 0; }
    }
    or (!game.deathmatch_game(s, 4, 0, defs.SK_MEDIUM, map, 1, 1)) {
        ret 0;
    }
    var i: i32 = 0;
    for (i < 4) {
        val m: *Member = ?l.members[picks[i]];
        if (!again) { seeds[i] = random(); }
        var used: *i8 = ?m.net[0];
        if (m.phase == 1 && m.kind == KIND_LEARNS) { used = ?m.trial[0]; }
        var k: i32 = 0;
        for (k < NET) {
            nets[i * NET + k] = used[k];
            k                 = k + 1;
        }
        kinds[i] = kind_for(l, picks, i);
        game.set_bot(s, i, kinds[i], used, seeds[i]);
        var q: i32 = 0;
        for (q < 4) {
            harm[i * 4 + q] = 0;
            q               = q + 1;
        }
        var blank: Tally;
        tally[i] = blank;
        i        = i + 1;
    }

    # the lines to watch in co-op: locked doors, by the door behind them, and
    # lines that work once (their special is taken away when they have)
    var doorline: [32]i32;
    var doorsec:  [32]i32;
    var ndoors:   i32 = 0;
    var onceline: [96]i32;
    var nonce:    i32 = 0;
    if (coop) {
        var l: i32 = 0;
        for (l < s.g.lv.numlines) {
            val line: *level.Line = ?s.g.lv.lines[l];
            val sp:   i32         = line.special::i32;
            val locked: bool = sp == 26 || sp == 27 || sp == 28 || sp == 32 || sp == 33 || sp == 34;
            if (locked && line.sidenum[1] != level.NONE && ndoors < 32) {
                # one door, however many faces it has
                var seen: bool = 0;
                var k:    i32  = 0;
                for (k < ndoors) {
                    if (doorsec[k] == line.backsector) { seen = 1; }
                    k = k + 1;
                }
                if (!seen) {
                    doorline[ndoors] = l;
                    doorsec[ndoors]  = line.backsector;
                    ndoors           = ndoors + 1;
                }
            }
            or (sp != 0 && line.tagnum != 0 && sp != 11 && sp != 51 && sp != 52 && sp != 124 && nonce < 96) {
                onceline[nonce] = l;
                nonce           = nonce + 1;
            }
            l = l + 1;
        }
    }

    var cmds: [4]defs.Ticcmd;
    var lastx: [4]i32;
    var lasty: [4]i32;
    var dead:  [4]bool;
    var died:  [4]i32;
    var hurt:  [4]i32;
    var ammo:  [16]i32;
    var tic:   i32 = 0;
    for (tic < length && !s.completed && !s.broken) {
        game.ticker_cmds(s, ?cmds[0]);
        # a locked door that has opened, or a line that has done its one
        # work: whoever is nearest it did that
        var w: i32 = 0;
        for (w < ndoors) {
            if (doorline[w] >= 0 && s.g.lv.sectors[doorsec[w]].ceilingheight > s.g.lv.sectors[doorsec[w]].floorheight) {
                val who: i32 = nearest(s, doorline[w]);
                if (who >= 0) { tally[who].doors = tally[who].doors + 1; }
                doorline[w] = -1;
            }
            w = w + 1;
        }
        w = 0;
        for (w < nonce) {
            if (onceline[w] >= 0 && s.g.lv.lines[onceline[w]].special == 0) {
                val who: i32 = nearest(s, onceline[w]);
                if (who >= 0) { tally[who].worked = tally[who].worked + 1; }
                onceline[w] = -1;
            }
            w = w + 1;
        }
        # shots, by the ammunition they used; and hits: a tic on which a
        # player's hurt rose and whoever did it is another player
        i = 0;
        for (i < 4) {
            val pl: *defs.Player = ?s.g.players[i];
            var k:  i32 = 0;
            for (k < 4) {
                if (pl.ammo[k] < ammo[i * 4 + k] && tic > 0 && pl.playerstate != defs.PST_REBORN) { tally[i].fired = tally[i].fired + ammo[i * 4 + k] - pl.ammo[k]; }
                ammo[i * 4 + k] = pl.ammo[k];
                k               = k + 1;
            }
            if (pl.damagecount > hurt[i] && pl.attacker != nil && pl.attacker != pl.mo) {
                var by: i32 = 0;
                for (by < 4) {
                    if (by != i && s.g.players[by].mo == pl.attacker) {
                        tally[by].hits  = tally[by].hits + 1;
                        harm[i * 4 + by] = harm[i * 4 + by] + 1;
                    }
                    by = by + 1;
                }
            }
            hurt[i] = pl.damagecount;
            i       = i + 1;
        }
        # how far each walked, in map units, a tic at a time; a respawn's
        # jump across the map is not walking
        i = 0;
        for (i < 4) {
            val mo: *defs.Mobj = s.g.players[i].mo;
            if (mo != nil) {
                val x: i32 = mo.x >> 16;
                val y: i32 = mo.y >> 16;
                var dx: i32 = x - lastx[i];
                var dy: i32 = y - lasty[i];
                if (dx < 0) { dx = -dx; }
                if (dy < 0) { dy = -dy; }
                if (tic > 0 && dx + dy < 64) { tally[i].distance = tally[i].distance + dx + dy; }
                lastx[i] = x;
                lasty[i] = y;
            }
            # and how often each died, which in co-op nothing else counts
            val gone: bool = s.g.players[i].playerstate == defs.PST_DEAD;
            if (gone && !dead[i]) { died[i] = died[i] + 1; }
            dead[i] = gone;
            i       = i + 1;
        }
        tic = tic + 1;
    }

    i = 0;
    for (i < 4) {
        val p: *defs.Player = ?s.g.players[i];
        tally[i].suicides = p.frags[i];
        tally[i].deaths   = p.frags[i];
        var k: i32 = 0;
        for (k < 4) {
            if (k != i) {
                tally[i].frags  = tally[i].frags + p.frags[k];
                tally[i].deaths = tally[i].deaths + s.g.players[k].frags[i];
                # being killed is five hits' worth of harm
                if (!coop) { harm[i * 4 + k] = harm[i * 4 + k] + 5 * s.g.players[k].frags[i]; }
            }
            k = k + 1;
        }
        tally[i].shots  = s.bots[i].shots;
        tally[i].turned = s.bots[i].turned;
        tally[i].uses   = s.bots[i].uses;
        # a deathmatch is rated on frags less suicides; and, since most
        # matches have no frags in them at all, on accuracy between bots
        # that are level on those
        if (tally[i].hits > tally[i].fired) { tally[i].hits = tally[i].fired; }
        if (tally[i].fired > 0) { tally[i].accuracy = tally[i].hits * 100 / tally[i].fired; }
        tally[i].score = (tally[i].frags - tally[i].suicides) * 200 + aim(?tally[i]);
        if (coop) {
            val b: *bot.Bot = ?s.bots[i];
            tally[i].frags    = p.killcount;
            tally[i].deaths   = died[i];
            tally[i].suicides = 0;
            if (b.goalstart > 1 && b.goalbest > 0) { tally[i].progress = (b.goalstart - b.goalbest) * 100 / (b.goalstart - 1); }
            if (s.completed) {
                tally[i].finished = 1;
                # out of the level, as far as the nearest of them got
                if (tally[i].progress > 90) { tally[i].progress = 100; }
            }
            k = 0;
            for (k < 6) {
                if (p.cards[k]) { tally[i].keys = tally[i].keys + 1; }
                k = k + 1;
            }
            tally[i].secrets = p.secretcount;
            tally[i].hidden  = s.g.totalsecret;
            var q: i32 = 0;
            for (q < 4) {
                tally[i].found = tally[i].found + s.g.players[q].secretcount;
                q              = q + 1;
            }
            # co-op is rated on what gets a team through the level: see
            # coop_reward. The level finished is the same for all four, so
            # it does not tell them apart and is left out here.
            tally[i].score = tally[i].frags + 25 * tally[i].secrets + tally[i].progress + 15 * tally[i].keys + 30 * tally[i].doors + 8 * tally[i].worked - 15 * tally[i].deaths;
        }
        i = i + 1;
    }
    ret !s.broken;
}

# ------------------------------------------------------------------ the files

fun put32(p: *u8, at: i32, v: i32) i32 {
    val u: u32 = v:~u32;
    p[at]     = u::u8;
    p[at + 1] = (u >> 8)::u8;
    p[at + 2] = (u >> 16)::u8;
    p[at + 3] = (u >> 24)::u8;
    ret at + 4;
}

fun get32(p: *u8, at: i32) i32 {
    ret (p[at]::u32 | (p[at + 1]::u32 << 8) | (p[at + 2]::u32 << 16) | (p[at + 3]::u32 << 24)):~i32;
}

# a member in the file: twelve numbers, then its net and its trial
val MEMBER_BYTES: i32 = 12 * 4 + 942 * 2;
val FILE_BYTES:   i32 = 16 + 100 * (12 * 4 + 942 * 2);

fun join(buf: *u8, at: i32, text: str) i32 {
    var k: i32 = 0;
    for (text[k] != 0) {
        buf[at + k] = text[k];
        k           = k + 1;
    }
    buf[at + k] = 0;
    ret at + k;
}

fun join_number(buf: *u8, at: i32, value: i64) i32 {
    var digits: [24]u8;
    var n:      i32 = 0;
    var v:      i64 = value;
    var end:    i32 = at;
    if (v < 0) {
        buf[end] = '-';
        end      = end + 1;
        v        = -v;
    }
    for {
        digits[n] = ('0' + (v % 10)::i32)::u8;
        n         = n + 1;
        v         = v / 10;
        if (v == 0) { brk; }
    }
    for (n > 0) {
        n        = n - 1;
        buf[end] = digits[n];
        end      = end + 1;
    }
    buf[end] = 0;
    ret end;
}

# write a file whole: under another name first, then renamed over the old,
# so that a reader never sees half of one
fun replace(dir: str, name: str, data: *u8, len: i32) bool {
    var path: [512]u8;
    var temp: [512]u8;
    var at:   i32 = join(?path[0], 0, dir);
    at = join(?path[0], at, "/");
    at = join(?path[0], at, name);
    at = join(?temp[0], 0, ?path[0]);
    at = join(?temp[0], at, ".new");
    val wrote: err[fs.FsError] = fs.write_bytes(?temp[0], data, len::usize, 0o644);
    if (sel wrote.err) { ret 0; }
    val moved: err[io_error.Error] = fs.rename(?temp[0], ?path[0]);
    if (sel moved.err) { ret 0; }
    ret 1;
}

fun save(l: *League, dir: str, buf: *u8) bool {
    buf[0] = 'M';
    buf[1] = 'D';
    buf[2] = 'L';
    buf[3] = '1';
    var at: i32 = put32(buf, 4, MEMBERS);
    at = put32(buf, at, (l.matches & 0xffffffff)::i32);
    # the co-op league keeps its count of levels finished where the
    # deathmatch league keeps the high half of a count that will not need it
    if (coop) {
        at = put32(buf, at, l.finished);
    }
    or {
        at = put32(buf, at, (l.matches >> 32)::i32);
    }
    var i: i32 = 0;
    for (i < MEMBERS) {
        val m: *Member = ?l.members[i];
        at = put32(buf, at, m.kind);
        at = put32(buf, at, m.style);
        at = put32(buf, at, m.sigma);
        at = put32(buf, at, m.share);
        at = put32(buf, at, m.rating);
        at = put32(buf, at, m.games);
        at = put32(buf, at, m.frags);
        at = put32(buf, at, m.deaths);
        at = put32(buf, at, m.generation);
        # three numbers a league that learned by blocks of games kept here
        at = put32(buf, at, 0);
        at = put32(buf, at, 0);
        at = put32(buf, at, 0);
        var k: i32 = 0;
        for (k < NET) {
            buf[at + k]       = m.net[k]:~u8;
            buf[at + NET + k] = m.trial[k]:~u8;
            k                 = k + 1;
        }
        at = at + 2 * NET;
        i  = i + 1;
    }
    if (coop) { ret replace(dir, "coop.bin", buf, at); }
    ret replace(dir, "league.bin", buf, at);
}

fun load(l: *League, a: *allocator.Allocator, dir: str) bool {
    var path: [512]u8;
    var at:   i32 = join(?path[0], 0, dir);
    if (coop) {
        at = join(?path[0], at, "/coop.bin");
    }
    or {
        at = join(?path[0], at, "/league.bin");
    }
    val bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?path[0]);
    if (sel bytes.err) { ret 0; }
    val p: *u8 = bytes.ok.data;
    if (bytes.ok.len != FILE_BYTES::usize || p[0] != 'M' || p[1] != 'D' || p[2] != 'L' || p[3] != '1' || get32(p, 4) != MEMBERS) { ret 0; }
    l.matches = (get32(p, 8):~u32)::i64 | ((get32(p, 12):~u32)::i64 << 32);
    if (coop) {
        l.matches  = (get32(p, 8):~u32)::i64;
        l.finished = get32(p, 12);
    }
    at = 16;
    var i: i32 = 0;
    for (i < MEMBERS) {
        val m: *Member = ?l.members[i];
        m.kind       = get32(p, at);
        m.style      = get32(p, at + 4) % STYLES;
        m.sigma      = get32(p, at + 8);
        m.share      = get32(p, at + 12);
        m.rating     = get32(p, at + 16);
        m.games      = get32(p, at + 20);
        m.frags      = get32(p, at + 24);
        m.deaths     = get32(p, at + 28);
        m.generation = get32(p, at + 32);
        m.phase      = 0;
        at = at + 48;
        var k: i32 = 0;
        for (k < NET) {
            m.net[k]   = p[at + k]:~i8;
            m.trial[k] = p[at + NET + k]:~i8;
            k          = k + 1;
        }
        at = at + 2 * NET;
        i  = i + 1;
    }

    # a league from before there were brawlers: the eighth of every twenty,
    # a fragger till now, becomes one, keeping its net and its record
    var brawlers: i32 = 0;
    i = 0;
    for (i < MEMBERS) {
        if (l.members[i].style == lf.STYLE_BRAWLER) { brawlers = brawlers + 1; }
        i = i + 1;
    }
    # and a league from before there were apprentices: the fourteenth of
    # every twenty becomes one, keeping its net and its record
    var apprentices: i32 = 0;
    i = 0;
    for (i < MEMBERS) {
        if (l.members[i].kind == KIND_APPRENTICE) { apprentices = apprentices + 1; }
        i = i + 1;
    }
    if (apprentices == 0) {
        i = 0;
        for (i < MEMBERS) {
            if (i % 20 == 13 && l.members[i].kind == KIND_LEARNS) {
                l.members[i].kind  = KIND_APPRENTICE;
                l.members[i].phase = 0;
            }
            i = i + 1;
        }
    }
    if (brawlers == 0 && !coop) {
        i = 0;
        for (i < MEMBERS) {
            if (i % 20 == 7 && l.members[i].kind == KIND_LEARNS) { l.members[i].style = lf.STYLE_BRAWLER; }
            i = i + 1;
        }
    }
    ret 1;
}

# the feelings: ten thousand bytes, or fifty all round if there are none kept
fun load_feel(a: *allocator.Allocator, dir: str) {
    var i: i32 = 0;
    for (i < MEMBERS * MEMBERS) {
        feel[i] = 50;
        i       = i + 1;
    }
    var path: [512]u8;
    var at:   i32 = join(?path[0], 0, dir);
    if (coop) {
        at = join(?path[0], at, "/coopfeel.bin");
    }
    or {
        at = join(?path[0], at, "/feel.bin");
    }
    val bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?path[0]);
    if (sel bytes.err) { ret; }
    if (bytes.ok.len != (MEMBERS * MEMBERS)::usize) { ret; }
    i = 0;
    for (i < MEMBERS * MEMBERS) {
        if (bytes.ok.data[i] <= 100) { feel[i] = bytes.ok.data[i]; }
        # no deathmatch bot likes another, whatever a file from before says
        if (!coop && feel[i] > 50) { feel[i] = 50; }
        i = i + 1;
    }
}

fun save_feel(dir: str) bool {
    if (coop) { ret replace(dir, "coopfeel.bin", ?feel[0], MEMBERS * MEMBERS); }
    ret replace(dir, "feel.bin", ?feel[0], MEMBERS * MEMBERS);
}

# the match just played, for a game to play again: 16 bytes (magic, the
# simulation's version, the map, 1 for co-op, the skill, the tics, the
# match's number), then for each of the four its kind, seed, frags (in
# co-op, monsters killed), deaths, rating, name (24 bytes) and net: 986
# bytes each
fun watchable(l: *League, dir: str, buf: *u8, picks: *i32, tally: *Tally, map: i32, seeds: *u32, nets: *i8) bool {
    buf[0] = 'M';
    buf[1] = 'D';
    buf[2] = 'W';
    buf[3] = '1';
    buf[4] = 1;
    buf[5] = map::u8;
    buf[6] = 0;
    buf[7] = defs.SK_MEDIUM::u8;
    var length: i32 = MATCH;
    if (coop) {
        buf[6] = 1;
        buf[7] = defs.SK_NIGHTMARE::u8;
        length = COOPMATCH;
    }
    var at: i32 = put32(buf, 8, length);
    at = put32(buf, at, (l.matches & 0x7fffffff)::i32);
    var i: i32 = 0;
    for (i < 4) {
        val m: *Member = ?l.members[picks[i]];
        at = put32(buf, at, kinds[i]);
        at = put32(buf, at, seeds[i]:~i32);
        at = put32(buf, at, tally[i].frags);
        at = put32(buf, at, tally[i].deaths);
        at = put32(buf, at, m.rating / 100);
        var k: i32 = 0;
        for (k < 24) {
            buf[at + k] = 0;
            k           = k + 1;
        }
        name_of(picks[i], ?buf[at]);
        at = at + 24;
        k  = 0;
        for (k < NET) {
            buf[at + k] = nets[i * NET + k]:~u8;
            k           = k + 1;
        }
        at = at + NET;
        i  = i + 1;
    }
    if (coop) { ret replace(dir, "coopwatch.bin", buf, at); }
    ret replace(dir, "watch.bin", buf, at);
}

fun name_of(i: i32, out: *u8) {
    lf.name_of(i, out);
}

# the standings, best first, and the match just played
fun board(l: *League, dir: str, buf: *u8, picks: *i32, tally: *Tally, map: i32, unix: i64) bool {
    var order: [100]i32;
    var i:     i32 = 0;
    for (i < MEMBERS) {
        order[i] = i;
        i        = i + 1;
    }
    i = 1;
    for (i < MEMBERS) {
        val who: i32 = order[i];
        var j:   i32 = i;
        for (j > 0 && l.members[order[j - 1]].rating < l.members[who].rating) {
            order[j] = order[j - 1];
            j        = j - 1;
        }
        order[j] = who;
        i        = i + 1;
    }

    var name: [32]u8;
    var at:   i32 = join(buf, 0, "{\"mode\":\"");
    if (coop) {
        at = join(buf, at, "coop\",\"finished\":");
        at = join_number(buf, at, l.finished::i64);
    }
    or {
        at = join(buf, at, "deathmatch\"");
    }
    at = join(buf, at, ",\"taught\":");
    at = join_number(buf, at, taught::i64);
    at = join(buf, at, ",\"matches\":");
    at = join_number(buf, at, l.matches);
    at = join(buf, at, ",\"updated\":");
    at = join_number(buf, at, unix);
    at = join(buf, at, ",\"last\":{\"map\":\"E1M");
    at = join_number(buf, at, map::i64);
    at = join(buf, at, "\",\"players\":[");
    i  = 0;
    for (i < 4) {
        name_of(picks[i], ?name[0]);
        if (i > 0) { at = join(buf, at, ","); }
        at = join(buf, at, "{\"name\":\"");
        at = join(buf, at, ?name[0]);
        at = join(buf, at, "\",\"frags\":");
        at = join_number(buf, at, tally[i].frags::i64);
        at = join(buf, at, ",\"deaths\":");
        at = join_number(buf, at, tally[i].deaths::i64);
        at = join(buf, at, ",\"progress\":");
        at = join_number(buf, at, tally[i].progress::i64);
        at = join(buf, at, ",\"accuracy\":");
        at = join_number(buf, at, tally[i].accuracy::i64);
        at = join(buf, at, ",\"doors\":");
        at = join_number(buf, at, tally[i].doors::i64);
        at = join(buf, at, "}");
        i  = i + 1;
    }
    at = join(buf, at, "],\"finished\":");
    at = join_number(buf, at, tally[0].finished::i64);
    at = join(buf, at, ",\"secrets\":");
    at = join_number(buf, at, tally[0].found::i64);
    at = join(buf, at, ",\"of\":");
    at = join_number(buf, at, tally[0].hidden::i64);
    at = join(buf, at, "},\"bots\":[");
    i  = 0;
    for (i < MEMBERS) {
        val m: *Member = ?l.members[order[i]];
        name_of(order[i], ?name[0]);
        if (i > 0) { at = join(buf, at, ","); }
        at = join(buf, at, "{\"name\":\"");
        at = join(buf, at, ?name[0]);
        at = join(buf, at, "\",\"style\":\"");
        if (m.kind == KIND_SCRIPT) {
            at = join(buf, at, "Hand-written");
        }
        or (m.kind == KIND_STATIC) {
            at = join(buf, at, "Noise");
        }
        or (m.kind == KIND_APPRENTICE) {
            at = join(buf, at, "Apprentice");
        }
        or (coop) {
            at = join(buf, at, COOP_NAMES[m.style]);
        }
        or {
            at = join(buf, at, STYLE_NAMES[m.style]);
        }
        at = join(buf, at, "\",\"rating\":");
        at = join_number(buf, at, (m.rating / 100)::i64);
        at = join(buf, at, ",\"games\":");
        at = join_number(buf, at, m.games::i64);
        at = join(buf, at, ",\"frags\":");
        at = join_number(buf, at, m.frags::i64);
        at = join(buf, at, ",\"deaths\":");
        at = join_number(buf, at, m.deaths::i64);
        at = join(buf, at, ",\"generation\":");
        at = join_number(buf, at, m.generation::i64);
        at = join(buf, at, ",\"quirk\":\"");
        at = join(buf, at, QUIRK_NAMES[lf.quirk_of(order[i])]);
        at = join(buf, at, "\"");
        # whom it likes best and least, if it has come to feel anything
        var best:  i32 = -1;
        var worst: i32 = -1;
        var j:     i32 = 0;
        for (j < MEMBERS) {
            if (j != order[i]) {
                val v: i32 = feel[order[i] * MEMBERS + j]::i32;
                if (v > 50 && (best < 0 || v > feel[order[i] * MEMBERS + best]::i32))   { best = j; }
                if (v < 50 && (worst < 0 || v < feel[order[i] * MEMBERS + worst]::i32)) { worst = j; }
            }
            j = j + 1;
        }
        if (best >= 0) {
            name_of(best, ?name[0]);
            at = join(buf, at, ",\"friend\":\"");
            at = join(buf, at, ?name[0]);
            at = join(buf, at, "\",\"likes\":");
            at = join_number(buf, at, feel[order[i] * MEMBERS + best]::i64);
        }
        if (worst >= 0) {
            name_of(worst, ?name[0]);
            at = join(buf, at, ",\"enemy\":\"");
            at = join(buf, at, ?name[0]);
            at = join(buf, at, "\",\"dislikes\":");
            at = join_number(buf, at, feel[order[i] * MEMBERS + worst]::i64);
        }
        at = join(buf, at, "}");
        i  = i + 1;
    }
    at = join(buf, at, "]}\n");
    if (coop) { ret replace(dir, "coop.json", buf, at); }
    ret replace(dir, "board.json", buf, at);
}

# The standings and the league itself, written once a minute and at the end.
# It is asked after every match, the replays too: whoever looks after this
# process takes ten minutes without new standings to mean it has stalled,
# and one match of Nightmare can take most of that within a few hundredths
# of a processor.
fun keep(l: *League, a: *allocator.Allocator, dir: str, fb: *u8, jb: *u8, pb: *u8, picks: *i32, tally: *Tally, map: i32, took: i64, last: bool) {
    val now: i64 = millis();
    if (now - saved < 60000 && !last) { ret; }
    # what people have sent since the last look, for the lessons to come and
    # for the standings to count
    pooled = read_pool(a, dir, pb);
    taught = of_this_kind(pb, pooled);
    var unix: i64 = 0;
    val wall: time.Clock = time.now();
    if (sel wall.ok) { unix = wall.ok.sec; }
    if (!save(l, dir, fb) || !save_feel(dir) || !board(l, dir, jb, picks, tally, map, unix)) {
        print.eprintln("arena: the league could not be written");
    }
    print.printlnf("arena: {} matches in all, the last took {} ms", l.matches, took);
    print.printlnf("arena: {} mutants tried since it started, {} kept", tried, kept);
    if (coop) { print.printlnf("arena: {} levels finished in all", l.finished); }
    saved = now;
}

# rest, to stay within the share of the processor: work that took t earns
# t * (100 - duty) / duty of sleep
fun rest(began: i64, duty: i64) {
    if (duty >= 100) { ret; }
    val idle: i64 = (millis() - began) * (100 - duty) / duty;
    if (idle > 0) { os.sleep(idle * 1000000); }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 4) {
        print.eprintln("usage: arena <wad> <first net> <directory> [<matches> [coop]]");
        ret 1;
    }
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 2; }

    val loaded: res[wad.Wad, wad.WadError] = wad.load(?a, argv[1]);
    if (sel loaded.err) {
        print.eprintln("arena: the WAD could not be read");
        ret 2;
    }
    var w: wad.Wad = loaded.ok;
    val graphics: res[rdata.Data, rdata.DataError] = rdata.init(?a, ?w);
    if (sel graphics.err) {
        print.eprintln("arena: the WAD's textures could not be read");
        ret 2;
    }
    var d: rdata.Data = graphics.ok;

    val first: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, argv[2]);
    if (sel first.err) {
        print.eprintln("arena: the first net could not be read");
        ret 2;
    }
    if (first.ok.len != NET::usize) {
        print.eprintln("arena: the first net should be 942 bytes");
        ret 2;
    }
    val dir:   str = argv[3];
    var limit: i64 = 0;
    if (argc >= 5) { limit = number(argv[4], 0); }
    if (argc >= 6) { coop = argv[5][0] == 'c' && argv[5][1] == 'o' && argv[5][2] == 'o' && argv[5][3] == 'p' && argv[5][4] == 0; }

    # the share of the processor to use, as a percentage
    var duty:    i64 = 5;
    var dutybuf: [16]u8;
    val dutyenv: res[opt[usize], env.EnvError] = env.get("ARENA_DUTY", ?dutybuf[0], 16);
    if (sel dutyenv.ok) {
        if (sel dutyenv.ok.some) { duty = number(?dutybuf[0], 5); }
    }
    if (duty < 1)   { duty = 1; }
    if (duty > 100) { duty = 100; }

    # ARENA_SEED makes a run repeatable, and ARENA_TRACE names each match
    # before it is played: for finding a match that goes wrong
    seed = rand.u64() | 1;
    var seedbuf: [32]u8;
    val seedenv: res[opt[usize], env.EnvError] = env.get("ARENA_SEED", ?seedbuf[0], 32);
    if (sel seedenv.ok) {
        if (sel seedenv.ok.some) { seed = number(?seedbuf[0], 1)::u64 | 1; }
    }
    var tracebuf: [8]u8;
    var trace:    bool = 0;
    val traceenv: res[opt[usize], env.EnvError] = env.get("ARENA_TRACE", ?tracebuf[0], 8);
    if (sel traceenv.ok) {
        if (sel traceenv.ok.some) { trace = 1; }
    }

    val lg: res[*League, allocator.Error] = allocator.zallocate[League](?a, 1);
    if (sel lg.err) { ret 2; }
    val l: *League = lg.ok;
    if (load(l, ?a, dir)) {
        print.printlnf("arena: the league goes on from match {}", l.matches);
    }
    or {
        fresh(l, first.ok.data:~*i8);
        print.println("arena: a new league of 100");
    }
    if (coop) { print.println("arena: the co-op league, on Nightmare"); }
    # nobody is half way through a block of games as a mutant, as a league
    # kept from before this one learned by replays may say
    var q: i32 = 0;
    for (q < MEMBERS) {
        l.members[q].phase = 0;
        q                  = q + 1;
    }

    val sg: res[*game.Session, allocator.Error] = allocator.zallocate[game.Session](?a, 1);
    if (sel sg.err) { ret 2; }
    val s: *game.Session = sg.ok;
    game.init(s, ?a, ?w, ?d);

    val fb: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, (FILE_BYTES + 64)::usize);
    val jb: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, 65536);
    if (sel fb.err) { ret 2; }
    if (sel jb.err) { ret 2; }
    val pb: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, (POOL_HEAD + POOL_MOST * POOL_RECORD + 64)::usize);
    if (sel pb.err) { ret 2; }
    pooled = read_pool(?a, dir, pb.ok);
    taught = of_this_kind(pb.ok, pooled);
    load_feel(?a, dir);
    var turn:   i32 = 0;
    val wb: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, 4096);
    val nb: res[*u8, allocator.Error] = allocator.zallocate[u8](?a, 4096);
    if (sel wb.err) { ret 2; }
    if (sel nb.err) { ret 2; }

    print.printlnf("arena: playing within {}% of a processor", duty);
    saved = millis();
    var shown:  bool = 0;
    var played: i64 = 0;
    for (limit == 0 || played < limit) {
        val began: i64 = millis();

        # four different members, and a map
        var picks: [4]i32;
        var i:     i32 = 0;
        for (i < 4) {
            picks[i] = below(MEMBERS);
            var again: bool = 0;
            var k:     i32  = 0;
            for (k < i) {
                if (picks[k] == picks[i]) { again = 1; }
                k = k + 1;
            }
            if (!again) { i = i + 1; }
        }
        var map: i32 = MAPS[below(7)];
        if (coop) { map = COOPMAPS[below(8)]; }

        if (trace) { print.printlnf("match {} map {} bots {} {} {} {} seed {}", played, map, picks[0], picks[1], picks[2], picks[3], seed); }
        var tally: [4]Tally;
        var seeds: [4]u32;
        if (!play(s, l, ?picks[0], map, ?tally[0], ?seeds[0], nb.ok:~*i8)) {
            print.eprintln("arena: a map would not load");
            ret 3;
        }
        settle(l, ?picks[0], ?tally[0]);
        played = played + 1;
        # worth watching: a match with some fighting in it, or the first
        # there is
        var worth: bool = tally[0].frags + tally[1].frags + tally[2].frags + tally[3].frags >= 4;
        # in co-op: a level finished, or half its secrets found
        if (coop) { worth = tally[0].finished != 0 || (tally[0].found > 0 && tally[0].found * 2 >= tally[0].hidden); }
        if (worth || !shown) {
            shown = watchable(l, dir, wb.ok, ?picks[0], ?tally[0], map, ?seeds[0], nb.ok:~*i8);
        }
        keep(l, ?a, dir, fb.ok, jb.ok, pb.ok, ?picks[0], ?tally[0], map, millis() - began, 0);
        rest(began, duty);
        # the league learns from the match played again with mutants; and
        # then the four have their feelings about it
        val again_began: i64 = millis();
        if (!relive(s, l, ?picks[0], map, ?tally[0], ?seeds[0], nb.ok:~*i8)) {
            print.eprintln("arena: a map would not load");
            ret 3;
        }
        befriend(?picks[0], ?tally[0]);
        if (played % 5 == 0) { inherit(l); }
        if (trace) { print.printlnf("  {} mutants tried, {} kept", tried, kept); }
        if (trace) { print.printlnf("  took {} ms, frags {} {} {} {} progress {} {} {} {} finished {} secrets {} of {} doors {} worked {} accuracy {} {} {} {}", millis() - began, tally[0].frags, tally[1].frags, tally[2].frags, tally[3].frags, tally[0].progress, tally[1].progress, tally[2].progress, tally[3].progress, tally[0].finished, tally[0].found, tally[0].hidden, tally[0].doors + tally[1].doors + tally[2].doors + tally[3].doors, tally[0].worked + tally[1].worked + tally[2].worked + tally[3].worked, tally[0].accuracy, tally[1].accuracy, tally[2].accuracy, tally[3].accuracy); }

        # one apprentice's lesson, each in its turn; with too little to learn
        # from, an apprentice is as the league began
        if (taught < ENOUGH) {
            var k: i32 = 0;
            for (k < MEMBERS) {
                val m: *Member = ?l.members[k];
                if (m.kind == KIND_APPRENTICE && m.generation != 0) {
                    var c: i32 = 0;
                    for (c < NET) {
                        m.net[c] = (first.ok.data[c]):~i8;
                        c        = c + 1;
                    }
                    m.generation = 0;
                }
                k = k + 1;
            }
        }
        or (pooled > 0) {
            var who: i32 = -1;
            var k:   i32 = 0;
            for (k < MEMBERS && who < 0) {
                turn = (turn + 1) % MEMBERS;
                if (l.members[turn].kind == KIND_APPRENTICE) { who = turn; }
                k = k + 1;
            }
            if (who >= 0) {
                val far: i32 = lesson(?l.members[who], pb.ok, pooled);
                if (trace && far >= 0) { print.printlnf("  apprentice {} is {} from the people, generation {}", who, far, l.members[who].generation); }
            }
        }

        keep(l, ?a, dir, fb.ok, jb.ok, pb.ok, ?picks[0], ?tally[0], map, millis() - again_began, limit != 0 && played == limit);
        rest(again_began, duty);
    }
    ret 0;
}
